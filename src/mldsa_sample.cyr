# mldsa_sample.cyr — rejection sampling + challenge expansion
#
# FIPS 204 §7: every pseudo-random poly that shows up during
# keygen / sign / verify is built here. The drivers all sit on
# top of `lib/keccak.cyr` (SHAKE-128 / SHAKE-256, landed in
# Cyrius 5.4.15). Reference: pq-crystals/dilithium ref/poly.c
# (the rej_uniform / rej_eta / poly_uniform_* / poly_challenge
# group) and ref/polyvec.c (polyvec_matrix_expand + polyvec*
# uniform wrappers).
#
# Streaming pattern: the stdlib exposes one-shot `shake128(...)`
# /`shake256(...)` wrappers plus the lower-level `_keccak_absorb`
# and `_keccak_f1600` primitives. We call those two primitives
# directly so the absorb step runs once per seed/nonce and each
# rejection-sampling block squeezes the minimum bytes it needs.
#
# Scratch: every driver keeps its Keccak state, its seed ‖ nonce
# absorb buffer, its squeeze buffer and its loop counters in its OWN
# frame — array locals inside the 122,880-byte per-fn budget are
# per-call and per-thread (CLAUDE.md quirk #1), and the largest here
# is ~1.1 KB. Nothing is shared between calls or threads, so every
# driver is reentrant and safe to call concurrently. Before the M11 fix the
# state and buffers were module globals, which raced concurrent
# signers and left ρ'-derived (secret) Keccak state behind.
#
# Zeroization: ExpandS (s1, s2) and ExpandMask (y) absorb the SECRET
# seed ρ' / ρ'', so their Keccak state, absorb buffer and squeeze
# buffer are wiped (`_mldsa_wipe`) before return. ExpandA (ρ) and
# SampleInBall (c̃) consume public inputs and are not wiped.

# SHAKE-128 rate: 168 bytes. SHAKE-256 rate: 136 bytes.
# Initial-squeeze sizes (matching pq-crystals `POLY_UNIFORM_*_NBLOCKS`):
#   uniform   (A): 5 blocks × 168 = 840 bytes  (covers 256-coeff w.h.p.)
#   uniform_eta:   2 blocks × 136 = 272 bytes  (η=4 needs 227)
#   uniform_gamma1:5 blocks × 136 = 680 bytes  (exactly POLYZ_PACKEDBYTES)

# Zero n bytes at p, eight at a time. Used on every ML-DSA secret
# buffer before it is released (a byte-loop memset over the ~94 KB
# sign workspace is 8x slower for no benefit).
fn _mldsa_wipe(p, n): i64 {
    var i = 0;
    var n8 = n - (n % 8);
    while (i < n8) {
        store64(p + i, 0);
        i = i + 8;
    }
    while (i < n) {
        store8(p + i, 0);
        i = i + 1;
    }
    return 0;
}

# ================================================================
# SHAKE streaming wrappers (one absorb + repeated squeeze)
# ================================================================
# Absorb = pq-crystals dilithium_shake{128,256}_stream_init: absorb
# seed then a little-endian 2-byte nonce, finalize. `st` (200 B) and
# `ab` (>= seedlen + 2 B) are the caller's per-call scratch; `st` is
# zeroed first so it never carries residue into the sponge.

fn _mldsa_shake_stream_init(st, ab, seed, seedlen, nonce, rate): i64 {
    memset(st, 0, 200);
    memcpy(ab, seed, seedlen);
    store8(ab + seedlen, nonce & 0xFF);
    store8(ab + seedlen + 1, (nonce >> 8) & 0xFF);
    _keccak_absorb(st, ab, seedlen + 2, rate, 0x1F);
    return 0;
}

# Squeeze `nblocks` × `rate` bytes of state `st` into `out`, permuting
# between blocks. After the last squeeze, state is left ready for
# one more block (i.e. the f1600 call is eager).
fn _mldsa_shake_squeeze_blocks(st, out, nblocks, rate): i64 {
    var b = 0;
    while (b < nblocks) {
        var i = 0;
        while (i < rate) {
            store8(out + b * rate + i, load8(st + i));
            i = i + 1;
        }
        _keccak_f1600(st);
        b = b + 1;
    }
    return 0;
}

# ================================================================
# rej_uniform — sample coeffs in [0, Q) from random bytes
# ================================================================
# Returns number of coefficients successfully sampled (≤ len). May
# return early if buflen is exhausted. Each attempt consumes 3
# bytes; acceptance probability Q / 2^23 ≈ 0.999 so 5 blocks of
# SHAKE-128 (= 840 B) are almost always enough for 256 coeffs.

# RejNTTPoly inner loop: take 3-byte little-endian groups of buf[buflen], mask to 23 bits,
# keep values < Q; writes up to `len` i64 coeffs in [0, Q) to `a` and returns how many.
fn mldsa_rej_uniform(a, len, buf, buflen): i64 {
    var ctr = 0;
    var pos = 0;
    while (ctr < len) {
        if (pos + 3 > buflen) { return ctr; }
        var t = load8(buf + pos) & 0xFF;
        t = t | ((load8(buf + pos + 1) & 0xFF) << 8);
        t = t | ((load8(buf + pos + 2) & 0xFF) << 16);
        t = t & 0x7FFFFF;
        pos = pos + 3;
        if (t < MLDSA_Q) {
            store64(a + ctr * 8, t);
            ctr = ctr + 1;
        }
    }
    return ctr;
}

# ================================================================
# rej_eta — sample coeffs in [-ETA, ETA] for ETA = 4
# ================================================================
# Each byte yields two nibbles; each nibble in [0, 8] accepts to
# `4 - nibble`, nibbles in [9, 15] reject. Acceptance per nibble
# is 9/16. η=4 path only; η=2 rejection tables are not ML-DSA-65.

# RejBoundedPoly inner loop (η = 4): low then high nibble t of each byte of buf[buflen];
# t < 9 yields the coeff 4 − t ∈ [−4, 4]. Writes up to `len` to `a`, returns how many.
fn mldsa_rej_eta(a, len, buf, buflen): i64 {
    var ctr = 0;
    var pos = 0;
    while (ctr < len) {
        if (pos >= buflen) { return ctr; }
        var byte = load8(buf + pos) & 0xFF;
        var t0 = byte & 0x0F;
        var t1 = byte >> 4;
        pos = pos + 1;
        if (t0 < 9) {
            store64(a + ctr * 8, MLDSA65_ETA - t0);
            ctr = ctr + 1;
        }
        if (ctr < len) {
            if (t1 < 9) {
                store64(a + ctr * 8, MLDSA65_ETA - t1);
                ctr = ctr + 1;
            }
        }
    }
    return ctr;
}

# polyz_unpack lives in mldsa_encode.cyr (shared with pk/sk/sig
# packing). That module is included before this one in lib.cyr
# so `_mldsa_polyz_unpack` is in scope here.

# ================================================================
# poly_uniform — ExpandA single-poly driver (uses SHAKE-128)
# ================================================================
# Fills `a` with 256 uniformly random coefficients in [0, Q) via
# rejection sampling of a SHAKE-128(ρ ‖ nonce) stream.
# Callers for ExpandA set nonce = (row << 8) | col; nonce is an
# i64 here but only the low 16 bits matter.

# RejNTTPoly: fill `a` (256 coeffs) with uniform values in [0, Q), used as an NTT-domain
# entry of Â, from SHAKE-128(seed[32] ‖ nonce as 2 LE bytes). Per-call scratch only, so it
# is reentrant and thread-safe. ρ is public, so the scratch is not wiped. Returns 0.
fn mldsa_poly_uniform(a, seed, nonce): i64 {
    var st[200];
    var ab[80];
    var buf[842];                   # 5 × 168 + 2 (carry-over bytes)
    _mldsa_shake_stream_init(&st, &ab, seed, MLDSA_SEEDBYTES, nonce, 168);
    # Initial 5-block squeeze — enough for 256 coeffs ~99% of the time.
    _mldsa_shake_squeeze_blocks(&st, &buf, 5, 168);
    var buflen = 5 * 168;
    var ctr = mldsa_rej_uniform(a, 256, &buf, buflen);
    # Fallback loop: carry over partial bytes, squeeze one more block.
    while (ctr < 256) {
        var off = buflen % 3;
        var i = 0;
        while (i < off) {
            store8(&buf + i, load8(&buf + buflen - off + i));
            i = i + 1;
        }
        # Squeeze one block at offset `off`.
        _mldsa_shake_squeeze_blocks(&st, &buf + off, 1, 168);
        buflen = 168 + off;
        ctr = ctr + mldsa_rej_uniform(a + ctr * 8, 256 - ctr, &buf, buflen);
    }
    return 0;
}

# ================================================================
# poly_uniform_eta — ExpandS single-poly driver (uses SHAKE-256)
# ================================================================
# Fills `a` with 256 coefficients in [-η, η] via rejection on a
# SHAKE-256(ρ' ‖ nonce) stream.

# RejBoundedPoly (η = 4): fill `a` (256 coeffs) with values in [−4, 4] from
# SHAKE-256(seed[64] ‖ nonce as 2 LE bytes). Per-call scratch, wiped before return (the
# seed is the secret ρ'), so reentrant and thread-safe. Returns 0.
fn mldsa_poly_uniform_eta(a, seed, nonce): i64 {
    var st[200];
    var ab[80];
    var buf[272];                   # 2 × 136
    _mldsa_shake_stream_init(&st, &ab, seed, MLDSA_CRHBYTES, nonce, 136);
    # η=4 needs ≈ 256·(16/9) ≈ 455 bytes on average. pq-crystals
    # squeezes 2 blocks then loops one block at a time; same here.
    _mldsa_shake_squeeze_blocks(&st, &buf, 2, 136);
    var ctr = mldsa_rej_eta(a, 256, &buf, 2 * 136);
    while (ctr < 256) {
        _mldsa_shake_squeeze_blocks(&st, &buf, 1, 136);
        ctr = ctr + mldsa_rej_eta(a + ctr * 8, 256 - ctr, &buf, 136);
    }
    _mldsa_wipe(&st, 200);
    _mldsa_wipe(&ab, 80);
    _mldsa_wipe(&buf, 272);
    return 0;
}

# ================================================================
# poly_uniform_gamma1 — ExpandMask single-poly driver
# ================================================================
# Packs SHAKE-256(ρ' ‖ κ) into POLYZ_PACKEDBYTES = 640 bytes of
# output, then unpacks 20 bits per coefficient to produce y
# with coefficients in [1 − γ1, γ1]. No rejection; the unpack
# is exact.

# One ExpandMask poly: unpack the first 640 bytes of SHAKE-256(seed[64] ‖ nonce as 2 LE
# bytes) as 20-bit values into `a`, coeffs in [1 − γ1, γ1]. Per-call scratch, wiped before
# return (the seed is the secret ρ''), so reentrant and thread-safe. Returns 0.
fn mldsa_poly_uniform_gamma1(a, seed, nonce): i64 {
    var st[200];
    var ab[80];
    var buf[680];                   # 5 × 136
    _mldsa_shake_stream_init(&st, &ab, seed, MLDSA_CRHBYTES, nonce, 136);
    _mldsa_shake_squeeze_blocks(&st, &buf, 5, 136);
    _mldsa_polyz_unpack(a, &buf);
    _mldsa_wipe(&st, 200);
    _mldsa_wipe(&ab, 80);
    _mldsa_wipe(&buf, 680);
    return 0;
}

# ================================================================
# poly_challenge — SampleInBall (τ non-zero ±1 coefficients)
# ================================================================
# c̃ (CTILDEBYTES bytes) is absorbed; first 8 output bytes become
# the 64-bit `signs` register (one bit per ±1 choice). Remaining
# bytes drive the Fisher-Yates-like swap that places TAU non-zero
# coefficients in the last TAU positions, shuffled earlier.

# SampleInBall: expand c̃ (`seed`, CTILDEBYTES = 48) via SHAKE-256 into `c` with exactly
# τ = 49 coeffs in {−1, +1} (signed i64) and the rest 0. Per-call scratch, so reentrant and
# thread-safe; c̃ is public, so the scratch is not wiped. Returns 0.
fn mldsa_poly_challenge(c, seed): i64 {
    var st[200];
    var buf[136];
    # FIPS 204 SampleInBall has no nonce, so absorb c̃ directly rather
    # than through the seed ‖ nonce stream wrapper.
    memset(&st, 0, 200);
    _keccak_absorb(&st, seed, MLDSA65_CTILDEBYTES, 136, 0x1F);
    _mldsa_shake_squeeze_blocks(&st, &buf, 1, 136);

    # Collect 64 sign bits from the first 8 bytes.
    var signs = 0;
    var si = 0;
    while (si < 8) {
        signs = signs | ((load8(&buf + si) & 0xFF) << (si * 8));
        si = si + 1;
    }
    var pos = 8;

    # Zero the output poly.
    var z = 0;
    while (z < 256) {
        store64(c + z * 8, 0);
        z = z + 1;
    }

    # Place ±1 at TAU positions via the swap walk.
    var i = 256 - MLDSA65_TAU;
    while (i < 256) {
        # Sample a uniform byte b ∈ [0, i] via rejection.
        var b = 0;
        var accepted = 0;
        while (accepted == 0) {
            if (pos >= 136) {
                _mldsa_shake_squeeze_blocks(&st, &buf, 1, 136);
                pos = 0;
            }
            b = load8(&buf + pos) & 0xFF;
            pos = pos + 1;
            if (b <= i) { accepted = 1; }
        }
        # c[i] = c[b]; c[b] = 1 - 2·(signs & 1); signs >>= 1
        store64(c + i * 8, load64(c + b * 8));
        store64(c + b * 8, 1 - 2 * (signs & 1));
        signs = signs >> 1;
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Polyvec / matrix wrappers
# ================================================================

# ExpandA: matrix mat[i][j] = SHAKE-128(ρ ‖ (i<<8)|j) sampled into
# [0, Q). Total K·L = 30 polys.
fn mldsa_polyvec_matrix_expand(mat, rho): i64 {
    var i = 0;
    while (i < MLDSA65_K) {
        var j = 0;
        while (j < MLDSA65_L) {
            var nonce = (i << 8) | j;
            # Row i of A is at offset i * L * 2048; poly (i,j) at +j*2048.
            mldsa_poly_uniform(
              mat + (i * MLDSA65_L + j) * 2048,
              rho,
              nonce
              );
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

# ExpandS → s1 (L polys, nonces 0..L-1)
fn mldsa_polyvecl_uniform_eta(v, seed, nonce_base): i64 {
    var i = 0;
    while (i < MLDSA65_L) {
        mldsa_poly_uniform_eta(v + i * 2048, seed, nonce_base + i);
        i = i + 1;
    }
    return 0;
}

# ExpandS → s2 (K polys, nonces L..L+K-1)
fn mldsa_polyveck_uniform_eta(v, seed, nonce_base): i64 {
    var i = 0;
    while (i < MLDSA65_K) {
        mldsa_poly_uniform_eta(v + i * 2048, seed, nonce_base + i);
        i = i + 1;
    }
    return 0;
}

# ExpandMask(ρ'', κ): the sign-time mask y (L polys), poly ℓ from nonce κ + ℓ. The caller
# owns κ and must advance it by L (not by 1) per rejection-loop attempt (FIPS 204 Alg. 7).
fn mldsa_polyvecl_uniform_gamma1(v, seed, nonce_base): i64 {
    var i = 0;
    while (i < MLDSA65_L) {
        mldsa_poly_uniform_gamma1(v + i * 2048, seed, nonce_base + i);
        i = i + 1;
    }
    return 0;
}
