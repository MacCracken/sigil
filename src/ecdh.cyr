# ecdh.cyr — ECDH key agreement on NIST P-256 and P-384 (3.13.8)
#
# The elliptic-curve Diffie-Hellman primitive (SEC 1 v2.0 §3.3.1, NIST SP 800-56A rev. 3
# §5.7.1.2) and its key-pair generation (FIPS 186-5 Appendix A.2.1), for TLS ECDHE on
# secp256r1 / secp384r1 (RFC 8422 §5.10; RFC 8446 §7.4.2). All scalar arithmetic runs on
# the constant-time engine in src/ec_ct.cyr: no branch and no memory address depends on the
# private scalar or on anything derived from it.
#
# Surface (all big-endian byte strings, SEC 1 §2.3):
#   ecdh_p256_keygen(rnd, rnd_len, priv_out, pub_out)        rnd >= 40 B -> priv 32 B, pub 65 B
#   ecdh_p256_shared(priv, peer_pub, peer_pub_len, secret_out)   -> secret 32 B
#   ecdh_p384_keygen(rnd, rnd_len, priv_out, pub_out)        rnd >= 56 B -> priv 48 B, pub 97 B
#   ecdh_p384_shared(priv, peer_pub, peer_pub_len, secret_out)   -> secret 48 B
# Each returns 0, or -1 with every output zeroed.
#
# ENTROPY. The caller supplies the randomness (sigil does not draw it here): rnd must come
# from a CSPRNG (`random_bytes` / getrandom). Key generation consumes exactly
# ECDH_P{256,384}_RAND_LEN bytes — len(n) + 64 bits, the "extra random bits" method of
# FIPS 186-5 A.2.1 — and derives d = (c mod (n - 1)) + 1, so d lies in [1, n - 1] with a bias
# below 2^-64 and no rejection loop (no retry that would need more randomness, and no
# branch on the random value).
#
# PEER VALIDATION (fail closed). The peer key must be exactly 1 + 2·len bytes, start with
# 0x04 (uncompressed; the compressed and hybrid forms are refused), have both coordinates
# below p, and satisfy the curve equation. That is the full public-key validation of
# SP 800-56A §5.6.2.3.3: both curves have cofactor 1, so a point on the curve has order n,
# and the point at infinity has no uncompressed encoding. Off-curve points are what the
# invalid-curve attack (Biehl–Meyer–Müller 2000; Jager–Schwenk–Somorovsky 2015) feeds a
# server that skips the check. The derived point is refused if it is the identity.
#
# THE SHARED SECRET is the x-coordinate of d·Q, big-endian, full field length (leading zero
# bytes kept) — the TLS premaster secret / Z of SP 800-56A. It is not a uniformly random
# key: derive keys from it with a KDF (the TLS key schedule does).

var ECDH_P256_RAND_LEN   = 40;   # random bytes keygen consumes (len(n) + 64 bits)
var ECDH_P256_PRIV_LEN   = 32;
var ECDH_P256_PUB_LEN    = 65;   # 0x04 || X || Y
var ECDH_P256_SECRET_LEN = 32;
var ECDH_P384_RAND_LEN   = 56;
var ECDH_P384_PRIV_LEN   = 48;
var ECDH_P384_PUB_LEN    = 97;
var ECDH_P384_SECRET_LEN = 48;

# Shared key-pair generation for a curve of nl limbs (field context f, scalar context nc,
# Montgomery b `bm`, generator G): d = (c mod (n - 1)) + 1 from the 8·(nl + 1) bytes at rnd,
# priv_out = d (nl·8 bytes), pub_out = 0x04 || X || Y (1 + 16·nl bytes). Returns 0, or -1
# with both outputs zeroed (never reached for valid constants: d·G is never the identity).
fn _ecdh_keygen(rnd, priv_out, pub_out, nl, f, nc, bm, G): i64 {
    var w = nl * 8;
    secret var S[480];
    var d   = &S;          # private scalar (LE limbs)
    var nm1 = &S + 64;     # n - 1 (public, but kept in the block)
    var x   = &S + 128;
    var y   = &S + 192;
    var P   = &S + 256;    # d·G, projective (144 B)
    memcpy(nm1, nc + 16, w);
    store64(nm1, load64(nm1) - 1);                   # n is odd: no borrow
    _ect_reduce_be(d, rnd, 8 * (nl + 1), nm1, nl);   # c mod (n - 1)
    var c = 1;                                       # d = d + 1; d <= n - 2, so no carry out
    var i = 0;
    while (i < nl) {
        var v = load64(d + i * 8);
        var s = v + c;
        c = ((v & c) | ((v | c) & (s ^ (0 - 1)))) >> 63;
        store64(d + i * 8, s);
        i = i + 1;
    }
    _ect_smul(P, d, G, f, bm);
    var ok = _ect_affine(x, y, P, f);
    _ect_store_be(priv_out, d, nl);
    store8(pub_out, 0x04);
    _ect_store_be(pub_out + 1, x, nl);
    _ect_store_be(pub_out + 1 + w, y, nl);
    if (ok == 0) {                                   # unreachable for a prime-order curve
        memset(priv_out, 0, w);
        memset(pub_out, 0, 1 + 2 * w);
        return 0 - 1;
    }
    return 0;
}

# Shared derivation for a curve of nl limbs: validates the peer's SEC 1 uncompressed point
# and our scalar, computes d·Q in constant time and writes its x-coordinate (nl·8 bytes,
# big-endian) to secret_out. Returns 0, or -1 with secret_out zeroed.
fn _ecdh_shared(priv, peer, peer_len, secret_out, nl, f, nc, bm): i64 {
    var w = nl * 8;
    memset(secret_out, 0, w);
    # --- the peer key: public data, so plain branches are fine here ---
    if (peer_len != 1 + 2 * w) { return 0 - 1; }
    if ((load8(peer) & 0xFF) != 0x04) { return 0 - 1; }
    var Q[144];
    var qx[64];
    var qy[64];
    _ect_load_be(&qx, peer + 1, nl);
    _ect_load_be(&qy, peer + 1 + w, nl);
    if (_ect_lt(&qx, f + 16, nl) == 0) { return 0 - 1; }   # x >= p
    if (_ect_lt(&qy, f + 16, nl) == 0) { return 0 - 1; }   # y >= p
    _ect_to_mont(&Q, &qx, f);
    _ect_to_mont(&Q + w, &qy, f);
    memcpy(&Q + 2 * w, f + 144, w);                         # Z = 1
    if (_ect_on_curve(&Q, &Q + w, f, bm) == 0) { return 0 - 1; }
    # --- our scalar: secret. Its range check is computed without a branch; only the final
    #     verdict is branched on, and a refused scalar is reported as a failure anyway. ---
    secret var S[400];
    var d = &S;            # LE limbs
    var x = &S + 64;
    var y = &S + 128;
    var R = &S + 192;      # d·Q, projective (144 B)
    _ect_load_be(d, priv, nl);
    var valid = _ect_lt(d, nc + 16, nl) & (1 ^ _ect_is_zero(d, nl));
    if (valid == 0) { return 0 - 1; }                       # d == 0 or d >= n
    _ect_smul(R, d, &Q, f, bm);
    var ok = _ect_affine(x, y, R, f);
    if (ok == 0) { return 0 - 1; }                          # d·Q at infinity
    _ect_store_be(secret_out, x, nl);
    return 0;
}

# P-256 ECDH key pair from caller-supplied randomness. rnd: at least ECDH_P256_RAND_LEN (40)
# bytes from a CSPRNG, of which exactly the first 40 are used. priv_out (32 B) receives the
# private scalar d = (c mod (n - 1)) + 1, big-endian (FIPS 186-5 A.2.1); pub_out (65 B) the
# public key d·G as 0x04 || X || Y. Constant-time in rnd and d. Returns 0, or -1 (both
# outputs zeroed) when rnd_len < 40.
fn ecdh_p256_keygen(rnd, rnd_len, priv_out, pub_out): i64 {
    if (rnd_len < ECDH_P256_RAND_LEN) {
        memset(priv_out, 0, 32);
        memset(pub_out, 0, 65);
        return 0 - 1;
    }
    _ect256_init();
    var rc = _ecdh_keygen(rnd, priv_out, pub_out, 4, _ect_fp256, _ect_fn256, _ect_b256, _ect_g256);
    _ect_burn_stack(8192);                 # the frames below here, _ecdh_keygen's included
    return rc;
}

# P-256 ECDH shared secret: secret_out (32 B) = the x-coordinate of d·Q, big-endian (the TLS
# premaster secret, RFC 8422 §5.10). priv: our 32-byte big-endian scalar, which must lie in
# [1, n - 1]. peer_pub: the peer's key, exactly 65 bytes 0x04 || X || Y with X, Y < p and on
# the curve. Constant-time in priv. Returns 0, or -1 (secret_out zeroed) on any invalid input.
fn ecdh_p256_shared(priv, peer_pub, peer_pub_len, secret_out): i64 {
    _ect256_init();
    var rc = _ecdh_shared(priv, peer_pub, peer_pub_len, secret_out, 4,
      _ect_fp256, _ect_fn256, _ect_b256);
    _ect_burn_stack(8192);                 # the frames below here, _ecdh_shared's included
    return rc;
}

# P-384 ECDH key pair from caller-supplied randomness. rnd: at least ECDH_P384_RAND_LEN (56)
# bytes from a CSPRNG, of which exactly the first 56 are used. priv_out (48 B) receives
# d = (c mod (n - 1)) + 1, big-endian; pub_out (97 B) the public key 0x04 || X || Y.
# Constant-time in rnd and d. Returns 0, or -1 (both outputs zeroed) when rnd_len < 56.
fn ecdh_p384_keygen(rnd, rnd_len, priv_out, pub_out): i64 {
    if (rnd_len < ECDH_P384_RAND_LEN) {
        memset(priv_out, 0, 48);
        memset(pub_out, 0, 97);
        return 0 - 1;
    }
    _ect384_init();
    var rc = _ecdh_keygen(rnd, priv_out, pub_out, 6, _ect_fp384, _ect_fn384, _ect_b384, _ect_g384);
    _ect_burn_stack(8192);
    return rc;
}

# P-384 ECDH shared secret: secret_out (48 B) = the x-coordinate of d·Q, big-endian. priv: our
# 48-byte big-endian scalar in [1, n - 1]. peer_pub: exactly 97 bytes 0x04 || X || Y with
# X, Y < p and on the curve. Constant-time in priv. Returns 0, or -1 (secret_out zeroed) on
# any invalid input.
fn ecdh_p384_shared(priv, peer_pub, peer_pub_len, secret_out): i64 {
    _ect384_init();
    var rc = _ecdh_shared(priv, peer_pub, peer_pub_len, secret_out, 6,
      _ect_fp384, _ect_fn384, _ect_b384);
    _ect_burn_stack(8192);
    return rc;
}
