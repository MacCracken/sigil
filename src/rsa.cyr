# rsa.cyr -- RSA signature VERIFICATION, PKCS#1 v1.5 (RFC 8017 §8.2.2 /
# §9.2), SHA-256 and SHA-384.
#
# SCOPE: verification only. RSA verify recovers `m = s^e mod n` from the
# signature `s` using the PUBLIC key (n, e) and checks the PKCS#1 v1.5
# encoding. Every operand is public, so:
#   * no constant-time requirement (no secret to leak; the bignum
#     engine's data-dependent reduction is fine here);
#   * not on the parallel batch-verify path. The static scratch below
#     was plain single-threaded; 3.9.7 banked it across `cbank()` lanes
#     (see src/bignum.cyr header / src/crypto_scratch.cyr) so concurrent
#     RSA callers can't race it — verify banks are PUBLIC (no wipe); the
#     sign / blind / CRT banks carry the secret-exponent residue and are
#     per-CALL wiped on the sign return (`_rsa_sign_scrub`, quirk #9). [3.12.9]
# RSA *signing* (private exponent) shipped in 3.6.4 — it adds blinding +
# a constant-time ladder (`bn_mont_modexp` + CRT); it does NOT reuse the
# non-CT `bn_modexp`.
# 3.12.2: every PUBLIC-exponent modexp on both paths (verify's `s^e`,
# sign's blinding `r^e` and its verify-after-sign `s^e`) moved to
# `bn_mont_modexp_pub` — same Montgomery core, public schedule. The
# secret exponents (d / dp / dq) keep the constant-time ladder.
#
# Interop note: TLS 1.3 / X.509 RSA certs are overwhelmingly
# `rsaEncryption` PKCS#1 v1.5 (and PSS); this lands the v1.5 verify
# path first (the load-bearing one), per the roadmap. PSS is a
# follow-on bite. Built on src/bignum.cyr (modexp) + sha256/sha384.

# DigestInfo working scratch + the RSA bignum buffers. n_len <= 512
# bytes (RSA-4096); limbs = ceil(n_len/8) <= 64.
#
# ⚠ THE PKCS#1 v1.5 VERIFY PATH NO LONGER USES SHARED SCRATCH (3.12.3), AND
# THAT IS A SECURITY FIX. DO NOT RE-BANK IT.
#
# Banking (3.9.7) widened each of these to `[N*SIGIL_CRYPTO_BANKS]` and gave
# every consumer its own lane `&X + cbank()*N` (src/crypto_scratch.cyr). On the
# verify path that was **an authentication bypass**: `_rsa_pkcs1v15_check` ended
#
#     return ct_eq_bytes(rem, rexp, n_len);
#
# with BOTH operands — the recovered EM and the expected EM — in the same shared
# lane. `cbank()` hands out 63 lanes and **never releases one** (no decrement
# anywhere), so the ceiling is 63 *lifetime* crypto-touching threads, not 63
# concurrent ones; past it, colliding pairs exist. A colliding thread that left a
# consistent valid pair in the lane made the next thread's compare succeed on
# bytes that were never its own.
#
# Reported by agnosai (100 sandhi pool workers over 63 lanes). Measured there:
# **888 of 400,000 forged signatures ACCEPTED** (~1 in 450) and 281,965 of
# 400,000 valid ones rejected, reproduced three times independently. See
# docs/development/issues/.
#
# The premise that forced banking was **quirk #1 — "function-scope `var X[N]`
# arrays are static globals" — and it is STALE.** Verified under cyrius 6.3.5;
# re-probed under **6.5.11** it is false for any array inside the per-fn stack
# budget: non-tail recursion yields four distinct frames 576 B apart, and two
# threads land ~2 MB apart (one thread stack). The budget is **122,880 bytes**
# per function, counted cumulatively (`cyrius/src/frontend/parse_decl.cyr:89`);
# exceeding it makes the compiler emit `note: oversized array local kept in
# shared global (not per-thread)`, which is the signal that a local really did
# become shared. **Re-verify that probe before relying on quirk #1 anywhere
# else in this tree.**
#
# Now function-scope (per-call, therefore per-thread, no lane, no ceiling):
#   `_rsa_recover_em`      n/s/m       3x512 = 1,536 B   (1.3% of budget)
#   `_rsa_pkcs1v15_check`  em/expected 2x512 = 1,024 B   (0.8%)
#   `rsa_pkcs1v15_verify_sha256/384`   64+24 =    88 B   (0.07%)
#   `rsa_pkcs1v15_sign_sha256/384`     64+24 =    88 B   (0.07%)   [3.12.6]
#   the ENTIRE PSS workspace (14 buffers)   4,664 B      (3.8%)    [3.12.6]
#
# ⚠ **3.12.6 IS A SECURITY FIX, NOT A CLEANUP — PSS VERIFY HAD THE SAME
# AUTHENTICATION BYPASS 3.12.3 FIXED FOR v1.5.** With the workspace banked and
# two threads pinned to one lane, `tests/tcyr/rsa_lane_race.tcyr` accepts a
# FORGED PSS signature (1 of 800) and rejects 9 of 800 valid ones. The v1.5
# bypass was found because agnosai hit it in production; the PSS twin survived
# three releases of this file BECAUSE the fix for it kept "failing", and the
# failure was misread as sigil's bug three times (3.12.3, .4, .5 each recorded
# "cause not understood" here).
#
# The cause was never in sigil. Every buffer that resisted localisation sat in
# a function ending `return <helper>(... ptr-into-this-frame ...)` with EXACTLY
# SIX arguments, and cycc's tail-call epilogue frees the frame before jumping.
# cycc declines TCO above 6 args — which is the whole reason the verify wrappers
# (10 args) localised cleanly in 3.12.3 while their sign twins (6 args) "broke
# the KATs". The arity was the variable, not the buffer. cycc's guard fired only
# on a `&` spelled literally in the arg list, so a pointer laundered through a
# local (`var rh = &hbuf; ... return f(rh)`) walked straight past it. Fixed in
# cyrius 6.5.14; this file REQUIRES >= 6.5.14, which cyrius.cyml pins.
# See CHANGELOG [3.12.6] and cyrius CHANGELOG [6.5.14].
#
# ⛔ 3.12.9: THE SIGN WORKSPACE IS LOCALISED TOO — NOTHING IN THIS FILE IS
# BANKED ANY MORE. `_rsa_sign_*`, `_rsa_blind_*` and `_rsa_crt_*` were 23
# globals kept banked "by design" (secret residue + per-lane wipe), which
# also meant they inherited the 63-lane ceiling. That framing understated
# the risk: the Bellcore verify-after-sign guard compared `_rsa_sign_chk`
# against `_rsa_sign_m` with BOTH operands in one shared lane — structurally
# the same defect as the v1.5 verify bypass above, and it would have waved
# through the faulty signature the guard exists to catch.
#
# Now function-scope, adding to the list above:
#   `_rsa_raw_sign`        10 buffers  5,632 B   (4.6% of budget)
#   `_rsa_crt_modexp`      11 buffers  3,328 B   (2.7%)
#   `_rsa_gen_blind`       rand          512 B   (0.4%)
#   `_rsa_pkcs1v15_sign`   em            512 B   (0.4%)
#
# Secret residue is still zeroized, per CALL rather than per lane
# (`_rsa_sign_scrub` / `_rsa_crt_scrub`; bignum's `bn_modinv` and
# `bn_mont_modexp` wipe their own). Covered by the sign half of
# `tests/tcyr/rsa_lane_race.tcyr`, which is mutation-proven: re-banking
# `sm`/`schk` yields 1 corrupted signature of 80 and 79/80 KAT matches.
# DO NOT RE-BANK ANY OF IT.

# PKCS#1 v1.5 DigestInfo prefixes (RFC 8017 §9.2 note 1): the DER
# `SEQUENCE { SEQUENCE { OID, NULL }, OCTET STRING <hash> }` header that
# precedes the raw digest. Returns the prefix length (19).
fn _rsa_di_sha256(buf): i64 {
    store8(buf + 0, 0x30);  store8(buf + 1, 0x31);  store8(buf + 2, 0x30);
    store8(buf + 3, 0x0d);  store8(buf + 4, 0x06);  store8(buf + 5, 0x09);
    store8(buf + 6, 0x60);  store8(buf + 7, 0x86);  store8(buf + 8, 0x48);
    store8(buf + 9, 0x01);  store8(buf + 10, 0x65); store8(buf + 11, 0x03);
    store8(buf + 12, 0x04); store8(buf + 13, 0x02); store8(buf + 14, 0x01);
    store8(buf + 15, 0x05); store8(buf + 16, 0x00); store8(buf + 17, 0x04);
    store8(buf + 18, 0x20);
    return 19;
}

fn _rsa_di_sha384(buf): i64 {
    store8(buf + 0, 0x30);  store8(buf + 1, 0x41);  store8(buf + 2, 0x30);
    store8(buf + 3, 0x0d);  store8(buf + 4, 0x06);  store8(buf + 5, 0x09);
    store8(buf + 6, 0x60);  store8(buf + 7, 0x86);  store8(buf + 8, 0x48);
    store8(buf + 9, 0x01);  store8(buf + 10, 0x65); store8(buf + 11, 0x03);
    store8(buf + 12, 0x04); store8(buf + 13, 0x02); store8(buf + 14, 0x02);
    store8(buf + 15, 0x05); store8(buf + 16, 0x00); store8(buf + 17, 0x04);
    store8(buf + 18, 0x30);
    return 19;
}

# EMSA-PKCS1-v1.5 encode (RFC 8017 §9.2): write EM = 0x00 01 PS 00 T
# into `out` (k bytes), where T = prefix || hash and PS is (k - 3 -
# |T|) bytes of 0xFF (>= 8 required). Returns 0, or -1 if k is too
# small. Used by both verify (rebuild-and-compare) and sign.
fn _rsa_emsa_encode(out, k, prefix, prefix_len, hash, hash_len): i64 {
    var tlen = prefix_len + hash_len;
    if (k < tlen + 11) { return 0 - 1; }
    var ps_len = k - 3 - tlen;
    store8(out + 0, 0x00);
    store8(out + 1, 0x01);
    var i = 0;
    while (i < ps_len) { store8(out + 2 + i, 0xFF); i = i + 1; }
    store8(out + 2 + ps_len, 0x00);
    memcpy(out + 3 + ps_len, prefix, prefix_len);
    memcpy(out + 3 + ps_len + prefix_len, hash, hash_len);
    return 0;
}

# RSAVP1 + I2OSP: recover the k-byte encoded message EM = (s^e mod n)
# from a signature using the public key (n_be, e_be). Writes n_len bytes
# to `em_out`. Returns 0 on success, -1 if lengths are out of range or
# s >= n. Operands are entirely public (no CT requirement). Shared by
# the PKCS#1 v1.5 check and the PSS verify.
fn _rsa_recover_em(n_be, n_len, e_be, e_len, sig, sig_len, em_out): i64 {
    # Length sanity (RFC 8017 §8.2.2 step 1): signature is exactly k
    # octets, and k must fit our buffers.
    if (sig_len != n_len) { return 0 - 1; }
    if (n_len > 512) { return 0 - 1; }
    var limbs = (n_len + 7) / 8;
    # Function-scope, therefore per-call and per-thread. 1,536 B of a 122,880 B
    # budget. A collision here corrupted the recovered EM rather than forging a
    # match, so it was the fail-closed half of the same defect.
    var nbuf[512];
    var sbuf[512];
    var mbuf[512];
    var rn = &nbuf;
    var rs = &sbuf;
    var rm = &mbuf;

    bn_from_be(rn, limbs, n_be, n_len);

    # bn_mont_modexp (3.6.6) requires an ODD modulus — a real RSA n always
    # is (p·q of two odd primes). The modulus here is attacker-controlled
    # (parsed from an SPKI / caller key), and the schoolbook path it
    # replaced accepted any modulus, so enforce the precondition at this
    # trust boundary: reject an even (or zero) n rather than feeding the
    # Montgomery ladder an input outside its domain. (Even n is malformed;
    # this is defense-in-depth — the EM compare would also reject.)
    if ((load64(rn) & 1) == 0) { return 0 - 1; }

    bn_from_be(rs, limbs, sig, sig_len);

    # RFC 8017 §8.2.2 / §5.2.1: reject s >= n (out of range).
    if (bn_cmp(rs, rn, limbs) >= 0) { return 0 - 1; }

    # m = s^e mod n  (RSAVP1), then I2OSP to k octets. The modulus is
    # odd (RSA n), so the Montgomery core applies; it is ~Nx faster than
    # the schoolbook `bn_modexp` here (3.6.6). Both operands are public,
    # so this takes the PUBLIC-exponent schedule (`_pub`, 3.12.2): the
    # constant-time ladder used through 3.12.1 walked every bit of e's
    # byte width with an unconditional multiply — 51 mont_muls for
    # e = 65537 where a public schedule needs 20. Nothing secret reaches
    # this path, so there is nothing for the ladder to protect.
    bn_mont_modexp_pub(rm, rs, e_be, e_len, rn, limbs);
    bn_to_be(em_out, n_len, rm, limbs);
    return 0;
}

# Core PKCS#1 v1.5 verify. n_be/e_be: public key as big-endian bytes.
# prefix/prefix_len: the DigestInfo prefix. hash/hash_len: the message
# digest. sig/sig_len: the signature. Returns 1 iff valid, else 0.
fn _rsa_pkcs1v15_check(n_be, n_len, e_be, e_len, prefix, prefix_len, hash, hash_len, sig, sig_len): i64 {
    # Function-scope, therefore per-call and per-thread. These are BOTH operands
    # of the compare that ends this function; sharing them across a cbank() lane
    # collision let a forged signature verify. 1,024 B of a 122,880 B budget.
    var embuf[512];
    var expbuf[512];
    var rem = &embuf;
    var rexp = &expbuf;
    if (_rsa_recover_em(n_be, n_len, e_be, e_len, sig, sig_len, rem) < 0) { return 0; }

    # Reconstruct the expected EM and compare all k octets (RFC 8017
    # §9.2). Operands are public, but reuse the OR-accumulating
    # constant-time compare for a single audit surface.
    if (_rsa_emsa_encode(rexp, n_len, prefix, prefix_len, hash, hash_len) < 0) { return 0; }
    return ct_eq_bytes(rem, rexp, n_len);
}

# Verify an RSASSA-PKCS1-v1.5 signature over SHA-256(msg) with public
# key (n_be, e_be). Returns 1 iff valid, else 0.
fn rsa_pkcs1v15_verify_sha256(n_be, n_len, e_be, e_len, msg, msg_len, sig, sig_len): i64 {
    # Function-scope: per-call, per-thread. 88 B of a 122,880 B budget.
    var hbuf[64];
    var dbuf[24];
    var rh = &hbuf;
    var rd = &dbuf;
    sha256(msg, msg_len, rh);
    var pl = _rsa_di_sha256(rd);
    return _rsa_pkcs1v15_check(n_be, n_len, e_be, e_len, rd, pl, rh, 32, sig, sig_len);
}

# Verify an RSASSA-PKCS1-v1.5 signature over SHA-384(msg).
fn rsa_pkcs1v15_verify_sha384(n_be, n_len, e_be, e_len, msg, msg_len, sig, sig_len): i64 {
    # Function-scope: per-call, per-thread. 88 B of a 122,880 B budget.
    var hbuf[64];
    var dbuf[24];
    var rh = &hbuf;
    var rd = &dbuf;
    sha384(msg, msg_len, rh);
    var pl = _rsa_di_sha384(rd);
    return _rsa_pkcs1v15_check(n_be, n_len, e_be, e_len, rd, pl, rh, 48, sig, sig_len);
}

# ================================================================
# Public-key DER parsing (3.6.3a)
# ================================================================
# Reuses the audited ASN.1/DER walker from src/x509.cyr (`der_walk`,
# `DER_TAG_*`, `_oid_eq`) rather than re-implementing a parser on
# untrusted input. x509.cyr is included before rsa.cyr.

# rsaEncryption OID content (1.2.840.113549.1.1.1), i.e. the 9 bytes
# after the `06 09` tag/length.
fn _rsa_oid_is_rsaencryption(buf, off, len): i64 {
    var ref[9];
    store8(&ref + 0, 0x2a); store8(&ref + 1, 0x86); store8(&ref + 2, 0x48);
    store8(&ref + 3, 0x86); store8(&ref + 4, 0xf7); store8(&ref + 5, 0x0d);
    store8(&ref + 6, 0x01); store8(&ref + 7, 0x01); store8(&ref + 8, 0x01);
    return _oid_eq(buf, off, len, &ref, 9);
}

# Copy a DER INTEGER's magnitude (stripping the leading 0x00 sign byte,
# if present) from buf[pos .. pos+len) into `out`, left-aligned. Returns
# the magnitude length, or -1 if it exceeds `out_max`.
fn _rsa_int_magnitude(buf, pos, len, out, out_max): i64 {
    var p = pos;
    var l = len;
    var go = 1;
    while (go == 1) {
        if (l > 1) {
            if ((load8(buf + p) & 0xFF) == 0) { p = p + 1; l = l - 1; }
            else { go = 0; }
        } else { go = 0; }
    }
    if (l > out_max) { return 0 - 1; }
    memcpy(out, buf + p, l);
    return l;
}

# Parse an RSA public key from DER. Accepts either a bare PKCS#1
# `RSAPublicKey` (SEQUENCE { INTEGER n, INTEGER e }) or an X.509
# SubjectPublicKeyInfo (SEQUENCE { SEQUENCE { rsaEncryption OID, NULL },
# BIT STRING { RSAPublicKey } }). Writes the modulus magnitude to
# `n_out` (big-endian, left-aligned) and the exponent to `e_out`;
# returns the modulus length (> 0) and writes the exponent length to
# `*e_len_out`. Returns -1 on any tag/length/OID mismatch (every
# `der_walk` is bounds-checked).
fn rsa_pubkey_from_der(der, der_len, n_out, n_max, e_out, e_max, e_len_out): i64 {
    var seq_c = 0;
    var seq_n = 0;
    if (der_walk(der, der_len, 0, DER_TAG_SEQUENCE, &seq_c, &seq_n) < 0) { return 0 - 1; }

    # `npos` = position of the INTEGER n (start of the RSAPublicKey body).
    var npos = 0 - 1;

    # Discriminate by the first inner element: INTEGER -> bare PKCS#1;
    # SEQUENCE -> SPKI (AlgorithmIdentifier).
    var ic = 0;
    var icn = 0;
    if (der_walk(der, der_len, seq_c, DER_TAG_INTEGER, &ic, &icn) >= 0) {
        npos = seq_c;
    } else {
        var ac = 0;
        var an = 0;
        if (der_walk(der, der_len, seq_c, DER_TAG_SEQUENCE, &ac, &an) < 0) { return 0 - 1; }
        var oc = 0;
        var on = 0;
        var oidlen = der_walk(der, der_len, ac, DER_TAG_OBJECT_ID, &oc, &on);
        if (oidlen < 0) { return 0 - 1; }
        if (_rsa_oid_is_rsaencryption(der, oc, oidlen) != 1) { return 0 - 1; }
        # BIT STRING (subjectPublicKey) follows the AlgorithmIdentifier.
        var bc = 0;
        var bn = 0;
        var bitlen = der_walk(der, der_len, an, DER_TAG_BIT_STRING, &bc, &bn);
        if (bitlen < 1) { return 0 - 1; }
        # First content byte is the unused-bits count; must be 0 for a
        # byte-aligned key. The RSAPublicKey SEQUENCE follows it.
        if ((load8(der + bc) & 0xFF) != 0) { return 0 - 1; }
        var rc = 0;
        var rn = 0;
        if (der_walk(der, der_len, bc + 1, DER_TAG_SEQUENCE, &rc, &rn) < 0) { return 0 - 1; }
        npos = rc;
    }

    # RSAPublicKey body: INTEGER n, INTEGER e.
    var nc = 0;
    var nn = 0;
    var nlen = der_walk(der, der_len, npos, DER_TAG_INTEGER, &nc, &nn);
    if (nlen < 0) { return 0 - 1; }
    var ec2 = 0;
    var en2 = 0;
    var elen = der_walk(der, der_len, nn, DER_TAG_INTEGER, &ec2, &en2);
    if (elen < 0) { return 0 - 1; }

    var nmag = _rsa_int_magnitude(der, nc, nlen, n_out, n_max);
    if (nmag < 0) { return 0 - 1; }
    var emag = _rsa_int_magnitude(der, ec2, elen, e_out, e_max);
    if (emag < 0) { return 0 - 1; }
    store64(e_len_out, emag);
    return nmag;
}

# ================================================================
# Private-key DER parsing (3.6.3b)
# ================================================================
# RSA private key, parsed into a caller-provided `RSAK_SIZE`-byte
# struct. Components are big-endian, left-aligned in fixed slots (sized
# for RSA-4096), each with a length field. The struct holds SECRET
# material (d, p, q, dp, dq, qinv) — the caller MUST zeroize it after
# use (e.g. wrap in `secret var` or memset before free).
var RSAK_N    = 0;       # 512 bytes (modulus)
var RSAK_E    = 512;     # 16  (public exponent)
var RSAK_D    = 528;     # 512 (private exponent)        [secret]
var RSAK_P    = 1040;    # 256 (prime1)                  [secret]
var RSAK_Q    = 1296;    # 256 (prime2)                  [secret]
var RSAK_DP   = 1552;    # 256 (d mod p-1)               [secret]
var RSAK_DQ   = 1808;    # 256 (d mod q-1)               [secret]
var RSAK_QINV = 2064;    # 256 (q^-1 mod p)              [secret]
var RSAK_NLEN = 2320;
var RSAK_ELEN = 2328;
var RSAK_DLEN = 2336;
var RSAK_PLEN = 2344;
var RSAK_QLEN = 2352;
var RSAK_DPLEN = 2360;
var RSAK_DQLEN = 2368;
var RSAK_QINVLEN = 2376;
var RSAK_SIZE = 2384;

# Walk the next DER INTEGER at *pos_ptr, store its magnitude (leading
# 0x00 stripped) into key+slot_off (cap slot_max), record the length at
# key+len_off, and advance *pos_ptr past it. Returns 0 / -1.
fn _rsa_take_int(der, der_len, pos_ptr, key, slot_off, slot_max, len_off): i64 {
    var c = 0;
    var nx = 0;
    var L = der_walk(der, der_len, load64(pos_ptr), DER_TAG_INTEGER, &c, &nx);
    if (L < 0) { return 0 - 1; }
    var mag = _rsa_int_magnitude(der, c, L, key + slot_off, slot_max);
    if (mag < 0) { return 0 - 1; }
    store64(key + len_off, mag);
    store64(pos_ptr, nx);
    return 0;
}

# Parse an RSA private key from DER into `key` (RSAK_SIZE bytes).
# Accepts a bare PKCS#1 `RSAPrivateKey` (RFC 8017 §A.1.2) or a PKCS#8
# `PrivateKeyInfo` wrapper (rsaEncryption). Extracts the 8 CRT
# components (n, e, d, p, q, dp, dq, qinv). Returns 0 on success, -1 on
# any tag/length/OID mismatch. `key` holds secret material — caller
# zeroizes.
fn rsa_privkey_from_der(der, der_len, key): i64 {
    var sc = 0;
    var sn = 0;
    if (der_walk(der, der_len, 0, DER_TAG_SEQUENCE, &sc, &sn) < 0) { return 0 - 1; }

    # First element is the version INTEGER. The element AFTER it
    # discriminates: INTEGER (modulus) => bare PKCS#1; SEQUENCE
    # (AlgorithmIdentifier) => PKCS#8.
    var vc = 0;
    var vn = 0;
    if (der_walk(der, der_len, sc, DER_TAG_INTEGER, &vc, &vn) < 0) { return 0 - 1; }

    var body = 0 - 1;       # offset of the RSAPrivateKey's version INTEGER
    var tc = 0;
    var tn = 0;
    if (der_walk(der, der_len, vn, DER_TAG_INTEGER, &tc, &tn) >= 0) {
        body = sc;          # bare PKCS#1: RSAPrivateKey starts at the outer version
    } else {
        var ac = 0;
        var an = 0;
        if (der_walk(der, der_len, vn, DER_TAG_SEQUENCE, &ac, &an) < 0) { return 0 - 1; }
        var oc = 0;
        var on = 0;
        var oidlen = der_walk(der, der_len, ac, DER_TAG_OBJECT_ID, &oc, &on);
        if (oidlen < 0) { return 0 - 1; }
        if (_rsa_oid_is_rsaencryption(der, oc, oidlen) != 1) { return 0 - 1; }
        var kc = 0;
        var kn = 0;
        if (der_walk(der, der_len, an, DER_TAG_OCTET_STRING, &kc, &kn) < 0) { return 0 - 1; }
        var ic = 0;
        var inn = 0;
        if (der_walk(der, der_len, kc, DER_TAG_SEQUENCE, &ic, &inn) < 0) { return 0 - 1; }
        body = ic;
    }

    # Skip the RSAPrivateKey version, then take the 8 components in order.
    var pos = body;
    var c = 0;
    var nx = 0;
    if (der_walk(der, der_len, pos, DER_TAG_INTEGER, &c, &nx) < 0) { return 0 - 1; }
    pos = nx;
    if (_rsa_take_int(der, der_len, &pos, key, RSAK_N,    512, RSAK_NLEN)    < 0) { return 0 - 1; }
    if (_rsa_take_int(der, der_len, &pos, key, RSAK_E,    16,  RSAK_ELEN)    < 0) { return 0 - 1; }
    if (_rsa_take_int(der, der_len, &pos, key, RSAK_D,    512, RSAK_DLEN)    < 0) { return 0 - 1; }
    if (_rsa_take_int(der, der_len, &pos, key, RSAK_P,    256, RSAK_PLEN)    < 0) { return 0 - 1; }
    if (_rsa_take_int(der, der_len, &pos, key, RSAK_Q,    256, RSAK_QLEN)    < 0) { return 0 - 1; }
    if (_rsa_take_int(der, der_len, &pos, key, RSAK_DP,   256, RSAK_DPLEN)   < 0) { return 0 - 1; }
    if (_rsa_take_int(der, der_len, &pos, key, RSAK_DQ,   256, RSAK_DQLEN)   < 0) { return 0 - 1; }
    if (_rsa_take_int(der, der_len, &pos, key, RSAK_QINV, 256, RSAK_QINVLEN) < 0) { return 0 - 1; }
    return 0;
}

# ================================================================
# PKCS#1 v1.5 signing (3.6.3d)
# ================================================================
# RSASSA-PKCS1-v1.5 (RFC 8017 §8.2.1), deterministic. The signature is
# `s = m^d mod n` over the secret exponent `d`, computed with the
# constant-time Montgomery ladder `bn_mont_modexp` (NOT the public
# `bn_modexp`). A **verify-after-sign** step recomputes `s^e mod n`
# (public exponent, fast) and refuses to release `s` unless it equals
# `m` — the Bellcore fault-attack guard (a faulty modexp could
# otherwise leak the key).
#
# Hardened in 3.6.4: **base blinding** (`s = (m·r^e)^d·r^-1 mod n`, fresh
# random r per signature — decorrelates the secret modexp from the key)
# and **CRT** (sign mod p,q then recombine, ~4×; the verify-after-sign
# guards the CRT fault surface). `_rsa_sign_*` / `_rsa_blind_*` /
# `_rsa_crt_*` hold message/signature-derived values; the secret is `d`
# (and p, q, dp, dq) inside `key` (caller zeroizes).
# ⛔ 3.12.9: THE SIGN PATH HOLDS NO BANKED SCRATCH ANY MORE.
#
# The sign / blind / CRT workspace was 23 file-scope globals banked across
# `cbank()` lanes — the last banked state in the library's asymmetric
# stack, and the last of the wider-scope items from the 2026-08-08 forged
# -signature issue. All 23 are now stack locals in the function that uses
# them, so a concurrent signer shares nothing and there is no
# 63-lifetime-thread ceiling on signing.
#
# **This was not merely a DoS surface.** The Bellcore verify-after-sign
# guard compared `_rsa_sign_chk` against `_rsa_sign_m` with BOTH operands
# in the same shared lane — structurally the same "both operands of the
# decision in one shared object" shape as the v1.5 verify bypass that
# 3.12.3 fixed, where a colliding thread that left a consistent pair
# behind made the compare succeed on bytes that were never its own. Here
# that would wave through a faulty signature the guard exists to catch.
#
# Secret residue is still zeroized, but per CALL: each function wipes its
# own frame before returning (`_rsa_sign_scrub`, `_rsa_crt_scrub`, and
# `bn_modinv` / `bn_mont_modexp`'s own scrubs in bignum.cyr). That is
# strictly tighter than the old whole-lane memset — it clears exactly this
# signature's data and cannot reach a sibling worker's in-flight lane,
# which the per-lane version could when two threads aliased.

# Generate a fresh blinding pair (r, r^-1 mod n) with r in [1, n) and
# invertible. Draws entropy via sigil's fail-closed CSPRNG boundary
# (src/random.cyr → per-target getrandom/getentropy/ProcessPrng).
# Returns 0 on success, -1 if no entropy or no invertible r within a few
# tries (effectively never).
fn _rsa_gen_blind(r_out, rinv_out, n_bn, nlen, limbs): i64 {
    # 3.12.9: stack local, not a `cbank()` lane. Raw CSPRNG bytes for the
    # blinding factor — secret-correlated, so wiped on every return path.
    var randbuf[512];
    var rand = &randbuf;
    var tries = 0;
    var ok = 0;
    while (ok == 0) {
        if (tries >= 16) { memset(rand, 0, 512); return 0 - 1; }
        tries = tries + 1;
        if (_sigil_random_fill(rand, nlen) != 0) { memset(rand, 0, 512); return 0 - 1; }
        bn_from_be(r_out, limbs, rand, nlen);
        bn_mod(r_out, r_out, limbs, n_bn, limbs);          # r in [0, n)
        if (bn_is_zero(r_out, limbs) == 0) {
            if (bn_modinv(rinv_out, r_out, n_bn, limbs) == 0) { ok = 1; }
        }
    }
    memset(rand, 0, 512);
    return 0;
}

# CRT exponentiation scratch (3.6.4). Half-width (RSA-4096 prime side).
# 3.12.9: stack locals inside `_rsa_crt_modexp`, wiped per call by
# `_rsa_crt_scrub`. p / q / qinv are secret KEY components and
# s1 / s2 / mp / mq / h the mod-p,q residues (mp^dp / mq^dq) — the most
# sensitive buffers on the sign path, and previously the ones a lane
# collision could have leaked into a sibling signature.

# Wipe `_rsa_crt_modexp`'s eleven working buffers. Fixed declared widths,
# not `hl`-derived: the half-limb count follows from the public modulus
# size, but a fixed-width wipe keeps zeroization independent of it and
# costs nothing against two half-width modexps.
fn _rsa_crt_scrub(cp, cq, cqinv, cmp_, cmq, cs1, cs2, cs2f, ch, cprod, cqh): i64 {
    memset(cp,    0, 256);
    memset(cq,    0, 256);
    memset(cqinv, 0, 256);
    memset(cmp_,  0, 256);
    memset(cmq,   0, 256);
    memset(cs1,   0, 256);
    memset(cs2,   0, 256);
    memset(cs2f,  0, 512);
    memset(ch,    0, 256);
    memset(cprod, 0, 512);
    memset(cqh,   0, 512);
    return 0;
}

# sb_out = mb^d mod n via the CRT (Garner): sign mod p and mod q with
# the constant-time Montgomery ladder, then recombine — ~4× faster
# than the full-width modexp. Returns 0, or -1 if the key lacks CRT
# parameters (caller falls back to the full-width path). The
# verify-after-sign in the caller guards the CRT fault surface.
fn _rsa_crt_modexp(key, mb, sb_out, limbs): i64 {
    var plen = load64(key + RSAK_PLEN);
    var qlen = load64(key + RSAK_QLEN);
    if (plen == 0) { return 0 - 1; }
    if (qlen == 0) { return 0 - 1; }
    var hl = limbs / 2;                 # half-width limbs (n_limbs is even)

    # 3.12.9: stack locals, not `cbank()` lanes. 3,328 B against the
    # 122,880 B per-fn budget. All eleven are SECRET (p/q/qinv are key
    # material; the rest are mod-p,q residues) and are wiped by
    # `_rsa_crt_scrub` before every return.
    var cpbuf[256];    var cqbuf[256];    var cqinvbuf[256];
    var cmpbuf[256];   var cmqbuf[256];   var cs1buf[256];
    var cs2buf[256];   var cs2fbuf[512];  var chbuf[256];
    var cprodbuf[512]; var cqhbuf[512];
    var cp     = &cpbuf;
    var cq     = &cqbuf;
    var cqinv  = &cqinvbuf;
    var cmp    = &cmpbuf;
    var cmq    = &cmqbuf;
    var cs1    = &cs1buf;
    var cs2    = &cs2buf;
    var cs2f   = &cs2fbuf;
    var ch     = &chbuf;
    var cprod  = &cprodbuf;
    var cqh    = &cqhbuf;

    bn_from_be(cp, hl, key + RSAK_P, plen);
    bn_from_be(cq, hl, key + RSAK_Q, qlen);
    bn_from_be(cqinv, hl, key + RSAK_QINV, load64(key + RSAK_QINVLEN));

    # s1 = (mb mod p)^dp mod p ; s2 = (mb mod q)^dq mod q
    bn_mod(cmp, mb, limbs, cp, hl);
    bn_mod(cmq, mb, limbs, cq, hl);
    bn_mont_modexp(cs1, cmp, key + RSAK_DP, load64(key + RSAK_DPLEN), cp, hl);
    bn_mont_modexp(cs2, cmq, key + RSAK_DQ, load64(key + RSAK_DQLEN), cq, hl);

    # h = (s1 - s2) * qinv mod p
    bn_copy(ch, cs1, hl);
    _bn_submod(ch, cs2, cp, hl);
    bn_mul(cprod, ch, cqinv, hl);
    bn_mod(ch, cprod, 2 * hl, cp, hl);

    # sb = s2 + q*h   (< n by construction; no final reduction needed)
    bn_mul(cqh, cq, ch, hl);   # 2*hl == limbs
    bn_zero(cs2f, limbs);
    bn_copy(cs2f, cs2, hl);
    bn_copy(sb_out, cqh, limbs);
    bn_add_assign(sb_out, cs2f, limbs);
    _rsa_crt_scrub(cp, cq, cqinv, cmp, cmq, cs1, cs2, cs2f, ch, cprod, cqh);
    return 0;
}

# Per-CALL secret zeroization of `_rsa_raw_sign`'s workspace (CLAUDE.md
# quirk #9 / ADR 0004). Every buffer is a stack local of the calling
# frame, so this wipes exactly this signature's data.
#
# 3.12.9 replaced `_rsa_scrub_sign_lanes()`, which memset the caller's
# `cbank()` lane of 23 file-scope globals plus the bignum engine's
# `_bn_inv_*` lanes. Those globals are gone. The per-lane version had a
# hazard of its own: when two threads aliased a lane it would zero a
# sibling's in-flight secret residue mid-sign. The bignum residues are now
# self-wiped by `bn_modinv` and `bn_mont_modexp` in their own frames, so
# there is nothing left here to reach across.
#
# Widths are the declared buffer sizes, not `limbs`-derived, so the wipe
# is complete for any key size. Called on EVERY return of `_rsa_raw_sign`.
fn _rsa_sign_scrub(sm, sn, ss, schk, br, brinv, bre, bmb, bsb, bprod): i64 {
    memset(sm,    0, 512);
    memset(sn,    0, 512);
    memset(ss,    0, 512);
    memset(schk,  0, 512);
    memset(br,    0, 512);
    memset(brinv, 0, 512);
    memset(bre,   0, 512);
    memset(bmb,   0, 512);
    memset(bsb,   0, 512);
    memset(bprod, 0, 1024);
    return 0;
}

# RSASP1 core: sign a fully-encoded k-byte message `em` (OS2IP'd to m)
# under the secret key. Computes s = m^d mod n with base blinding + CRT
# (or the full-width Montgomery ladder) + verify-after-sign, then writes
# the k-byte signature to `sig_out`. Returns k (>0), or -1 on a too-small
# modulus or a failed verify-after-sign. Shared by the PKCS#1 v1.5 and
# PSS signers (both differ only in how `em` is built). `em` is `nlen`
# bytes; caller guarantees m = OS2IP(em) < n.
fn _rsa_raw_sign(key, em, sig_out): i64 {
    var nlen = load64(key + RSAK_NLEN);
    if (nlen > 512) { return 0 - 1; }
    var limbs = (nlen + 7) / 8;

    var dlen = load64(key + RSAK_DLEN);
    var elen = load64(key + RSAK_ELEN);

    # 3.12.9: stack locals, not `cbank()` lanes. 5,632 B against the
    # 122,880 B per-fn budget. Critically, `schk` and `sm` — the two
    # operands of the Bellcore verify-after-sign compare below — are now
    # in THIS frame, so no sibling thread can plant a matching pair the
    # way a shared lane allowed.
    var smbuf[512];    var snbuf[512];    var ssbuf[512];   var schkbuf[512];
    var brbuf[512];    var brinvbuf[512]; var brebuf[512];
    var bmbbuf[512];   var bsbbuf[512];   var bprodbuf[1024];
    var sm   = &smbuf;
    var sn   = &snbuf;
    var ss   = &ssbuf;
    var schk = &schkbuf;
    var br    = &brbuf;
    var brinv = &brinvbuf;
    var bre   = &brebuf;
    var bmb   = &bmbbuf;
    var bsb   = &bsbbuf;
    var bprod = &bprodbuf;

    # m = OS2IP(EM); n as a bignum.
    bn_from_be(sm, limbs, em, nlen);
    bn_from_be(sn, limbs, key + RSAK_N, nlen);

    # Base blinding: fresh random r, mb = m * r^e mod n  (r^e via the
    # public-exponent modexp). Decorrelates the secret modexp from the
    # key; the final s is unchanged.
    if (_rsa_gen_blind(br, brinv, sn, nlen, limbs) < 0) {
        _rsa_sign_scrub(sm, sn, ss, schk, br, brinv, bre, bmb, bsb, bprod);
        return 0 - 1;
    }
    # r^e mod n: PUBLIC exponent e over the blinding base r. The `_pub`
    # schedule (3.12.2) branches on the exponent only, and e is public —
    # r never steers control flow, so blinding is not weakened. (The
    # secret modexp below keeps the constant-time ladder.)
    bn_mont_modexp_pub(bre, br, key + RSAK_E, elen, sn, limbs);
    bn_mul(bprod, sm, bre, limbs);
    bn_mod(bmb, bprod, 2 * limbs, sn, limbs);

    # sb = mb^d mod n  (constant-time). CRT when the key has p/q/dp/dq/
    # qinv (~4×); else the full-width Montgomery ladder.
    if (_rsa_crt_modexp(key, bmb, bsb, limbs) < 0) {
        bn_mont_modexp(bsb, bmb, key + RSAK_D, dlen, sn, limbs);
    }

    # Unblind: s = sb * r^-1 mod n.
    bn_mul(bprod, bsb, brinv, limbs);
    bn_mod(ss, bprod, 2 * limbs, sn, limbs);

    # Verify-after-sign (Bellcore guard): s^e mod n must equal m. Public
    # exponent over the (public) signature, so the `_pub` schedule
    # (3.12.2) applies — this is a verify, not a sign.
    bn_mont_modexp_pub(schk, ss, key + RSAK_E, elen, sn, limbs);
    if (bn_cmp(schk, sm, limbs) != 0) {
        bn_zero(ss, limbs);   # discard a faulty signature
        _rsa_sign_scrub(sm, sn, ss, schk, br, brinv, bre, bmb, bsb, bprod);
        return 0 - 1;
    }

    bn_to_be(sig_out, nlen, ss, limbs);
    _rsa_sign_scrub(sm, sn, ss, schk, br, brinv, bre, bmb, bsb, bprod);
    return nlen;
}

# Core signer. `key` is an RSAK struct; prefix/hash form the DigestInfo.
# Writes the k-byte signature to `sig_out`. Returns k (>0), or -1 on a
# too-small modulus or a failed verify-after-sign.
fn _rsa_pkcs1v15_sign(key, prefix, prefix_len, hash, hash_len, sig_out): i64 {
    var nlen = load64(key + RSAK_NLEN);
    if (nlen > 512) { return 0 - 1; }

    # EM = EMSA-PKCS1-v1.5(hash); sign via the shared RSASP1 core.
    # 3.12.9: stack local, not a `cbank()` lane. `em` is public (the encoded
    # message) but shared it still let two signers interleave bytes into one
    # buffer, so a colliding thread could sign the wrong message. Wiped here
    # rather than by `_rsa_raw_sign`, which no longer sees this buffer.
    var sembuf[512];
    var sem = &sembuf;
    if (_rsa_emsa_encode(sem, nlen, prefix, prefix_len, hash, hash_len) < 0) {
        memset(sem, 0, 512);
        return 0 - 1;
    }
    var rc = _rsa_raw_sign(key, sem, sig_out);
    memset(sem, 0, 512);
    return rc;
}

# Sign SHA-256(msg) with RSASSA-PKCS1-v1.5. `key` is an RSAK struct
# (from rsa_privkey_from_der). Writes k bytes to sig_out; returns k.
fn rsa_pkcs1v15_sign_sha256(key, msg, msg_len, sig_out): i64 {
    # Function-scope: per-call, per-thread. 88 B of a 122,880 B budget.
    # (Mirrors the verify wrappers above. Those were localised in 3.12.3 and
    # these were not, for a reason that was never sigil's: `_rsa_pkcs1v15_sign`
    # takes exactly 6 args so it took cycc's tail-call path, whose epilogue
    # freed this frame before the callee read `rd`/`rh` out of it; the verify
    # wrappers pass 10 args and cycc already declines TCO above 6. Needs
    # cyrius >= 6.5.14.)
    var hbuf[64];
    var dbuf[24];
    var rh = &hbuf;
    var rd = &dbuf;
    sha256(msg, msg_len, rh);
    var pl = _rsa_di_sha256(rd);
    return _rsa_pkcs1v15_sign(key, rd, pl, rh, 32, sig_out);
}

# Sign SHA-384(msg) with RSASSA-PKCS1-v1.5.
fn rsa_pkcs1v15_sign_sha384(key, msg, msg_len, sig_out): i64 {
    # Function-scope: per-call, per-thread. 88 B of a 122,880 B budget.
    # See the SHA-256 sibling above for why these lagged the verify wrappers.
    var hbuf[64];
    var dbuf[24];
    var rh = &hbuf;
    var rd = &dbuf;
    sha384(msg, msg_len, rh);
    var pl = _rsa_di_sha384(rd);
    return _rsa_pkcs1v15_sign(key, rd, pl, rh, 48, sig_out);
}

# ================================================================
# RSASSA-PSS (RFC 8017 §8.1 / §9.1), SHA-256 and SHA-384 (3.6.5)
# ================================================================
# The modern TLS 1.3 RSA signature scheme (`rsa_pss_rsae_sha256` /
# `_sha384`, RFC 8446 §4.2.3). MGF1 uses the SAME hash as the message
# digest. Sign uses a fresh random salt of length hLen (the TLS 1.3
# convention; equals the digest length). Verify is salt-length-agnostic
# (EMSA-PSS-VERIFY recovers the salt from the 0x01 separator in DB), so
# it accepts any conformant salt length — matching OpenSSL's
# RSA_PSS_SALTLEN_AUTO.
#
# SCOPE / TIMING: PSS verify is entirely public (signature, public key).
# PSS sign reuses `_rsa_raw_sign` (blinding + CRT + verify-after-sign);
# the EMSA-PSS encode/MGF1 operate on the message digest + a random salt,
# never on `d` — no secret-dependent branch is introduced here. The salt
# is per-signature random, not key material, so no zeroization beyond the
# raw signer's existing handling is required.

# hLen for a hash id: 0 = SHA-256 (32), 1 = SHA-384 (48).
fn _rsa_pss_hlen(hid): i64 {
    if (hid == 1) { return 48; }
    return 32;
}

# Dispatch hash by id into `out` (hLen bytes).
fn _rsa_pss_hash(hid, msg, msg_len, out): i64 {
    if (hid == 1) { sha384(msg, msg_len, out); return 48; }
    sha256(msg, msg_len, out);
    return 32;
}

# PSS scratch (single-threaded; verify is public, sign reuses the raw
# signer's banks). emLen <= 512 (RSA-4096); dbLen = emLen-hLen-1 <= 512.
# The M' buffer holds = (8 zero octets) || mHash || salt: for verify the
# recovered salt can be as large as dbLen, so size for the worst case
# (8 + 48 + ~479).
# 3.12.6: the whole PSS workspace is now function-scope (per-call, therefore
# per-thread) — no lane, no 63-lane ceiling. It was banked across `cbank()`
# lanes (quirk #1); with two threads on one lane, PSS verify accepted 798 of
# 800 valid signatures. Removing `_rsa_em` alone got there, and the residual
# 2/800 was the rest of this workspace still being shared — which is why the
# gate asserts 800/800 and not "mostly". Every buffer here is PUBLIC (verify
# takes no secret input; the sign salt is recoverable from the signature), so
# they need no wipe — only privacy. The SECRET residue stays in the raw
# signer's banks, which remain banked-and-wiped by design.
#   `_rsa_mgf1`            seedc/blk       136 B   (shared by sign + verify)
#   `_rsa_emsa_pss_verify` dbmask/db/M'/H  1,688 B
#   `_rsa_pss_verify`      EM + mHash        576 B
#   `_rsa_pss_sign`        6 buffers       2,264 B
# 12 banked globals deleted = 196,096 B (191.5 KiB) of .bss, replaced by 14
# function-scope buffers totalling 4,664 B per call.

# MGF1 (RFC 8017 §B.2.1) with the id-`hid` hash. Writes `mask_len` bytes
# of mask to `mask_out`. seed is `seed_len` bytes.
fn _rsa_mgf1(hid, seed, seed_len, mask_out, mask_len): i64 {
    var hlen = _rsa_pss_hlen(hid);
    # Function-scope: per-call, per-thread. 136 B of a 122,880 B budget. Shared
    # by PSS sign and verify, so this one localisation covers both. (3.12.6)
    var seedcbuf[72];
    var blkbuf[64];
    var seedc = &seedcbuf;
    var blk   = &blkbuf;
    memcpy(seedc, seed, seed_len);
    var counter = 0;
    var off = 0;
    while (off < mask_len) {
        # C = I2OSP(counter, 4), big-endian.
        store8(seedc + seed_len + 0, (counter >> 24) & 0xFF);
        store8(seedc + seed_len + 1, (counter >> 16) & 0xFF);
        store8(seedc + seed_len + 2, (counter >> 8) & 0xFF);
        store8(seedc + seed_len + 3, counter & 0xFF);
        _rsa_pss_hash(hid, seedc, seed_len + 4, blk);
        var n = hlen;
        if (off + n > mask_len) { n = mask_len - off; }
        memcpy(mask_out + off, blk, n);
        off = off + n;
        counter = counter + 1;
    }
    return 0;
}

# Highest-set-bit index + 1 of a big-endian byte string (0 if all zero).
fn _rsa_bitlen_be(buf, len): i64 {
    var i = 0;
    while (i < len) {
        var b = load8(buf + i) & 0xFF;
        if (b != 0) {
            var bit = 7;
            while (bit >= 0) {
                if (((b >> bit) & 1) == 1) { return (len - 1 - i) * 8 + bit + 1; }
                bit = bit - 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

# Mask of the top `nbits` bits of a single octet (e.g. 1 -> 0x80,
# 2 -> 0xC0). nbits is 0..8.
fn _rsa_top_mask(nbits): i64 {
    var m = 0;
    var k = 0;
    while (k < nbits) { m = m | ((0x80 >> k) & 0xFF); k = k + 1; }
    return m;
}

# Fill `out` with `n` fresh CSPRNG bytes (the PSS salt) via sigil's
# fail-closed entropy boundary (src/random.cyr). Returns 0 / -1.
fn _rsa_pss_rand(out, n): i64 {
    return _sigil_random_fill(out, n);
}

# EMSA-PSS-VERIFY (RFC 8017 §9.1.2) on the `emlen`-byte encoded message
# at `em` (embits = modBits-1). `mhash` is the hLen-byte message digest.
# Salt-length-agnostic. Returns 1 if consistent, else 0.
fn _rsa_emsa_pss_verify(hid, em, emlen, embits, mhash, hlen): i64 {
    # Step 4: rightmost octet must be 0xbc.
    if ((load8(em + emlen - 1) & 0xFF) != 0xbc) { return 0; }

    var dblen = emlen - hlen - 1;
    if (dblen < 1) { return 0; }
    var hptr = em + dblen;                  # H = next hLen octets

    # Function-scope: per-call, per-thread. 1,688 B of a 122,880 B budget.
    # PSS verify is entirely public, so these need no wipe — they need only to
    # not be shared. (3.12.6)
    var dbmaskbuf[512];
    var dbbuf[512];
    var mprimebuf[600];
    var phbuf[64];
    var dbmask = &dbmaskbuf;
    var db     = &dbbuf;
    var mprime = &mprimebuf;
    var ph     = &phbuf;

    # Step 6: the top (8*emlen - embits) bits of maskedDB[0] must be 0.
    var topbits = 8 * emlen - embits;
    var tmask = _rsa_top_mask(topbits);
    if (((load8(em) & 0xFF) & tmask) != 0) { return 0; }

    # Step 7-8: DB = maskedDB XOR MGF1(H, dbLen); clear the same top bits.
    _rsa_mgf1(hid, hptr, hlen, dbmask, dblen);
    var i = 0;
    while (i < dblen) {
        store8(db + i, (load8(em + i) & 0xFF) ^ (load8(dbmask + i) & 0xFF));
        i = i + 1;
    }
    store8(db, (load8(db) & 0xFF) & (tmask ^ 0xFF));

    # Step 10 (salt-agnostic): DB = (zero octets) || 0x01 || salt. Scan
    # left; every octet before the first 0x01 must be zero.
    var sep = 0 - 1;
    i = 0;
    while (i < dblen) {
        if (sep < 0) {
            var v = load8(db + i) & 0xFF;
            if (v == 0x01) { sep = i; }
            else { if (v != 0x00) { return 0; } }
        }
        i = i + 1;
    }
    if (sep < 0) { return 0; }              # no 0x01 separator
    var slen = dblen - 1 - sep;             # recovered salt length
    if (slen < 0) { return 0; }

    # Step 12-14: M' = (0x)00*8 || mHash || salt ; H' = Hash(M').
    var j = 0;
    while (j < 8) { store8(mprime + j, 0); j = j + 1; }
    memcpy(mprime + 8, mhash, hlen);
    memcpy(mprime + 8 + hlen, db + sep + 1, slen);
    _rsa_pss_hash(hid, mprime, 8 + hlen + slen, ph);

    # Constant-time compare H' against the embedded H.
    return ct_eq_bytes(hptr, ph, hlen);
}

# Verify an RSASSA-PSS signature (RFC 8017 §8.1.2) over the `hid` digest
# of msg, public key (n_be, e_be). Returns 1 iff valid, else 0.
fn _rsa_pss_verify(hid, n_be, n_len, e_be, e_len, msg, msg_len, sig, sig_len): i64 {
    var hlen = _rsa_pss_hlen(hid);
    # Function-scope, therefore per-call and per-thread — the last of the RSA
    # verify buffers to come off a `cbank()` lane, and the reason it lagged the
    # others (3.12.3-3.12.5) was NOT sigil: `return _rsa_emsa_pss_verify(...)`
    # is a tail call, and cycc's tail-call epilogue freed this frame before the
    # callee dereferenced `em` into it. cycc only skipped TCO when `&` appeared
    # LITERALLY in the arg list, so `var rem = &rembuf; ... return f(em)` walked
    # past the guard. Fixed in cyrius 6.5.14 (`_fn_local_addr`); requires it.
    var rembuf[512];
    var rem = &rembuf;
    var mhashbuf[64];
    var mhash = &mhashbuf;
    if (_rsa_recover_em(n_be, n_len, e_be, e_len, sig, sig_len, rem) < 0) { return 0; }

    var modbits = _rsa_bitlen_be(n_be, n_len);
    var embits = modbits - 1;
    var emlen = (embits + 7) / 8;
    if (emlen < hlen + 2) { return 0; }     # cannot hold H || 0xbc + minimum DB
    if (emlen > n_len) { return 0; }        # (cannot happen for valid n)

    # EM is the low `emlen` octets of the k-byte RSAVP1 output (the top
    # n_len-emlen octets are zero by I2OSP). _rsa_recover_em wrote k bytes.
    var em = rem + (n_len - emlen);

    _rsa_pss_hash(hid, msg, msg_len, mhash);
    return _rsa_emsa_pss_verify(hid, em, emlen, embits, mhash, hlen);
}

# Sign msg with RSASSA-PSS (RFC 8017 §8.1.1). `key` is an RSAK struct;
# salt length = hLen (fresh CSPRNG via src/random.cyr). Writes k bytes to
# sig_out; returns k (>0), or -1 on failure (entropy, too-small modulus,
# or a failed verify-after-sign).
fn _rsa_pss_sign(hid, key, msg, msg_len, sig_out): i64 {
    var hlen = _rsa_pss_hlen(hid);
    var nlen = load64(key + RSAK_NLEN);
    if (nlen > 512) { return 0 - 1; }

    var modbits = _rsa_bitlen_be(key + RSAK_N, nlen);
    var embits = modbits - 1;
    var emlen = (embits + 7) / 8;
    var slen = hlen;                        # salt length = digest length
    if (emlen < hlen + slen + 2) { return 0 - 1; }
    var dblen = emlen - hlen - 1;

    # Function-scope: per-call, per-thread. 2,264 B of a 122,880 B budget. The
    # PSS salt is per-signature random and recoverable from the signature, so
    # it is public and needs no wipe; the SECRET residue lives in the raw
    # signer's banks, which stay banked-and-wiped by design. (3.12.6)
    var mhashbuf[64];
    var saltbuf[64];
    var pembuf[512];
    var mprimebuf[600];
    var dbbuf[512];
    var dbmaskbuf[512];
    var mhash  = &mhashbuf;
    var salt   = &saltbuf;
    var pem    = &pembuf;
    var mprime = &mprimebuf;
    var db     = &dbbuf;
    var dbmask = &dbmaskbuf;

    # mHash = Hash(M); salt <- random hLen bytes.
    _rsa_pss_hash(hid, msg, msg_len, mhash);
    if (_rsa_pss_rand(salt, slen) < 0) { return 0 - 1; }

    # EM is built right-aligned in an nlen-byte buffer (leading zero pad
    # when emlen < nlen). emstart points at EM[0].
    memset(pem, 0, nlen);
    var emstart = pem + (nlen - emlen);
    var hptr = emstart + dblen;             # H lands here in EM

    # M' = (0x)00*8 || mHash || salt ; H = Hash(M') written directly to EM.
    var j = 0;
    while (j < 8) { store8(mprime + j, 0); j = j + 1; }
    memcpy(mprime + 8, mhash, hlen);
    memcpy(mprime + 8 + hlen, salt, slen);
    _rsa_pss_hash(hid, mprime, 8 + hlen + slen, hptr);

    # DB = (0x)00*(dbLen-slen-1) || 0x01 || salt.
    var i = 0;
    while (i < dblen) { store8(db + i, 0); i = i + 1; }
    store8(db + (dblen - slen - 1), 0x01);
    memcpy(db + (dblen - slen), salt, slen);

    # maskedDB = DB XOR MGF1(H, dbLen) -> written into EM[0..dbLen).
    _rsa_mgf1(hid, hptr, hlen, dbmask, dblen);
    i = 0;
    while (i < dblen) {
        store8(emstart + i, (load8(db + i) & 0xFF) ^ (load8(dbmask + i) & 0xFF));
        i = i + 1;
    }
    # Clear the top (8*emlen - embits) bits of maskedDB[0]; set trailer.
    var tmask = _rsa_top_mask(8 * emlen - embits);
    store8(emstart, (load8(emstart) & 0xFF) & (tmask ^ 0xFF));
    store8(emstart + emlen - 1, 0xbc);

    # m = OS2IP(EM); s = m^d mod n via the shared blinded/CRT RSASP1.
    return _rsa_raw_sign(key, pem, sig_out);
}

# Verify an RSASSA-PSS signature over SHA-256(msg). Returns 1 iff valid.
fn rsa_pss_verify_sha256(n_be, n_len, e_be, e_len, msg, msg_len, sig, sig_len): i64 {
    return _rsa_pss_verify(0, n_be, n_len, e_be, e_len, msg, msg_len, sig, sig_len);
}

# Verify an RSASSA-PSS signature over SHA-384(msg). Returns 1 iff valid.
fn rsa_pss_verify_sha384(n_be, n_len, e_be, e_len, msg, msg_len, sig, sig_len): i64 {
    return _rsa_pss_verify(1, n_be, n_len, e_be, e_len, msg, msg_len, sig, sig_len);
}

# Sign SHA-256(msg) with RSASSA-PSS (salt = 32 bytes). Returns k.
fn rsa_pss_sign_sha256(key, msg, msg_len, sig_out): i64 {
    return _rsa_pss_sign(0, key, msg, msg_len, sig_out);
}

# Sign SHA-384(msg) with RSASSA-PSS (salt = 48 bytes). Returns k.
fn rsa_pss_sign_sha384(key, msg, msg_len, sig_out): i64 {
    return _rsa_pss_sign(1, key, msg, msg_len, sig_out);
}
