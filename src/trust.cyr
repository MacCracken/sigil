# trust.cyr — signing, verification, key management
# Ed25519 (RFC 8032) for asymmetric signing, HMAC-SHA256 for symmetric.

# ================================================================
# KeyRole
# ================================================================

enum KeyRole {
    KEY_ROLE_ROOT = 0;
    KEY_ROLE_INTERMEDIATE = 1;
    KEY_ROLE_PUBLISHER = 2;
}

# Returns the display name of KeyRole `role` as a static C-string (`Root`, `Intermediate`,
# `Publisher`), or `unknown` for any other value. keyring_save emits it as the JSON `role`.
fn key_role_name(role): i64 {
    if (role == KEY_ROLE_ROOT) { return "Root"; }
    if (role == KEY_ROLE_INTERMEDIATE) { return "Intermediate"; }
    if (role == KEY_ROLE_PUBLISHER) { return "Publisher"; }
    return "unknown";
}

# ================================================================
# KeyVersion (96 bytes)
# ================================================================
# Layout:
#   +0   key_id          (C-string ptr)
#   +8   valid_from      (epoch seconds)
#   +16  valid_until     (epoch seconds, 0 = no expiry)
#   +24  public_key_hex  (C-string ptr, 64-char hex)
#   +32  role            (i64 KEY_ROLE_*)
#   +40  issued_by       (C-string ptr, 0 = self-signed)
#   +48  issuer_sig      (ptr to raw bytes, 0 = none) — the issuing parent's Ed25519
#                        signature over kv_issuance_message_into(kv); see
#                        keyring_sign_issuance / keyring_validate_chain
#   +56  issuer_sig_len  (i64; must be 64 for the link to validate)
#   +64  pub_name        (C-string ptr, 0 = none)
#   +72  pub_contact     (C-string ptr, 0 = none)
#   +80  secret_key      (ptr to 32 raw bytes, 0 = none, for HMAC signing)
#   +88  allowed_types   (vec of ARTIFACT_* i64s, 0 = all types allowed)

# Allocates a 96-byte KeyVersion (fl_alloc) for `key_id` and its public-key hex C-string,
# both stored by pointer (not copied). Starts as role Publisher, valid from now, no expiry;
# every other field is 0 (no issuer, publisher info, secret key or type limit). Returns it.
fn key_version_new(key_id, public_key_hex): i64 {
    var kv = fl_alloc(96);
    store64(kv, key_id);
    store64(kv + 8, clock_epoch_secs());
    store64(kv + 16, 0);
    store64(kv + 24, public_key_hex);
    store64(kv + 32, KEY_ROLE_PUBLISHER);
    store64(kv + 40, 0);
    store64(kv + 48, 0);
    store64(kv + 56, 0);
    store64(kv + 64, 0);
    store64(kv + 72, 0);
    store64(kv + 80, 0);
    store64(kv + 88, 0);
    return kv;
}

# Returns the key-id C-string of key version `kv`.
fn kv_key_id(kv): i64 { return load64(kv); }
# Returns the valid-from time of `kv` (epoch seconds).
fn kv_valid_from(kv): i64 { return load64(kv + 8); }
# Returns the valid-until time of `kv` (epoch seconds; 0 = no expiry).
fn kv_valid_until(kv): i64 { return load64(kv + 16); }
# Returns the public-key hex C-string of `kv` (64 hex chars expected; not validated on store).
fn kv_public_key_hex(kv): i64 { return load64(kv + 24); }
# Returns the KeyRole (KEY_ROLE_*) of `kv`.
fn kv_role(kv): i64 { return load64(kv + 32); }
# Returns the issuer key-id C-string of `kv` (0 = none / self-signed).
fn kv_issued_by(kv): i64 { return load64(kv + 40); }
# Returns the issuer-signature buffer pointer of `kv` (0 = none); see keyring_sign_issuance.
fn kv_issuer_sig(kv): i64 { return load64(kv + 48); }
# Returns the issuer-signature length of `kv` in bytes (64 for an Ed25519 signature).
fn kv_issuer_sig_len(kv): i64 { return load64(kv + 56); }
# Returns the publisher-name C-string of `kv` (0 = none).
fn kv_pub_name(kv): i64 { return load64(kv + 64); }
# Returns the publisher-contact C-string of `kv` (0 = none).
fn kv_pub_contact(kv): i64 { return load64(kv + 72); }
# Returns the secret-key buffer pointer attached to `kv` (0 = none).
fn kv_secret_key(kv): i64 { return load64(kv + 80); }

# Sets the valid-from time of `kv` to `v` (epoch seconds); returns `kv`.
fn kv_set_valid_from(kv, v): i64 { store64(kv + 8, v); return kv; }
# Sets the valid-until time of `kv` to `v` (epoch seconds, 0 = no expiry); returns `kv`.
fn kv_set_valid_until(kv, v): i64 { store64(kv + 16, v); return kv; }
# Sets the KeyRole (KEY_ROLE_*) of `kv` to `r`; returns `kv`.
fn kv_set_role(kv, r): i64 { store64(kv + 32, r); return kv; }
# Sets the issuer key-id C-string of `kv` to `v` (0 = none / self-signed); returns `kv`.
fn kv_set_issued_by(kv, v): i64 { store64(kv + 40, v); return kv; }
# Attaches issuer signature `sig` (`sig_len` bytes; 0 = none) to `kv`; returns `kv`. Only the
# pointer is stored. keyring_validate_chain accepts a link only if sig_len is exactly 64 and
# the bytes are the parent's Ed25519 signature over kv_issuance_message_into(kv).
fn kv_set_issuer_sig(kv, sig, sig_len): i64 {
    store64(kv + 48, sig);
    store64(kv + 56, sig_len);
    return kv;
}
# Sets the publisher-name C-string of `kv` to `v` (0 = none); returns `kv`.
fn kv_set_pub_name(kv, v): i64 { store64(kv + 64, v); return kv; }
# Sets the publisher-contact C-string of `kv` to `v` (0 = none); returns `kv`.
fn kv_set_pub_contact(kv, v): i64 { store64(kv + 72, v); return kv; }
# Attaches secret-key buffer `sk` to `kv` (0 = none); returns `kv`. Only the pointer is
# stored: the buffer is not copied, so the caller keeps ownership (and its zeroization).
fn kv_set_secret_key(kv, sk): i64 { store64(kv + 80, sk); return kv; }

# Allowed-artifact-type restriction. An unset (0) list means "this key
# is authorized for every ArtifactType" — the Rust `KeyMetadata`
# default. A non-empty list restricts the key to signing only those
# artifact types; any other type fails verification with a dedicated
# "allowed_type" check, independent of the signature itself.
fn kv_allowed_types(kv): i64 { return load64(kv + 88); }

# Adds `artifact_type` (ARTIFACT_*) to `kv`'s allowed-type list (created on first use),
# restricting the key to the listed types (see kv_is_type_allowed). Returns `kv`.
fn kv_add_allowed_type(kv, artifact_type): i64 {
    var v = load64(kv + 88);
    if (v == 0) { v = vec_new(); store64(kv + 88, v); }
    vec_push(v, artifact_type);
    return kv;
}

# Drops `kv`'s allowed-type list (reset to 0 = every ArtifactType allowed); returns `kv`.
fn kv_clear_allowed_types(kv): i64 { store64(kv + 88, 0); return kv; }

# Is this key authorized to sign artifacts of `artifact_type`?
# Unrestricted key (no allowed_types list or empty list) → 1.
fn kv_is_type_allowed(kv, artifact_type): i64 {
    var v = load64(kv + 88);
    if (v == 0) { return 1; }
    var n = vec_len(v);
    if (n == 0) { return 1; }
    var i = 0;
    while (i < n) {
        if (vec_get(v, i) == artifact_type) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Returns 1 if `kv` is valid at epoch time `when` (valid_from <= when and, unless valid_until
# is 0 = no expiry, when <= valid_until; both bounds inclusive), else 0.
fn kv_is_valid_at(kv, when): i64 {
    if (when < load64(kv + 8)) { return 0; }
    var until = load64(kv + 16);
    if (until != 0) {
        if (when > until) { return 0; }
    }
    return 1;
}

# ================================================================
# PublisherKeyring (16 bytes)
# ================================================================
# Layout:
#   +0   keys_map   (hashmap: key_id -> vec of KeyVersion)
#   +8   keys_dir   (C-string ptr)

# Allocates a 16-byte PublisherKeyring (fl_alloc) with an empty key-id map; returns the
# pointer. `keys_dir` (stored by pointer) is where keyring_save writes; 0 disables saving.
fn keyring_new(keys_dir): i64 {
    var kr = fl_alloc(16);
    store64(kr, map_new());
    store64(kr + 8, keys_dir);
    return kr;
}

# Appends key version `kv` to the version list for its key ID (a new ID gets a new list,
# keyed by its key-id C-string pointer, not a copy), so the last-added version is the
# newest. No duplicate or validity checks. Returns `kr`.
fn keyring_add_key(kr, kv): i64 {
    var m = load64(kr);
    var kid = kv_key_id(kv);
    var existing = map_get(m, kid);
    if (existing == 0) {
        var v = vec_new();
        vec_push(v, kv);
        map_set(m, kid, v);
    } else {
        vec_push(existing, kv);
    }
    return kr;
}

# Returns the newest (last-added) version of `key_id` that is valid now (kv_is_valid_at at
# clock_epoch_secs), or 0 if the ID is unknown or no version is currently valid.
fn keyring_get_current(kr, key_id): i64 {
    var m = load64(kr);
    var versions = map_get(m, key_id);
    if (versions == 0) { return 0; }
    var now = clock_epoch_secs();
    var vlen = vec_len(versions);
    # Return last valid key
    var i = vlen - 1;
    while (i >= 0) {
        var kv = vec_get(versions, i);
        if (kv_is_valid_at(kv, now) == 1) { return kv; }
        i = i - 1;
    }
    return 0;
}

# Returns the keyring's own vec of every KeyVersion for `key_id`, in insertion order (the
# live internal vec, not a copy), or 0 if the ID is unknown.
fn keyring_get_all_versions(kr, key_id): i64 {
    var m = load64(kr);
    var versions = map_get(m, key_id);
    return versions;
}

# Returns the number of distinct key IDs in the keyring (not the number of versions).
fn keyring_len(kr): i64 {
    var m = load64(kr);
    return map_count(m);
}

# Returns a new vec of every KeyVersion (all IDs and versions, valid or not) whose role is
# `role` (KEY_ROLE_*); empty if none match.
fn keyring_find_by_role(kr, role): i64 {
    var result = vec_new();
    var m = load64(kr);
    var keys = map_keys(m);
    var klen = vec_len(keys);
    var i = 0;
    while (i < klen) {
        var kid = vec_get(keys, i);
        var versions = map_get(m, kid);
        var vlen = vec_len(versions);
        var j = 0;
        while (j < vlen) {
            var kv = vec_get(versions, j);
            if (kv_role(kv) == role) {
                vec_push(result, kv);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

# Returns 1 if the keyring holds no key IDs, else 0.
fn keyring_is_empty(kr): i64 {
    if (keyring_len(kr) == 0) { return 1; }
    return 0;
}

# Get key valid at a specific time
fn keyring_get_key_valid_at(kr, key_id, when): i64 {
    var m = load64(kr);
    var versions = map_get(m, key_id);
    if (versions == 0) { return 0; }
    var vlen = vec_len(versions);
    var i = vlen - 1;
    while (i >= 0) {
        var kv = vec_get(versions, i);
        if (kv_is_valid_at(kv, when) == 1) { return kv; }
        i = i - 1;
    }
    return 0;
}

# Get all key IDs in the keyring
fn keyring_key_ids(kr): i64 {
    var m = load64(kr);
    return map_keys(m);
}

# Find keys by publisher name (case-sensitive substring match)
fn keyring_find_by_publisher(kr, name): i64 {
    var result = vec_new();
    var m = load64(kr);
    var keys = map_keys(m);
    var klen = vec_len(keys);
    var nlen = strlen(name);
    var i = 0;
    while (i < klen) {
        var kid = vec_get(keys, i);
        var versions = map_get(m, kid);
        var vlen = vec_len(versions);
        var j = 0;
        while (j < vlen) {
            var kv = vec_get(versions, j);
            var pname = kv_pub_name(kv);
            if (pname != 0) {
                # Simple substring search
                var plen = strlen(pname);
                var k = 0;
                while (k + nlen <= plen) {
                    if (memeq(pname + k, name, nlen) == 1) {
                        vec_push(result, kv);
                        k = plen;  # break
                    }
                    k = k + 1;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

# Rotate key: create new version with overlap period
fn keyring_rotate_key(kr, key_id, new_pk_hex, overlap_until): i64 {
    var new_kv = key_version_new(key_id, new_pk_hex);
    # Set the old key's valid_until to overlap_until
    var m = load64(kr);
    var versions = map_get(m, key_id);
    if (versions != 0) {
        var vlen = vec_len(versions);
        if (vlen > 0) {
            var old_kv = vec_get(versions, vlen - 1);
            kv_set_valid_until(old_kv, overlap_until);
        }
    }
    keyring_add_key(kr, new_kv);
    return new_kv;
}

# Get trust chain from key to root (following issued_by links)
fn keyring_get_chain(kr, key_id): i64 {
    var chain = vec_new();
    var current_id = key_id;
    var max_depth = 10;
    var depth = 0;
    while (current_id != 0) {
        if (depth >= max_depth) { return chain; }
        var kv = keyring_get_current(kr, current_id);
        if (kv == 0) { return chain; }
        vec_push(chain, kv);
        current_id = kv_issued_by(kv);
        if (current_id == 0) { return chain; }
        # Check for self-signed (root)
        if (streq(current_id, key_id) == 1) { return chain; }
        depth = depth + 1;
    }
    return chain;
}

# ================================================================
# Key issuance signatures (3.13.0 — audit M1)
# ================================================================
# Every non-root KeyVersion carries its parent's Ed25519 signature over a canonical,
# domain-separated issuance message (layout in kv_issuance_message_into's doc).
# keyring_validate_chain verifies each link against it, fail-closed.

# Maximum number of keys in a validated chain (leaf .. root inclusive).
var _KEYRING_MAX_CHAIN = 10;

# Writes the low `nbytes` bytes of `v` big-endian at `p`.
fn _kv_put_be(p, v, nbytes): i64 {
    var i = 0;
    while (i < nbytes) {
        store8(p + i, (v >> ((nbytes - 1 - i) * 8)) & 0xFF);
        i = i + 1;
    }
    return 0;
}

# Length of C-string `s` for the issuance message (0 for a null pointer).
fn _kv_msg_strlen(s): i64 {
    if (s == 0) { return 0; }
    return strlen(s);
}

# Writes u32-BE length || bytes of C-string `s` (0 = empty) at `p`; returns bytes written.
fn _kv_put_lpstr(p, s): i64 {
    var n = _kv_msg_strlen(s);
    _kv_put_be(p, n, 4);
    if (n > 0) { memcpy(p + 4, s, n); }
    return 4 + n;
}

# Decodes `kv`'s public-key hex into the 32 bytes at `out`. Returns 1 only for exactly 64
# valid hex characters, else 0.
fn _kv_decode_pk(kv, out): i64 {
    var hex = kv_public_key_hex(kv);
    if (hex == 0) { return 0; }
    if (strlen(hex) != 64) { return 0; }
    return hex_decode_into(hex, 64, out);
}

# Returns the byte length of `kv`'s canonical issuance message (see kv_issuance_message_into),
# or -1 if `kv` has none: missing/empty key_id, a public key that is not exactly 64 hex chars,
# or a string field whose length does not fit the u32 length prefix.
fn kv_issuance_message_len(kv): i64 {
    if (kv == 0) { return -1; }
    var kid = kv_key_id(kv);
    var klen = _kv_msg_strlen(kid);
    if (klen == 0) { return -1; }
    var pk[32];
    if (_kv_decode_pk(kv, &pk) == 0) { return -1; }
    var ilen = _kv_msg_strlen(kv_issued_by(kv));
    var nlen = _kv_msg_strlen(kv_pub_name(kv));
    var clen = _kv_msg_strlen(kv_pub_contact(kv));
    var lim = 4294967295;
    if (klen > lim) { return -1; }
    if (ilen > lim) { return -1; }
    if (nlen > lim) { return -1; }
    if (clen > lim) { return -1; }
    var tcount = 0;
    var types = kv_allowed_types(kv);
    if (types != 0) { tcount = vec_len(types); }
    if (tcount > lim) { return -1; }
    return 98 + klen + ilen + nlen + clen + tcount * 8;
}

# Writes `kv`'s canonical issuance message — the exact bytes a parent key signs to issue
# `kv` — to `out` (size it with kv_issuance_message_len). Returns the byte count, or -1
# (nothing written) if kv_issuance_message_len is -1. Integers are big-endian; strings are
# a u32 byte length then the bytes, no NUL (a null pointer encodes as length 0):
#   "SIGIL-KEY-ISSUANCE-V1" 0x00       22 B  domain tag
#   key_id                             u32 len || bytes
#   public key                         32 B  raw, decoded from public_key_hex
#   role                               u64   KEY_ROLE_*
#   valid_from, valid_until            u64, u64  (two's complement; 0 = no expiry)
#   issued_by                          u32 len || bytes (the parent key_id)
#   pub_name, pub_contact              u32 len || bytes each
#   allowed_types                      u32 count || count x u64, in stored order
#                                      (count 0 = unrestricted, whether unset or empty)
# Any change to these fields after signing invalidates the issuer signature.
fn kv_issuance_message_into(kv, out): i64 {
    var total = kv_issuance_message_len(kv);
    if (total < 0) { return -1; }
    memcpy(out, "SIGIL-KEY-ISSUANCE-V1", 21);
    store8(out + 21, 0);
    var p = out + 22;
    p = p + _kv_put_lpstr(p, kv_key_id(kv));
    _kv_decode_pk(kv, p);
    p = p + 32;
    _kv_put_be(p, kv_role(kv), 8);
    _kv_put_be(p + 8, kv_valid_from(kv), 8);
    _kv_put_be(p + 16, kv_valid_until(kv), 8);
    p = p + 24;
    p = p + _kv_put_lpstr(p, kv_issued_by(kv));
    p = p + _kv_put_lpstr(p, kv_pub_name(kv));
    p = p + _kv_put_lpstr(p, kv_pub_contact(kv));
    var types = kv_allowed_types(kv);
    var tcount = 0;
    if (types != 0) { tcount = vec_len(types); }
    _kv_put_be(p, tcount, 4);
    p = p + 4;
    var i = 0;
    while (i < tcount) {
        _kv_put_be(p, vec_get(types, i), 8);
        p = p + 8;
        i = i + 1;
    }
    return total;
}

# Issues `child_kv`: Ed25519-signs its canonical issuance message (kv_issuance_message_into)
# with the parent's 64-byte `parent_secret_key` (seed || pk, as from generate_keypair) and
# attaches the fresh 64-byte signature with kv_set_issuer_sig. Set every child field —
# issued_by (the parent key_id), role, validity, allowed types, publisher info — BEFORE
# calling: a later change invalidates the signature. Returns 1, or 0 (nothing attached) if
# `parent_secret_key` is null, the child has no issued_by, or it has no issuance message.
# The parent key is not checked against issued_by here; keyring_validate_chain does that.
fn keyring_sign_issuance(parent_secret_key, child_kv): i64 {
    if (parent_secret_key == 0) { return 0; }
    if (child_kv == 0) { return 0; }
    if (kv_issued_by(child_kv) == 0) { return 0; }
    var mlen = kv_issuance_message_len(child_kv);
    if (mlen < 0) { return 0; }
    var msg = fl_alloc(mlen);
    kv_issuance_message_into(child_kv, msg);
    var sig = alloc(64);
    ed25519_sign(parent_secret_key, msg, mlen, sig);
    fl_free(msg);
    kv_set_issuer_sig(child_kv, sig, 64);
    return 1;
}

# Returns 1 if `child`'s issuer_sig is exactly 64 bytes and a valid Ed25519 signature by
# `parent`'s public key over child's issuance message, else 0.
fn _kv_issuer_sig_ok(child, parent): i64 {
    var sig = kv_issuer_sig(child);
    if (sig == 0) { return 0; }
    if (kv_issuer_sig_len(child) != 64) { return 0; }
    var ppk[32];
    if (_kv_decode_pk(parent, &ppk) == 0) { return 0; }
    var mlen = kv_issuance_message_len(child);
    if (mlen < 0) { return 0; }
    var msg = fl_alloc(mlen);
    kv_issuance_message_into(child, msg);
    var ok = ed25519_verify(&ppk, msg, mlen, sig);
    fl_free(msg);
    if (ok == 1) { return 1; }
    return 0;
}

# Returns the version of `issuer_id` that issued `child`: the newest version valid at `now`
# whose role may issue (Root or Intermediate) and whose key verifies child's issuer_sig.
# Trying every valid version keeps children of a rotated-out-but-overlapping parent valid.
# Returns 0 if none qualifies.
fn _keyring_find_issuer(kr, issuer_id, child, now): i64 {
    var versions = map_get(load64(kr), issuer_id);
    if (versions == 0) { return 0; }
    var i = vec_len(versions) - 1;
    while (i >= 0) {
        var p = vec_get(versions, i);
        if (kv_is_valid_at(p, now) == 1) {
            if (kv_role(p) != KEY_ROLE_PUBLISHER) {
                if (_kv_issuer_sig_ok(child, p) == 1) { return p; }
            }
        }
        i = i - 1;
    }
    return 0;
}

# Validates the issuance chain of `key_id`, fail-closed: returns 1 only if every link verifies,
# else 0. Starting from its current version (keyring_get_current), each non-Root key must name
# an issued_by other than itself, and that key ID must have a version that is valid now, has
# role Root or Intermediate (a Publisher cannot issue), and whose Ed25519 public key verifies
# the child's 64-byte issuer_sig over kv_issuance_message_into(child) (see
# keyring_sign_issuance). The walk must reach a Root — the trust anchor, whose own issued_by
# must be 0 or its own key_id; a Root's issuer_sig is not checked — within 10 keys, without
# revisiting a key ID (cycle). An unknown key, missing or non-64-byte signature, forged or
# stale signature (any signed field changed), missing or expired parent, or a chain topped by
# a non-Root all return 0.
fn keyring_validate_chain(kr, key_id): i64 {
    if (key_id == 0) { return 0; }
    var now = clock_epoch_secs();
    var kv = keyring_get_current(kr, key_id);
    if (kv == 0) { return 0; }
    var seen[80];                       # _KEYRING_MAX_CHAIN key-id pointers
    var depth = 0;
    while (depth < _KEYRING_MAX_CHAIN) {
        var kid = kv_key_id(kv);
        if (kid == 0) { return 0; }
        var j = 0;
        while (j < depth) {
            if (streq(load64(&seen + j * 8), kid) == 1) { return 0; }   # cycle
            j = j + 1;
        }
        store64(&seen + depth * 8, kid);
        var issuer = kv_issued_by(kv);
        if (kv_role(kv) == KEY_ROLE_ROOT) {
            if (issuer == 0) { return 1; }
            if (streq(issuer, kid) == 1) { return 1; }
            return 0;                   # a Root that names another issuer is no anchor
        }
        if (issuer == 0) { return 0; }  # chain ends at a non-Root
        if (streq(issuer, kid) == 1) { return 0; }  # self-issued non-Root
        var parent = _keyring_find_issuer(kr, issuer, kv, now);
        if (parent == 0) { return 0; }
        kv = parent;
        depth = depth + 1;
    }
    return 0;
}

# Validate key_id as a safe filename:
#   - non-empty, max 64 chars
#   - only [A-Za-z0-9_-] (no '/', '.', or control bytes)
# Returns 1 if safe, 0 otherwise. Prevents path traversal in keyring_save.
fn _is_safe_key_id(kid): i64 {
    if (kid == 0) { return 0; }
    var klen = strlen(kid);
    if (klen == 0) { return 0; }
    if (klen > 64) { return 0; }
    var i = 0;
    while (i < klen) {
        var c = load8(kid + i) & 0xFF;
        var ok = 0;
        if (c >= 48) { if (c <= 57) { ok = 1; } }       # 0-9
        if (c >= 65) { if (c <= 90) { ok = 1; } }       # A-Z
        if (c >= 97) { if (c <= 122) { ok = 1; } }      # a-z
        if (c == 95) { ok = 1; }                        # _
        if (c == 45) { ok = 1; }                        # -
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Save keyring to JSON files in keys_dir.
# Returns count of key versions written. Skips any key_id that
# fails _is_safe_key_id or whose full path exceeds 255 bytes.
fn keyring_save(kr): i64 {
    var keys_dir = load64(kr + 8);
    if (keys_dir == 0) { return 0; }
    var m = load64(kr);
    var kids = map_keys(m);
    var klen = vec_len(kids);
    var count = 0;
    var i = 0;
    while (i < klen) {
        var kid = vec_get(kids, i);
        var versions = map_get(m, kid);
        var vlen = vec_len(versions);
        # Validate key_id — reject path traversal or oversized names
        if (_is_safe_key_id(kid) == 0) { i = i + 1; }
        else {
            var dlen = strlen(keys_dir);
            var kidlen = strlen(kid);
            # dlen + "/" + kidlen + ".json" + NUL
            var need = dlen + 1 + kidlen + 5 + 1;
            if (need > 256) { i = i + 1; }
            else {
                # Write JSON file: keys_dir/key_id.json
                var path = alloc(256);
                var pos = 0;
                memcpy(path, keys_dir, dlen);
                pos = pos + dlen;
                store8(path + pos, 47);  # /
                pos = pos + 1;
                memcpy(path + pos, kid, kidlen);
                pos = pos + kidlen;
                memcpy(path + pos, ".json", 5);
                pos = pos + 5;
                store8(path + pos, 0);

                # 3.13.0: named flags — the literal 577 lost O_TRUNC on Darwin (0x241 there is
                # O_WRONLY|O_ASYNC|O_CREAT), so a shrinking key file kept a stale tail.
                var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 420);  # 0644
                if (fd >= 0) {
                    file_write(fd, "[", 1);
                    var j = 0;
                    while (j < vlen) {
                        var kv = vec_get(versions, j);
                        if (j > 0) { file_write(fd, ",", 1); }
                        file_write(fd, "{\"key_id\":\"", 11);
                        json_write_escaped(fd, kv_key_id(kv), strlen(kv_key_id(kv)));
                        file_write(fd, "\",\"public_key_hex\":\"", 20);
                        json_write_escaped(fd, kv_public_key_hex(kv), strlen(kv_public_key_hex(kv)));
                        file_write(fd, "\",\"role\":\"", 10);
                        var rn = key_role_name(kv_role(kv));
                        json_write_escaped(fd, rn, strlen(rn));
                        file_write(fd, "\"}", 2);
                        j = j + 1;
                    }
                    file_write(fd, "]", 1);
                    file_close(fd);
                    count = count + vlen;
                }
                i = i + 1;
            }
        }
    }
    return count;
}

# ================================================================
# JSON string escaping
# ================================================================
# Write `s` (length `slen`) to `fd`, escaping the minimal RFC 8259 set:
# `"`, `\`, and control bytes < 0x20. Non-ASCII bytes pass through
# verbatim (sigil stores UTF-8 path/hex content). Used by persistence
# paths to prevent JSON injection from tampered field values.
fn json_write_escaped(fd, s, slen): i64 {
    if (s == 0) { return 0; }
    var i = 0;
    var chunk_start = 0;
    while (i < slen) {
        var c = load8(s + i) & 0xFF;
        var needs_escape = 0;
        if (c == 34) { needs_escape = 1; }       # "
        elif (c == 92) { needs_escape = 1; }     # \
        elif (c < 32) { needs_escape = 1; }      # control
        if (needs_escape == 1) {
            if (i > chunk_start) {
                file_write(fd, s + chunk_start, i - chunk_start);
            }
            if (c == 34) { file_write(fd, "\\\"", 2); }
            elif (c == 92) { file_write(fd, "\\\\", 2); }
            elif (c == 8) { file_write(fd, "\\b", 2); }
            elif (c == 9) { file_write(fd, "\\t", 2); }
            elif (c == 10) { file_write(fd, "\\n", 2); }
            elif (c == 12) { file_write(fd, "\\f", 2); }
            elif (c == 13) { file_write(fd, "\\r", 2); }
            else {
                # \u00XX for other control bytes
                var hex_buf[6];
                store8(&hex_buf, 92);   # \
                store8(&hex_buf + 1, 117); # u
                store8(&hex_buf + 2, 48);  # 0
                store8(&hex_buf + 3, 48);  # 0
                var hi = (c >> 4) & 0xF;
                var lo = c & 0xF;
                if (hi < 10) { store8(&hex_buf + 4, 48 + hi); }
                else { store8(&hex_buf + 4, 87 + hi); }
                if (lo < 10) { store8(&hex_buf + 5, 48 + lo); }
                else { store8(&hex_buf + 5, 87 + lo); }
                file_write(fd, &hex_buf, 6);
            }
            chunk_start = i + 1;
        }
        i = i + 1;
    }
    if (slen > chunk_start) {
        file_write(fd, s + chunk_start, slen - chunk_start);
    }
    return 0;
}

# ================================================================
# Hash functions
# ================================================================

# SHA-256 of `len` bytes at `data`, as a freshly alloc'd 64-char lowercase hex C-string.
fn hash_data(data, len): i64 {
    return sha256_hex(data, len);
}

# Dispatch hashing by algorithm (mirrors Rust `hash_data_with`).
# HASH_ALG_SHA256 (default, 32-byte digest) or HASH_ALG_SHA512
# (64-byte digest). Unknown algorithm defaults to SHA-256 rather
# than returning 0 — a trust engine must never silently skip hashing.
fn hash_data_with(data, len, algorithm): i64 {
    if (algorithm == HASH_ALG_SHA512) { return sha512_hex(data, len); }
    return sha256_hex(data, len);
}

# Streams the file at `path` through SHA-256; returns the digest as a freshly alloc'd
# 64-char lowercase hex C-string, or 0 if the file cannot be opened or any read fails (a
# negative read, e.g. EISDIR on a directory or EIO, is an error, never EOF — no digest of a
# prefix is ever returned).
fn hash_file(path): i64 {
    var fd = file_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0; }
    var ctx = sha256_init();
    var buf[4096];
    var n = file_read(fd, &buf, 4096);
    while (n > 0) {
        sha256_update(ctx, &buf, n);
        n = file_read(fd, &buf, 4096);
    }
    file_close(fd);
    if (n < 0) {
        fl_free(ctx);
        return 0;
    }
    var digest[32];
    sha256_finalize(ctx, &digest);
    fl_free(ctx);
    return hex_encode(&digest, 32);
}

# Alloc-free variant of hash_file (3.2.0). Writes a 64-character
# lowercase SHA-256 hex digest plus a NUL terminator (65 bytes
# total) into `hex_out`, using `ctx_buf` as a 144-byte scratch
# SHA-256 context. Returns 1 on success, 0 if the file could not
# be opened or any read fails (a negative read is an error, never
# EOF; `hex_out` is then left unwritten).
#
# Caller MUST size:
#   hex_out  ≥ 65 bytes
#   ctx_buf  ≥ 144 bytes
#
# Used by the parallel-batch verify worker so the per-artifact
# hash step doesn't touch the freelist allocator (CLAUDE.md quirk
# #7). The 4 KB file_read buffer remains a stack-local — fine for
# concurrent workers, each thread gets its own stack.
fn hash_file_into(path, hex_out, ctx_buf): i64 {
    var fd = file_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0; }
    sha256_init_into(ctx_buf);
    # Banked per thread (3.6): the file-read buffer and digest are
    # `var X[N]` static function-scope globals (CLAUDE.md quirk #1).
    # On the parallel batch path each worker streams the file into its
    # own lane; a shared read buffer would interleave bytes across
    # workers and corrupt the content hash. (ctx_buf is already a
    # caller-provided per-artifact slot.)
    var bk = cbank();
    var buf[262144];  var bufb = &buf + bk * 4096;     # 4096 * SIGIL_CRYPTO_BANKS
    var digest[2048]; var digestb = &digest + bk * 32; # 32 * SIGIL_CRYPTO_BANKS
    var n = file_read(fd, bufb, 4096);
    while (n > 0) {
        sha256_update(ctx_buf, bufb, n);
        n = file_read(fd, bufb, 4096);
    }
    file_close(fd);
    if (n < 0) { return 0; }
    sha256_finalize(ctx_buf, digestb);
    # Inline hex_encode of the 32-byte digest into hex_out (lowercase,
    # NUL-terminated). Mirrors hex.cyr's hex_encode body but writes
    # into the caller-provided buffer instead of allocating.
    var i = 0;
    while (i < 32) {
        var b = load8(digestb + i) & 0xFF;
        var hi = (b >> 4) & 0xF;
        var lo = b & 0xF;
        if (hi < 10) { store8(hex_out + i * 2, 48 + hi); }
        else { store8(hex_out + i * 2, 87 + hi); }
        if (lo < 10) { store8(hex_out + i * 2 + 1, 48 + lo); }
        else { store8(hex_out + i * 2 + 1, 87 + lo); }
        i = i + 1;
    }
    store8(hex_out + 64, 0);
    return 1;
}

# File hash with algorithm selection (mirror of hash_data_with for
# on-disk content). Returns hex C-string, or 0 if the file cannot be
# opened or any read fails (a negative read is an error, never EOF).
# Unknown algorithm falls back to SHA-256 — trust engine must never
# silently skip hashing.
fn hash_file_with(path, algorithm): i64 {
    if (algorithm != HASH_ALG_SHA512) { return hash_file(path); }
    var fd = file_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0; }
    var ctx = sha512_init();
    var buf[4096];
    var n = file_read(fd, &buf, 4096);
    while (n > 0) {
        sha512_update(ctx, &buf, n);
        n = file_read(fd, &buf, 4096);
    }
    file_close(fd);
    if (n < 0) {
        fl_free(ctx);
        return 0;
    }
    var digest[64];
    sha512_finalize(ctx, &digest);
    fl_free(ctx);
    return hex_encode(&digest, 64);
}

# ================================================================
# Signing / verification (Ed25519)
# ================================================================

# Ed25519-signs `len` bytes at `data` with the 64-byte `secret_key` (seed || pk, as written
# by generate_keypair). Returns a freshly alloc'd 64-byte signature.
fn sign_data(data, len, secret_key): i64 {
    # secret_key is 64 bytes (seed || pk) from ed25519_keypair
    var sig = alloc(64);
    ed25519_sign(secret_key, data, len, sig);
    return sig;
}

# Verifies the 64-byte Ed25519 signature `sig` over `len` bytes at `data` against the raw
# 32-byte `public_key` (not hex). Returns 1 if valid, 0 otherwise.
fn verify_data(data, len, sig, public_key): i64 {
    # public_key is 32 bytes
    return ed25519_verify(public_key, data, len, sig);
}

# ================================================================
# Key generation (Ed25519)
# ================================================================

# Generates an Ed25519 keypair from a fresh 32-byte CSPRNG seed: writes the 64-byte secret
# key (seed || pk) to `sk_out` and the 32-byte public key to `pk_out`. Returns the key ID,
# an alloc'd C-string of the first 16 hex chars of the public key, or 0 on entropy failure
# (outputs untouched). The caller owns the secret in `sk_out` (wipe it with zeroize_key).
fn generate_keypair(sk_out, pk_out): i64 {
    # sk_out: 64 bytes (seed || pk), pk_out: 32 bytes
    # Returns key_id (C-string) on success, 0 on entropy failure.
    # `secret var` zeroizes seed on every return (Cyrius 5.3.5+).
    secret var seed[32];
    memset(&seed, 0, 32);
    # Entropy via sigil's single fail-closed CSPRNG boundary (src/random.cyr) —
    # per-target getrandom/getentropy/ProcessPrng. On any failure `secret var`
    # zeroizes `seed` on the return path; no weak fallback.
    if (_sigil_random_fill(&seed, 32) != 0) { return 0; }
    ed25519_keypair(&seed, sk_out, pk_out);

    # key_id = first 16 hex chars of public key
    var hex = hex_encode(pk_out, 32);
    var kid = alloc(17);
    memcpy(kid, hex, 16);
    store8(kid + 16, 0);
    return kid;
}

# ================================================================
# Key zeroization
# ================================================================

# Overwrites the `len`-byte key buffer at `key_buf` with zeros (memset). Returns 0.
fn zeroize_key(key_buf, len): i64 {
    memset(key_buf, 0, len);
    return 0;
}
