# mul64.cyr -- native 64x64 -> 128 unsigned multiply (3.12.2).
#
# Include-guard marker: single-file consumers may pull this in via a
# `#ifndef`-guarded include from bignum.cyr / bigint_ext.cyr / ecdsa_p384.cyr,
# but the dist bundles (dist/sigil.cyr and friends) already inline this module —
# so the bundle's redundant include must NOT re-fire (the file is absent in the
# fold, and cyrius hard-errors on a missing include since v6.1.35). Same marker
# pattern as sha_ni.cyr.
#define _SIGIL_MUL64_INCLUDED
#
# WHY THIS MODULE EXISTS
# ----------------------
# Every big-integer path in sigil is built on one operation: multiply two
# 64-bit limbs and keep all 128 bits of the product. Through 3.12.1 each of
# the four engines below did that with a portable 32-bit-halves decomposition
# — FOUR 32x32 multiplies, a shifted middle-term recombination, and TWO
# comparison-based carry fixups per product:
#
#   lib/bayan.cyr `_mul64`          <- src/bignum.cyr   (RSA: bn_mul, _bn_mont_mul)
#   src/ecdsa_p384.cyr `_p384_mul64` <- u384_mul_full   (ECDSA P-384 sign+verify)
#   src/bigint_ext.cyr (inlined x5)  <- u256_mul_full   (Ed25519, ECDSA P-256)
#
# x86-64 has done the whole thing in ONE instruction since 2003: `MUL r/m64`
# puts the 128-bit product in RDX:RAX. It is baseline long mode — not an
# extension — so unlike the SHA-NI and AES-NI dispatchers there is NO CPUID
# probe, no runtime feature cache, and no software/hardware dispatch: just an
# arch `#ifdef` with a portable fallback for aarch64.
#
# Measured (RSA-2048, this host): one 32-limb CIOS Montgomery multiply
# (2 * 32^2 = 2048 of these products) went 42 us -> 20.2 us. See
# docs/development/issues/2026-07-30-rsa-verify-uses-secret-exponent-ladder.md
# "Piece 2", which filed the memory round-trip as the suspected cost.
#
# CONSTANT-TIME POSTURE
# ---------------------
# `MUL r64` is data-independent on every x86-64 microarchitecture sigil
# targets. The portable code it replaces carries two VALUE-DEPENDENT branches
# (the `mid_carry` / `lo_carry` fixups), so on the secret-operand paths — RSA's
# secret-exponent ladder, ECDSA P-384's signing nonce — the native path is not
# merely faster, it removes two data-dependent branches per product. This is a
# side-channel improvement, not a trade-off.
#
# TWO ENTRY POINTS, AND WHY
# -------------------------
# `_nmul64` returns both halves through caller pointers. That suits bignum.cyr,
# whose CIOS loop owns a 16-byte lo||hi slot as a stack local (3.12.9;
# it was the banked `_bn_m64` through 3.12.8).
#
# `_nmul64_hi` returns ONLY the high half, in rax. Its callers pair it with a
# plain `a * b` for the low half — cyrius's `*` on i64 is a wrapping multiply,
# and the low 64 bits of a product are identical for signed and unsigned
# operands in two's complement, so `a * b` IS the low half, exactly. This form
# exists because `u256_mul_full` / `_u256_mul_full_schoolbook` (bigint_ext.cyr)
# and `u384_mul_full`'s callers run on the **Ed25519 parallel batch-verify
# path** and are documented thread-safe by having NO static scratch at all.
# A `var lo[8]` to receive a pointer-form result would be a function-scope
# STATIC GLOBAL (CLAUDE.md quirk #1) and would reintroduce exactly the race
# 3.9.7 spent a cycle removing. Returning a scalar keeps those functions
# scratch-free: scalar `var x = ...` locals ARE per-call.
#
# TOOLCHAIN DEPENDENCY (read before editing `_nmul64_hi`)
# ------------------------------------------------------
# `_nmul64_hi` has NO trailing `return` statement: the asm block leaves the
# value in rax and the function falls through to its epilogue, which is what
# makes a register return possible at all (a `return 0;` would clobber rax).
# That is a real dependency on cyrius codegen, verified against pin 6.5.3.
# It is NOT left to trust: `tests/tcyr/bignum.tcyr` cross-checks `_nmul64_hi`
# against bayan's portable `_mul64` on 17 adversarial operand pairs, so a
# toolchain that ever zeroes or reuses rax in the epilogue fails the suite
# loudly at build time rather than silently corrupting a signature.
#
# REGISTER DISCIPLINE (SysV x86-64)
# ---------------------------------
#   rax = a  (MUL's implicit multiplicand; the LOW half on exit)
#   rcx = b  (the explicit operand)
#   rdx      (clobbered by MUL; receives the HIGH half)
#   rsi/rdi = out_lo / out_hi, `_nmul64` only
# All of these are CALLER-saved. Nothing callee-saved (rbx, rbp, r12-r15) is
# touched, so — unlike the CPUID probes in sha_ni.cyr / aes_ni.cyr — no
# push/pop is needed. Each block is straight-line with no calls. Parameters
# are read through the prologue-drift-proof `param_load` pseudo (cyrius
# 6.0.67+), which resolves each spill slot at emit time; hardcoded `[rbp-N]`
# literals are what caused the 6.1.20 SIGILL re-break documented in
# sha_ni.cyr's header. In `_nmul64` BOTH pointer params are loaded BEFORE the
# MUL, so the rdx clobber cannot eat one.
#
# Design notes: docs/architecture/002-native-asm-multiply.md

# Full 128-bit product of two 64-bit limbs: *out_lo = low 64, *out_hi = high 64.
# `out_lo` and `out_hi` may point into the same buffer 8 bytes apart (the
# `lo||hi` slot shape bignum.cyr uses); the stores are lo first, then hi.
fn _nmul64(a, b, out_lo, out_hi): i64 {
    #ifdef CYRIUS_ARCH_X86
    asm {
        param_load(rax, 0);            # a  -> rax (MUL's implicit operand)
        param_load(rcx, 1);            # b  -> rcx
        param_load(rsi, 2);            # out_lo
        param_load(rdi, 3);            # out_hi
        0x48; 0xF7; 0xE1;              # mul rcx        ; rdx:rax = rax * rcx
        0x48; 0x89; 0x06;              # mov [rsi], rax ; *out_lo = low  64
        0x48; 0x89; 0x17;              # mov [rdi], rdx ; *out_hi = high 64
    }
    #endif
    #ifndef CYRIUS_ARCH_X86
    _mul64(a, b, out_lo, out_hi);
    #endif
    return 0;
}

# High 64 bits of a * b, returned in rax. Pair with a plain `a * b` for the
# low half. NOTE: deliberately has no trailing `return` on the x86 path — see
# "TOOLCHAIN DEPENDENCY" in this file's header before changing that.
fn _nmul64_hi(a, b): i64 {
    #ifdef CYRIUS_ARCH_X86
    asm {
        param_load(rax, 0);            # a -> rax
        param_load(rcx, 1);            # b -> rcx
        0x48; 0xF7; 0xE1;              # mul rcx    ; rdx:rax = rax * rcx
        0x48; 0x89; 0xD0;              # mov rax,rdx; return the HIGH half
    }
    #endif
    #ifndef CYRIUS_ARCH_X86
    return _nmul64_hi_sw(a, b);
    #endif
}

# Portable high-half multiply for non-x86 targets. Same 32-bit-halves
# decomposition bayan's `_mul64` uses, reduced to the high word. Never
# compiled on x86-64; kept unguarded so `cyrius doc --check` and the aarch64
# build both see it.
fn _nmul64_hi_sw(a, b): i64 {
    var mask32 = 0xFFFFFFFF;
    var sbit = 1 << 63;
    var aL = a & mask32;
    var aH = (a >> 32) & mask32;
    var bL = b & mask32;
    var bH = (b >> 32) & mask32;
    var ll = aL * bL;
    var lh = aL * bH;
    var hl = aH * bL;
    var hh = aH * bH;
    var mid = lh + hl;
    var mid_carry = 0;
    if ((mid ^ sbit) < (lh ^ sbit)) { mid_carry = 1; }
    var lo = ll + (mid << 32);
    var lo_carry = 0;
    if ((lo ^ sbit) < (ll ^ sbit)) { lo_carry = 1; }
    return hh + (mid >> 32) + (mid_carry << 32) + lo_carry;
}
