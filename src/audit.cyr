# audit.cyr — structured audit event logging

# ================================================================
# AuditEvent types
# ================================================================

enum AuditEventType {
    AUDIT_ARTIFACT_VERIFIED = 0;
    AUDIT_ARTIFACT_SIGNED = 1;
    AUDIT_REVOCATION_ADDED = 2;
    AUDIT_KEY_ROTATED = 3;
    AUDIT_CHAIN_VALIDATED = 4;
}

# Returns the static C-string name of an AuditEventType value ("artifact_verified",
# "artifact_signed", "revocation_added", "key_rotated", "chain_validated"), or "unknown".
# This is the JSONL "type" string alog_save writes; audit_event_type_from_name inverts it.
fn audit_event_name(t): i64 {
    if (t == AUDIT_ARTIFACT_VERIFIED) { return "artifact_verified"; }
    if (t == AUDIT_ARTIFACT_SIGNED) { return "artifact_signed"; }
    if (t == AUDIT_REVOCATION_ADDED) { return "revocation_added"; }
    if (t == AUDIT_KEY_ROTATED) { return "key_rotated"; }
    if (t == AUDIT_CHAIN_VALIDATED) { return "chain_validated"; }
    return "unknown";
}

# Inverse of audit_event_name. Returns the AUDIT_* constant for a
# known name, or -1 if the string does not match any known event.
fn audit_event_type_from_name(name): i64 {
    if (streq(name, "artifact_verified") == 1) { return AUDIT_ARTIFACT_VERIFIED; }
    if (streq(name, "artifact_signed") == 1) { return AUDIT_ARTIFACT_SIGNED; }
    if (streq(name, "revocation_added") == 1) { return AUDIT_REVOCATION_ADDED; }
    if (streq(name, "key_rotated") == 1) { return AUDIT_KEY_ROTATED; }
    if (streq(name, "chain_validated") == 1) { return AUDIT_CHAIN_VALIDATED; }
    return (0 - 1);
}

# ================================================================
# AuditEvent (64 bytes)
# ================================================================
# Generic event struct that holds all possible fields.
# Layout:
#   +0   event_type    (i64 AUDIT_*)
#   +8   path          (C-string ptr, 0 = n/a)
#   +16  artifact_type (i64, -1 = n/a)
#   +24  trust_level   (i64, -1 = n/a)
#   +32  passed        (i64, -1 = n/a)
#   +40  content_hash  (C-string ptr, 0 = n/a)
#   +48  key_id        (C-string ptr, 0 = n/a)
#   +56  timestamp     (epoch seconds)
#   +64  reason        (C-string ptr, 0 = n/a; 3.13.1 — the revocation reason)

# Allocates a 72-byte AuditEvent (fl_alloc) of `event_type` with every optional field unset
# (pointers 0; artifact_type, trust_level and passed -1) and the timestamp set to the current
# epoch seconds. Returns the pointer.
fn audit_event_new(event_type): i64 {
    var e = fl_alloc(72);
    store64(e, event_type);
    store64(e + 8, 0);
    store64(e + 16, 0 - 1);
    store64(e + 24, 0 - 1);
    store64(e + 32, 0 - 1);
    store64(e + 40, 0);
    store64(e + 48, 0);
    store64(e + 56, clock_epoch_secs());
    store64(e + 64, 0);
    return e;
}

# Returns the AUDIT_* event type of event `e`.
fn ae_type(e): i64 { return load64(e); }
# Returns the path C-string of event `e` (0 = n/a).
fn ae_path(e): i64 { return load64(e + 8); }
# Returns the ArtifactType of event `e` (-1 = n/a).
fn ae_artifact_type(e): i64 { return load64(e + 16); }
# Returns the TrustLevel of event `e` (-1 = n/a).
fn ae_trust_level(e): i64 { return load64(e + 24); }
# Returns the pass/fail flag of event `e` (1 or 0; -1 = n/a).
fn ae_passed(e): i64 { return load64(e + 32); }
# Returns the content-hash C-string of event `e` (0 = n/a; the new key id on key_rotated).
fn ae_content_hash(e): i64 { return load64(e + 40); }
# Returns the key-id C-string of event `e` (0 = n/a; the old key id on key_rotated).
fn ae_key_id(e): i64 { return load64(e + 48); }
# Returns the timestamp of event `e` in epoch seconds.
fn ae_timestamp(e): i64 { return load64(e + 56); }

# Sets the path C-string of event `e` to `v`; returns `e`.
fn ae_set_path(e, v): i64 { store64(e + 8, v); return e; }
# Sets the ArtifactType of event `e` to `v`; returns `e`.
fn ae_set_artifact_type(e, v): i64 { store64(e + 16, v); return e; }
# Sets the TrustLevel of event `e` to `v`; returns `e`.
fn ae_set_trust_level(e, v): i64 { store64(e + 24, v); return e; }
# Sets the pass/fail flag of event `e` to `v` (1 or 0); returns `e`.
fn ae_set_passed(e, v): i64 { store64(e + 32, v); return e; }
# Sets the content-hash C-string of event `e` to `v`; returns `e`.
fn ae_set_content_hash(e, v): i64 { store64(e + 40, v); return e; }
# Sets the key-id C-string of event `e` to `v`; returns `e`.
fn ae_set_key_id(e, v): i64 { store64(e + 48, v); return e; }
# Returns the reason C-string of event `e` (the revocation reason), or 0 if none.
fn ae_reason(e): i64 { return load64(e + 64); }
# Sets the reason C-string of event `e` to `v` (stored by pointer, 0 = none); returns `e`.
fn ae_set_reason(e, v): i64 { store64(e + 64, v); return e; }

# ================================================================
# Convenience constructors
# ================================================================

# Builds an AUDIT_ARTIFACT_VERIFIED event recording `path`, ArtifactType `atype`, resulting
# TrustLevel `tlevel`, `passed` (1 or 0) and content hash `chash`. Returns the event
# (fl_alloc, via audit_event_new).
fn audit_artifact_verified(path, atype, tlevel, passed, chash): i64 {
    var e = audit_event_new(AUDIT_ARTIFACT_VERIFIED);
    ae_set_path(e, path);
    ae_set_artifact_type(e, atype);
    ae_set_trust_level(e, tlevel);
    ae_set_passed(e, passed);
    ae_set_content_hash(e, chash);
    return e;
}

# Builds an AUDIT_ARTIFACT_SIGNED event recording `path`, ArtifactType `atype`, signer
# `key_id` and content hash `chash`. Returns the event (fl_alloc, via audit_event_new).
fn audit_artifact_signed(path, atype, key_id, chash): i64 {
    var e = audit_event_new(AUDIT_ARTIFACT_SIGNED);
    ae_set_path(e, path);
    ae_set_artifact_type(e, atype);
    ae_set_key_id(e, key_id);
    ae_set_content_hash(e, chash);
    return e;
}

# Builds an AUDIT_REVOCATION_ADDED event for the revoked `key_id` and/or content hash
# `chash` (either may be 0), recording `reason` (a C-string, 0 = none; stored by pointer).
# Returns the event (fl_alloc, via audit_event_new).
fn audit_revocation_added(key_id, chash, reason): i64 {
    var e = audit_event_new(AUDIT_REVOCATION_ADDED);
    ae_set_key_id(e, key_id);
    ae_set_content_hash(e, chash);
    ae_set_reason(e, reason);
    return e;
}

# Builds an AUDIT_KEY_ROTATED event: `old_kid` goes in key_id and `new_kid` is stored in the
# content_hash field. Returns the event (fl_alloc, via audit_event_new).
fn audit_key_rotated(old_kid, new_kid): i64 {
    var e = audit_event_new(AUDIT_KEY_ROTATED);
    ae_set_key_id(e, old_kid);
    ae_set_content_hash(e, new_kid);  # reuse field for new key id
    return e;
}

# ================================================================
# AuditLog (8 bytes)
# ================================================================
# Layout:
#   +0   events  (vec of AuditEvent ptrs)

# Allocates an 8-byte AuditLog (fl_alloc) holding an empty event vec. Returns the pointer.
fn audit_log_new(): i64 {
    var log = fl_alloc(8);
    store64(log, vec_new());
    return log;
}

# Appends AuditEvent `event` to `log` (the pointer is kept, not copied); returns `log`.
# Not thread-safe: vec_push updates the vec's len/data (and may grow it) without a lock.
fn alog_record(log, event): i64 {
    vec_push(load64(log), event);
    return log;
}

# Returns the live vec of AuditEvent pointers held by `log` (not a copy).
fn alog_events(log): i64 { return load64(log); }
# Returns the number of events recorded in `log`.
fn alog_len(log): i64 { return vec_len(load64(log)); }
# Returns 1 if `log` holds no events, else 0.
fn alog_is_empty(log): i64 { if (alog_len(log) == 0) { return 1; } return 0; }

# Empties `log` by swapping in a fresh vec; the old vec and its events are not freed, so a
# vec obtained earlier from alog_events keeps its contents. Returns `log`.
fn alog_clear(log): i64 {
    store64(log, vec_new());
    return log;
}

# Append audit events to file (one JSON line per event).
# Renamed from alog_append_to_file in 3.0 to match the rl_save /
# crl_save / sv_save_trust_store vocabulary. Still O_APPEND under
# the hood — the name reflects the contract (persist to disk),
# not the write mode.
#
# 3.13.0 (H3): every string field (path / key_id / content_hash) is JSON-escaped with the
# trust.cyr json_write_escaped set (`"`, `\`, control bytes; \u00XX for those without a
# short form), which alog_load's _rj_parse_string decodes back byte-for-byte, so a crafted
# path can no longer inject a forged event line. Each line is built in a per-event fl_alloc
# buffer sized from the escaped field lengths (was a fixed alloc(512) that a long field
# overflowed, and that leaked 512 B per event) and still goes out in ONE write, so two
# O_APPEND writers cannot interleave inside a line. Ordinary fields serialize unchanged.
fn alog_save(log, path): i64 {
    # 3.13.0: named per-target flags, not the x86_64-Linux literal 1089. On Darwin 1089 is
    # O_WRONLY|O_ASYNC|O_TRUNC — no O_CREAT and no O_APPEND — so every save TRUNCATED the
    # journal (and failed outright if it did not exist yet).
    var fd = file_open(path, O_WRONLY | O_CREAT | O_APPEND, 420);  # 0644
    if (fd < 0) { return SIGIL_ERR_IO; }
    var events = load64(log);
    var elen = vec_len(events);
    var i = 0;
    while (i < elen) {
        var e = vec_get(events, i);
        var tname = audit_event_name(ae_type(e));
        # Upper bound: the fixed keys and punctuation (80 B), a <= 20-digit timestamp, the
        # type name, and each string field at its escaped length.
        var cap = 128 + strlen(tname);
        if (ae_path(e) != 0) { cap = cap + _alog_esc_len(ae_path(e)); }
        if (ae_key_id(e) != 0) { cap = cap + _alog_esc_len(ae_key_id(e)); }
        if (ae_content_hash(e) != 0) { cap = cap + _alog_esc_len(ae_content_hash(e)); }
        if (ae_reason(e) != 0) { cap = cap + 16 + _alog_esc_len(ae_reason(e)); }
        var line = fl_alloc(cap);
        if (line == 0) { file_close(fd); return SIGIL_ERR_IO; }
        # Simple JSON line: {"type":"...","timestamp":...}
        var pos = 0;
        pos = pos + _alog_write_str(line + pos, "{\"type\":\"");
        pos = pos + _alog_write_str(line + pos, tname);
        pos = pos + _alog_write_str(line + pos, "\",\"timestamp\":");
        pos = pos + _alog_write_int(line + pos, ae_timestamp(e));
        if (ae_path(e) != 0) {
            pos = pos + _alog_write_str(line + pos, ",\"path\":\"");
            pos = pos + _alog_write_esc(line + pos, ae_path(e));
            pos = pos + _alog_write_str(line + pos, "\"");
        }
        if (ae_key_id(e) != 0) {
            pos = pos + _alog_write_str(line + pos, ",\"key_id\":\"");
            pos = pos + _alog_write_esc(line + pos, ae_key_id(e));
            pos = pos + _alog_write_str(line + pos, "\"");
        }
        if (ae_content_hash(e) != 0) {
            pos = pos + _alog_write_str(line + pos, ",\"content_hash\":\"");
            pos = pos + _alog_write_esc(line + pos, ae_content_hash(e));
            pos = pos + _alog_write_str(line + pos, "\"");
        }
        if (ae_reason(e) != 0) {
            pos = pos + _alog_write_str(line + pos, ",\"reason\":\"");
            pos = pos + _alog_write_esc(line + pos, ae_reason(e));
            pos = pos + _alog_write_str(line + pos, "\"");
        }
        if (ae_passed(e) != (0 - 1)) {
            pos = pos + _alog_write_str(line + pos, ",\"passed\":");
            if (ae_passed(e) == 1) { pos = pos + _alog_write_str(line + pos, "true"); }
            else { pos = pos + _alog_write_str(line + pos, "false"); }
        }
        pos = pos + _alog_write_str(line + pos, "}\n");
        # 3.13.1: a failed or short write is an error (was ignored, and success returned).
        var w = file_write(fd, line, pos);
        fl_free(line);
        if (w != pos) { file_close(fd); return SIGIL_ERR_IO; }
        i = i + 1;
    }
    file_close(fd);
    return SIGIL_ERR_NONE;
}

fn _alog_write_str(dst, src): i64 {
    var len = strlen(src);
    memcpy(dst, src, len);
    return len;
}

# The short escape letter for byte `c` inside a JSON string ('"', '\\', b t n f r), 0 if
# `c` has none. Same set and spelling as trust.cyr json_write_escaped.
fn _alog_esc_short(c): i64 {
    if (c == 34) { return 34; }
    if (c == 92) { return 92; }
    if (c == 8) { return 98; }
    if (c == 9) { return 116; }
    if (c == 10) { return 110; }
    if (c == 12) { return 102; }
    if (c == 13) { return 114; }
    return 0;
}

# Byte length of C-string `s` once JSON-escaped by _alog_write_esc: 2 for a short escape,
# 6 for any other control byte (\u00xx), 1 otherwise.
fn _alog_esc_len(s): i64 {
    var n = 0;
    var i = 0;
    var c = load8(s) & 0xFF;
    while (c != 0) {
        if (_alog_esc_short(c) != 0) { n = n + 2; }
        elif (c < 32) { n = n + 6; }
        else { n = n + 1; }
        i = i + 1;
        c = load8(s + i) & 0xFF;
    }
    return n;
}

# Writes C-string `s` JSON-escaped to `dst` (no quotes, no NUL): `"` `\` and the control
# bytes b t n f r as two-byte escapes, every other byte < 0x20 as \u00xx, all bytes >= 0x20
# (UTF-8 included) verbatim. Returns the byte count, which equals _alog_esc_len(s).
fn _alog_write_esc(dst, s): i64 {
    var w = 0;
    var i = 0;
    var c = load8(s) & 0xFF;
    while (c != 0) {
        var sc = _alog_esc_short(c);
        if (sc != 0) {
            store8(dst + w, 92);
            store8(dst + w + 1, sc);
            w = w + 2;
        } elif (c < 32) {
            store8(dst + w, 92);
            store8(dst + w + 1, 117);   # u
            store8(dst + w + 2, 48);
            store8(dst + w + 3, 48);
            store8(dst + w + 4, 48 + ((c >> 4) & 0xF));   # high nibble is 0 or 1
            var lo = c & 0xF;
            if (lo < 10) { store8(dst + w + 5, 48 + lo); }
            else { store8(dst + w + 5, 87 + lo); }
            w = w + 6;
        } else {
            store8(dst + w, c);
            w = w + 1;
        }
        i = i + 1;
        c = load8(s + i) & 0xFF;
    }
    return w;
}

# ================================================================
# alog_load(log, path) — inverse of alog_save. Renamed from
# alog_load_from_file in 3.0.
#
# Reads JSONL (one event per line) from `path`, parses each line
# as a flat JSON object, and pushes an AuditEvent into `log`. Lines
# with an unknown `type` are skipped — forensic replay must not
# abort on an unknown event that a newer writer produced.
#
# Reuses `_rj_parse_string` / `_rj_parse_int` from policy.cyr (same
# compilation unit) for escape-aware string decoding, matching the
# escapes alog_save's _alog_write_esc emits.
#
# Returns the number of events loaded, or -1 on IO failure.
# ================================================================

fn _alog_parse_one_line(log, line, llen): i64 {
    var rjb[32];
    memset(&rjb, 0, 32);
    var rj = &rjb;
    var reason = 0;
    var etype = 0 - 1;
    var apath = 0;
    var kid = 0;
    var chash = 0;
    var passed = 0 - 1;
    var ts = 0;

    var pos = 0;
    while (pos < llen) {
        var c = load8(line + pos) & 0xFF;
        if (c != 34) { pos = pos + 1; }
        else {
            pos = _rj_parse_string(rj, line, pos, llen);
            var k = load64(rj);
            if (k == 0) { break; }
            # Skip to colon
            while (pos < llen) {
                if ((load8(line + pos) & 0xFF) == 58) { pos = pos + 1; break; }
                pos = pos + 1;
            }
            # Skip whitespace
            while (pos < llen) {
                var ws = load8(line + pos) & 0xFF;
                if (ws == 32) { pos = pos + 1; }
                elif (ws == 9) { pos = pos + 1; }
                else { break; }
            }
            if (pos >= llen) { break; }
            var vc = load8(line + pos) & 0xFF;
            if (vc == 34) {
                pos = _rj_parse_string(rj, line, pos, llen);
                var v = load64(rj);
                if (streq(k, "type") == 1) { etype = audit_event_type_from_name(v); }
                elif (streq(k, "path") == 1) { apath = v; }
                elif (streq(k, "key_id") == 1) { kid = v; }
                elif (streq(k, "content_hash") == 1) { chash = v; }
                elif (streq(k, "reason") == 1) { reason = v; }
            } elif (streq(k, "timestamp") == 1) {
                # Strict signed integer (3.13.1: a negative timestamp used to be written as
                # an empty value and read back as 0).
                var tp = _rj_parse_int(rj, line, pos, llen);
                if (tp < 0) { return 0; }
                ts = load64(rj + 24);
                pos = tp;
            } else {
                # Literal: true / false / number
                var vs = pos;
                while (pos < llen) {
                    var vcc = load8(line + pos) & 0xFF;
                    if (vcc == 44) { break; }
                    if (vcc == 125) { break; }
                    if (vcc == 32) { break; }
                    if (vcc == 10) { break; }
                    pos = pos + 1;
                }
                var vlen = pos - vs;
                if (vlen > 0) {
                    var fb = load8(line + vs) & 0xFF;
                    if (fb == 116) {
                        # "true"
                        if (streq(k, "passed") == 1) { passed = 1; }
                    } elif (fb == 102) {
                        # "false"
                        if (streq(k, "passed") == 1) { passed = 0; }
                    }
                }
            }
        }
    }

    if (etype < 0) { return 0; }   # unknown event type; skip

    var e = audit_event_new(etype);
    if (apath != 0) { ae_set_path(e, apath); }
    if (kid != 0) { ae_set_key_id(e, kid); }
    if (chash != 0) { ae_set_content_hash(e, chash); }
    if (reason != 0) { ae_set_reason(e, reason); }
    if (passed != (0 - 1)) { ae_set_passed(e, passed); }
    store64(e + 56, ts);    # timestamp
    alog_record(log, e);
    return 1;
}

# 1 if bytes 0 through `llen`-1 of `line` hold one complete JSON object: after optional
# leading space / tab / CR the first byte is '{', every string literal is closed (a
# backslash escapes the next byte), and the last byte outside a string, ignoring trailing
# space / tab / CR, is '}'; and exactly one '{' and one '}' occur outside strings (events
# are flat objects). 0 otherwise, e.g. a line torn by a crash mid-append — including a torn
# fragment that a later append completed into one merged line (3.13.1: such a line passed,
# and loaded as one made-up event while the real event was lost).
fn _alog_line_complete(line, llen): i64 {
    var i = 0;
    while (i < llen) {
        var lc = load8(line + i) & 0xFF;
        if (lc == 32) { i = i + 1; }
        elif (lc == 9) { i = i + 1; }
        elif (lc == 13) { i = i + 1; }
        else { break; }
    }
    if (i >= llen) { return 0; }
    if ((load8(line + i) & 0xFF) != 123) { return 0; }   # {
    var in_str = 0;
    var last = 0;
    var opens = 0;
    var closes = 0;
    while (i < llen) {
        var c = load8(line + i) & 0xFF;
        if (in_str == 1) {
            if (c == 92) {
                if (i + 1 >= llen) { return 0; }   # escape runs off the end
                i = i + 2;
            } else {
                if (c == 34) { in_str = 0; last = 34; }
                i = i + 1;
            }
        } else {
            if (c == 34) { in_str = 1; }
            if (c == 123) { opens = opens + 1; }
            if (c == 125) { closes = closes + 1; }
            if (c != 32) { if (c != 9) { if (c != 13) { last = c; } } }
            i = i + 1;
        }
    }
    if (in_str == 1) { return 0; }
    if (last != 125) { return 0; }   # }
    if (opens != 1) { return 0; }
    if (closes != 1) { return 0; }
    return 1;
}

# Appends the events in the JSONL journal at `path` to `log` (format notes in the alog_load
# block above). Reads the WHOLE file (3.13.0, H6: was silently capped at the first 64 KiB)
# up to RJ_MAX_FILE_BYTES — a larger file is an error, not truncated — into a buffer freed
# once parsed (3.13.1).
# A line that is not one complete JSON object (a torn final append, an unterminated string)
# is skipped rather than loaded as a partial event. Returns the number of events appended,
# or -1 if the file cannot be opened or read.
fn alog_load(log, path): i64 {
    var n = 0;
    var buf = _rj_read_file(path, &n);
    if (buf == 0) { return (0 - 1); }
    var loaded = 0;
    var pos = 0;
    while (pos < n) {
        var start = pos;
        while (pos < n) {
            if ((load8(buf + pos) & 0xFF) == 10) { break; }
            pos = pos + 1;
        }
        var llen = pos - start;
        if (_alog_line_complete(buf + start, llen) == 1) {
            if (_alog_parse_one_line(log, buf + start, llen) == 1) {
                loaded = loaded + 1;
            }
        }
        if (pos < n) { pos = pos + 1; }   # skip '\n'
    }
    fl_free(buf);
    return loaded;
}

# Writes `val` in decimal (with a leading '-' when negative; i64 min included) to `dst`;
# returns the byte count. 3.13.1: the digits are built in a per-call stack buffer (was one
# module-global buffer, racing concurrent alog_save calls), and a negative value is written
# (it used to come out empty, leaving `"timestamp":,` in the line).
fn _alog_write_int(dst, val): i64 {
    var ib[24];
    var v = val;
    var pos = 23;
    if (v == 0) {
        store8(&ib + pos, 48);
        pos = pos - 1;
    }
    # Digits of a negative value come from the negative remainder, so i64 min needs no
    # negation (division truncates toward zero).
    while (v != 0) {
        var d = v % 10;
        if (d < 0) { d = 0 - d; }
        store8(&ib + pos, 48 + d);
        v = v / 10;
        pos = pos - 1;
    }
    if (val < 0) {
        store8(&ib + pos, 45);   # -
        pos = pos - 1;
    }
    pos = pos + 1;
    var len = 24 - pos;
    memcpy(dst, &ib + pos, len);
    return len;
}
