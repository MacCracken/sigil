# policy.cyr — revocation list management

# ================================================================
# RevocationEntry (48 bytes)
# ================================================================
# Layout:
#   +0   key_id        (C-string ptr, 0 = none)
#   +8   content_hash  (C-string ptr, 0 = none)
#   +16  reason        (C-string ptr)
#   +24  revoked_at    (epoch seconds)
#   +32  revoked_by    (C-string ptr)
#   +40  revoked_after (epoch seconds, 0 = unconditional)

# Allocates a 48-byte RevocationEntry (fl_alloc) revoking key `key_id` and/or artifact
# `content_hash` (either may be 0, not both: rl_add rejects that), with revoked_at = now and
# revoked_after = 0 (unconditional). Strings are stored by pointer, not copied; `reason` and
# `revoked_by` must be non-null for the JSONL writers. Returns the pointer.
fn revocation_entry_new(key_id, content_hash, reason, revoked_by): i64 {
    var e = fl_alloc(48);
    store64(e, key_id);
    store64(e + 8, content_hash);
    store64(e + 16, reason);
    store64(e + 24, clock_epoch_secs());
    store64(e + 32, revoked_by);
    store64(e + 40, 0);
    return e;
}

# Returns the revoked key-id C-string of entry `e` (0 = the entry revokes no key).
fn rev_key_id(e): i64 { return load64(e); }
# Returns the revoked content-hash C-string of entry `e` (0 = the entry revokes no artifact).
fn rev_content_hash(e): i64 { return load64(e + 8); }
# Returns the revocation-reason C-string of entry `e`.
fn rev_reason(e): i64 { return load64(e + 16); }
# Returns the revoked_at time of entry `e` (epoch seconds, when the revocation was recorded).
fn rev_at(e): i64 { return load64(e + 24); }
# Returns the revoked-by C-string (who issued the revocation) of entry `e`.
fn rev_by(e): i64 { return load64(e + 32); }
# Returns revoked_after of entry `e` (epoch seconds; 0 = unconditional). Timed queries
# (rl_is_*_revoked_at with `at` != 0) apply the entry only when `at` >= this; untimed
# queries (`at` = 0, rl_is_key_revoked, rl_is_artifact_revoked) always apply it.
fn rev_after(e): i64 { return load64(e + 40); }
# Sets revoked_after of entry `e` to `v` (epoch seconds, 0 = unconditional); returns `e`.
fn rev_set_after(e, v): i64 { store64(e + 40, v); return e; }

# ================================================================
# RevocationList (24 bytes)
# ================================================================
# Layout:
#   +0   entries       (vec of RevocationEntry ptrs)
#   +8   revoked_keys  (hashmap key_id -> 1)
#   +16  revoked_hashes (hashmap content_hash -> 1)

# Allocates an empty 24-byte RevocationList (fl_alloc): an entry vec plus key-id and
# content-hash lookup maps. Returns the pointer.
fn revocation_list_new(): i64 {
    var rl = fl_alloc(24);
    store64(rl, vec_new());
    store64(rl + 8, map_new());
    store64(rl + 16, map_new());
    return rl;
}

# Appends `entry` to `rl` and indexes its key ID and/or content hash (by pointer). Returns
# SIGIL_ERR_NONE, or SIGIL_ERR_INVALID_INPUT (nothing added) if the entry names neither.
# No duplicate check (rl_merge dedupes).
fn rl_add(rl, entry): i64 {
    var kid = load64(entry);
    var chash = load64(entry + 8);
    if (kid == 0) {
        if (chash == 0) { return SIGIL_ERR_INVALID_INPUT; }
    }
    if (kid != 0) {
        map_set(load64(rl + 8), kid, 1);
    }
    if (chash != 0) {
        map_set(load64(rl + 16), chash, 1);
    }
    vec_push(load64(rl), entry);
    return SIGIL_ERR_NONE;
}

# Returns 1 if `rl` holds any revocation entry for `key_id`, else 0. Untimed: revoked_after
# is ignored, so a conditional entry counts even before it takes effect.
fn rl_is_key_revoked(rl, key_id): i64 {
    return rl_is_key_revoked_at(rl, key_id, 0);
}

# Returns 1 if `key_id` is revoked as of epoch time `at` (some entry for it has revoked_after
# 0 = unconditional, or revoked_after <= `at`), else 0. `at` = 0 is untimed: any entry counts.
fn rl_is_key_revoked_at(rl, key_id, at): i64 {
    var keys = load64(rl + 8);
    if (map_get(keys, key_id) == 0) { return 0; }
    if (at == 0) { return 1; }
    # Check entries for revoked_after semantics
    var entries = load64(rl);
    var elen = vec_len(entries);
    var i = 0;
    while (i < elen) {
        var e = vec_get(entries, i);
        var ekid = load64(e);
        if (ekid != 0) {
            if (streq(ekid, key_id) == 1) {
                var after = load64(e + 40);
                if (after == 0) { return 1; }
                if (at >= after) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Returns 1 if `rl` holds any revocation entry for `content_hash`, else 0. Untimed, like
# rl_is_key_revoked: revoked_after is ignored.
fn rl_is_artifact_revoked(rl, content_hash): i64 {
    return rl_is_artifact_revoked_at(rl, content_hash, 0);
}

# Returns 1 if `content_hash` is revoked as of epoch time `at` (some entry for it has
# revoked_after 0 = unconditional, or revoked_after <= `at`), else 0. `at` = 0 is untimed.
fn rl_is_artifact_revoked_at(rl, content_hash, at): i64 {
    var hashes = load64(rl + 16);
    if (map_get(hashes, content_hash) == 0) { return 0; }
    if (at == 0) { return 1; }
    var entries = load64(rl);
    var elen = vec_len(entries);
    var i = 0;
    while (i < elen) {
        var e = vec_get(entries, i);
        var ehash = load64(e + 8);
        if (ehash != 0) {
            if (streq(ehash, content_hash) == 1) {
                var after = load64(e + 40);
                if (after == 0) { return 1; }
                if (at >= after) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Returns the number of entries in `rl` (not the number of distinct keys or hashes).
fn rl_len(rl): i64 { return vec_len(load64(rl)); }
# Returns 1 if `rl` has no entries, else 0.
fn rl_is_empty(rl): i64 { if (rl_len(rl) == 0) { return 1; } return 0; }

# Adds each entry of `other` not already in `rl` (via rl_add, shared by pointer); returns
# the count added. Duplicate = same key ID, content hash (0 matches 0) AND revoked_after, so
# a same-target entry with a different cutoff — e.g. an unconditional revocation next to a
# conditional one — is added (3.13.1; revoked_after was not compared, so the _at queries
# could miss the earlier cutoff).
fn rl_merge(rl, other): i64 {
    var other_entries = load64(other);
    var olen = vec_len(other_entries);
    var added = 0;
    var i = 0;
    while (i < olen) {
        var e = vec_get(other_entries, i);
        # Check for duplicate
        var dup = 0;
        var our_entries = load64(rl);
        var ulen = vec_len(our_entries);
        var j = 0;
        while (j < ulen) {
            var oe = vec_get(our_entries, j);
            var kid_match = 0;
            var hash_match = 0;
            if (load64(e) == 0) { if (load64(oe) == 0) { kid_match = 1; } }
            else { if (load64(oe) != 0) { if (streq(load64(e), load64(oe)) == 1) { kid_match = 1; } } }
            if (load64(e + 8) == 0) { if (load64(oe + 8) == 0) { hash_match = 1; } }
            else { if (load64(oe + 8) != 0) { if (streq(load64(e + 8), load64(oe + 8)) == 1) { hash_match = 1; } } }
            if (kid_match == 1) {
                if (hash_match == 1) {
                    if (load64(e + 40) == load64(oe + 40)) { dup = 1; }
                }
            }
            j = j + 1;
        }
        if (dup == 0) {
            rl_add(rl, e);
            added = added + 1;
        }
        i = i + 1;
    }
    return added;
}

# ================================================================
# CRL — Certificate Revocation List (40 bytes)
# ================================================================
# Layout:
#   +0   version     (i64)
#   +8   issuer      (C-string ptr)
#   +16  issued_at   (epoch seconds)
#   +24  next_update (epoch seconds, 0 = none)
#   +32  entries     (vec of RevocationEntry ptrs)

# Allocates a 40-byte Crl (fl_alloc) with `version` and `issuer` (non-null C-string, stored
# by pointer), issued_at = now, no next_update (0) and an empty entry vec. Returns the pointer.
fn crl_new(version, issuer): i64 {
    var c = fl_alloc(40);
    store64(c, version);
    store64(c + 8, issuer);
    store64(c + 16, clock_epoch_secs());
    store64(c + 24, 0);
    store64(c + 32, vec_new());
    return c;
}

# Returns the version number of CRL `c`.
fn crl_version(c): i64 { return load64(c); }
# Returns the issuer C-string of CRL `c`.
fn crl_issuer(c): i64 { return load64(c + 8); }
# Returns the issued_at time of CRL `c` (epoch seconds).
fn crl_issued_at(c): i64 { return load64(c + 16); }
# Returns the next_update time of CRL `c` (epoch seconds; 0 = none).
fn crl_next_update(c): i64 { return load64(c + 24); }
# Returns the CRL's own vec of RevocationEntry pointers (the live vec, not a copy).
fn crl_entries(c): i64 { return load64(c + 32); }

# Sets the next_update time of CRL `c` to `v` (epoch seconds, 0 = none); returns `c`.
fn crl_set_next_update(c, v): i64 { store64(c + 24, v); return c; }

# Appends `entry` to CRL `c` by pointer, unvalidated (rl_add vets it when the CRL is
# applied with crl_apply_to). Returns `c`.
fn crl_add_entry(c, entry): i64 {
    vec_push(load64(c + 32), entry);
    return c;
}

# Returns 1 if CRL `c` has a next_update and the current time is past it, else 0 (a CRL
# with no next_update is never stale).
fn crl_is_stale(c): i64 {
    var next = load64(c + 24);
    if (next == 0) { return 0; }
    if (clock_epoch_secs() > next) { return 1; }
    return 0;
}

# Adds every entry of CRL `c` to revocation list `rl` via rl_add; returns the count
# accepted (entries naming neither key nor hash are rejected). No dedupe or staleness check.
fn crl_apply_to(c, rl): i64 {
    var entries = load64(c + 32);
    var elen = vec_len(entries);
    var added = 0;
    var i = 0;
    while (i < elen) {
        var e = vec_get(entries, i);
        var result = rl_add(rl, e);
        if (result == SIGIL_ERR_NONE) { added = added + 1; }
        i = i + 1;
    }
    return added;
}

# ================================================================
# JSON Lines serialization (RevocationEntry, RevocationList, Crl)
#
# Deliberate format choice: one JSON object per line, newline-
# separated. Cyrius' lib/json.cyr parses a single object at a time
# and has no array support, so JSONL is the cleanest round-trip
# format and matches `alog_save`.  Rust's `to_json()`
# produced a JSON array; JSONL is trivially convertible with
# `jq -s`.
#
# Null fields use JSON `null` (no quotes). Parsing treats `null`,
# empty, and missing fields as 0 (C-string null ptr).
# ================================================================

# Internal: emit one entry as a JSONL line into a str_builder.
fn _rev_entry_to_jsonl(sb, e): i64 {
    str_builder_add_cstr(sb, "{\"key_id\":");
    if (rev_key_id(e) != 0) {
        str_builder_add_cstr(sb, "\"");
        _json_escape_cstr(sb, rev_key_id(e));
        str_builder_add_cstr(sb, "\"");
    } else {
        str_builder_add_cstr(sb, "null");
    }
    str_builder_add_cstr(sb, ",\"content_hash\":");
    if (rev_content_hash(e) != 0) {
        str_builder_add_cstr(sb, "\"");
        _json_escape_cstr(sb, rev_content_hash(e));
        str_builder_add_cstr(sb, "\"");
    } else {
        str_builder_add_cstr(sb, "null");
    }
    str_builder_add_cstr(sb, ",\"reason\":\"");
    _json_escape_cstr(sb, rev_reason(e));
    str_builder_add_cstr(sb, "\",\"revoked_at\":");
    str_builder_add_int(sb, rev_at(e));
    str_builder_add_cstr(sb, ",\"revoked_by\":\"");
    _json_escape_cstr(sb, rev_by(e));
    str_builder_add_cstr(sb, "\",\"revoked_after\":");
    str_builder_add_int(sb, rev_after(e));
    str_builder_add_cstr(sb, "}\n");
    return 0;
}

# Serialize a RevocationList to a JSONL C-string. Caller owns the
# returned pointer (alloc'd). Returns 0 on OOM (not expected).
fn rl_to_jsonl(rl): i64 {
    var sb = str_builder_new();
    var entries = load64(rl);
    var elen = vec_len(entries);
    var i = 0;
    while (i < elen) {
        _rev_entry_to_jsonl(sb, vec_get(entries, i));
        i = i + 1;
    }
    # Return C-string: copy builder's underlying buf + terminator.
    var total = load64(sb + 8);
    var out = alloc(total + 1);
    memcpy(out, load64(sb), total);
    store8(out + total, 0);
    return out;
}

# Parser state for the _rj_* JSON helpers lives in a 32-byte context the CALLER owns (a
# stack `var rjb[32]` per parse), not in module globals, so concurrent parses cannot
# overwrite each other's results (3.13.1; through 3.13.0 these were globals):
#   rj+0   the string the last _rj_parse_string produced (fresh alloc'd C-string, or 0)
#   rj+8   1 if that string's closing quote was found (a line cut mid-string must be
#          rejected, not loaded with a truncated value), else 0
#   rj+16  1 if the last _rj_member_end / _rj_object_open reached the object's '}'
#   rj+24  the value of the last successful _rj_parse_int

# Internal: parse the quoted value at data[pos] (the opening quote). Returns the offset
# just past the closing quote. Writes a fresh C-string copy of the contents to rj+0; sets
# rj+0 to 0 and returns pos unchanged if data[pos] is not a quote. Never reads at or past
# `end`: a backslash that is the last byte ends the scan with the string unclosed.
fn _rj_parse_string(rj, data, pos, end): i64 {
    store64(rj, 0);
    store64(rj + 8, 0);
    if (pos >= end) { return pos; }
    if ((load8(data + pos) & 0xFF) != 34) { return pos; }
    pos = pos + 1;
    # First pass: find closing quote, handling escapes (\" and \\)
    # so an embedded quote does not end the string prematurely.
    var start = pos;
    while (pos < end) {
        var c = load8(data + pos) & 0xFF;
        if (c == 92) {
            # Escape sequence — skip the next char (it's part of the value). A backslash
            # as the last byte has no next char: stop at `end` (3.13.1 — this read one byte
            # past `end`).
            if (pos + 1 >= end) { pos = end; break; }
            pos = pos + 2;
        } elif (c == 34) {
            break;
        } else {
            pos = pos + 1;
        }
    }
    # Second pass: copy content, unescaping \x → x for \" \\ \n \r \t \b \f.
    # \uXXXX is rejected as non-ASCII.  #skip-lint: \u-escape notation, not a deferral
    # (The caller's writer only emits control chars as \uNNNN for bytes < 32;
    # we decode those back to the raw byte.)
    var raw_len = pos - start;
    var out = alloc(raw_len + 1);
    var w = 0;
    var r = 0;
    while (r < raw_len) {
        var c = load8(data + start + r) & 0xFF;
        if (c == 92) {
            r = r + 1;
            if (r >= raw_len) { break; }
            var ec = load8(data + start + r) & 0xFF;
            if (ec == 110) { store8(out + w, 10); }     # \n
            elif (ec == 114) { store8(out + w, 13); }   # \r
            elif (ec == 116) { store8(out + w, 9); }    # \t
            elif (ec == 98)  { store8(out + w, 8); }    # \b
            elif (ec == 102) { store8(out + w, 12); }   # \f
            elif (ec == 117) {
                # \uXXXX — read 4 hex digits, emit as byte if ≤ 0xFF  #skip-lint: \u-escape notation, not a deferral
                if (r + 4 < raw_len) {
                    var v = 0;
                    var k = 1;
                    while (k <= 4) {
                        var h = load8(data + start + r + k) & 0xFF;
                        var d = 0;
                        if (h >= 48) { if (h <= 57) { d = h - 48; } }
                        if (h >= 97) { if (h <= 102) { d = h - 87; } }
                        if (h >= 65) { if (h <= 70)  { d = h - 55; } }
                        v = (v << 4) | d;
                        k = k + 1;
                    }
                    store8(out + w, v & 0xFF);
                    r = r + 4;
                }
            } else {
                # \" \\ / and any other → pass through the second char.
                store8(out + w, ec);
            }
            r = r + 1;
            w = w + 1;
        } else {
            store8(out + w, c);
            r = r + 1;
            w = w + 1;
        }
    }
    store8(out + w, 0);
    store64(rj, out);
    if (pos < end) { pos = pos + 1; store64(rj + 8, 1); }   # skip closing quote
    return pos;
}

# Internal: 1 if byte `c` is JSON whitespace (space, tab, LF, CR), else 0.
fn _rj_is_ws(c): i64 {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    if (c == 10) { return 1; }
    if (c == 13) { return 1; }
    return 0;
}

# Internal: returns the first offset >= `pos` in data[..end) that is not JSON whitespace.
fn _rj_skip_ws(data, pos, end): i64 {
    while (pos < end) {
        if (_rj_is_ws(load8(data + pos) & 0xFF) == 0) { return pos; }
        pos = pos + 1;
    }
    return pos;
}

# Internal: offset just past the JSON literal `lit` (a C-string) at data[pos], or -1 if the
# bytes there differ or run past `end`.
fn _rj_match_lit(data, pos, end, lit): i64 {
    var n = strlen(lit);
    if (pos + n > end) { return 0 - 1; }
    var i = 0;
    while (i < n) {
        if ((load8(data + pos + i) & 0xFF) != (load8(lit + i) & 0xFF)) { return 0 - 1; }
        i = i + 1;
    }
    return pos + n;
}

# Internal: offset of the next member key after the value ending at `pos` — skips JSON
# whitespace, then either ',' (plus whitespace; the key's '"' is checked by the caller) or
# the object's closing '}'. Returns -1 on anything else. On '}' sets rj+16 = 1 and
# returns the offset just past it.
fn _rj_member_end(rj, data, pos, end): i64 {
    store64(rj + 16, 0);
    pos = _rj_skip_ws(data, pos, end);
    if (pos >= end) { return 0 - 1; }
    var c = load8(data + pos) & 0xFF;
    if (c == 125) { store64(rj + 16, 1); return pos + 1; }
    if (c != 44) { return 0 - 1; }
    return _rj_skip_ws(data, pos + 1, end);
}

# Internal: offset of the first member key of the one-line JSON object at data[0..end) —
# whitespace, '{', whitespace. Returns -1 if the line does not open an object; sets
# rj+16 = 1 (offset just past '}') for the empty object "{}".
fn _rj_object_open(rj, data, end): i64 {
    store64(rj + 16, 0);
    var pos = _rj_skip_ws(data, 0, end);
    if (pos >= end) { return 0 - 1; }
    if ((load8(data + pos) & 0xFF) != 123) { return 0 - 1; }
    pos = _rj_skip_ws(data, pos + 1, end);
    if (pos < end) {
        if ((load8(data + pos) & 0xFF) == 125) { store64(rj + 16, 1); return pos + 1; }
    }
    return pos;
}

# Internal: 1 if only JSON whitespace follows `pos` in data[..end) (the object was the
# whole line), else 0.
fn _rj_at_line_end(data, pos, end): i64 {
    if (_rj_skip_ws(data, pos, end) == end) { return 1; }
    return 0;
}

# Internal: after a key string ending at `pos`, skips JSON whitespace, requires ':', then
# skips whitespace again. Returns the offset of the value's first byte, or -1 if there is
# no ':' or no value.
fn _rj_expect_colon(data, pos, end): i64 {
    pos = _rj_skip_ws(data, pos, end);
    if (pos >= end) { return 0 - 1; }
    if ((load8(data + pos) & 0xFF) != 58) { return 0 - 1; }
    pos = _rj_skip_ws(data, pos + 1, end);
    if (pos >= end) { return 0 - 1; }
    return pos;
}

# Internal: strict JSON integer starting at data[pos] (leading whitespace skipped). Grammar:
# optional '-', then '0' or a nonzero digit followed by digits; no '+', no leading zeros, no
# fraction or exponent. The number must fit an i64 (overflow is rejected, never wrapped) and
# be followed, after optional whitespace, by ',' or '}'. On success stores the value in
# rj+24 and returns the offset of that ',' / '}'; on any failure returns -1.
fn _rj_parse_int(rj, data, pos, end): i64 {
    store64(rj + 24, 0);
    pos = _rj_skip_ws(data, pos, end);
    if (pos >= end) { return 0 - 1; }
    var neg = 0;
    if ((load8(data + pos) & 0xFF) == 45) { neg = 1; pos = pos + 1; }
    if (pos >= end) { return 0 - 1; }
    # Accumulate as a non-positive value so i64 min is representable. `lim` is the most
    # negative accumulator allowed; the check acc >= (lim + d) / 10 relies on division
    # truncating toward zero (a ceiling for these negative operands).
    var lim = 0 - 9223372036854775807;
    if (neg == 1) { lim = lim - 1; }
    var first = pos;
    var acc = 0;
    while (pos < end) {
        var c = load8(data + pos) & 0xFF;
        if (c < 48) { break; }
        if (c > 57) { break; }
        var d = c - 48;
        if (acc < (lim + d) / 10) { return 0 - 1; }
        acc = acc * 10 - d;
        pos = pos + 1;
    }
    var ndig = pos - first;
    if (ndig == 0) { return 0 - 1; }
    if (ndig > 1) { if ((load8(data + first) & 0xFF) == 48) { return 0 - 1; } }
    pos = _rj_skip_ws(data, pos, end);
    if (pos >= end) { return 0 - 1; }
    var t = load8(data + pos) & 0xFF;
    if (t != 44) { if (t != 125) { return 0 - 1; } }
    if (neg == 1) { store64(rj + 24, acc); }
    else { store64(rj + 24, 0 - acc); }
    return pos;
}

# Internal: skips one scalar JSON value at data[pos] — a closed string, null / true / false,
# or a strict integer (_rj_parse_int) — for a field the caller does not read. Returns the
# offset just past it (for an integer, of the ',' / '}' after it), or -1 if it is none of
# those (nested objects / arrays are not accepted).
fn _rj_skip_value(rj, data, pos, end): i64 {
    if (pos >= end) { return 0 - 1; }
    if ((load8(data + pos) & 0xFF) == 34) {
        pos = _rj_parse_string(rj, data, pos, end);
        if (load64(rj + 8) == 0) { return 0 - 1; }
        return pos;
    }
    var p = _rj_match_lit(data, pos, end, "null");
    if (p >= 0) { return p; }
    p = _rj_match_lit(data, pos, end, "true");
    if (p >= 0) { return p; }
    p = _rj_match_lit(data, pos, end, "false");
    if (p >= 0) { return p; }
    return _rj_parse_int(rj, data, pos, end);
}

# Parse a single JSONL entry line into a fresh RevocationEntry.
# Returns entry ptr, or 0 on malformed input. The line must be exactly one flat JSON object
# ('{' "key": value, ... '}', JSON whitespace allowed between tokens, nothing after the
# '}'), every string closed, and revoked_at / revoked_after strict i64 integers
# (_rj_parse_int). A line cut short (a truncated file's last record) or carrying a junk,
# fractional or overflowing number is therefore rejected, never loaded as an entry.
fn _rev_entry_from_jsonl(line, llen): i64 {
    var rjb[32];
    memset(&rjb, 0, 32);
    var rj = &rjb;
    # Six fields: key_id, content_hash, reason, revoked_at, revoked_by, revoked_after, in
    # any order. key_id / content_hash / reason / revoked_by take a string or null (null =
    # 0 / ""); unknown fields take any scalar and are ignored.
    var key_id = 0;
    var chash = 0;
    var reason = 0;
    var revoked_by = 0;
    var revoked_at = 0;
    var revoked_after = 0;

    var pos = _rj_object_open(rj, line, llen);
    if (pos < 0) { return 0; }
    while (load64(rj + 16) == 0) {
        if (pos >= llen) { return 0; }
        if ((load8(line + pos) & 0xFF) != 34) { return 0; }
        pos = _rj_parse_string(rj, line, pos, llen);
        var k = load64(rj);
        if (load64(rj + 8) == 0) { return 0; }
        pos = _rj_expect_colon(line, pos, llen);
        if (pos < 0) { return 0; }
        if (streq(k, "revoked_at") == 1) {
            pos = _rj_parse_int(rj, line, pos, llen);
            if (pos < 0) { return 0; }
            revoked_at = load64(rj + 24);
        } elif (streq(k, "revoked_after") == 1) {
            pos = _rj_parse_int(rj, line, pos, llen);
            if (pos < 0) { return 0; }
            revoked_after = load64(rj + 24);
        } elif ((load8(line + pos) & 0xFF) == 34) {
            pos = _rj_parse_string(rj, line, pos, llen);
            if (load64(rj + 8) == 0) { return 0; }
            var v = load64(rj);
            if (streq(k, "key_id") == 1) { key_id = v; }
            elif (streq(k, "content_hash") == 1) { chash = v; }
            elif (streq(k, "reason") == 1) { reason = v; }
            elif (streq(k, "revoked_by") == 1) { revoked_by = v; }
        } else {
            pos = _rj_skip_value(rj, line, pos, llen);
            if (pos < 0) { return 0; }
        }
        pos = _rj_member_end(rj, line, pos, llen);
        if (pos < 0) { return 0; }
    }
    if (_rj_at_line_end(line, pos, llen) == 0) { return 0; }

    if (reason == 0) { reason = ""; }
    if (revoked_by == 0) { revoked_by = ""; }
    var e = revocation_entry_new(key_id, chash, reason, revoked_by);
    store64(e + 24, revoked_at);
    store64(e + 40, revoked_after);
    return e;
}

# Load a RevocationList from JSONL content (rl_from_jsonl, below): always a list, never 0.
# Invalid entries in the stream are skipped rather than aborting —
# callers building a fresh list from a third-party CRL should not
# be taken down by a single malformed line — and each rejected line
# is counted, readable through rl_load_bad_count(). Well-formed
# output from our own writer always round-trips cleanly.
var _rl_load_bad = 0;

# Returns how many lines the most recent rl_from_jsonl parse rejected (rl_load parses via
# it). The count is taken per call and published when the parse finishes, so concurrent
# parses cannot corrupt each other's count; this reports the one that finished last.
fn rl_load_bad_count(): i64 { return _rl_load_bad; }

# Parses `content_len` bytes of JSONL into a new RevocationList (one entry per line, empty
# lines skipped). Malformed or rl_add-rejected lines are skipped and counted (see
# rl_load_bad_count). Returns the list, possibly empty.
fn rl_from_jsonl(content, content_len): i64 {
    var bad = 0;
    var rl = revocation_list_new();
    var pos = 0;
    while (pos < content_len) {
        # Find end of line
        var start = pos;
        while (pos < content_len) {
            if ((load8(content + pos) & 0xFF) == 10) { break; }
            pos = pos + 1;
        }
        var llen = pos - start;
        if (llen > 0) {
            var e = _rev_entry_from_jsonl(content + start, llen);
            if (e == 0) { bad = bad + 1; }
            else {
                if (rl_add(rl, e) != SIGIL_ERR_NONE) { bad = bad + 1; }
            }
        }
        if (pos < content_len) { pos = pos + 1; }   # skip '\n'
    }
    _rl_load_bad = bad;
    return rl;
}

# File wrappers — idiomatic "save/load via path" shortcuts.
fn rl_save(rl, path): i64 {
    var jsonl = rl_to_jsonl(rl);
    var n = file_write_all(path, jsonl, strlen(jsonl));
    if (n < 0) { return SIGIL_ERR_IO; }
    return SIGIL_ERR_NONE;
}

# Largest file the JSONL / JSON loaders (rl_load, crl_load, alog_load, sv_load_trust_store)
# read. A larger file is an error, never truncated.
enum RjLimits { RJ_MAX_FILE_BYTES = 67108864; }   # 64 MiB

# Reads the whole file at `path` into a fresh fl_alloc buffer — the caller fl_frees it once
# parsed — and stores its length in *out_len. Returns 0 (length 0) if the file cannot be
# opened or read (a read error is not end-of-file), is larger than RJ_MAX_FILE_BYTES, or
# memory runs out. 3.13.1: the loaders used file_read_whole, whose bump-heap buffer is never
# reclaimed (each load cost ~2x the file size for the life of the process) and had no cap.
fn _rj_read_file(path, out_len): i64 {
    store64(out_len, 0);
    var fd = file_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0; }
    var cap = 4096;
    var buf = fl_alloc(cap + 1);
    if (buf == 0) { file_close(fd); return 0; }
    var total = 0;
    while (1 == 1) {
        if (total == cap) {
            if (cap > RJ_MAX_FILE_BYTES) { fl_free(buf); file_close(fd); return 0; }
            var ncap = cap + cap;
            if (ncap > RJ_MAX_FILE_BYTES) { ncap = RJ_MAX_FILE_BYTES + 1; }
            var nb = fl_alloc(ncap + 1);
            if (nb == 0) { fl_free(buf); file_close(fd); return 0; }
            memcpy(nb, buf, total);
            fl_free(buf);
            buf = nb;
            cap = ncap;
        }
        var n = file_read(fd, buf + total, cap - total);
        if (n < 0) { fl_free(buf); file_close(fd); return 0; }
        if (n == 0) { break; }
        total = total + n;
    }
    file_close(fd);
    if (total > RJ_MAX_FILE_BYTES) { fl_free(buf); return 0; }
    store8(buf + total, 0);
    store64(out_len, total);
    return buf;
}

# Reads the whole file at `path` (up to RJ_MAX_FILE_BYTES; larger is an error, never
# truncated) and parses it with rl_from_jsonl, so a cut or malformed final line is counted
# in rl_load_bad_count, never loaded. Returns the new RevocationList, or 0 if the file cannot
# be opened or read or is too large.
fn rl_load(path): i64 {
    var n = 0;
    var buf = _rj_read_file(path, &n);
    if (buf == 0) { return 0; }
    var rl = rl_from_jsonl(buf, n);
    fl_free(buf);
    return rl;
}

# ================================================================
# Crl JSON Lines — first line is the header, subsequent lines are
# entries in the same format as rl_to_jsonl.
# ================================================================

# Serializes CRL `c` to JSONL: a header line (version, issuer, issued_at, next_update), then
# one line per entry as in rl_to_jsonl. Returns a freshly alloc'd NUL-terminated C-string.
fn crl_to_jsonl(c): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"version\":");
    str_builder_add_int(sb, crl_version(c));
    str_builder_add_cstr(sb, ",\"issuer\":\"");
    _json_escape_cstr(sb, crl_issuer(c));
    str_builder_add_cstr(sb, "\",\"issued_at\":");
    str_builder_add_int(sb, crl_issued_at(c));
    str_builder_add_cstr(sb, ",\"next_update\":");
    str_builder_add_int(sb, crl_next_update(c));
    str_builder_add_cstr(sb, "}\n");
    var entries = crl_entries(c);
    var elen = vec_len(entries);
    var i = 0;
    while (i < elen) {
        _rev_entry_to_jsonl(sb, vec_get(entries, i));
        i = i + 1;
    }
    var total = load64(sb + 8);
    var out = alloc(total + 1);
    memcpy(out, load64(sb), total);
    store8(out + total, 0);
    return out;
}

# Parse the CRL header line. Returns new Crl struct with the entries
# vec initialized empty. Returns 0 on failure: the line must be one flat JSON object (as for
# _rev_entry_from_jsonl), issuer a closed string, and version / issued_at / next_update
# strict i64 integers (_rj_parse_int). Fails closed: a header whose next_update is junk,
# fractional, overflowing, quoted or null yields no CRL at all rather than one that
# crl_is_stale would report fresh. A missing field keeps its default (next_update 0 = none).
fn _crl_parse_header(line, llen): i64 {
    var rjb[32];
    memset(&rjb, 0, 32);
    var rj = &rjb;
    var version = 0;
    var issuer = 0;
    var issued_at = 0;
    var next_update = 0;

    var pos = _rj_object_open(rj, line, llen);
    if (pos < 0) { return 0; }
    while (load64(rj + 16) == 0) {
        if (pos >= llen) { return 0; }
        if ((load8(line + pos) & 0xFF) != 34) { return 0; }
        pos = _rj_parse_string(rj, line, pos, llen);
        var k = load64(rj);
        if (load64(rj + 8) == 0) { return 0; }
        pos = _rj_expect_colon(line, pos, llen);
        if (pos < 0) { return 0; }
        var nf = 0;
        if (streq(k, "version") == 1) { nf = 1; }
        elif (streq(k, "issued_at") == 1) { nf = 2; }
        elif (streq(k, "next_update") == 1) { nf = 3; }
        if (nf != 0) {
            pos = _rj_parse_int(rj, line, pos, llen);
            if (pos < 0) { return 0; }
            if (nf == 1) { version = load64(rj + 24); }
            elif (nf == 2) { issued_at = load64(rj + 24); }
            else { next_update = load64(rj + 24); }
        } elif ((load8(line + pos) & 0xFF) == 34) {
            pos = _rj_parse_string(rj, line, pos, llen);
            if (load64(rj + 8) == 0) { return 0; }
            if (streq(k, "issuer") == 1) { issuer = load64(rj); }
        } else {
            pos = _rj_skip_value(rj, line, pos, llen);
            if (pos < 0) { return 0; }
        }
        pos = _rj_member_end(rj, line, pos, llen);
        if (pos < 0) { return 0; }
    }
    if (_rj_at_line_end(line, pos, llen) == 0) { return 0; }
    if (issuer == 0) { return 0; }
    var c = crl_new(version, issuer);
    store64(c + 16, issued_at);
    store64(c + 24, next_update);
    return c;
}

# Entry lines the most recent crl_from_jsonl rejected; see crl_load_bad_count.
var _crl_load_bad = 0;

# Returns how many entry lines the most recent crl_from_jsonl parse rejected (crl_load parses
# via it) — each is one revocation the CRL meant to carry and the returned Crl lacks. Counted
# per call and published when the parse finishes; 0 when the header itself was rejected.
fn crl_load_bad_count(): i64 { return _crl_load_bad; }

# Parse CRL from JSONL content. First line = header, subsequent lines = revocation entries.
# A malformed entry line is skipped and counted (crl_load_bad_count), not loaded.
fn crl_from_jsonl(content, content_len): i64 {
    _crl_load_bad = 0;
    # Extract first line
    var hend = 0;
    while (hend < content_len) {
        if ((load8(content + hend) & 0xFF) == 10) { break; }
        hend = hend + 1;
    }
    if (hend == 0) { return 0; }
    var c = _crl_parse_header(content, hend);
    if (c == 0) { return 0; }
    var bad = 0;
    # Entries start after the header newline
    var pos = hend + 1;
    while (pos < content_len) {
        var start = pos;
        while (pos < content_len) {
            if ((load8(content + pos) & 0xFF) == 10) { break; }
            pos = pos + 1;
        }
        var llen = pos - start;
        if (llen > 0) {
            var e = _rev_entry_from_jsonl(content + start, llen);
            if (e != 0) { crl_add_entry(c, e); }
            else { bad = bad + 1; }
        }
        if (pos < content_len) { pos = pos + 1; }
    }
    _crl_load_bad = bad;
    return c;
}

# Writes crl_to_jsonl(c) to `path` (created or truncated, mode 0644). Returns SIGIL_ERR_NONE
# or SIGIL_ERR_IO. Not atomic: a failed write can leave `path` truncated.
fn crl_save(c, path): i64 {
    var jsonl = crl_to_jsonl(c);
    var n = file_write_all(path, jsonl, strlen(jsonl));
    if (n < 0) { return SIGIL_ERR_IO; }
    return SIGIL_ERR_NONE;
}

# Reads the whole file at `path` (up to RJ_MAX_FILE_BYTES; larger is an error, never
# truncated) and parses it with crl_from_jsonl. Returns the new Crl, or 0 if the file cannot
# be opened or read, is too large, or its header line is missing, malformed (including an
# unparseable number) or lacks an issuer. Malformed entry lines are skipped and counted in
# crl_load_bad_count.
fn crl_load(path): i64 {
    var n = 0;
    var buf = _rj_read_file(path, &n);
    if (buf == 0) { return 0; }
    var c = crl_from_jsonl(buf, n);
    fl_free(buf);
    return c;
}
