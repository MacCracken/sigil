# mldsa_poly.cyr — poly + polyvec operations for ML-DSA
#
# Thin layer over the reduce + NTT primitives that expresses
# the FIPS 204 signing / verification algorithms as polynomial
# vector arithmetic. The reference is pq-crystals/dilithium
# `ref/poly.c` + `ref/polyvec.c`; API surface and data layout
# match 1:1.
#
# Buffer layout (all heap-allocated by callers):
#   poly         — 256·8 bytes, one i64 per coefficient
#   polyvecl     — L (=5) × 2048 bytes; vec[i] = base + i·2048
#   polyveck     — K (=6) × 2048 bytes; same scheme
#   matrix A     — K · L × 2048 bytes; row i at base + i · L · 2048
#
# Every function here keeps its state in locals and the caller's
# buffers: no module globals, so all of them are reentrant and safe
# to call from concurrent threads. (Before the M11 fix the two hot paths,
# `polyvecl_pointwise_acc_montgomery` and
# `polyvec_matrix_pointwise_montgomery`, kept their loop state and a
# 2 KB scratch poly in module globals — a cc5-era workaround — which
# made concurrent ML-DSA signers corrupt each other's A·y product.)

# ================================================================
# Per-poly operations
# ================================================================

# c = a + b (componentwise, no modular reduction).
# Caller ensures |coeff| stays within a safe range.
fn mldsa_poly_add(c, a, b): i64 {
    var i = 0;
    while (i < 256) {
        store64(c + i * 8, load64(a + i * 8) + load64(b + i * 8));
        i = i + 1;
    }
    return 0;
}

# c = a - b (componentwise, no modular reduction).
fn mldsa_poly_sub(c, a, b): i64 {
    var i = 0;
    while (i < 256) {
        store64(c + i * 8, load64(a + i * 8) - load64(b + i * 8));
        i = i + 1;
    }
    return 0;
}

# Reduce every coefficient to [-6283008, 6283008] via reduce32.
fn mldsa_poly_reduce(a): i64 {
    var i = 0;
    while (i < 256) {
        store64(a + i * 8, mldsa_reduce32(load64(a + i * 8)));
        i = i + 1;
    }
    return 0;
}

# Bring every coefficient into canonical [0, Q) via caddq.
fn mldsa_poly_caddq(a): i64 {
    var i = 0;
    while (i < 256) {
        store64(a + i * 8, mldsa_caddq(load64(a + i * 8)));
        i = i + 1;
    }
    return 0;
}

# a ← a · 2^D  (used by verify to recover c · 2^D · t1). Assumes
# inputs fit in 2^{31-D} in absolute value — not checked.
fn mldsa_poly_shiftl(a): i64 {
    var i = 0;
    while (i < 256) {
        store64(a + i * 8, load64(a + i * 8) << MLDSA_D);
        i = i + 1;
    }
    return 0;
}

# c[i] = montgomery_reduce(a[i] · b[i]).
# Used in NTT domain: multiplies two NTT-form polys and brings
# the product back into a Montgomery-form representation of the
# same length.
fn mldsa_poly_pointwise_montgomery(c, a, b): i64 {
    var i = 0;
    while (i < 256) {
        var prod = load64(a + i * 8) * load64(b + i * 8);
        store64(c + i * 8, mldsa_montgomery_reduce(prod));
        i = i + 1;
    }
    return 0;
}

# Infinity-norm bound check: returns 1 if any |coeff| ≥ B, else 0.
# Early exit on the first violation is OK — the C ref notes the
# probability of each coefficient violating is independent of
# secret data; what must *not* leak is the sign of the violating
# coefficient, which this branchless abs() handles.
# B > (Q-1)/8 auto-fails to catch out-of-range bounds.
fn mldsa_poly_chknorm(a, B): i64 {
    if (B > (MLDSA_Q - 1) / 8) { return 1; }
    var i = 0;
    while (i < 256) {
        var c = load64(a + i * 8);
        # Branchless absolute value: sign_mask is 0 (c≥0) or −1 (c<0).
        var sign_mask = 0 - ((c >> 63) & 1);
        var abs_c = c - (sign_mask & (c + c));
        if (abs_c >= B) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Polyvec L (length L = 5)
# ================================================================

# w[i] = u[i] + v[i] for the L = 5 polys (no modular reduction). Returns 0.
fn mldsa_polyvecl_add(w, u, v): i64 {
    var i = 0;
    while (i < MLDSA65_L) {
        mldsa_poly_add(w + i * 2048, u + i * 2048, v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# reduce32 every coefficient of the L polys in place, to [-6283008, 6283008]. Returns 0.
fn mldsa_polyvecl_reduce(v): i64 {
    var i = 0;
    while (i < MLDSA65_L) {
        mldsa_poly_reduce(v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# Forward NTT (mldsa_ntt) of each of the L polys, in place. Returns 0.
fn mldsa_polyvecl_ntt(v): i64 {
    var i = 0;
    while (i < MLDSA65_L) {
        mldsa_ntt(v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# Inverse NTT times 2^32 (mldsa_invntt_tomont) of each of the L polys, in place. Returns 0.
fn mldsa_polyvecl_invntt_tomont(v): i64 {
    var i = 0;
    while (i < MLDSA65_L) {
        mldsa_invntt_tomont(v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# r[i] = a · v[i] for i in 0..L (scalar-poly × vec).
fn mldsa_polyvecl_pointwise_poly_montgomery(r, a, v): i64 {
    var i = 0;
    while (i < MLDSA65_L) {
        mldsa_poly_pointwise_montgomery(r + i * 2048, a, v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# Returns 1 if any coefficient of the L polys has |c| ≥ bound (or bound > (Q-1)/8), else 0.
# Exits at the first violation; see mldsa_poly_chknorm for why that is acceptable.
fn mldsa_polyvecl_chknorm(v, bound): i64 {
    var i = 0;
    while (i < MLDSA65_L) {
        if (mldsa_poly_chknorm(v + i * 2048, bound) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Polyvec K (length K = 6)
# ================================================================

# w[i] = u[i] + v[i] for the K = 6 polys (no modular reduction). Returns 0.
fn mldsa_polyveck_add(w, u, v): i64 {
    var i = 0;
    while (i < MLDSA65_K) {
        mldsa_poly_add(w + i * 2048, u + i * 2048, v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# w[i] = u[i] - v[i] for the K polys (no modular reduction). Returns 0.
fn mldsa_polyveck_sub(w, u, v): i64 {
    var i = 0;
    while (i < MLDSA65_K) {
        mldsa_poly_sub(w + i * 2048, u + i * 2048, v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# reduce32 every coefficient of the K polys in place, to [-6283008, 6283008]. Returns 0.
fn mldsa_polyveck_reduce(v): i64 {
    var i = 0;
    while (i < MLDSA65_K) {
        mldsa_poly_reduce(v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# caddq every coefficient of the K polys in place: (−Q, Q) → [0, Q). Returns 0.
fn mldsa_polyveck_caddq(v): i64 {
    var i = 0;
    while (i < MLDSA65_K) {
        mldsa_poly_caddq(v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# Multiply every coefficient of the K polys by 2^D (D = 13) in place, unreduced; verify
# uses it for t1 · 2^D. Assumes |coeff| < 2^(31-D), unchecked. Returns 0.
fn mldsa_polyveck_shiftl(v): i64 {
    var i = 0;
    while (i < MLDSA65_K) {
        mldsa_poly_shiftl(v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# Forward NTT (mldsa_ntt) of each of the K polys, in place. Returns 0.
fn mldsa_polyveck_ntt(v): i64 {
    var i = 0;
    while (i < MLDSA65_K) {
        mldsa_ntt(v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# Inverse NTT times 2^32 (mldsa_invntt_tomont) of each of the K polys, in place. Returns 0.
fn mldsa_polyveck_invntt_tomont(v): i64 {
    var i = 0;
    while (i < MLDSA65_K) {
        mldsa_invntt_tomont(v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# r[i] = a · v[i] for i in 0..K (poly × polyveck, pointwise Montgomery in the NTT domain).
# Each coefficient is read before it is written, so `r` may alias `v`. Returns 0.
fn mldsa_polyveck_pointwise_poly_montgomery(r, a, v): i64 {
    var i = 0;
    while (i < MLDSA65_K) {
        mldsa_poly_pointwise_montgomery(r + i * 2048, a, v + i * 2048);
        i = i + 1;
    }
    return 0;
}

# Returns 1 if any coefficient of the K polys has |c| ≥ bound (or bound > (Q-1)/8), else 0.
# Exits at the first violation; see mldsa_poly_chknorm for why that is acceptable.
fn mldsa_polyveck_chknorm(v, bound): i64 {
    var i = 0;
    while (i < MLDSA65_K) {
        if (mldsa_poly_chknorm(v + i * 2048, bound) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Accumulated pointwise product: w = Σ u[i] · v[i]
# ================================================================
# Accumulated coefficient by coefficient in a local, so no scratch
# poly is needed: w[k] = Σ_j montgomery_reduce(u[j][k] · v[j][k]),
# the same sum (integer adds are exact) the per-poly
# pointwise-then-add formulation produces.

# w = u[0]·v[0] + u[1]·v[1] + ... + u[L-1]·v[L-1] in NTT domain.
# Each inner pointwise is a montgomery_reduce, so the sum is
# already scaled by R^{-1}. `w` may alias u[0] or v[0] (each w[k] is
# written after its inputs are read). Reentrant. Returns 0.
fn mldsa_polyvecl_pointwise_acc_montgomery(w, u, v): i64 {
    var k = 0;
    while (k < 256) {
        var acc = 0;
        var j = 0;
        while (j < MLDSA65_L) {
            var off = j * 2048 + k * 8;
            acc = acc + mldsa_montgomery_reduce(load64(u + off) * load64(v + off));
            j = j + 1;
        }
        store64(w + k * 8, acc);
        k = k + 1;
    }
    return 0;
}

# ================================================================
# Matrix-vector product: t = A · v  (A is K rows × L cols)
# ================================================================
# Used during A·s1, A·y, and A·z computations in keygen / sign /
# verify. Row i of A is an L-element polyvecl at offset
# i · L · 2048 bytes from the matrix base. Each row is reduced
# against v via polyvecl_pointwise_acc_montgomery.

# t = Â · v in the NTT domain: t[i] = Σ_j A[i][j] · v[j] (Montgomery products) for the K rows
# of the K×L matrix `A` against polyvecl `v`, into polyveck `t`. `t` must not overlap `v`
# (re-read for every row). Locals only, so reentrant and thread-safe. Returns 0.
fn mldsa_polyvec_matrix_pointwise_montgomery(t, A, v): i64 {
    var i = 0;
    while (i < MLDSA65_K) {
        mldsa_polyvecl_pointwise_acc_montgomery(t + i * 2048, A + i * MLDSA65_L * 2048, v);
        i = i + 1;
    }
    return 0;
}
