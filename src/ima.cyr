# ima.cyr — Linux IMA (Integrity Measurement Architecture) integration.
# Thin wrapper over agnosys ima_* functions.
#
# Sigil-facing surface:
#   - `sigil_ima_available()`          — IMA active on this host?
#   - `sigil_ima_measurement_count()`  — number of kernel measurements
#   - `sigil_ima_policy_loaded()`      — is an IMA policy installed?
#   - `sigil_ima_snapshot()`           — aggregate (active, count, policy) struct
#
# All calls are safe on hosts without IMA — they return 0 counts and
# active=0 rather than failing. This mirrors the TPM module's
# runtime-detection posture.

# ================================================================
# ImaSnapshot (24 bytes) — sigil-side summary of agnosys ima_status
# ================================================================
# Layout:
#   +0   active           (i64, 0 or 1)
#   +8   measurement_cnt  (i64)
#   +16  policy_loaded    (i64, 0 or 1)

# New ImaSnapshot (24 B, `fl_alloc` — caller releases with fl_free) holding the active flag,
# the measurement count and the policy-loaded flag.
fn sigil_ima_snapshot_new(active, count, policy): i64 {
    var s = fl_alloc(24);
    store64(s, active);
    store64(s + 8, count);
    store64(s + 16, policy);
    return s;
}

# IMA-active flag (0 / 1) of snapshot `s`.
fn sigil_ima_active(s): i64 { return load64(s); }
# Kernel measurement count of snapshot `s`.
fn sigil_ima_count(s): i64 { return load64(s + 8); }
# Policy-loaded flag (0 / 1) of snapshot `s`.
fn sigil_ima_policy(s): i64 { return load64(s + 16); }

# ================================================================
# sigil_ima_snapshot — query current kernel IMA state
#
# Delegates to agnosys `ima_get_status()`, unwraps the Result, and
# returns a sigil-native snapshot. On a host without IMA mounted at
# /sys/kernel/security/ima, agnosys returns Ok(inactive); we pass
# that through.
# ================================================================

# Snapshot kernel IMA state via ima_get_status() into a new ImaSnapshot (`fl_alloc`, caller
# fl_frees). An Err from ima_get_status yields an all-zero snapshot rather than a failure.
fn sigil_ima_snapshot(): i64 {
    var res_tag, res = ima_get_status();
    if (is_err_result(res_tag) == 1) {
        return sigil_ima_snapshot_new(0, 0, 0);
    }
    var ag = result_unwrap(res_tag, res);
    return sigil_ima_snapshot_new(
      ima_status_active(ag),
      ima_status_measurement_count(ag),
      ima_status_policy_loaded(ag)
      );
}

# Convenience predicates — avoid allocating a snapshot when the
# caller only wants one field.

# 1 if IMA is active on this host, else 0 (takes a snapshot and frees it).
fn sigil_ima_available(): i64 {
    var s = sigil_ima_snapshot();
    var v = sigil_ima_active(s);
    fl_free(s);
    return v;
}

# Number of kernel IMA measurements; 0 when IMA is absent (takes a snapshot and frees it).
fn sigil_ima_measurement_count(): i64 {
    var s = sigil_ima_snapshot();
    var v = sigil_ima_count(s);
    fl_free(s);
    return v;
}

# Policy-loaded flag (0 / 1); 0 when IMA is absent (takes a snapshot and frees it).
fn sigil_ima_policy_loaded(): i64 {
    var s = sigil_ima_snapshot();
    var v = sigil_ima_policy(s);
    fl_free(s);
    return v;
}
