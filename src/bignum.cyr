# bignum.cyr -- general variable-width big-integer arithmetic.
#
# WHY A THIRD BIGINT MODULE
# -------------------------
# `lib/bigint.cyr` is fixed 256-bit (u256) and `src/bigint_ext.cyr` is
# Curve25519 field arithmetic (mod 2^255-19 only). RSA needs arbitrary
# modular exponentiation over 2048/3072/4096-bit operands, so this
# module provides general big integers: little-endian arrays of 64-bit
# limbs, backed by caller-provided byte buffers (limb i lives at byte
# offset i*8; `var X[N]` is N BYTES, CLAUDE.md quirk #3). Schoolbook
# multiply (on the native `_nmul64`, src/mul64.cyr) + binary long-division reduction +
# left-to-right square-and-multiply modexp.
#
# SCOPE / THREADING / TIMING
# --------------------------
# This is the engine for RSA. RSA *verification* (the first consumer)
# operates entirely on PUBLIC data -- signature, public modulus n,
# public exponent e -- so:
#   * no constant-time requirement (data-dependent branches in the
#     reduction loop are fine; there is no secret to leak). RSA *sign*
#     shipped in 3.6.4 — it uses blinding + a constant-time ladder
#     (`bn_mont_modexp`); do NOT reuse this non-CT `bn_modexp` for
#     secret exponents.
#   * not on the parallel batch-verify path (that is Ed25519). The
#     working buffers WERE plain static function-scope scratch, then
#     3.9.7 banked them across `cbank()` lanes for race-freedom. **As of
#     3.12.9 they are ordinary stack locals and the engine holds no
#     shared mutable state at all** — see the banking note below. The
#     secret-exponent mont/inv residues are wiped per CALL, in the frame
#     that produced them (quirk #9), not per lane.
#
# Correctness is the bar for this schoolbook engine; the Montgomery pass
# shipped in 3.6.6 (`bn_mont_modexp`) and carries the live RSA verify +
# sign paths. This bit-by-bit `bn_modexp` has no PRODUCTION call sites, but
# is deliberately RETAINED (decided 3.8.0) as the independent, differently-
# structured oracle that cross-checks `bn_mont_modexp` in
# tests/tcyr/bignum.tcyr (the `mont == schoolbook` differential test + 5
# direct modexp KATs) and the schoolbook baseline in tests/bcyr/rsa.bcyr —
# a two-implementation cross-check for the trust-boundary modexp. It is
# public-data / non-CT (the "do not use for secret exponents" warnings
# below stand). Roadmap "bn_modexp dead-code" item: resolved → keep.

# Max width: 64 limbs = 4096 bits (RSA-4096). Products are 2x = 128
# limbs. The reduction's running remainder needs 1 extra limb.
var BN_MAX_LIMBS = 64;

# ⛔ 3.12.9: THE BIGNUM ENGINE HOLDS NO BANKED SCRATCH ANY MORE.
#
# Every working buffer in this module is now a function-scope stack local,
# so no bignum path shares mutable state between threads and none carries
# the 63-lifetime-thread `cbank()` ceiling. Deleted here: `_bn_modrem` /
# `_bn_modn1` (dead since 3.12.5 localised `bn_mod`), `_bn_exp_result` /
# `_bn_exp_prod` / `_bn_exp_base` (→ `bn_modexp`), `_bn_m64` (→ `bn_mul`;
# `_bn_mont_mul` got its own at 3.12.4), `_bn_mont_t` / `_r2` / `_r2src` /
# `_base` / `_res` / `_tmp` / `_one` (→ `bn_mont_modexp`), and `_bn_inv_u`
# / `_v` / `_x1` / `_x2` (→ `bn_modinv`). **4,751,360 B of .bss removed.**
#
# ⚠ That figure is 8x the declared sizes, and it is not a typo: a MODULE-LEVEL
# `var X[N]` allocates N *8-byte slots*, i.e. 8N bytes — unlike a function-local
# `var X[N]`, which really is N bytes (CLAUDE.md quirk #3). Verified by probe
# under cycc 6.5.21 (`var G[20000]` -> 160,000 B of static data). So every
# banked global here cost 8x what its `# 512 * SIGIL_CRYPTO_BANKS` comment
# implied, and the 17 declarations above summing to 593,920 declared units were
# really 4,751,360 bytes.
#
# The banking existed for CLAUDE.md quirk #1 — "function-scope `var X[N]`
# arrays are static globals" — which was true under cycc 6.0.52 and has
# been FALSE since cyrius 6.3.15 routed array locals to per-thread stack
# slots. Every buffer above is far inside the 122,880-byte per-fn budget,
# and the compiler emits `note: oversized array local kept in shared
# global` if one ever is not. That note is the only signal to trust here;
# do not re-introduce a lane on the strength of the old quirk text.
#
# Secret residue is still wiped, but per CALL rather than per LANE:
# `_bn_mont_scrub` (secret-exponent ladder) and `_bn_inv_scrub` (blinding
# factor) zero the calling frame's own buffers before returning, which is
# tighter than the old whole-lane memset and cannot reach a sibling.

# ----------------------------------------------------------------
# Basic limb ops (all take a `limbs` count; buffers are byte ptrs)
# ----------------------------------------------------------------

fn bn_zero(a, limbs): i64 {
    var i = 0;
    while (i < limbs) { store64(a + i * 8, 0); i = i + 1; }
    return 0;
}

fn bn_copy(dst, src, limbs): i64 {
    memcpy(dst, src, limbs * 8);
    return 0;
}

fn bn_is_zero(a, limbs): i64 {
    var acc = 0;
    var i = 0;
    while (i < limbs) { acc = acc | load64(a + i * 8); i = i + 1; }
    if (acc == 0) { return 1; }
    return 0;
}

# Unsigned compare of two `limbs`-limb numbers: 1 if a>b, -1 if a<b,
# 0 if equal. (i64 `<` is signed, so flip the sign bit for unsigned.)
fn bn_cmp(a, b, limbs): i64 {
    var sbit = 1 << 63;
    var i = limbs - 1;
    while (i >= 0) {
        var av = load64(a + i * 8);
        var bv = load64(b + i * 8);
        if (av != bv) {
            if ((av ^ sbit) < (bv ^ sbit)) { return 0 - 1; }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

# a -= b (both `limbs` limbs); caller guarantees a >= b. Returns the
# out-borrow (0 on a valid subtraction).
fn bn_sub_assign(a, b, limbs): i64 {
    var sbit = 1 << 63;
    var borrow = 0;
    var i = 0;
    while (i < limbs) {
        var av = load64(a + i * 8);
        var bv = load64(b + i * 8);
        if (borrow == 0) {
            store64(a + i * 8, av - bv);
            # borrow out iff av < bv (unsigned)
            if ((av ^ sbit) < (bv ^ sbit)) { borrow = 1; } else { borrow = 0; }
        } else {
            store64(a + i * 8, av - bv - 1);
            # borrow out iff av <= bv (unsigned), i.e. NOT (bv < av)
            if ((bv ^ sbit) < (av ^ sbit)) { borrow = 0; } else { borrow = 1; }
        }
        i = i + 1;
    }
    return borrow;
}

# a <<= 1 over `limbs` limbs; returns the bit shifted out of the top.
fn bn_shl1(a, limbs): i64 {
    var carry = 0;
    var i = 0;
    while (i < limbs) {
        var v = load64(a + i * 8);
        var top = (v >> 63) & 1;
        store64(a + i * 8, (v << 1) | carry);
        carry = top;
        i = i + 1;
    }
    return carry;
}

# a >>= 1 (logical) over `limbs` limbs; returns the bit shifted out of
# the bottom. The 0x7FFF.. mask clears the sign bit that cyrius's
# arithmetic `>>` would otherwise smear in.
fn bn_shr1(a, limbs): i64 {
    var carry = 0;                  # bit descending from the limb above
    var i = limbs - 1;
    while (i >= 0) {
        var v = load64(a + i * 8);
        var low = v & 1;
        store64(a + i * 8, ((v >> 1) & 0x7FFFFFFFFFFFFFFF) | (carry << 63));
        carry = low;
        i = i - 1;
    }
    return carry;
}

# a += b (both `limbs` limbs); returns the carry out.
fn bn_add_assign(a, b, limbs): i64 {
    var sbit = 1 << 63;
    var carry = 0;
    var i = 0;
    while (i < limbs) {
        var av = load64(a + i * 8);
        var bv = load64(b + i * 8);
        var s1 = av + bv;
        var c1 = 0;
        if ((s1 ^ sbit) < (av ^ sbit)) { c1 = 1; }
        var s2 = s1 + carry;
        var c2 = 0;
        if ((s2 ^ sbit) < (s1 ^ sbit)) { c2 = 1; }
        store64(a + i * 8, s2);
        carry = c1 + c2;
        i = i + 1;
    }
    return carry;
}

# 1 if the `limbs`-limb value equals 1, else 0.
fn bn_is_one(a, limbs): i64 {
    if (load64(a) != 1) { return 0; }
    var i = 1;
    while (i < limbs) {
        if (load64(a + i * 8) != 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Index of the highest set bit + 1 (0 for a zero value).
fn bn_bitlen(a, limbs): i64 {
    var i = limbs - 1;
    while (i >= 0) {
        var v = load64(a + i * 8);
        if (v != 0) {
            var b = 63;
            while (b >= 0) {
                if (((v >> b) & 1) == 1) { return i * 64 + b + 1; }
                b = b - 1;
            }
        }
        i = i - 1;
    }
    return 0;
}

# Bit `idx` (0 = LSB) of an arbitrarily-wide little-endian number.
fn bn_test_bit(a, idx): i64 {
    var limb = idx / 64;
    var bit = idx % 64;
    return (load64(a + limb * 8) >> bit) & 1;
}

# ----------------------------------------------------------------
# Serialization (big-endian bytes <-> little-endian limbs)
# ----------------------------------------------------------------

# Parse `blen` big-endian bytes into `limbs` little-endian limbs.
# `out` is zeroed first; bytes beyond the buffer width are dropped.
fn bn_from_be(out, limbs, bytes, blen): i64 {
    bn_zero(out, limbs);
    var i = 0;                          # byte index counting from the LSB
    while (i < blen) {
        var b = load8(bytes + (blen - 1 - i)) & 0xFF;
        var limb = i / 8;
        var shift = (i % 8) * 8;
        if (limb < limbs) {
            store64(out + limb * 8, load64(out + limb * 8) | (b << shift));
        }
        i = i + 1;
    }
    return 0;
}

# Serialize `limbs` little-endian limbs to `blen` big-endian bytes,
# left-zero-padded (or truncated to the low `blen` bytes).
fn bn_to_be(bytes, blen, a, limbs): i64 {
    var i = 0;
    while (i < blen) {
        var b = 0;
        if (i < limbs * 8) {
            var limb = i / 8;
            var shift = (i % 8) * 8;
            b = (load64(a + limb * 8) >> shift) & 0xFF;
        }
        store8(bytes + (blen - 1 - i), b);
        i = i + 1;
    }
    return 0;
}

# ----------------------------------------------------------------
# Multiply and reduce
# ----------------------------------------------------------------

# out (2*limbs) = a * b (each `limbs` limbs). Schoolbook; out is zeroed.
fn bn_mul(out, a, b, limbs): i64 {
    # 3.12.9: stack local, not a `cbank()` lane. Pure within-call scratch —
    # `_nmul64` writes lo||hi and both are read before the next call, so
    # nothing survives and nothing needed a lane. Matches `_bn_mont_mul`'s
    # 3.12.4 localisation; see quirk #1's 6.3.15 revision.
    var m64buf[16];
    var m64 = &m64buf;
    bn_zero(out, 2 * limbs);
    var sbit = 1 << 63;
    var i = 0;
    while (i < limbs) {
        var av = load64(a + i * 8);
        var carry = 0;
        var j = 0;
        while (j < limbs) {
            var bv = load64(b + j * 8);
            _nmul64(av, bv, m64, m64 + 8);
            var lov = load64(m64);
            var hiv = load64(m64 + 8);
            var prev = load64(out + (i + j) * 8);
            # s1 = prev + lov
            var s1 = prev + lov;
            var c1 = 0;
            if ((s1 ^ sbit) < (prev ^ sbit)) { c1 = 1; }
            # s2 = s1 + carry
            var s2 = s1 + carry;
            var c2 = 0;
            if ((s2 ^ sbit) < (s1 ^ sbit)) { c2 = 1; }
            store64(out + (i + j) * 8, s2);
            carry = hiv + c1 + c2;
            j = j + 1;
        }
        # propagate the final column carry upward
        var k = i + limbs;
        while (carry != 0) {
            var prev = load64(out + k * 8);
            var s = prev + carry;
            var cc = 0;
            if ((s ^ sbit) < (prev ^ sbit)) { cc = 1; }
            store64(out + k * 8, s);
            carry = cc;
            k = k + 1;
        }
        i = i + 1;
    }
    return 0;
}

# rem (m_limbs) = x (x_limbs) mod modulus (m_limbs), via binary long
# division. NOT constant-time -- intended for public operands (RSA
# verify). Running remainder uses m_limbs+1 limbs internally so the
# pre-subtract shift can't overflow.
# ⛔ 3.12.5: STACK LOCALS, not `cbank()` lanes — the last shared state on the public
# verify path. `bn_mont_modexp_pub` calls this at the R^2 setup (`:661`/`:740`), so a
# localised modexp still reached a banked lane here. Measured on the pinned-lane harness:
# 3.12.3 verified 1 of 2,000 valid signatures, 3.12.4 (mont localised) 712, and this is
# the remainder.
#
# ⚠ NOT a copy-paste of the other localisations. `bn_mod` is ALSO called on SECRET
# operands by the CRT sign path (rsa.cyr:538/:539/:547), and rsa.cyr scrubbed the shared
# lane on the sign return. Moving to stack locals would make that scrub a no-op on a dead
# global and leave the secret residue live on the stack — so the buffers ZERO THEMSELVES
# before returning (quirk #9 / ADR 0004 intent, applied per-call). That is strictly
# better than the lane scrub: it wipes exactly this call's data instead of a whole lane,
# and it cannot miss a lane a sibling is using. The now-dangling lane memsets in
# rsa.cyr's `_rsa_scrub_sign_lanes` are deleted rather than left pointing at nothing.
fn bn_mod(rem, x, x_limbs, modulus, m_limbs): i64 {
    var modrembuf[520];
    var modn1buf[520];
    var modrem = &modrembuf;
    var modn1  = &modn1buf;
    var rl = m_limbs + 1;
    bn_zero(modrem, rl);
    # zero-extended modulus (top limb 0) so cmp/sub run over rl limbs
    bn_copy(modn1, modulus, m_limbs);
    store64(modn1 + m_limbs * 8, 0);

    var i = bn_bitlen(x, x_limbs) - 1;
    while (i >= 0) {
        bn_shl1(modrem, rl);
        # bring down bit i of x into the LSB
        store64(modrem, load64(modrem) | bn_test_bit(x, i));
        if (bn_cmp(modrem, modn1, rl) >= 0) {
            bn_sub_assign(modrem, modn1, rl);
        }
        i = i - 1;
    }
    bn_copy(rem, modrem, m_limbs);
    # Self-scrub: this fn sees SECRET operands on the CRT sign path, and a stack local
    # is not wiped by anything else. Plain stores, never `secret var` — the whole-array
    # wipe of `secret` is what ADR 0004 forbids here.
    var zi = 0;
    while (zi < 520) { store8(&modrembuf + zi, 0); store8(&modn1buf + zi, 0); zi = zi + 1; }
    return 0;
}

# Bit `idx` of a big-endian byte string `exp` (blen bytes), 0 = LSB.
fn _bn_exp_bit(exp, blen, idx): i64 {
    var byte_from_end = idx / 8;
    var bit = idx % 8;
    return (load8(exp + (blen - 1 - byte_from_end)) >> bit) & 1;
}

# out (limbs) = base^exp mod modulus, where `exp` is `exp_blen`
# big-endian bytes. Left-to-right square-and-multiply. PUBLIC exponent
# only (see header) -- NOT for secret-exponent (sign) use.
fn bn_modexp(out, base, exp, exp_blen, modulus, limbs): i64 {
    # 3.12.9: stack locals, not `cbank()` lanes. All three are within-call
    # scratch (each fully written before it is read), so this path shares no
    # mutable state between threads and has no 63-lifetime-thread ceiling.
    var resultbuf[512];
    var prodbuf[1024];
    var basecbuf[512];
    var result = &resultbuf;
    var prod   = &prodbuf;
    var basec  = &basecbuf;
    bn_zero(result, limbs);
    store64(result, 1);                     # result = 1
    bn_copy(basec, base, limbs);

    # Locate the highest set bit of exp (hb = -1 when exp == 0, leaving
    # result = 1 = base^0). cyrius has no break/continue, so guard the
    # scan with hb < 0.
    var hb = 0 - 1;
    var i = exp_blen * 8 - 1;
    while (i >= 0) {
        if (hb < 0) {
            if (_bn_exp_bit(exp, exp_blen, i) == 1) { hb = i; }
        }
        i = i - 1;
    }

    i = hb;
    while (i >= 0) {
        # result = result^2 mod modulus
        bn_mul(prod, result, result, limbs);
        bn_mod(result, prod, 2 * limbs, modulus, limbs);
        # if bit i set: result = result * base mod modulus
        if (_bn_exp_bit(exp, exp_blen, i) == 1) {
            bn_mul(prod, result, basec, limbs);
            bn_mod(result, prod, 2 * limbs, modulus, limbs);
        }
        i = i - 1;
    }
    bn_copy(out, result, limbs);
    return 0;
}

# ================================================================
# Constant-time Montgomery modular exponentiation (3.6.3c)
# ================================================================
# For the SECRET exponent (RSA sign): unlike `bn_modexp`, this does a
# square AND a multiply every iteration over a FIXED bit count, with a
# constant-time select instead of a branch on the exponent bit — so the
# control flow and memory-access pattern do not depend on the secret.
# (Residual: the per-multiply Montgomery final conditional subtract and
# `bn_sub_assign`'s borrow chain are minor value-dependent timing paths;
# RSA sign blinds the base so they don't correlate with the key.)
#
# CIOS Montgomery multiplication (Koc et al.). Modulus must be ODD
# (true for RSA n and primes p, q). R = 2^(64*limbs).

# The SECRET mont scratch (`_bn_mont_t` / `_r2` / `_r2src` / `_base` /
# `_res` / `_tmp` / `_one`) used to live here as seven banked globals.
# 3.12.9 moved them into `bn_mont_modexp`'s frame as stack locals, wiped
# per call by `_bn_mont_scrub`; `_bn_mont_t` went into `_bn_mont_mul` at
# 3.12.4. See the module header for why the banking is gone.

# ================================================================
# Modular inverse (binary inversion, odd modulus)
# ================================================================
# Used only for the ephemeral per-signature RSA blinding factor (r is
# random, not the key), so this is NOT constant-time. GECC Alg. 2.22
# shape, kept fully reduced in [0, n) throughout.
#
# 3.12.9: the four working buffers (`_bn_inv_u` / `_v` / `_x1` / `_x2`)
# are now stack locals inside `bn_modinv`, wiped per call by
# `_bn_inv_scrub` instead of per lane from rsa.cyr. The residue
# (r / r^-1 / gcd intermediates) is still zeroed on every return path.

# x = x/2 mod n (n odd): if x even, plain halve; else (x+n)/2 — x+n is
# even and < 2n, so capture the add-carry into the top bit after the
# shift.
fn _bn_halve_mod(x, n, limbs): i64 {
    if ((load64(x) & 1) == 0) {
        bn_shr1(x, limbs);
    } else {
        var c = bn_add_assign(x, n, limbs);
        bn_shr1(x, limbs);
        if (c == 1) {
            store64(x + (limbs - 1) * 8, load64(x + (limbs - 1) * 8) | (1 << 63));
        }
    }
    return 0;
}

# a = (a - b) mod n, with a, b in [0, n).
fn _bn_submod(a, b, n, limbs): i64 {
    if (bn_cmp(a, b, limbs) < 0) { bn_add_assign(a, n, limbs); }
    bn_sub_assign(a, b, limbs);
    return 0;
}

# Wipe `bn_modinv`'s four working buffers. Full 512 B each rather than
# `limbs`-wide: the caller's limb count is a public parameter, but a
# fixed-width wipe keeps this free of any dependence on it and costs
# nothing measurable against a modular inversion.
fn _bn_inv_scrub(u, v, x1, x2): i64 {
    memset(u, 0, 512);
    memset(v, 0, 512);
    memset(x1, 0, 512);
    memset(x2, 0, 512);
    return 0;
}

# rinv = r^-1 mod n  (n odd, gcd(r,n)=1). Returns 0 on success, -1 if r
# is 0 or not invertible (iteration cap). NOT constant-time.
fn bn_modinv(rinv, r, n, limbs): i64 {
    if (bn_is_zero(r, limbs) == 1) { return 0 - 1; }
    # 3.12.9: stack locals, not `cbank()` lanes. These carry the ephemeral
    # RSA blinding residue (r / r^-1 / gcd intermediates), so they are wiped
    # before every return below — per-call, which is strictly tighter than
    # the old whole-lane wipe in rsa.cyr's `_rsa_scrub_sign_lanes`.
    var ubuf[512];
    var vbuf[512];
    var x1buf[512];
    var x2buf[512];
    var u  = &ubuf;
    var v  = &vbuf;
    var x1 = &x1buf;
    var x2 = &x2buf;
    bn_copy(u, r, limbs);
    bn_copy(v, n, limbs);
    bn_zero(x1, limbs);
    store64(x1, 1);
    bn_zero(x2, limbs);

    var cap = 64 * limbs * 4;
    var it = 0;
    var done = 0;
    while (done == 0) {
        if (bn_is_one(u, limbs) == 1) { done = 1; }
        else { if (bn_is_one(v, limbs) == 1) { done = 2; }
        else { if (bn_is_zero(u, limbs) == 1) { done = 3; }   # gcd>1: not invertible
        else { if (bn_is_zero(v, limbs) == 1) { done = 3; }
        else { if (it >= cap) { done = 3; }
        else {
            while ((load64(u) & 1) == 0) {
                bn_shr1(u, limbs);
                _bn_halve_mod(x1, n, limbs);
            }
            while ((load64(v) & 1) == 0) {
                bn_shr1(v, limbs);
                _bn_halve_mod(x2, n, limbs);
            }
            if (bn_cmp(u, v, limbs) >= 0) {
                bn_sub_assign(u, v, limbs);
                _bn_submod(x1, x2, n, limbs);
            } else {
                bn_sub_assign(v, u, limbs);
                _bn_submod(x2, x1, n, limbs);
            }
            it = it + 1;
        } } } } }
    }

    if (done == 3) { _bn_inv_scrub(u, v, x1, x2); return 0 - 1; }
    if (done == 1) { bn_copy(rinv, x1, limbs); }
    else { bn_copy(rinv, x2, limbs); }
    _bn_inv_scrub(u, v, x1, x2);
    return 0;
}

# -n[0]^-1 mod 2^64 via Newton's iteration (n0 odd). Each step doubles
# the number of correct low bits: 1 -> 2 -> 4 -> ... -> 64.
fn _bn_mont_n0inv(n0): i64 {
    var inv = 1;
    var i = 0;
    while (i < 6) {
        inv = inv * (2 - n0 * inv);   # mod 2^64 (natural i64 wraparound)
        i = i + 1;
    }
    return 0 - inv;                   # -inv mod 2^64
}

# out = a * b * R^-1 mod n   (CIOS). a, b, n, out are `limbs` limbs.
fn _bn_mont_mul(out, a, b, n, n0inv, limbs): i64 {
    # ⛔ 3.12.4: STACK LOCALS, not `cbank()` lanes. Both are pure within-call scratch —
    # `t` is zeroed at entry and consumed before `out` is written; `m64` is just
    # `_nmul64`'s lo||hi slot. Nothing survives the call, so nothing needed a lane.
    #
    # The banking existed for cyrius **quirk #1** — "function-scope `var X[N]` arrays are
    # static globals", confirmed under cycc 6.0.52. **That is no longer true.** cyrius
    # v6.3.15 routed array locals to per-thread STACK slots (`_STACK_ARRAYS = 1`,
    # src/frontend/parse.cyr:287) and sigil never revisited the workaround. Verified
    # directly on cycc 6.5.12 with two real threads writing distinct sentinels into their
    # own `var buf[64]` and reading them back after the sibling wrote: 111111 / 222222, no
    # collision.
    #
    # This is the root cause the 3.12.3 residual pointed at — "two threads on one lane
    # corrupt each other's modexp", which turned the closed bypass into a fail-closed DoS
    # (1 of 2,000 VALID signatures verified). A stack local has no lane to collide on and
    # no 63-thread ceiling.
    var tbuf[528];
    var t = &tbuf;
    var m64buf[16];
    var m64 = &m64buf;
    var s = limbs;
    var sbit = 1 << 63;
    bn_zero(t, s + 2);

    var i = 0;
    while (i < s) {
        var bi = load64(b + i * 8);
        # t += a * b[i]
        var C = 0;
        var j = 0;
        while (j < s) {
            _nmul64(load64(a + j * 8), bi, m64, m64 + 8);
            var tj = load64(t + j * 8);
            var s1 = tj + load64(m64);
            var c1 = 0;
            if ((s1 ^ sbit) < (tj ^ sbit)) { c1 = 1; }
            var s2 = s1 + C;
            var c2 = 0;
            if ((s2 ^ sbit) < (s1 ^ sbit)) { c2 = 1; }
            store64(t + j * 8, s2);
            C = load64(m64 + 8) + c1 + c2;
            j = j + 1;
        }
        var ts = load64(t + s * 8);
        var s3 = ts + C;
        var c3 = 0;
        if ((s3 ^ sbit) < (ts ^ sbit)) { c3 = 1; }
        store64(t + s * 8, s3);
        store64(t + (s + 1) * 8, c3);

        # m = t[0] * n0inv mod 2^64; t += m * n; shift down one limb
        var m = load64(t) * n0inv;
        _nmul64(m, load64(n), m64, m64 + 8);
        var t0 = load64(t);
        var u0 = t0 + load64(m64);
        var d0 = 0;
        if ((u0 ^ sbit) < (t0 ^ sbit)) { d0 = 1; }
        C = load64(m64 + 8) + d0;       # t[0]+m*n[0] is == 0 mod 2^64 by construction
        j = 1;
        while (j < s) {
            _nmul64(m, load64(n + j * 8), m64, m64 + 8);
            var tj = load64(t + j * 8);
            var x1 = tj + load64(m64);
            var e1 = 0;
            if ((x1 ^ sbit) < (tj ^ sbit)) { e1 = 1; }
            var x2 = x1 + C;
            var e2 = 0;
            if ((x2 ^ sbit) < (x1 ^ sbit)) { e2 = 1; }
            store64(t + (j - 1) * 8, x2);
            C = load64(m64 + 8) + e1 + e2;
            j = j + 1;
        }
        var ts2 = load64(t + s * 8);
        var y = ts2 + C;
        var f = 0;
        if ((y ^ sbit) < (ts2 ^ sbit)) { f = 1; }
        store64(t + (s - 1) * 8, y);
        store64(t + s * 8, load64(t + (s + 1) * 8) + f);
        i = i + 1;
    }

    # t (low s limbs + carry t[s]) is < 2n; reduce to [0, n).
    bn_copy(out, t, s);
    var extra = load64(t + s * 8);
    # subtract n iff extra != 0 OR out >= n
    var dosub = 0;
    if (extra != 0) { dosub = 1; }
    else { if (bn_cmp(out, n, s) >= 0) { dosub = 1; } }
    if (dosub == 1) { bn_sub_assign(out, n, s); }
    return 0;
}

# out (limbs) = a ? a_buf : b_buf, per limb, constant-time. `bit` is 0/1.
fn _bn_ct_select(out, a_buf, b_buf, bit, limbs): i64 {
    var mask = 0 - bit;               # all-ones if bit==1, else 0
    var nmask = mask ^ (0 - 1);
    var i = 0;
    while (i < limbs) {
        store64(out + i * 8,
                (load64(a_buf + i * 8) & mask) | (load64(b_buf + i * 8) & nmask));
        i = i + 1;
    }
    return 0;
}

# Per-CALL secret zeroization of a mont-modexp workspace (quirk #9 /
# ADR 0004). `res`/`tmp`/`basem` carry the secret-exponent residue
# (m^d / mp^dp / mq^dq) on the RSA sign path; `r2`/`r2src`/`one` derive
# from public n or the constant 1 but are wiped too, so there is one
# hygiene surface rather than two.
#
# 3.12.9 replaced the previous `_bn_mont_scrub_lanes()`, which wiped the
# caller's `cbank()` lane of seven file-scope globals. Those globals are
# gone — every buffer here is a stack local of the calling frame, so the
# wipe now touches exactly this call's data and cannot reach a sibling
# thread's in-flight state. Sizes are the declared buffer widths, not
# `limbs`-derived, so the wipe is complete regardless of key size.
fn _bn_mont_scrub(r2src, r2, one, basem, res, tmp): i64 {
    memset(r2src, 0, 1040);
    memset(r2,    0, 512);
    memset(one,   0, 512);
    memset(basem, 0, 512);
    memset(res,   0, 512);
    memset(tmp,   0, 512);
    return 0;
}

# out (limbs) = base^exp mod modulus, `exp` = `exp_blen` big-endian
# bytes. Constant-time in the exponent (square+multiply every bit over
# the full width). Modulus MUST be odd. Safe for the secret exponent.
#
# For a PUBLIC exponent (RSA verify, blinding, verify-after-sign) call
# `bn_mont_modexp_pub` below instead — same Montgomery core, ~2.5x
# fewer multiplies. This entry point stays the one for d / dp / dq.
fn bn_mont_modexp(out, base, exp, exp_blen, modulus, limbs): i64 {
    # 3.12.9: stack locals, not `cbank()` lanes — the last banked buffers on
    # any RSA path. `res`/`tmp`/`basem` carry the SECRET-exponent residue
    # (m^d / mp^dp / mq^dq), so they are wiped by `_bn_mont_scrub` before the
    # return. That wipe is now per-call rather than per-lane, which is both
    # tighter (only this call's data) and safe with no sibling to clobber.
    var r2srcbuf[1040];
    var r2buf[512];
    var onebuf[512];
    var basembuf[512];
    var resbuf[512];
    var tmpbuf[512];
    var r2src = &r2srcbuf;
    var r2    = &r2buf;
    var one   = &onebuf;
    var basem = &basembuf;
    var res   = &resbuf;
    var tmp   = &tmpbuf;
    var n0inv = _bn_mont_n0inv(load64(modulus));

    # R^2 mod n  =  2^(128*limbs) mod n
    var r2limbs = 2 * limbs + 1;
    bn_zero(r2src, r2limbs);
    store64(r2src + (2 * limbs) * 8, 1);
    bn_mod(r2, r2src, r2limbs, modulus, limbs);

    bn_zero(one, limbs);
    store64(one, 1);

    # base_m = base*R mod n ; res = 1*R mod n (Montgomery 1)
    _bn_mont_mul(basem, base, r2, modulus, n0inv, limbs);
    _bn_mont_mul(res, one, r2, modulus, n0inv, limbs);

    var i = exp_blen * 8 - 1;
    while (i >= 0) {
        _bn_mont_mul(res, res, res, modulus, n0inv, limbs);
        _bn_mont_mul(tmp, res, basem, modulus, n0inv, limbs);
        _bn_ct_select(res, tmp, res, _bn_exp_bit(exp, exp_blen, i), limbs);
        i = i - 1;
    }

    # convert out of Montgomery form: out = res * 1 * R^-1 mod n
    _bn_mont_mul(out, res, one, modulus, n0inv, limbs);
    _bn_mont_scrub(r2src, r2, one, basem, res, tmp);   # this call's secret residue
    return 0;
}

# ================================================================
# PUBLIC-exponent Montgomery modular exponentiation (3.12.2)
# ================================================================
# Same CIOS Montgomery core as `bn_mont_modexp`, but with `bn_modexp`'s
# public-exponent schedule transplanted in: locate the exponent's high
# bit, seed the accumulator with the base, then square every iteration
# and multiply ONLY when the bit is set. The control flow therefore
# depends on the exponent — which is exactly why this must NEVER be
# called with a secret exponent (RSA d / dp / dq). Use `bn_mont_modexp`
# there.
#
# Why it exists: RSA *verification* is a public operation on public
# operands (s^e mod n with e = 65537), and the constant-time ladder is
# over-provisioning that costs 2.3x. For e = 65537 handed back by
# `rsa_pubkey_from_der` as the 3 bytes `01 00 01`:
#
#   bn_mont_modexp      24 bits x (square + unconditional multiply)
#                       + 3 setup/teardown                  = 51 mont_muls
#   bn_mont_modexp_pub  high bit at 16 -> 16 squarings + 1 multiply
#                       + 3 setup/teardown                  = 20 mont_muls
#
# Seeding `res = basem` at the high bit (rather than starting from
# Montgomery 1 and letting the first iteration square it) saves the
# leading square+multiply pair, which is where the last 2 of the 22 in
# the filed issue's estimate go.
#
# Modulus MUST be odd (RSA n is p.q of two odd primes; callers enforce
# this at their trust boundary). 3.12.9: there is no shared scratch left
# to inherit residue from — both ladders are fully stack-local — so the
# scrub on the return path is pure hygiene over this call's own frame,
# kept so there is one wipe surface rather than two.
#
# Issue: docs/development/issues/2026-07-30-rsa-verify-uses-secret-exponent-ladder.md
fn bn_mont_modexp_pub(out, base, exp, exp_blen, modulus, limbs): i64 {
    # ⛔ 3.12.4: STACK LOCALS, not `cbank()` lanes — see the note on `_bn_mont_mul`.
    # All five are within-call scratch (each is fully written before it is read), so the
    # PUBLIC verify path now shares NO mutable state between threads. This is what the
    # 3.12.3 residual was blocked on: with the lanes gone there is no collision to corrupt
    # a sibling's modexp, and no 63-lifetime-thread ceiling.
    var r2srcbuf[1040];
    var r2buf[512];
    var onebuf[512];
    var basembuf[512];
    var resbuf[512];
    var r2src = &r2srcbuf;
    var r2    = &r2buf;
    var one   = &onebuf;
    var basem = &basembuf;
    var res   = &resbuf;
    var n0inv = _bn_mont_n0inv(load64(modulus));

    # R^2 mod n  =  2^(128*limbs) mod n
    var r2limbs = 2 * limbs + 1;
    bn_zero(r2src, r2limbs);
    store64(r2src + (2 * limbs) * 8, 1);
    bn_mod(r2, r2src, r2limbs, modulus, limbs);

    bn_zero(one, limbs);
    store64(one, 1);

    # base_m = base*R mod n ; res = 1*R mod n (Montgomery 1)
    _bn_mont_mul(basem, base, r2, modulus, n0inv, limbs);
    _bn_mont_mul(res, one, r2, modulus, n0inv, limbs);

    # Locate the highest set bit of exp. hb stays -1 when exp == 0 (or
    # exp_blen == 0), leaving res = Montgomery 1 so out = 1 = base^0 —
    # same answer `bn_modexp` gives. cyrius has no break/continue, so
    # the scan is guarded with `hb < 0` rather than exited early.
    var hb = 0 - 1;
    var i = exp_blen * 8 - 1;
    while (i >= 0) {
        if (hb < 0) {
            if (_bn_exp_bit(exp, exp_blen, i) == 1) { hb = i; }
        }
        i = i - 1;
    }

    if (hb >= 0) {
        # Seed with the base at the high bit, then process hb-1 .. 0.
        # `_bn_mont_mul` writes `out` only after consuming `a`/`b` (it
        # accumulates into the banked `t`), so res-aliasing is safe.
        bn_copy(res, basem, limbs);
        i = hb - 1;
        while (i >= 0) {
            _bn_mont_mul(res, res, res, modulus, n0inv, limbs);
            if (_bn_exp_bit(exp, exp_blen, i) == 1) {
                _bn_mont_mul(res, res, basem, modulus, n0inv, limbs);
            }
            i = i - 1;
        }
    }

    # convert out of Montgomery form: out = res * 1 * R^-1 mod n
    _bn_mont_mul(out, res, one, modulus, n0inv, limbs);
    # Public operands throughout, so this is hygiene rather than a
    # requirement — but it keeps one scrub surface across both ladders.
    # `res` doubles as this path's multiply temp (there is no separate
    # `tmp`), so it is passed for both slots.
    _bn_mont_scrub(r2src, r2, one, basem, res, res);
    return 0;
}
