# pem.cyr — minimal PEM decoder for embedded cert chains.
#
# Sigil 3.5 — bite 1 of the TEE-attestation completion arc
# (origin: `docs/development/roadmap.md` "Road to v3.5"). The
# 3.2.x parsers (`src/sgx.cyr`, `src/tdx.cyr`) record an
# `qe_cert_data` byte range that, when `qe_cert_data_type == 5`,
# holds a PEM-encoded PCK cert chain (typically root → ...→
# leaf, 2–3 certs). SEV-SNP's VCEK chain is fetched out-of-band
# from AMD KDS in a similar PEM shape. 3.5's *_verify_full
# orchestrators want one decoder that turns those PEM bytes
# into a (cert_ptr, der_len) array consumable by
# `x509_parse` + `x509_verify_chain`.
#
# Scope (deliberately narrow):
#   • Recognises ONLY `-----BEGIN CERTIFICATE-----` /
#     `-----END CERTIFICATE-----` markers. Encrypted-PEM, RSA-key,
#     EC-key, CSR markers are ignored / rejected.
#   • Base64 alphabet is RFC 4648 §4 (standard, not URL-safe).
#     `+`, `/` valid; `-`, `_` rejected.
#   • Padding (`=`) accepted at the end of the body in 0/1/2-char
#     forms per RFC 4648. Padding inside the body is rejected.
#   • Whitespace (LF, CR, space, tab) inside the body is skipped
#     transparently — real-world PEMs wrap at 64 cols.
#   • No tolerance for extra content between blocks (e.g. embedded
#     human-readable cert summaries from `openssl x509 -text`).
#     The decoder allows arbitrary bytes BEFORE the first BEGIN
#     marker and BETWEEN END/BEGIN-of-next-block (so trailing
#     newlines / preamble are fine) but rejects any malformed
#     marker sequencing. (The 3.13.7 trust-bundle walk,
#     `pem_decode_certs_lenient_into`, skips such a block instead.)
#
# Threat model: the PEM bytes are fully attacker-controlled (they
# travel from a remote untrusted host inside the TEE quote's
# `qe_cert_data` region). Every byte read is bounds-checked
# against `pem_len`; every byte write is bounds-checked against
# `der_pool_size`; the chain count is bounds-checked against
# `max_certs`. Any malformation returns -1 with the chain array
# untouched beyond the malformed entry; the caller MUST treat
# a non-positive return as a hard failure.
#
# Surface:
#   fn pem_decode_certs_into(pem, pem_len, out_chain, max_certs,
#                              der_pool, der_pool_size): i64
#       — _into variant: caller provides the DER scratch pool.
#         Returns count of decoded certs (≥ 1) on success, -1 on
#         any malformed input. `out_chain` is a contiguous array
#         of `max_certs * 16` bytes; each 16-byte entry is
#         (der_ptr: i64, der_len: i64) with der_ptr pointing into
#         der_pool. Entries beyond the returned count are
#         untouched.
#   fn pem_decode_certs(pem, pem_len, out_chain, max_certs): i64
#       — convenience wrapper. Bump-allocates a der_pool sized to
#         `pem_len` (a strict upper bound on the decoded DER) and
#         delegates. Lifetime is the process; suitable for one-
#         shot verify paths. See the LOW audit note in
#         `docs/audit/2026-05-XX-audit.md`.
#   fn pem_decode_certs_lenient_into(pem, pem_len, out_chain,
#        max_certs, der_pool, der_pool_size, out_skipped): i64
#       — 3.13.7, for TRUST BUNDLES: the same layout and pool, but
#         a malformed block (unmatched BEGIN, bad base64) is
#         skipped and counted through `out_skipped` instead of
#         failing the whole input. Returns the count decoded
#         (≥ 0), -1 only on a bad argument or a well-formed block
#         with no room. See its section at the end of this file.
#   fn pem_count_cert_blocks(pem, pem_len): i64
#       — 3.13.7: the BEGIN-marker count the lenient walk visits
#         (decoded + skipped), for sizing `out_chain`.
#
# The strict pair above is all-or-nothing and stays the decode for
# attestation chains and for any caller that wants a SPECIFIC
# certificate (e.g. the leaf as the first block).
#
# Layout of out_chain entries (16 B each):
#   0..7   der_ptr (absolute address into der_pool)
#   8..15  der_len (bytes, > 0)

# ================================================================
# Format constants
# ================================================================

var PEM_BEGIN_CERT_LEN = 27;
var PEM_END_CERT_LEN   = 25;

# Base64 lookup table: 256 entries
#   0..63  → base64 digit
#   64     → `=` padding
#   65     → whitespace (LF/CR/space/tab)
#   66     → invalid
var _pem_b64_table = 0;
var _pem_begin     = 0;
var _pem_end       = 0;
var _pem_inited    = 0;   # 0 / 1 building / 2 published (_sigil_once_*)

fn _pem_init(): i64 {
    if (atomic_load(&_pem_inited) == 2) { return _sigil_once_acquired(); }
    if (_sigil_once_claim(&_pem_inited) == 0) { return 0; }

    # Build the lookup table.
    _pem_b64_table = alloc(256);
    var i = 0;
    while (i < 256) {
        store8(_pem_b64_table + i, 66);   # default: invalid
        i = i + 1;
    }
    # A-Z → 0..25
    i = 0;
    while (i < 26) {
        store8(_pem_b64_table + 65 + i, i);
        i = i + 1;
    }
    # a-z → 26..51
    i = 0;
    while (i < 26) {
        store8(_pem_b64_table + 97 + i, 26 + i);
        i = i + 1;
    }
    # 0-9 → 52..61
    i = 0;
    while (i < 10) {
        store8(_pem_b64_table + 48 + i, 52 + i);
        i = i + 1;
    }
    # `+` → 62, `/` → 63
    store8(_pem_b64_table + 43, 62);
    store8(_pem_b64_table + 47, 63);
    # `=` → padding marker
    store8(_pem_b64_table + 61, 64);
    # whitespace: LF, CR, space, tab
    store8(_pem_b64_table + 10, 65);
    store8(_pem_b64_table + 13, 65);
    store8(_pem_b64_table + 32, 65);
    store8(_pem_b64_table + 9,  65);

    # Marker strings (use raw bytes, not C-strings — we compare
    # byte-by-byte over a known length).
    _pem_begin = alloc(PEM_BEGIN_CERT_LEN);
    var b = "-----BEGIN CERTIFICATE-----";
    i = 0;
    while (i < PEM_BEGIN_CERT_LEN) {
        store8(_pem_begin + i, load8(b + i) & 0xFF);
        i = i + 1;
    }
    _pem_end = alloc(PEM_END_CERT_LEN);
    var e = "-----END CERTIFICATE-----";
    i = 0;
    while (i < PEM_END_CERT_LEN) {
        store8(_pem_end + i, load8(e + i) & 0xFF);
        i = i + 1;
    }

    _sigil_once_publish(&_pem_inited);
    return 0;
}

# ================================================================
# Helpers
# ================================================================

# Compare `len` bytes at buf+pos against marker[0..len]. Returns 1
# if they match exactly, 0 otherwise. `pos + len` must be ≤ buf_len.
fn _pem_match_at(buf, buf_len, pos, marker, len): i64 {
    if (pos + len > buf_len) { return 0; }
    var i = 0;
    while (i < len) {
        if ((load8(buf + pos + i) & 0xFF) != (load8(marker + i) & 0xFF)) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

# Search buf[start..buf_len] for the first occurrence of `marker`.
# Returns the absolute offset on success, -1 if not found.
fn _pem_find(buf, buf_len, start, marker, marker_len): i64 {
    if (marker_len <= 0) { return 0 - 1; }
    var i = start;
    var end = buf_len - marker_len + 1;
    while (i < end) {
        if (_pem_match_at(buf, buf_len, i, marker, marker_len) == 1) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Walk one base64 body pem[body_start..body_end) and, unless `dry`,
# decode it into out. Returns the number of decoded bytes (> 0); -1
# on malformed input (invalid char, padding inside body, wrong
# padding count, a partial final quad, zero body length); -2 when
# `dry` is 0 and the decoded bytes would exceed `out_max` — the walk
# stops there, so a -2 body may still be malformed further on.
# `dry` = 1 validates and sizes only: `out` is never written and
# `out_max` is ignored, so a dry walk never returns -2 and its answer
# is what a decode with room to spare returns. The lenient bundle
# decode uses it to tell a full pool from a bad block (3.13.7).
fn _pem_b64_walk(pem, body_start, body_end, out, out_max, dry): i64 {
    var i = body_start;
    var op = 0;
    var quad[4];
    var quad_n = 0;
    var seen_pad = 0;

    while (i < body_end) {
        var c = load8(pem + i) & 0xFF;
        i = i + 1;
        var v = load8(_pem_b64_table + c) & 0xFF;

        if (v == 65) { continue; }      # whitespace: skip
        if (v == 66) { return 0 - 1; }   # invalid byte
        if (v == 64) {
            # Padding `=`. Allowed only in the final quad, after
            # at least 2 alphabet chars in that quad. Once we see
            # padding, only padding + whitespace may follow.
            if (seen_pad == 0) {
                if (quad_n < 2) { return 0 - 1; }
                seen_pad = 1;
            }
            quad_n = quad_n + 1;
            if (quad_n > 4) { return 0 - 1; }
            store8(&quad + quad_n - 1, 64);
        } else {
            if (seen_pad == 1) { return 0 - 1; }  # alphabet after pad
            quad_n = quad_n + 1;
            if (quad_n > 4) { return 0 - 1; }
            store8(&quad + quad_n - 1, v);
        }

        if (quad_n == 4) {
            # Emit. Determine how many output bytes (1/2/3) by
            # counting pads at the tail.
            var pads = 0;
            if ((load8(&quad + 3) & 0xFF) == 64) { pads = 1; }
            if ((load8(&quad + 2) & 0xFF) == 64) { pads = 2; }
            # All-pad or three-pad quads are malformed.
            if (pads == 2) {
                if ((load8(&quad + 3) & 0xFF) != 64) { return 0 - 1; }
            }
            var out_n = 3 - pads;
            if (dry == 0) {
                if (op + out_n > out_max) { return 0 - 2; }

                var b0 = load8(&quad + 0) & 0xFF;
                var b1 = load8(&quad + 1) & 0xFF;
                var b2 = load8(&quad + 2) & 0xFF;
                var b3 = load8(&quad + 3) & 0xFF;
                store8(out + op, ((b0 << 2) | (b1 >> 4)) & 0xFF);
                if (out_n >= 2) {
                    store8(out + op + 1, (((b1 & 0xF) << 4) | (b2 >> 2)) & 0xFF);
                }
                if (out_n >= 3) {
                    store8(out + op + 2, (((b2 & 0x3) << 6) | b3) & 0xFF);
                }
            }
            op = op + out_n;
            quad_n = 0;
            # If we saw padding, no more data allowed (only WS).
            if (seen_pad == 1) {
                while (i < body_end) {
                    var c2 = load8(pem + i) & 0xFF;
                    var v2 = load8(_pem_b64_table + c2) & 0xFF;
                    if (v2 != 65) { return 0 - 1; }
                    i = i + 1;
                }
            }
        }
    }

    # End of body. Must have consumed a whole number of quads.
    if (quad_n != 0) { return 0 - 1; }
    if (op == 0) { return 0 - 1; }   # empty body — reject

    return op;
}

# Decode a single base64 body from pem[body_start..body_end) into
# out (must have room for the worst-case output). Returns the
# number of decoded bytes (> 0) on success, -1 on malformed input
# (invalid char, padding inside body, wrong padding count, zero
# body length). `out_max` is the maximum bytes the caller can
# accept in `out` — if the decoded size would exceed it, returns
# -1.
fn _pem_b64_decode(pem, body_start, body_end, out, out_max): i64 {
    var n = _pem_b64_walk(pem, body_start, body_end, out, out_max, 0);
    if (n < 0) { return 0 - 1; }
    return n;
}

# ================================================================
# Public surface
# ================================================================

# _into variant — caller-provided DER scratch pool.
fn pem_decode_certs_into(pem, pem_len, out_chain, max_certs,
  der_pool, der_pool_size): i64 {
    _pem_init();

    if (pem_len < 0) { return 0 - 1; }
    if (max_certs <= 0) { return 0 - 1; }
    if (der_pool_size < 0) { return 0 - 1; }

    var count = 0;
    var pool_used = 0;
    var cur = 0;

    while (cur < pem_len) {
        # Find next BEGIN marker.
        var begin_off = _pem_find(pem, pem_len, cur, _pem_begin, PEM_BEGIN_CERT_LEN);
        if (begin_off < 0) {
            # No more BEGIN markers. Done — return whatever we
            # have. (count == 0 is still a malformation case: a
            # caller asking us to decode something with no BEGIN
            # at all should hear about it.)
            if (count == 0) { return 0 - 1; }
            return count;
        }

        var body_start = begin_off + PEM_BEGIN_CERT_LEN;

        # Find the matching END marker after body_start.
        var end_off = _pem_find(pem, pem_len, body_start, _pem_end, PEM_END_CERT_LEN);
        if (end_off < 0) { return 0 - 1; }   # unmatched BEGIN

        # Decode base64 between body_start and end_off into the
        # pool (sliced at pool_used).
        if (count >= max_certs) { return 0 - 1; }
        if (pool_used > der_pool_size) { return 0 - 1; }  # paranoid
        var pool_avail = der_pool_size - pool_used;
        var decoded = _pem_b64_decode(pem, body_start, end_off,
          der_pool + pool_used, pool_avail);
        if (decoded < 0) { return 0 - 1; }

        # Record entry in the chain array.
        store64(out_chain + count * 16,     der_pool + pool_used);
        store64(out_chain + count * 16 + 8, decoded);
        pool_used = pool_used + decoded;
        count = count + 1;

        cur = end_off + PEM_END_CERT_LEN;
    }

    if (count == 0) { return 0 - 1; }
    return count;
}

# Convenience wrapper — bump-allocates a DER pool sized at
# `pem_len` (strict upper bound: base64 expands by 4/3×, so DER ≤
# (3/4) × PEM, plus a small overhead for markers/whitespace; pem_len
# is conservative).
#
# NOTE: the bump-allocator pool is freed only at program exit. The
# drift-free path shipped in 3.7.3 — long-running consumers (kavach
# attestation loop) should call `pem_decode_certs_into` with their own
# arena (`arena_reset` between calls). This wrapper remains for one-shot
# use.
fn pem_decode_certs(pem, pem_len, out_chain, max_certs): i64 {
    if (pem_len <= 0) { return 0 - 1; }
    var pool = alloc(pem_len);
    return pem_decode_certs_into(pem, pem_len, out_chain, max_certs,
      pool, pem_len);
}

# ================================================================
# Trust bundles — skip a malformed block, keep the rest (3.13.7)
# ================================================================
#
# pem_decode_certs_into is all-or-nothing: one malformed block (an
# unmatched BEGIN, bad base64) fails the whole input. That is right
# for an attestation chain, where every certificate is needed, and
# wrong for a trust bundle — an OS store of ~150 independent roots —
# where it meant one corrupt block installed ZERO roots (cyrius's
# native TLS loads the system store through it). The bundle walk
# below skips such a block, keeps every other one and reports how
# many it skipped. Keep the strict decode wherever a SPECIFIC
# certificate is wanted (a leaf taken as the first block): skipping
# a bad first block would silently hand back the next certificate.
#
# Blocks are the `-----BEGIN CERTIFICATE-----` markers, found left to
# right with no two counted markers overlapping (each BEGIN's search
# for the next starts after its own 27 bytes). A block decodes when an
# END marker follows its BEGIN and the base64 between them is valid.
# Otherwise it is skipped and the walk resumes at the NEXT BEGIN after
# this one — never after the END it may have reached: an unmatched
# BEGIN's body runs into the next block's BEGIN, whose `-` is not
# base64, so the strict decode fails there and the bundle walk must
# not lose that next block. Bytes before the first BEGIN, between
# blocks and after the last END are ignored, as in the strict decode
# (a stray END included). Cost: within ~2% of the strict decode on a
# well-formed 121-block OS store. CHANGELOG [3.13.7].

# Count the certificate blocks in pem[0..pem_len): every `-----BEGIN CERTIFICATE-----`
# marker, found left to right with no two counted markers overlapping. These are exactly
# the blocks pem_decode_certs_lenient_into walks: every non-negative return of it has
# decoded + skipped == this count, so a caller sizes out_chain from it (max_certs = this
# count never runs out of entries). Returns the count (>= 0; 0 for an empty input or no
# marker), or -1 for pem_len < 0, or a null pem with pem_len > 0.
fn pem_count_cert_blocks(pem, pem_len): i64 {
    _pem_init();
    if (pem_len < 0) { return 0 - 1; }
    if (pem_len == 0) { return 0; }
    if (pem == 0) { return 0 - 1; }
    var n = 0;
    var b = _pem_find(pem, pem_len, 0, _pem_begin, PEM_BEGIN_CERT_LEN);
    while (b >= 0) {
        n = n + 1;
        b = _pem_find(pem, pem_len, b + PEM_BEGIN_CERT_LEN, _pem_begin, PEM_BEGIN_CERT_LEN);
    }
    return n;
}

# Trust-bundle decode: pem_decode_certs_into's layout and pool, but a malformed block is
# SKIPPED, not fatal — an unmatched BEGIN (no END before the next BEGIN or the end of the
# input), or a body that is not valid base64 (a bad byte, bad padding, a partial quad, an
# empty body). Every other block is decoded into the next out_chain entry (16 B: der_ptr
# into der_pool, der_len). Returns the number decoded (>= 0; 0 when nothing decodes — no
# BEGIN marker, or every block skipped) and writes the number skipped through out_skipped
# (not written when out_skipped is 0): decoded + skipped == pem_count_cert_blocks.
# Returns -1, with out_skipped 0, for a bad argument (pem_len < 0, max_certs <= 0,
# der_pool_size < 0, a null pem / out_chain / der_pool with a non-zero length) or when a
# WELL-FORMED block finds no room: out_chain already holds max_certs entries, or its DER
# does not fit the rest of der_pool. A skipped block takes no entry and no pool space,
# whatever its size. Room never runs out with max_certs >= pem_count_cert_blocks(pem,
# pem_len) and der_pool_size >= pem_len. Entries past the returned count are untouched;
# pool bytes outside the returned entries are scratch. For trust bundles only — where a
# SPECIFIC certificate is wanted (a leaf taken as the first block) use the strict
# pem_decode_certs_into, which fails instead of handing back the next block.
fn pem_decode_certs_lenient_into(pem, pem_len, out_chain, max_certs,
  der_pool, der_pool_size, out_skipped): i64 {
    _pem_init();
    if (out_skipped != 0) { store64(out_skipped, 0); }
    if (pem_len < 0) { return 0 - 1; }
    if (pem == 0) { if (pem_len > 0) { return 0 - 1; } }
    if (out_chain == 0) { return 0 - 1; }
    if (max_certs <= 0) { return 0 - 1; }
    if (der_pool_size < 0) { return 0 - 1; }
    if (der_pool == 0) { if (der_pool_size > 0) { return 0 - 1; } }

    var count = 0;
    var skipped = 0;
    var pool_used = 0;
    # The first END at or after the last body start searched: -2 = not searched yet,
    # -1 = none left in the input. Reused while it still lies past the current body
    # start, so a run of unmatched BEGINs does not rescan the tail once per block.
    var end_off = 0 - 2;
    var begin_off = _pem_find(pem, pem_len, 0, _pem_begin, PEM_BEGIN_CERT_LEN);
    while (begin_off >= 0) {
        var body_start = begin_off + PEM_BEGIN_CERT_LEN;
        if (end_off != 0 - 1) {
            if (end_off < body_start) {
                end_off = _pem_find(pem, pem_len, body_start, _pem_end, PEM_END_CERT_LEN);
            }
        }
        var got = 0 - 1;
        if (end_off >= 0) {
            got = _pem_b64_walk(pem, body_start, end_off, der_pool + pool_used,
              der_pool_size - pool_used, 0);
            if (got == 0 - 2) {
                # Out of room before the walk finished. Only a well-formed block makes that a
                # capacity failure; a malformed one is skipped whatever the pool's size.
                if (_pem_b64_walk(pem, body_start, end_off, 0, 0, 1) > 0) { return 0 - 1; }
                got = 0 - 1;
            }
        }
        if (got > 0) {
            if (count >= max_certs) { return 0 - 1; }
            store64(out_chain + count * 16,     der_pool + pool_used);
            store64(out_chain + count * 16 + 8, got);
            pool_used = pool_used + got;
            count = count + 1;
            # A body that decodes is base64 and whitespace only — no `-` — so no BEGIN starts
            # inside it, and the next one is at or after this END (sharing its dashes or not).
            begin_off = _pem_find(pem, pem_len, end_off, _pem_begin, PEM_BEGIN_CERT_LEN);
        } else {
            # Malformed, or an unmatched BEGIN: no END follows, or the body ran into the next
            # BEGIN (whose `-` the walk refused). Resume at the next BEGIN after this one.
            skipped = skipped + 1;
            begin_off = _pem_find(pem, pem_len, body_start, _pem_begin, PEM_BEGIN_CERT_LEN);
        }
    }
    if (out_skipped != 0) { store64(out_skipped, skipped); }
    return count;
}
