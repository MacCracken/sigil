# agnosys — shared cross-module utilities
#
# Small helpers that several modules need identically. Kept here (rather
# than copied per-module) so a single definition is audited and tested
# once. Public `agnosys_*` prefix per the project's prefix discipline.
#
# Placed in [lib.core] so every profile bundle (core + domain) resolves
# these — consumers span security/storage/trust/system profiles.

# Emit a JSON value for a possibly-null C string into a str_builder:
# `null` when the pointer is 0, otherwise a JSON-quoted/escaped string.
# Replaces the per-module `_<mod>_emit_cstr_or_null` shims (mac, dmverity,
# drm, certpin, update) that were byte-identical.
fn agnosys_json_emit_cstr_or_null(sb, c): i64 {
    if (c == 0) {
        str_builder_add_cstr(sb, "null");
    } else {
        str_builder_add_json_str(sb, str_from(c));
    }
    return 0;
}

# Is `ch` an ASCII hex digit (0-9, a-f, A-F)? Single definition shared by
# the hash/digest validators in ima, dmverity, tpm, update.
fn agnosys_is_hex_char(ch): i64 {
    if (ch >= 48 && ch <= 57) { return 1; }   # 0-9
    if (ch >= 65 && ch <= 70) { return 1; }   # A-F
    if (ch >= 97 && ch <= 102) { return 1; }  # a-f
    return 0;
}

# Is `ch` valid in a device-mapper / volume name (alphanumeric, `-`, `_`)?
# Single source for the dm-name allowlist shared by dmverity and luks.
fn agnosys_is_name_char(ch): i64 {
    if (ch >= 48 && ch <= 57) { return 1; }   # 0-9
    if (ch >= 65 && ch <= 90) { return 1; }   # A-Z
    if (ch >= 97 && ch <= 122) { return 1; }  # a-z
    if (ch == 45) { return 1; }               # -
    if (ch == 95) { return 1; }               # _
    return 0;
}

# Does C string `str` start with C string `prefix`? Single-pass: walks
# `prefix` and compares, stopping at the first mismatch, the prefix
# terminator, or the str terminator — no up-front strlen of either side
# (the previous per-module copies scanned both strings fully first).
fn agnosys_cstr_starts_with(str, prefix): i64 {
    var i = 0;
    var pc = load8(prefix);
    while (pc != 0) {
        var sc = load8(str + i);
        if (sc == 0) { return 0; }
        if (sc != pc) { return 0; }
        i = i + 1;
        pc = load8(prefix + i);
    }
    return 1;
}

# ⚠ BOUNDED AND STATUS-CHECKED (M10). This delegated to the stdlib's
# `exec_capture`, which is unbounded and DISCARDS the child's exit status, so a
# missing or failing tool came back as Ok(bytes) — fail open. It now delegates
# to `agnosys_run_capture_timeout` with the default bound, the same move
# `agnosys_run_checked` made in 3.12.13; on agnos / Windows that refuses with
# not_supported instead of pretending a tool ran.
# Run a subprocess (cstr argv vec) and capture stdout into a caller buffer.
# Returns Ok(bytes_read) only when the child exited 0 within the default bound;
# Err(errmsg) otherwise. Shared by dmverity/luks `*_run_capture`.
fn agnosys_run_capture(args, buf, buflen, errmsg): i64 {
    return agnosys_run_capture_timeout(args, buf, buflen, 0, errmsg);
}

# ⚠ BOUNDED, STATUS-CHECKED CAPTURE. 3.12.11 — kybernet audit MEDIUM-8.
#
# `agnosys_run_capture` above delegated (until M10) to the stdlib's `exec_capture`,
# which has two properties that are fine for a CLI and wrong for an init system:
#
#   1. IT IS UNBOUNDED. The drain is a blocking `sys_read` loop and the reap is
#      `sys_waitpid(pid, &stbuf, 0)` with no WNOHANG and no deadline. A tool that
#      wedges — /dev/tpm0 held open by another consumer, a tabrmd/D-Bus TCTI
#      wait, a firmware TPM in a bad state — blocks the caller forever. kybernet
#      calls this at phase 6c, BEFORE its event loop, so nothing reaps, nothing
#      services a watchdog, no service has started, and every signal is blocked:
#      the board looks dead with `edge boot: reading PCRs` as its last line.
#   2. IT FAILS OPEN. `exec_capture` DISCARDS waitpid's status and returns the
#      byte count regardless, so a tool that was missing or exited 127 comes
#      back as `Ok(0)` — and sigil's PCR parser then zero-fills every PCR it
#      could not find. An attestation "pass" derived from a tool that never ran.
#
# One aggravator worth recording, because it inverts the usual reasoning about
# who is trusted: in kybernet the PCR read runs BEFORE the dm-verity verify, so
# an attacker who has already tampered with the rootfs can plant a
# `tpm2_pcrread` that simply sleeps and wedge PID 1 before verification ever
# executes.
#
# This is modelled on argonaut 1.13.2's `run_safe_cmd_timeout`, which made the
# same move for `run_safe_cmd` after the same class of finding.
#
# Returns Ok(bytes_captured) ONLY when the child exited 0 inside the deadline.
# Err on: spawn failure, timeout (child SIGKILLed and reaped), abnormal exit, or
# any non-zero status. `timeout_ms <= 0` means "use the default" rather than
# "wait forever" — an unbounded exec is the defect this exists to remove.
enum AgnosysCaptureLimits { AGNOSYS_CAPTURE_DEFAULT_TIMEOUT_MS = 10000; }

# Run a subprocess under a wall-clock bound, capturing its stdout into `buf`.
# Returns Ok(bytes_captured) only when the child exited 0 within `timeout_ms`;
# Err(errmsg) on spawn failure, timeout (the child is SIGKILLed and reaped),
# abnormal termination, or any non-zero exit. `timeout_ms <= 0` uses
# AGNOSYS_CAPTURE_DEFAULT_TIMEOUT_MS rather than waiting forever. Unlike
# `agnosys_run_capture` this never reports a tool that failed or never ran as a
# successful capture of zero bytes. See the note above for why that matters.
fn agnosys_run_capture_timeout(args, buf, buflen, timeout_ms, errmsg): i64 {
    var argc = vec_len(args);
    if (argc < 1) { return sigil_err_invalid_argument("empty argv"); }

    # ⛔⛔ AGNOS HAS NO SUBPROCESS. This function is pipe -> fork -> dup2 -> execve -> waitpid, and
    # agnos has **none** of those: no `sys_fork`, no `sys_execve`, no three-argument `sys_waitpid`,
    # no `SYS_FCNTL`, no `WNOHANG`. It reaches ring 3 through `spawn_path #43`, a different shape
    # entirely — a spawn with no fork and no wait-with-status.
    # ⛔ AND UNGUARDED, IT BROKE EVERY AGNOS CONSUMER'S BUILD, not just this call. Cyrius treats an
    # undefined *variable* as a hard error regardless of reachability (unlike an undefined function,
    # which is downgraded), so `SYS_FCNTL` and `WNOHANG` failed the whole compile. aethersafha could
    # not build its `--agnos` target at all — measured 2026-08-27, and it presented as "the desktop is
    # broken" four repos away from the line that caused it.
    # ⚠ REFUSE, DO NOT SILENTLY SUCCEED. `Ok(0)` here would be "the tool ran and produced no output",
    # which is precisely the lie this function was ADDED to remove — see the header note about
    # `agnosys_run_capture` reporting a tool that never ran as a successful capture of zero bytes.
    # `ENOSYS` is the honest code: the feature is absent on this target, not failing on it.
    #ifdef CYRIUS_TARGET_AGNOS
    return sigil_err_not_supported("subprocess capture (no fork/execve on agnos)");
    #endif
    # 3.12.14 — ⛔ WINDOWS NEEDS THE SAME REFUSAL, AND 3.12.12 ONLY FIXED AGNOS.
    # The reasoning in the note above is not agnos-specific: it is about targets with no
    # fork/execve/fcntl. Windows is one. The cyrius PE peer (`lib/syscalls_windows.cyr`) has
    # no `SYS_FCNTL` at all, so by the very mechanism that note describes — an undefined
    # VARIABLE is a hard error regardless of reachability — this function failed the whole
    # compile on PE. The blast radius was the same shape too: sigil is in mabda's and yukti's
    # closure, so *their* Windows builds died as well, on a line neither repo contains.
    # Caught by cyrius 6.5.36's `pe_reloc_cap_full_stdlib` gate while folding 3.12.13.
    # ⚠ Guarding one target and stopping is what made this a second incident. Any future
    # target without fork/exec needs an arm here; the POSIX body below is the exception, not
    # the default.
    #ifdef CYRIUS_TARGET_WIN
    return sigil_err_not_supported("subprocess capture (no fork/execve on windows)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    #ifndef CYRIUS_TARGET_WIN

    var tmo = timeout_ms;
    if (tmo <= 0) { tmo = AGNOSYS_CAPTURE_DEFAULT_TIMEOUT_MS; }

    var argv = alloc((argc + 1) * 8);
    var avi = 0;
    while (avi < argc) {
        store64(argv + avi * 8, vec_get(args, avi));
        avi = avi + 1;
    }
    store64(argv + argc * 8, 0);
    var envp = alloc(8);
    store64(envp, 0);

    var pipefd[16];
    if (sys_pipe(&pipefd) < 0) { return sigil_err_unknown(errmsg); }
    var rfd = load32(&pipefd);
    var wfd = load32(&pipefd + 4);

    var pid = sys_fork();
    if (pid < 0) { sys_close(rfd); sys_close(wfd); return sigil_err_unknown(errmsg); }
    if (pid == 0) {
        sys_close(rfd);
        sys_dup2(wfd, 1);
        sys_close(wfd);
        var devnull = file_open("/dev/null", O_WRONLY, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); file_close(devnull); }
        sys_execve(vec_get(args, 0), argv, envp);
        sys_exit(127);
    }
    sys_close(wfd);

    # Non-blocking drain, so a child that produces nothing cannot pin us in
    # read(2). SYS_FCNTL is an arch-dispatched stdlib enum (x86_64 72,
    # aarch64 25), not a literal. It stays a direct `syscall(...)` because the
    # stdlib has no `sys_fcntl` wrapper yet — requested upstream, cyrius
    # docs/development/issues/2026-09-23-sigil-sys-fcntl-wrapper.md; switch to it
    # when it lands. F_GETFL (3) / F_SETFL (4) are the same on Linux and Darwin.
    # 3.13.0: `O_NONBLOCK` is the per-target stdlib name. The literal 2048 it
    # replaces is Linux's value; Darwin's O_NONBLOCK is 4 and 2048 there is O_EXCL,
    # which F_SETFL ignores — so on macOS the pipe stayed BLOCKING and a silent
    # child could hold the "bounded" drain in read(2) past its deadline.
    var fl = syscall(SYS_FCNTL, rfd, 3, 0);          # F_GETFL
    syscall(SYS_FCNTL, rfd, 4, fl | O_NONBLOCK);     # F_SETFL |= O_NONBLOCK

    var deadline = clock_now_ms() + tmo;
    var total = 0;
    var draining = 1;
    var timed_out = 0;
    while (draining == 1) {
        if (clock_now_ms() > deadline) { timed_out = 1; draining = 0; }
        elif (total >= buflen) { draining = 0; }
        else {
            var n = sys_read(rfd, buf + total, buflen - total);
            if (n > 0) { total = total + n; }
            elif (n == 0) { draining = 0; }              # EOF: child closed stdout
            elif (n == 0 - 11) { sleep_ms(5); }          # EAGAIN: nothing yet
            else { draining = 0; }                        # a real read error
        }
    }
    sys_close(rfd);

    var st[4];
    if (timed_out == 1) {
        sys_kill(pid, SIGKILL);
        sys_waitpid(pid, &st, 0);     # lands: the child is killed
        return sigil_err_unknown(errmsg);
    }

    # Bounded reap. ⚠ CHECK waitpid's RETURN BEFORE READING THE STATUS — a wait
    # that did not land leaves the buffer holding whatever was there before,
    # which is how `exec_capture` reports a child it never reaped as exit 0.
    var reaped = 0;
    while (clock_now_ms() <= deadline) {
        var r = sys_waitpid(pid, &st, WNOHANG);
        if (r > 0) { reaped = 1; break; }
        if (r < 0) { break; }
        sleep_ms(2);
    }
    if (reaped == 0) {
        sys_kill(pid, SIGKILL);
        sys_waitpid(pid, &st, 0);
        return sigil_err_unknown(errmsg);
    }

    var status = load32(&st);
    if (WIFEXITED(status) == 0) { return sigil_err_unknown(errmsg); }
    if (WEXITSTATUS(status) != 0) { return sigil_err_unknown(errmsg); }
    return Ok(total);
    #endif
    #endif
}

# Run a subprocess (cstr argv vec) and check for a zero exit code.
# Returns Ok(0) or Err(errmsg) on non-zero exit / exec failure. Shared by
# dmverity/luks/tpm `*_run_checked`.
# ⚠ BOUNDED AND STATUS-CHECKED. 3.12.13.
#
# This delegated to the cyrius stdlib's `exec_vec`, which standing rule 17 in
# kybernet forbids outright, for two reasons that both matter to its callers —
# `veritysetup` (dmverity.cyr), the tpm2 tools (tpm_core.cyr) and `cryptsetup`
# (luks.cyr), i.e. every security-relevant exec sigil makes:
#
#   1. UNBOUNDED. `exec_vec` waits with `sys_waitpid(pid, &stbuf, 0)` — no
#      WNOHANG, no deadline. Under kybernet, which is PID 1 and blocks all
#      signals into a signalfd, the wait is not even EINTR-breakable, so a
#      wedged tool is a dead board.
#   2. FAILS OPEN. It discards waitpid's return before reading a `var stbuf[4]`
#      that is STATIC storage in cyrius, so a wait that does not land decodes
#      status 0 as SUCCESS. On `veritysetup verify` that is a verification which
#      never ran, reported as verified.
#
# Modelled on `agnosys_run_capture_timeout` above, but with the child's stdout
# and stderr on /dev/null rather than a pipe. That is deliberate: a checked run
# does not want the output, and a pipe the parent stops draining would hand a
# chatty tool EPIPE and turn a successful command into a reported failure.
#
# `timeout_ms <= 0` takes AGNOSYS_CAPTURE_DEFAULT_TIMEOUT_MS rather than waiting
# forever. Returns Ok(0) only when the child exited 0 inside the deadline.
fn agnosys_run_checked_timeout(args, timeout_ms, errmsg): i64 {
    var argc = vec_len(args);
    if (argc < 1) { return sigil_err_invalid_argument("empty argv"); }

    # 3.12.14 — SAME REFUSAL AS `agnosys_run_capture_timeout` ABOVE, AND FOR THE SAME REASON.
    # ⛔ 3.12.13 added this function — the release whose headline was "every exec in sigil is
    # bounded and status-checked" — and shipped it with NO target guard at all, one release
    # after 3.12.12 guarded its sibling. So the fix and the regression landed together: the
    # agnos/Windows break simply moved to the new function. cyrius 6.5.36's
    # `folds_agnos_parity` gate reported 11 of 11 folds broken on agnos, all one root cause
    # here (`WNOHANG` undefined, `sys_waitpid` arity 1 not 3).
    # ⚠ THE LESSON IS THE ONE 3.12.12 ALREADY WROTE DOWN: fork/exec is the exception, not the
    # default. A new subprocess helper needs these arms on the way IN, not a release later.
    #ifdef CYRIUS_TARGET_AGNOS
    return sigil_err_not_supported("checked subprocess run (no fork/execve on agnos)");
    #endif
    #ifdef CYRIUS_TARGET_WIN
    return sigil_err_not_supported("checked subprocess run (no fork/execve on windows)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    #ifndef CYRIUS_TARGET_WIN

    var tmo = timeout_ms;
    if (tmo <= 0) { tmo = AGNOSYS_CAPTURE_DEFAULT_TIMEOUT_MS; }

    var argv = alloc((argc + 1) * 8);
    var avi = 0;
    while (avi < argc) {
        store64(argv + avi * 8, vec_get(args, avi));
        avi = avi + 1;
    }
    store64(argv + argc * 8, 0);
    var envp = alloc(8);
    store64(envp, 0);

    var pid = sys_fork();
    if (pid < 0) { return sigil_err_unknown(errmsg); }
    if (pid == 0) {
        var devnull = file_open("/dev/null", O_WRONLY, 0);
        if (devnull >= 0) {
            sys_dup2(devnull, 1);
            sys_dup2(devnull, 2);
            file_close(devnull);
        }
        sys_execve(vec_get(args, 0), argv, envp);
        sys_exit(127);
    }

    # Bounded reap. ⚠ waitpid's RETURN is checked BEFORE the status is read —
    # that check is exactly what `exec_vec` omits, and omitting it is how a
    # child that was never reaped reports as exit 0.
    var st[4];
    var deadline = clock_now_ms() + tmo;
    var reaped = 0;
    while (clock_now_ms() <= deadline) {
        var r = sys_waitpid(pid, &st, WNOHANG);
        if (r > 0) { reaped = 1; break; }
        if (r < 0) { break; }
        sleep_ms(2);
    }
    if (reaped == 0) {
        sys_kill(pid, SIGKILL);
        sys_waitpid(pid, &st, 0);
        return sigil_err_unknown(errmsg);
    }

    var status = load32(&st);
    if (WIFEXITED(status) == 0) { return sigil_err_unknown(errmsg); }
    if (WEXITSTATUS(status) != 0) { return sigil_err_unknown(errmsg); }
    return Ok(0);
    #endif
    #endif
}

# ⚠ DROP-IN BOUNDED REPLACEMENT FOR THE STDLIB'S `exec_capture`. 3.12.13.
#
# Same shape as `exec_capture(args, buf, buflen)` — returns the number of bytes
# captured — so a call site converts by changing the function name and nothing
# else. The difference is the two properties rule 17 exists for: it is BOUNDED,
# and it returns **-1** when the child timed out, could not be spawned, or exited
# non-zero, instead of handing back a byte count for a tool that never ran.
#
# That -1 is the point. Every existing call site already tests `n <= 0` or
# `n < 0` and treats it as failure, so converting turns a fail-OPEN read (a
# zero-filled buffer parsed as if it were output) into a fail-CLOSED one with no
# change at the call site.
fn agnosys_capture_n(args, buf, buflen, timeout_ms): i64 {
    var r_tag, r = agnosys_run_capture_timeout(args, buf, buflen, timeout_ms, "capture failed");
    if (is_err_result(r_tag) == 1) { return 0 - 1; }
    return r;
}

# Back-compatible wrapper: bounded by the default rather than unbounded.
fn agnosys_run_checked(args, errmsg): i64 {
    return agnosys_run_checked_timeout(args, 0, errmsg);
}

# Read up to `cap` bytes from `fd` into a fresh heap buffer, NUL-terminate,
# and return it as a Str (also valid as a cstr). Drains short reads. The
# buffer is `cap + 1` bytes so the terminator never writes past the end
# even at a full read (the per-module copies alloc'd exactly `cap`, a
# latent 1-byte overflow when the file filled the buffer). Shared by the
# pam config / passwd readers. Returns 0 if a read fails: only a 0-byte read is end-of-file
# (3.13.1 — a read error used to end the loop too, returning the prefix read so far as if it
# were the whole file).
fn agnosys_read_fd_to_str(fd, cap): i64 {
    var buf = alloc(cap + 1);
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(fd, buf + total, cap - total);
        if (n < 0) { return 0; }
        if (n == 0) {
            rgo = 0;
        } else {
            total = total + n;
            if (total >= cap) { rgo = 0; }
        }
    }
    store8(buf + total, 0);
    return str_new(buf, total);
}

# Write the WHOLE buffer to `fd` through io.cyr's `file_write`, looping until
# every byte lands. Returns `len`, or a negative errno; a write that makes no
# progress (returns 0) is -EIO (-5). A short write is never reported as success.
# 3.13.0: the LUKS keyfile, `tpm_seal`'s staged plaintext and the IMA policy each
# made ONE write and accepted a short count, so a full disk / RLIMIT_FSIZE / a
# signal could hand cryptsetup a truncated key, or seal or load a truncated
# payload, with no error. Same contract as the stdlib's module-private
# `_io_write_full` (cyrius 6.6.6), which has no public fd-level counterpart.
fn agnosys_write_all(fd, buf, len): i64 {
    var off = 0;
    while (off < len) {
        var w = file_write(fd, buf + off, len - off);
        if (w < 0) { return w; }
        if (w == 0) { return 0 - 5; }
        off = off + w;
    }
    return len;
}
