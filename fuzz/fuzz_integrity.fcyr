# fuzz_integrity.fcyr — fuzz integrity verifier operations
#
# NOTE on fmt_int: lib/fmt.cyr `fmt_int(n)` prints to stdout and
# returns 0 (not a C-string). Use `fmt_int_buf(n, buf)` to write
# digits into a buffer and get a length back.

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fmt.cyr"
include "lib/sakshi.cyr"
include "lib/chrono.cyr"
include "lib/random.cyr"
include "lib/thread_local.cyr"
include "lib/bayan.cyr"

include "src/types.cyr"
include "src/error.cyr"
include "src/random.cyr"
include "src/crypto_scratch.cyr"
include "src/mul64.cyr"
include "src/sha256.cyr"
include "src/hex.cyr"
include "lib/ct.cyr"
include "src/hmac.cyr"
include "src/sha512.cyr"
include "src/bigint_ext.cyr"
include "src/ed25519.cyr"
include "src/trust.cyr"
include "src/integrity.cyr"
include "tests/scratch.cyr"

# "<scratch dir>/sigil_fuzz_{i}.bin" as a fresh C string — inside this run's private directory
# (tests/scratch.cyr; through 3.13.7 a fixed name in the shared /tmp).
fn _fuzz_path(i) {
    var name = alloc(40);
    memcpy(name, "sigil_fuzz_", 11);
    var nbuf[24];
    memset(&nbuf, 0, 24);
    var nlen = fmt_int_buf(i, &nbuf);
    memcpy(name + 11, &nbuf, nlen);
    memcpy(name + 11 + nlen, ".bin", 4);
    store8(name + 15 + nlen, 0);
    return scratch_path(name);
}

fn main() {
    alloc_init();
    if (scratch_init("fuzz_integrity") == 0) {
        assert(0, "a private per-run scratch directory under $TMPDIR");
        return assert_summary();
    }
    ed25519_init();

    # Create temp files with known content
    var i = 0;
    while (i < 20) {
        var path = _fuzz_path(i);
        var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 420);
        var content = alloc(256);
        memset(content, 0x41 + (i % 26), 256);
        file_write(fd, content, 256);
        file_close(fd);
        i = i + 1;
    }

    # Build integrity policy with correct hashes
    var policy = integrity_policy_new();
    i = 0;
    while (i < 20) {
        var path = _fuzz_path(i);
        var h = hash_file(path);
        if (h != 0) {
            ipolicy_add(policy, path, h);
        }
        i = i + 1;
    }

    # Verify all — should be clean
    var iv = integrity_verifier_new(policy);
    var report = iv_verify_all(iv);
    assert_eq(ireport_is_clean(report), 1, "all clean");
    assert_eq(ireport_total(report), 20, "20 files");

    # Export and import baseline
    var snap = iv_export_baseline(iv);
    var count = iv_import_baseline(iv, snap);
    assert_eq(count, 20, "imported 20");

    # Verify again after import
    var report2 = iv_verify_all(iv);
    assert_eq(ireport_is_clean(report2), 1, "clean after import");

    # Tamper with one file and re-verify
    var tamper_fd = file_open(_fuzz_path(5), O_WRONLY | O_CREAT | O_TRUNC, 420);
    file_write(tamper_fd, "TAMPERED", 8);
    file_close(tamper_fd);

    var report3 = iv_verify_all(iv);
    assert_eq(ireport_is_clean(report3), 0, "tamper detected");
    assert_eq(vec_len(ireport_mismatches(report3)), 1, "1 mismatch");

    # Cleanup
    i = 0;
    while (i < 20) {
        var path = _fuzz_path(i);
        xunlink(path);
        i = i + 1;
    }

    assert_eq(scratch_cleanup(), 0, "the scratch directory and everything in it is removed");
    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
