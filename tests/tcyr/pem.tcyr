# pem.tcyr — PEM decoder tests.
#
# Sigil 3.5 — bite 1 of the TEE-attestation completion arc.
#
# Test fixtures: the existing root + leaf P-256 certs from
# `tests/tcyr/x509.tcyr` re-encoded as PEM (base64 + markers,
# 64-col line breaks). The decoder round-trip must reproduce the
# original DER bytes exactly so we can chain into x509_parse +
# x509_verify_chain.

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/str.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fmt.cyr"
include "lib/bayan.cyr"
include "lib/sakshi.cyr"
include "lib/chrono.cyr"
include "lib/ct.cyr"

include "lib/thread_local.cyr"
include "src/crypto_scratch.cyr"
include "src/mul64.cyr"
include "src/types.cyr"
include "src/error.cyr"
include "src/sha256.cyr"
include "src/hex.cyr"
include "src/sha512.cyr"
include "src/sha384.cyr"
include "src/bigint_ext.cyr"
include "src/bignum.cyr"
include "src/ed25519.cyr"
include "src/ecdsa_p256.cyr"
include "src/ecdsa_p384.cyr"
include "src/x509.cyr"
include "src/pem.cyr"
include "src/rsa.cyr"

# ------------------------------------------------------------------
# Fixtures — generated 2026-05-22 by gen_pem_fixtures.py against the
# existing x509.tcyr root + leaf DER. The PEMs use the 64-col line
# break that `openssl x509` produces by default.
# ------------------------------------------------------------------

var ROOT_DER_HEX = "";
var ROOT_DER_LEN = 421;

var LEAF_DER_HEX = "";
var LEAF_DER_LEN = 413;

var ROOT_PEM_HEX = "";
var ROOT_PEM_LEN = 627;

var LEAF_PEM_HEX = "";
var LEAF_PEM_LEN = 615;

var CHAIN_PEM_HEX = "";
var CHAIN_PEM_LEN = 1242;

# Helper: byte-by-byte equality.
fn bytes_eq(a, b, len): i64 {
    var i = 0;
    while (i < len) {
        if ((load8(a + i) & 0xFF) != (load8(b + i) & 0xFF)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ------------------------------------------------------------------
# 3.13.7 — trust-bundle decode (pem_decode_certs_lenient_into +
# pem_decode_certs_count). One malformed block used to fail the whole
# bundle (pem_decode_certs_into is all-or-nothing), so one corrupt
# block in an OS store installed zero roots in cyrius's native TLS.
# ------------------------------------------------------------------

# Malformed blocks, one per defect the strict decode refuses.
var BAD_B64     = "-----BEGIN CERTIFICATE-----\nAAAA*AAAA\n-----END CERTIFICATE-----\n";
var UNMATCHED   = "-----BEGIN CERTIFICATE-----\nAAAA\n";
var EMPTY_BODY  = "-----BEGIN CERTIFICATE-----\n-----END CERTIFICATE-----\n";
var BAD_PAD     = "-----BEGIN CERTIFICATE-----\nAAAA====\n-----END CERTIFICATE-----\n";
var PAD_ALPHA   = "-----BEGIN CERTIFICATE-----\nAAA=AAAA\n-----END CERTIFICATE-----\n";
var PARTIAL_Q   = "-----BEGIN CERTIFICATE-----\nAAAAA\n-----END CERTIFICATE-----\n";
var STRAY_END   = "-----END CERTIFICATE-----\n";

var _rd = 0;    # root DER / leaf DER / root PEM / leaf PEM (set in main)
var _ld = 0;
var _rp = 0;
var _lp = 0;

# The bundle under construction. The buffer holds 8 of the largest block (the root PEM):
# Group 18 writes up to 7. pb_add refuses to write past it — the decode's pool is allocated
# right after, so an overrun would be decoded over before it was read.
var _pb_buf = 0;
var _pb_len = 0;
var _pb_cap = 0;

fn pb_reset(): i64 {
    _pb_cap = 8 * ROOT_PEM_LEN;
    _pb_buf = alloc(_pb_cap);
    _pb_len = 0;
    return 0;
}

fn pb_add(p, n): i64 {
    if (_pb_len + n > _pb_cap) {
        assert_eq(_pb_len + n, _pb_cap, "pb_add: the bundle fits its buffer");
        return 0 - 1;
    }
    memcpy(_pb_buf + _pb_len, p, n);
    _pb_len = _pb_len + n;
    return 0;
}

fn pb_str(s): i64 { return pb_add(s, strlen(s)); }
fn pb_root(): i64 { return pb_add(_rp, ROOT_PEM_LEN); }
fn pb_leaf(): i64 { return pb_add(_lp, LEAF_PEM_LEN); }

# The leaf's PEM with its last body character replaced by `*`: a block as long as a real
# certificate whose defect is only found at the end of its body.
fn pb_leaf_bad_tail(): i64 {
    var at = _pb_len;
    pb_leaf();
    # LEAF_PEM ends "...<body>\n-----END CERTIFICATE-----\n": the body's last byte is 28 back.
    store8(_pb_buf + at + LEAF_PEM_LEN - 28, 42);
    return 0;
}

# 1 when chain entry i holds exactly der[0..len).
fn entry_is(chain, i, der, len): i64 {
    if (load64(chain + i * 16 + 8) != len) { return 0; }
    return bytes_eq(load64(chain + i * 16), der, len);
}

# Decode the current bundle leniently with ample room (max_certs 8, pool = bundle length).
fn pb_lenient(chain, skp): i64 {
    var pool = alloc(_pb_len + 1);
    return pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 8, pool, _pb_len, skp);
}

# The strict decode of the current bundle, for contrast.
fn pb_strict(chain): i64 {
    var pool = alloc(_pb_len + 1);
    return pem_decode_certs_into(_pb_buf, _pb_len, chain, 8, pool, _pb_len);
}

fn pb_count(): i64 { return pem_count_cert_blocks(_pb_buf, _pb_len); }

# One malformed block among root + leaf: both survive in order, one is skipped, the count
# invariant holds, and the strict decode still refuses the bundle.
fn check_root_leaf_one_bad(chain): i64 {
    var sk = 99;
    var n = pb_lenient(chain, &sk);
    assert_eq(n, 2, "  both good certificates decode");
    assert_eq(sk, 1, "  exactly one block skipped");
    assert_eq(entry_is(chain, 0, _rd, ROOT_DER_LEN), 1, "  entry 0 is the root, byte for byte");
    assert_eq(entry_is(chain, 1, _ld, LEAF_DER_LEN), 1, "  entry 1 is the leaf, byte for byte");
    assert_eq(pb_count(), 3, "  pem_count_cert_blocks sees 3 blocks (decoded + skipped)");
    assert_eq(pb_strict(chain), 0 - 1, "  strict decode still refuses the bundle");
    return 0;
}

fn lenient_tests(): i64 {
    var chain = alloc(8 * 16);
    var sk = 0;
    var n = 0;

    # ============================================================
    # Group 10 — clean bundle: same answer as the strict decode
    # ============================================================
    test_group("pem_decode_certs_lenient_into — clean bundle");
    pb_reset(); pb_root(); pb_leaf();
    sk = 99;
    n = pb_lenient(chain, &sk);
    assert_eq(n, 2, "clean root + leaf bundle decodes 2");
    assert_eq(sk, 0, "nothing skipped");
    assert_eq(entry_is(chain, 0, _rd, ROOT_DER_LEN), 1, "entry 0 is the root");
    assert_eq(entry_is(chain, 1, _ld, LEAF_DER_LEN), 1, "entry 1 is the leaf");
    assert_eq(pb_count(), 2, "pem_count_cert_blocks = 2");

    # ============================================================
    # Group 11 — one bad-base64 block first / middle / last
    # ============================================================
    test_group("pem_decode_certs_lenient_into — bad base64 first");
    pb_reset(); pb_str(BAD_B64); pb_root(); pb_leaf();
    check_root_leaf_one_bad(chain);
    test_group("pem_decode_certs_lenient_into — bad base64 middle");
    pb_reset(); pb_root(); pb_str(BAD_B64); pb_leaf();
    check_root_leaf_one_bad(chain);
    test_group("pem_decode_certs_lenient_into — bad base64 last");
    pb_reset(); pb_root(); pb_leaf(); pb_str(BAD_B64);
    check_root_leaf_one_bad(chain);
    test_group("pem_decode_certs_lenient_into — certificate-sized block, defect at its end");
    pb_reset(); pb_root(); pb_leaf_bad_tail(); pb_leaf();
    check_root_leaf_one_bad(chain);

    # ============================================================
    # Group 12 — unmatched BEGIN first / middle / last
    # ============================================================
    # In the middle, the strict walk takes the NEXT block's END and fails on the BEGIN
    # text inside the body; the lenient walk resumes at that BEGIN.
    test_group("pem_decode_certs_lenient_into — unmatched BEGIN first");
    pb_reset(); pb_str(UNMATCHED); pb_root(); pb_leaf();
    check_root_leaf_one_bad(chain);
    test_group("pem_decode_certs_lenient_into — unmatched BEGIN middle");
    pb_reset(); pb_root(); pb_str(UNMATCHED); pb_leaf();
    check_root_leaf_one_bad(chain);
    test_group("pem_decode_certs_lenient_into — unmatched BEGIN last");
    pb_reset(); pb_root(); pb_leaf(); pb_str(UNMATCHED);
    check_root_leaf_one_bad(chain);

    test_group("pem_decode_certs_lenient_into — a run of unmatched BEGINs at the tail");
    pb_reset(); pb_root(); pb_str(UNMATCHED); pb_str(UNMATCHED); pb_str(UNMATCHED);
    sk = 0;
    n = pb_lenient(chain, &sk);
    assert_eq(n, 1, "the root still decodes");
    assert_eq(sk, 3, "all three unmatched BEGINs skipped");
    assert_eq(entry_is(chain, 0, _rd, ROOT_DER_LEN), 1, "entry 0 is the root");
    assert_eq(pb_count(), 4, "pem_count_cert_blocks = 4");

    # ============================================================
    # Group 13 — every malformed-body kind is skipped
    # ============================================================
    test_group("pem_decode_certs_lenient_into — every malformed body kind");
    pb_reset();
    pb_root();
    pb_str(EMPTY_BODY); pb_str(BAD_PAD); pb_str(PAD_ALPHA); pb_str(PARTIAL_Q); pb_str(BAD_B64);
    pb_str(STRAY_END);
    pb_leaf();
    sk = 0;
    n = pb_lenient(chain, &sk);
    assert_eq(n, 2, "root and leaf decode around five malformed blocks");
    assert_eq(sk, 5, "empty body, excess padding, alpha after pad, partial quad, bad byte: 5 skipped");
    assert_eq(entry_is(chain, 0, _rd, ROOT_DER_LEN), 1, "entry 0 is the root");
    assert_eq(entry_is(chain, 1, _ld, LEAF_DER_LEN), 1, "entry 1 is the leaf");
    assert_eq(pb_count(), 7, "pem_count_cert_blocks = 7 (a stray END is not a block)");

    # ============================================================
    # Group 14 — nothing decodes
    # ============================================================
    test_group("pem_decode_certs_lenient_into — all bad / no blocks");
    pb_reset(); pb_str(BAD_B64); pb_str(UNMATCHED);
    sk = 0;
    assert_eq(pb_lenient(chain, &sk), 0, "all blocks bad: 0 decoded (not -1)");
    assert_eq(sk, 2, "all blocks bad: both skipped");
    assert_eq(pb_count(), 2, "all blocks bad: pem_count_cert_blocks = 2");
    pb_reset(); pb_str("no markers here at all\n"); pb_str(STRAY_END);
    sk = 99;
    assert_eq(pb_lenient(chain, &sk), 0, "no BEGIN marker: 0 decoded");
    assert_eq(sk, 0, "no BEGIN marker: 0 skipped");
    assert_eq(pb_count(), 0, "no BEGIN marker: pem_count_cert_blocks = 0");
    var pool0 = alloc(8);
    sk = 99;
    assert_eq(pem_decode_certs_lenient_into(pool0, 0, chain, 8, pool0, 8, &sk), 0,
      "empty input: 0 decoded");
    assert_eq(sk, 0, "empty input: 0 skipped");
    assert_eq(pem_count_cert_blocks(pool0, 0), 0, "empty input: pem_count_cert_blocks = 0");

    # ============================================================
    # Group 15 — capacity edges
    # ============================================================
    test_group("pem_decode_certs_lenient_into — out_chain capacity");
    # A skipped block takes no entry: max_certs = the good-block count suffices.
    pb_reset(); pb_str(BAD_B64); pb_root(); pb_leaf();
    var pool = alloc(_pb_len);
    sk = 0;
    n = pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 2, pool, _pb_len, &sk);
    assert_eq(n, 2, "bad block first, max_certs = 2 good: 2 decoded");
    assert_eq(sk, 1, "bad block first, max_certs = 2 good: 1 skipped");
    # ...including one after the entries are full: a block takes an entry only once it decodes.
    pb_reset(); pb_root(); pb_leaf(); pb_str(BAD_B64);
    pool = alloc(_pb_len);
    sk = 0;
    n = pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 2, pool, _pb_len, &sk);
    assert_eq(n, 2, "bad base64 after the last good one, max_certs = 2: 2 decoded");
    assert_eq(sk, 1, "bad base64 after the last good one, max_certs = 2: 1 skipped");
    pb_reset(); pb_root(); pb_leaf(); pb_str(UNMATCHED);
    pool = alloc(_pb_len);
    sk = 0;
    n = pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 2, pool, _pb_len, &sk);
    assert_eq(n, 2, "unmatched BEGIN after the last good one, max_certs = 2: 2 decoded");
    assert_eq(sk, 1, "unmatched BEGIN after the last good one, max_certs = 2: 1 skipped");
    # A well-formed block with no entry left is a capacity failure, not a skip.
    pb_reset(); pb_root(); pb_str(BAD_B64); pb_leaf();
    pool = alloc(_pb_len);
    sk = 77;
    n = pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 1, pool, _pb_len, &sk);
    assert_eq(n, 0 - 1, "2 good blocks, max_certs = 1: -1");
    assert_eq(sk, 0, "on -1 out_skipped is 0");
    # Entries past the returned count are untouched.
    memset(chain, 0x5A, 8 * 16);
    pb_reset(); pb_str(BAD_B64); pb_root();
    sk = 0;
    n = pb_lenient(chain, &sk);
    assert_eq(n, 1, "bad + root: 1 decoded");
    assert_eq(load64(chain + 16), 0x5A5A5A5A5A5A5A5A, "entry 1 (past the count) untouched");
    assert_eq(load64(chain + 24), 0x5A5A5A5A5A5A5A5A, "entry 1 length untouched");

    test_group("pem_decode_certs_lenient_into — der_pool capacity");
    # Pool exactly the two DERs (834 B): a certificate-sized bad block between them writes
    # into the pool before its defect shows, and must not keep any of it.
    pb_reset(); pb_root(); pb_leaf_bad_tail(); pb_leaf();
    pool = alloc(ROOT_DER_LEN + LEAF_DER_LEN);
    sk = 0;
    n = pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 8, pool,
      ROOT_DER_LEN + LEAF_DER_LEN, &sk);
    assert_eq(n, 2, "pool = exactly the good DER: 2 decoded");
    assert_eq(sk, 1, "pool = exactly the good DER: the bad block skipped");
    assert_eq(entry_is(chain, 1, _ld, LEAF_DER_LEN), 1, "the leaf filled the pool's tail intact");
    # One byte short: the well-formed leaf does not fit — a capacity failure.
    pb_reset(); pb_root(); pb_leaf();
    pool = alloc(ROOT_DER_LEN + LEAF_DER_LEN);
    sk = 77;
    n = pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 8, pool,
      ROOT_DER_LEN + LEAF_DER_LEN - 1, &sk);
    assert_eq(n, 0 - 1, "pool one byte short of a well-formed block: -1");
    assert_eq(sk, 0, "pool one byte short: out_skipped 0");
    # No room at all for a MALFORMED block: still a skip, not a capacity failure.
    pb_reset(); pb_root(); pb_leaf_bad_tail();
    pool = alloc(ROOT_DER_LEN);
    sk = 0;
    n = pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 8, pool, ROOT_DER_LEN, &sk);
    assert_eq(n, 1, "pool full, then a malformed block: 1 decoded (not -1)");
    assert_eq(sk, 1, "pool full, then a malformed block: it is skipped");
    # ...whereas a well-formed block in the same place is a capacity failure.
    pb_reset(); pb_root(); pb_leaf();
    pool = alloc(ROOT_DER_LEN);
    n = pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 8, pool, ROOT_DER_LEN, &sk);
    assert_eq(n, 0 - 1, "pool full, then a well-formed block: -1");

    test_group("pem_decode_certs_lenient_into — arguments");
    pb_reset(); pb_root();
    pool = alloc(_pb_len);
    n = pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 8, pool, _pb_len, 0);
    assert_eq(n, 1, "out_skipped = 0 (not wanted) is accepted");
    sk = 77;
    assert_eq(pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 0, pool, _pb_len, &sk),
      0 - 1, "max_certs = 0: -1");
    assert_eq(sk, 0, "max_certs = 0: out_skipped 0");
    assert_eq(pem_decode_certs_lenient_into(_pb_buf, 0 - 1, chain, 8, pool, _pb_len, &sk),
      0 - 1, "pem_len < 0: -1");
    assert_eq(pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 8, pool, 0 - 1, &sk),
      0 - 1, "der_pool_size < 0: -1");
    assert_eq(pem_decode_certs_lenient_into(_pb_buf, _pb_len, 0, 8, pool, _pb_len, &sk),
      0 - 1, "null out_chain: -1");
    assert_eq(pem_decode_certs_lenient_into(0, 16, chain, 8, pool, _pb_len, &sk),
      0 - 1, "null pem with a length: -1");
    assert_eq(pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 8, 0, 16, &sk),
      0 - 1, "null der_pool with a size: -1");
    assert_eq(pem_count_cert_blocks(_pb_buf, 0 - 1), 0 - 1, "pem_count_cert_blocks: pem_len < 0 -> -1");
    assert_eq(pem_count_cert_blocks(0, 16), 0 - 1, "pem_count_cert_blocks: null pem -> -1");
    # Each argument check on its own: on inputs where nothing else returns -1 (no capacity
    # failure — no BEGIN marker, or every block malformed before a byte is written), so the
    # check alone decides.
    sk = 77;
    assert_eq(pem_decode_certs_lenient_into("no markers", 10, chain, 0, pool, 8, &sk),
      0 - 1, "max_certs = 0, no BEGIN marker: -1");
    assert_eq(sk, 0, "max_certs = 0, no BEGIN marker: out_skipped 0");
    pb_reset(); pb_str(EMPTY_BODY); pb_str(UNMATCHED);
    assert_eq(pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 8, pool, 0 - 1, &sk),
      0 - 1, "der_pool_size < 0, every block malformed: -1");
    assert_eq(pem_decode_certs_lenient_into(_pb_buf, _pb_len, 0, 8, pool, _pb_len, &sk),
      0 - 1, "null out_chain, every block malformed: -1");
    assert_eq(pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, 8, 0, 16, &sk),
      0 - 1, "null der_pool with a size, every block malformed: -1");

    # ============================================================
    # Group 16 — what survives is usable: parse + chain-verify
    # ============================================================
    test_group("pem_decode_certs_lenient_into — survivors parse and verify");
    pb_reset(); pb_str(UNMATCHED); pb_root(); pb_str(BAD_B64); pb_leaf(); pb_str(PARTIAL_Q);
    sk = 0;
    n = pb_lenient(chain, &sk);
    assert_eq(n, 2, "2 certificates survive 3 malformed blocks");
    assert_eq(sk, 3, "3 skipped");
    var rc = x509_cert_alloc();
    var lc = x509_cert_alloc();
    assert_eq(x509_parse(load64(chain), load64(chain + 8), rc), 1, "surviving root parses");
    assert_eq(x509_parse(load64(chain + 16), load64(chain + 24), lc), 1, "surviving leaf parses");
    assert_eq(x509_verify_chain(lc, alloc(0), 0, rc, 1781481600), 1,
      "surviving leaf -> root chain verifies");

    # ============================================================
    # Group 17 — the walk visits every block the count reports
    # ============================================================
    # An END whose trailing dashes double as the next BEGIN's leading dashes. The strict
    # walk resumes after the END and never sees that BEGIN (1 certificate, silently); the
    # lenient walk and the count both find it.
    test_group("pem_count_cert_blocks — END and BEGIN sharing their dashes");
    pb_reset();
    pb_add(_rp, ROOT_PEM_LEN - 1);           # root, without its final newline
    pb_add(_lp + 5, LEAF_PEM_LEN - 5);       # leaf, without its BEGIN's leading dashes
    assert_eq(pb_count(), 2, "pem_count_cert_blocks = 2");
    sk = 99;
    n = pb_lenient(chain, &sk);
    assert_eq(n, 2, "lenient decodes both");
    assert_eq(sk, 0, "nothing skipped");
    assert_eq(entry_is(chain, 1, _ld, LEAF_DER_LEN), 1, "entry 1 is the leaf");
    assert_eq(pb_strict(chain), 1, "the strict walk sees only the first (unchanged behaviour)");

    # Two BEGIN markers overlapping: a BEGIN whose closing dashes are the next BEGIN's
    # opening ones. Counted markers never overlap (each search resumes 27 bytes past the last
    # match), so this is ONE block, whose body runs into the second marker's text and is
    # skipped — and the walk agrees with the count. A count, or a skip, that rescanned inside
    # a counted marker would see the root behind it and break decoded + skipped == the count,
    # which is the identity cyrius derives its skipped-root count from.
    test_group("pem_count_cert_blocks — overlapping BEGIN markers are one block");
    pb_reset();
    pb_add(_rp, 22);                         # "-----BEGIN CERTIFICATE", no closing dashes
    pb_root();                               # the root's BEGIN dashes close the first one
    assert_eq(pb_count(), 1, "pem_count_cert_blocks = 1");
    sk = 99;
    n = pb_lenient(chain, &sk);
    assert_eq(n, 0, "lenient: nothing decodes");
    assert_eq(sk, 1, "lenient: the one block is skipped");
    assert_eq(n + sk, pb_count(), "decoded + skipped == pem_count_cert_blocks");
    assert_eq(pb_strict(chain), 0 - 1, "strict: -1");

    # ============================================================
    # Group 18 — 400 generated bundles against a model
    # ============================================================
    # Each bundle is 0..7 blocks drawn from {root, leaf, six malformed kinds, unmatched
    # BEGIN}. The model: every good block decodes, in order; every other block is skipped;
    # decoded + skipped == the block count; and the strict decode answers the good count
    # only when nothing is malformed (-1 otherwise, and for no blocks at all).
    test_group("pem_decode_certs_lenient_into — 400 generated bundles vs the model");
    var want = alloc(8 * 8);
    var seed = 0x2545F491;
    var bad_n = 0;
    var bad_skip = 0;
    var bad_entry = 0;
    var bad_count = 0;
    var bad_strict = 0;
    var t = 0;
    while (t < 400) {
        pb_reset();
        seed = (seed * 6364136223846793005 + 1442695040888963407);
        var nblk = (seed >> 33) % 8;
        var good = 0;
        var bads = 0;
        var k = 0;
        while (k < nblk) {
            seed = (seed * 6364136223846793005 + 1442695040888963407);
            var pick = (seed >> 33) % 9;
            if (pick == 0) { pb_root(); store64(want + good * 8, 0); good = good + 1; }
            if (pick == 1) { pb_leaf(); store64(want + good * 8, 1); good = good + 1; }
            if (pick == 2) { pb_str(BAD_B64); bads = bads + 1; }
            if (pick == 3) { pb_str(UNMATCHED); bads = bads + 1; }
            if (pick == 4) { pb_str(EMPTY_BODY); bads = bads + 1; }
            if (pick == 5) { pb_str(BAD_PAD); bads = bads + 1; }
            if (pick == 6) { pb_str(PAD_ALPHA); bads = bads + 1; }
            if (pick == 7) { pb_str(PARTIAL_Q); bads = bads + 1; }
            if (pick == 8) { pb_leaf_bad_tail(); bads = bads + 1; }
            k = k + 1;
        }
        sk = 0 - 5;
        var pool_t = alloc(_pb_len + 1);
        var cnt = pb_count();
        var lim = cnt;
        if (lim < 1) { lim = 1; }
        n = pem_decode_certs_lenient_into(_pb_buf, _pb_len, chain, lim, pool_t, _pb_len, &sk);
        if (n != good) { bad_n = bad_n + 1; }
        if (sk != bads) { bad_skip = bad_skip + 1; }
        if (cnt != nblk) { bad_count = bad_count + 1; }
        var e = 0;
        while (e < good) {
            if (e < n) {
                if (load64(want + e * 8) == 0) {
                    if (entry_is(chain, e, _rd, ROOT_DER_LEN) != 1) { bad_entry = bad_entry + 1; }
                } else {
                    if (entry_is(chain, e, _ld, LEAF_DER_LEN) != 1) { bad_entry = bad_entry + 1; }
                }
            }
            e = e + 1;
        }
        var strict_want = 0 - 1;
        if (bads == 0) { if (good > 0) { strict_want = good; } }
        if (pb_strict(chain) != strict_want) { bad_strict = bad_strict + 1; }
        t = t + 1;
    }
    assert_eq(bad_n, 0, "decoded count == good blocks, in all 400");
    assert_eq(bad_skip, 0, "skipped == malformed blocks, in all 400");
    assert_eq(bad_entry, 0, "every decoded entry is the right certificate, in order");
    assert_eq(bad_count, 0, "pem_count_cert_blocks == blocks written, in all 400");
    assert_eq(bad_strict, 0, "the strict decode is unchanged: good count, or -1 on any bad block");
    return 0;
}

fn main() {
    alloc_init();
    _p256_init();

    var root_der = hex_decode(ROOT_DER_HEX, 2 * ROOT_DER_LEN);
    var leaf_der = hex_decode(LEAF_DER_HEX, 2 * LEAF_DER_LEN);
    var root_pem = hex_decode(ROOT_PEM_HEX, 2 * ROOT_PEM_LEN);
    var leaf_pem = hex_decode(LEAF_PEM_HEX, 2 * LEAF_PEM_LEN);
    var chain_pem = hex_decode(CHAIN_PEM_HEX, 2 * CHAIN_PEM_LEN);

    var chain[64];   # 4 entries × 16 bytes
    memset(&chain, 0, 64);

    # ============================================================
    # Group 1 — Single-cert decode (root)
    # ============================================================
    test_group("pem_decode_certs — single cert (root)");

    var n = pem_decode_certs(root_pem, ROOT_PEM_LEN, &chain, 4);
    assert_eq(n, 1, "root PEM decodes to 1 cert");
    var p0 = load64(&chain + 0);
    var l0 = load64(&chain + 8);
    assert_eq(l0, ROOT_DER_LEN, "root DER length matches");
    assert_eq(bytes_eq(p0, root_der, ROOT_DER_LEN), 1, "root DER bytes round-trip");

    # ============================================================
    # Group 2 — Single-cert decode (leaf)
    # ============================================================
    test_group("pem_decode_certs — single cert (leaf)");

    memset(&chain, 0, 64);
    n = pem_decode_certs(leaf_pem, LEAF_PEM_LEN, &chain, 4);
    assert_eq(n, 1, "leaf PEM decodes to 1 cert");
    var pL = load64(&chain + 0);
    var lL = load64(&chain + 8);
    assert_eq(lL, LEAF_DER_LEN, "leaf DER length matches");
    assert_eq(bytes_eq(pL, leaf_der, LEAF_DER_LEN), 1, "leaf DER bytes round-trip");

    # ============================================================
    # Group 3 — Multi-cert decode (chain)
    # ============================================================
    test_group("pem_decode_certs — chain (root then leaf)");

    memset(&chain, 0, 64);
    n = pem_decode_certs(chain_pem, CHAIN_PEM_LEN, &chain, 4);
    assert_eq(n, 2, "chain PEM decodes to 2 certs");

    var c0_ptr = load64(&chain + 0);
    var c0_len = load64(&chain + 8);
    var c1_ptr = load64(&chain + 16);
    var c1_len = load64(&chain + 24);
    assert_eq(c0_len, ROOT_DER_LEN, "chain[0] (root) DER length");
    assert_eq(c1_len, LEAF_DER_LEN, "chain[1] (leaf) DER length");
    assert_eq(bytes_eq(c0_ptr, root_der, ROOT_DER_LEN), 1, "chain[0] bytes match root DER");
    assert_eq(bytes_eq(c1_ptr, leaf_der, LEAF_DER_LEN), 1, "chain[1] bytes match leaf DER");

    # ============================================================
    # Group 4 — Decoded chain verifies via x509_verify_chain
    # ============================================================
    test_group("pem_decode_certs — round-trip through x509_verify_chain");

    var root_cert = x509_cert_alloc();
    assert_eq(x509_parse(c0_ptr, c0_len, root_cert), 1, "decoded root parses");

    var leaf_cert = x509_cert_alloc();
    assert_eq(x509_parse(c1_ptr, c1_len, leaf_cert), 1, "decoded leaf parses");

    var inters = alloc(0);
    assert_eq(x509_verify_chain(leaf_cert, inters, 0, root_cert, 1781481600), 1,
      "decoded leaf → root chain verifies (round-trip end-to-end)");

    # ============================================================
    # Group 5 — _into variant: caller-provided pool
    # ============================================================
    test_group("pem_decode_certs_into — caller pool");

    var pool[2048];
    memset(&pool, 0, 2048);
    memset(&chain, 0, 64);
    n = pem_decode_certs_into(chain_pem, CHAIN_PEM_LEN, &chain, 4, &pool, 2048);
    assert_eq(n, 2, "_into decodes 2 certs with caller-provided pool");
    # Pointers should land inside `pool`.
    var p_into = load64(&chain + 0);
    assert_eq(p_into >= &pool, 1, "_into entry pointer ≥ pool start");
    assert_eq(p_into + load64(&chain + 8) <= &pool + 2048, 1,
      "_into entry pointer + len within pool");

    # ============================================================
    # Group 6 — _into variant: pool too small
    # ============================================================
    test_group("pem_decode_certs_into — pool exhaustion");

    var tiny[64];
    memset(&tiny, 0, 64);
    memset(&chain, 0, 64);
    n = pem_decode_certs_into(chain_pem, CHAIN_PEM_LEN, &chain, 4, &tiny, 64);
    assert_eq(n, 0 - 1, "_into rejects when pool can't hold decoded DER");

    # ============================================================
    # Group 7 — max_certs enforcement
    # ============================================================
    test_group("pem_decode_certs — max_certs enforcement");

    memset(&chain, 0, 64);
    n = pem_decode_certs(chain_pem, CHAIN_PEM_LEN, &chain, 1);
    assert_eq(n, 0 - 1, "chain with 2 certs but max_certs=1 returns -1");

    memset(&chain, 0, 64);
    n = pem_decode_certs(root_pem, ROOT_PEM_LEN, &chain, 1);
    assert_eq(n, 1, "single cert with max_certs=1 returns 1");

    # ============================================================
    # Group 8 — Malformed input rejection
    # ============================================================
    test_group("pem_decode_certs — malformed inputs");

    # Empty input
    var empty = alloc(1);
    memset(&chain, 0, 64);
    assert_eq(pem_decode_certs(empty, 0, &chain, 4), 0 - 1, "empty input rejected");

    # No BEGIN marker
    var no_begin = "no markers here just garbage bytes";
    memset(&chain, 0, 64);
    assert_eq(pem_decode_certs(no_begin, 34, &chain, 4), 0 - 1,
      "input with no BEGIN marker rejected");

    # BEGIN but no END
    var no_end = alloc(50);
    memcpy(no_end, "-----BEGIN CERTIFICATE-----\nAAAA\n", 33);
    memset(&chain, 0, 64);
    assert_eq(pem_decode_certs(no_end, 33, &chain, 4), 0 - 1,
      "BEGIN without matching END rejected");

    # Invalid base64 char inside body
    var bad_b64 = alloc(80);
    memcpy(bad_b64, "-----BEGIN CERTIFICATE-----\nAAAA*AAAA\n-----END CERTIFICATE-----\n", 64);
    memset(&chain, 0, 64);
    assert_eq(pem_decode_certs(bad_b64, 64, &chain, 4), 0 - 1,
      "invalid base64 character rejected");

    # Empty body between markers
    var empty_body = alloc(80);
    memcpy(empty_body, "-----BEGIN CERTIFICATE-----\n-----END CERTIFICATE-----\n", 54);
    memset(&chain, 0, 64);
    assert_eq(pem_decode_certs(empty_body, 54, &chain, 4), 0 - 1,
      "empty body rejected");

    # Excess padding (three `=` in final quad)
    # 8 alphabet chars → 2 quads, but tail "===" is invalid.
    var bad_pad = alloc(80);
    memcpy(bad_pad, "-----BEGIN CERTIFICATE-----\nAAAA====\n-----END CERTIFICATE-----\n", 63);
    memset(&chain, 0, 64);
    assert_eq(pem_decode_certs(bad_pad, 63, &chain, 4), 0 - 1,
      "excess padding rejected");

    # Alphabet char after padding
    var pad_then_alpha = alloc(80);
    memcpy(pad_then_alpha, "-----BEGIN CERTIFICATE-----\nAAA=AAAA\n-----END CERTIFICATE-----\n", 63);
    memset(&chain, 0, 64);
    assert_eq(pem_decode_certs(pad_then_alpha, 63, &chain, 4), 0 - 1,
      "alphabet char following padding rejected");

    # ============================================================
    # Group 9 — Padding variants (0/1/2 chars), known-good
    # ============================================================
    test_group("pem_decode_certs — padding variants");

    # 0-pad (3-byte body). base64("foo") = "Zm9v"
    var pem0 = alloc(80);
    memcpy(pem0, "-----BEGIN CERTIFICATE-----\nZm9v\n-----END CERTIFICATE-----\n", 59);
    memset(&chain, 0, 64);
    n = pem_decode_certs(pem0, 59, &chain, 4);
    assert_eq(n, 1, "0-padding (3-byte body) decodes");
    var po = load64(&chain + 0);
    var lo = load64(&chain + 8);
    assert_eq(lo, 3, "decoded length = 3");
    assert_eq(load8(po) & 0xFF, 0x66, "byte[0] = 'f'");
    assert_eq(load8(po + 1) & 0xFF, 0x6F, "byte[1] = 'o'");
    assert_eq(load8(po + 2) & 0xFF, 0x6F, "byte[2] = 'o'");

    # 1-pad (2-byte body). base64("fo") = "Zm8="
    var pem1 = alloc(80);
    memcpy(pem1, "-----BEGIN CERTIFICATE-----\nZm8=\n-----END CERTIFICATE-----\n", 59);
    memset(&chain, 0, 64);
    n = pem_decode_certs(pem1, 59, &chain, 4);
    assert_eq(n, 1, "1-padding (2-byte body) decodes");
    assert_eq(load64(&chain + 8), 2, "decoded length = 2");
    var p1 = load64(&chain + 0);
    assert_eq(load8(p1) & 0xFF, 0x66, "byte[0] = 'f'");
    assert_eq(load8(p1 + 1) & 0xFF, 0x6F, "byte[1] = 'o'");

    # 2-pad (1-byte body). base64("f") = "Zg=="
    var pem2 = alloc(80);
    memcpy(pem2, "-----BEGIN CERTIFICATE-----\nZg==\n-----END CERTIFICATE-----\n", 59);
    memset(&chain, 0, 64);
    n = pem_decode_certs(pem2, 59, &chain, 4);
    assert_eq(n, 1, "2-padding (1-byte body) decodes");
    assert_eq(load64(&chain + 8), 1, "decoded length = 1");
    var p2 = load64(&chain + 0);
    assert_eq(load8(p2) & 0xFF, 0x66, "byte[0] = 'f'");

    _rd = root_der;
    _ld = leaf_der;
    _rp = root_pem;
    _lp = leaf_pem;
    lenient_tests();

    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
