# mldsa_kat.tcyr — ML-DSA-65 (FIPS 204) known-answer + concurrency tests
#
# Every expected byte below was produced by OpenSSL 3.6.4's independent
# ML-DSA-65 implementation, NOT by sigil:
#
#   openssl genpkey -algorithm ML-DSA-65 -pkeyopt hexseed:<seed> -out k.pem
#   pk = last 1952 bytes of `openssl pkey -in k.pem -pubout -outform DER`
#   sk = the `priv:` block of `openssl pkey -in k.pem -text -noout`
#   sig = openssl pkeyutl -sign -rawin -inkey k.pem -in m.bin \
#           -pkeyopt deterministic:1
#
# `deterministic:1` is FIPS 204 rnd = {0}^32, and OpenSSL's default
# message-encoding (1) is pure ML-DSA with an empty context string,
# M' = 0x00 ‖ 0x00 ‖ M — exactly what mldsa65_sign implements. So a sigil
# signature must equal OpenSSL's byte for byte.
#
# Why this file exists (finding H4): the signing rejection loop
# advanced the ExpandMask counter κ by 1 per attempt instead of by ℓ = 5
# (FIPS 204 Algorithm 7: κ ← κ + ℓ), so consecutive attempts shared 4 of their
# 5 mask polynomials. A signature accepted on the first attempt was still
# correct, which is why the closed-loop round-trip tests never noticed —
# vector 0 below is such a first-attempt signature and matched even before
# the fix. Every other vector needs >= 2 attempts and mismatched OpenSSL
# until κ advanced by ℓ.
#
# Finding M11 (thread safety, zeroization) is covered by the other groups:
#   0. Forty times, with the lazy zetas-table init reset to "not built", two
#      threads make the first NTT call, the second arriving part-way through
#      the first's table decode; every result must equal the serial NTT.
#      Probabilistic: the unguarded init failed it in 33 of 35 x86_64 runs,
#      so a pass is evidence, not proof — the CAS guard is also reviewed.
#   1. From an empty workspace pool, six threads keygen, sign, verify and
#      reject at once; every result must equal the OpenSSL answer.
#   2-3. The workspace keygen / sign used is poisoned beforehand and must
#      come back with its whole secret prefix zero.
#   5. `_mldsa_wipe` edge lengths, and a dead-stack probe of the ExpandS /
#      ExpandMask drivers' own Keccak state and buffers.
#   6. The workspace pool: serial calls reuse it (no per-call mmap — that
#      leaked on Windows), and its empty and full paths.
#
# Messages: vector j is (j * 37) % 200 bytes, byte k = (k*29 + j*71 + 3) & 0xFF.
# Seeds: key 0 byte i = 0x11 ^ i; key 2 byte i = (37*i + 5) & 0xFF.
# OpenSSL's pkeyutl cannot sign an empty -rawin file, so the empty message is
# covered by the round-trip test in mldsa.tcyr, not here.

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/str.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/chrono.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fmt.cyr"
include "lib/bayan.cyr"
include "lib/sakshi.cyr"
include "lib/ct.cyr"
include "lib/keccak.cyr"
include "lib/thread.cyr"

# Ed25519 stack (mldsa.cyr's hybrid verifier references it).
include "lib/thread_local.cyr"
include "src/crypto_scratch.cyr"
include "src/mul64.cyr"
include "src/types.cyr"
include "src/error.cyr"
include "lib/random.cyr"
include "src/random.cyr"
include "src/sha256.cyr"
include "src/hex.cyr"
include "src/sha512.cyr"
include "src/bigint_ext.cyr"
include "src/ed25519.cyr"

# ML-DSA stack.
include "src/mldsa_params.cyr"
include "src/mldsa_reduce.cyr"
include "src/mldsa_ntt.cyr"
include "src/mldsa_poly.cyr"
include "src/mldsa_rounding.cyr"
include "src/mldsa_encode.cyr"
include "src/mldsa_sample.cyr"
include "src/mldsa.cyr"

# ================================================================
# Expected values (OpenSSL 3.6.4)
# ================================================================

# pk for seed 0x11^i (openssl genpkey hexseed, SPKI tail)
fn _kat_pk0(): i64 {
    return "";
}

# sk (expanded, FIPS 204 skEncode) for seed 0x11^i
fn _kat_sk0(): i64 {
    return "";
}

# pk for seed (37*i + 5) & 0xFF
fn _kat_pk2(): i64 {
    return "";
}

# sk for seed (37*i + 5) & 0xFF
fn _kat_sk2(): i64 {
    return "";
}

# key 0, msg j=1 (37 B): accepted on the FIRST rejection-loop attempt
fn _kat_sig0(): i64 {
    return "";
}

# key 0, msg j=2 (74 B): needs >= 2 attempts
fn _kat_sig1(): i64 {
    return "";
}

# key 0, msg j=9 (133 B): needs >= 2 attempts
fn _kat_sig2(): i64 {
    return "";
}

# key 2, msg j=3 (111 B): needs >= 2 attempts
fn _kat_sig3(): i64 {
    return "";
}

# key 2, msg j=13 (81 B): needs >= 2 attempts
fn _kat_sig4(): i64 {
    return "";
}

# key 2, msg j=5 (185 B): needs >= 2 attempts
fn _kat_sig5(): i64 {
    return "";
}

# ================================================================
# Vector table
# ================================================================
# Two keys (slot 0 = seed kind 0, slot 1 = seed kind 2) and six signing
# vectors. Vector 0 is accepted on the first rejection-loop attempt; vectors
# 1-5 each need at least two attempts, so they exercise the κ schedule.

var KAT_NV = 6;
var KAT_MSGCAP = 256;
var KAT_DEADLINE_MS = 120000;   # the fixed code finishes the whole section in well under 1 s

var _kv_seed = 0;   # 2 × 32 seeds
var _kv_pk = 0;     # 2 × PK_BYTES expected pk
var _kv_sk = 0;     # 2 × SK_BYTES expected sk
var _kv_sig = 0;    # NV × SIG_BYTES expected signatures
var _kv_msg = 0;    # NV × MSGCAP messages
var _kv_tmsg = 0;   # NV × MSGCAP messages with byte 0 flipped
var _kv_len = 0;    # NV × 8 message lengths
var _kv_key = 0;    # NV × 8 key slot

# Per-vector worker outputs (allocated on the main thread before spawn).
var _cw_pk = 0;     # NV × PK_BYTES
var _cw_sk = 0;     # NV × SK_BYTES
var _cw_sig = 0;    # NV × SIG_BYTES
var _cw_bad = 0;    # NV × 4 × 8: keygen, sign, verify-accept, verify-reject failures

fn kat_seed(buf, kind) {
    var i = 0;
    while (i < 32) {
        var v = 0x11 ^ i;
        if (kind == 2) { v = i * 37 + 5; }
        store8(buf + i, v & 0xFF);
        i = i + 1;
    }
    return 0;
}

fn kat_msg(buf, len, j) {
    var k = 0;
    while (k < len) {
        store8(buf + k, (k * 29 + j * 71 + 3) & 0xFF);
        k = k + 1;
    }
    return 0;
}

# Number of differing bytes between a[n] and b[n].
fn kat_diff(a, b, n) {
    var d = 0;
    var i = 0;
    while (i < n) {
        if ((load8(a + i) & 0xFF) != (load8(b + i) & 0xFF)) { d = d + 1; }
        i = i + 1;
    }
    return d;
}

fn kat_hex_into(dst, hex) {
    var n = strlen(hex);
    var raw = hex_decode(hex, n);
    memcpy(dst, raw, n / 2);
    return n / 2;
}

# Key slot of vector v: 0 for v0-v2 (seed kind 0), 1 for v3-v5 (seed kind 2).
fn kat_vec_key(v) {
    if (v < 3) { return 0; }
    return 1;
}

# Message index j of vector v.
fn kat_vec_j(v) {
    if (v == 0) { return 1; }
    if (v == 1) { return 2; }
    if (v == 2) { return 9; }
    if (v == 3) { return 3; }
    if (v == 4) { return 13; }
    return 5;
}

fn kat_sig_hex(v) {
    if (v == 0) { return _kat_sig0(); }
    if (v == 1) { return _kat_sig1(); }
    if (v == 2) { return _kat_sig2(); }
    if (v == 3) { return _kat_sig3(); }
    if (v == 4) { return _kat_sig4(); }
    return _kat_sig5();
}

fn kat_sig_name(v) {
    if (v == 0) { return "sign KAT v0: key0 msg1 (37 B, first-attempt accept) == OpenSSL"; }
    if (v == 1) { return "sign KAT v1: key0 msg2 (74 B, >= 2 attempts) == OpenSSL"; }
    if (v == 2) { return "sign KAT v2: key0 msg9 (133 B, >= 2 attempts) == OpenSSL"; }
    if (v == 3) { return "sign KAT v3: key2 msg3 (111 B, >= 2 attempts) == OpenSSL"; }
    if (v == 4) { return "sign KAT v4: key2 msg13 (81 B, >= 2 attempts) == OpenSSL"; }
    return "sign KAT v5: key2 msg5 (185 B, >= 2 attempts) == OpenSSL";
}

fn kat_setup() {
    _kv_seed = alloc(2 * 32);
    _kv_pk = alloc(2 * MLDSA65_PK_BYTES);
    _kv_sk = alloc(2 * MLDSA65_SK_BYTES);
    kat_seed(_kv_seed, 0);
    kat_seed(_kv_seed + 32, 2);
    kat_hex_into(_kv_pk, _kat_pk0());
    kat_hex_into(_kv_sk, _kat_sk0());
    kat_hex_into(_kv_pk + MLDSA65_PK_BYTES, _kat_pk2());
    kat_hex_into(_kv_sk + MLDSA65_SK_BYTES, _kat_sk2());

    _kv_sig = alloc(KAT_NV * MLDSA65_SIG_BYTES);
    _kv_msg = alloc(KAT_NV * KAT_MSGCAP);
    _kv_tmsg = alloc(KAT_NV * KAT_MSGCAP);
    _kv_len = alloc(KAT_NV * 8);
    _kv_key = alloc(KAT_NV * 8);
    var v = 0;
    while (v < KAT_NV) {
        var j = kat_vec_j(v);
        var len = (j * 37) % 200;
        store64(_kv_key + v * 8, kat_vec_key(v));
        store64(_kv_len + v * 8, len);
        kat_msg(_kv_msg + v * KAT_MSGCAP, len, j);
        memcpy(_kv_tmsg + v * KAT_MSGCAP, _kv_msg + v * KAT_MSGCAP, len);
        store8(_kv_tmsg + v * KAT_MSGCAP, (load8(_kv_msg + v * KAT_MSGCAP) & 0xFF) ^ 0x01);
        kat_hex_into(_kv_sig + v * MLDSA65_SIG_BYTES, kat_sig_hex(v));
        v = v + 1;
    }

    _cw_pk = alloc(KAT_NV * MLDSA65_PK_BYTES);
    _cw_sk = alloc(KAT_NV * MLDSA65_SK_BYTES);
    _cw_sig = alloc(KAT_NV * MLDSA65_SIG_BYTES);
    _cw_bad = alloc(KAT_NV * 32);
    memset(_cw_bad, 0, KAT_NV * 32);
    return 0;
}

# ================================================================
# Thread reaping with a deadline
# ================================================================
# A bare thread_join hangs forever on a livelock (before the M11 fix six
# workers sharing the module workspace spun in the rejection loop: a run was
# killed after 300 s at ~570% CPU). Poll instead, and on expiry fail and end
# the WHOLE process: sys_exit_group, not sys_exit, which is exit(2) and ends
# only the calling thread — the stuck workers would keep the test alive.

fn kat_reap(ths, n, what) {
    var deadline = clock_now_ms() + KAT_DEADLINE_MS;
    var running = n;
    while (running > 0) {
        running = 0;
        var v = 0;
        while (v < n) {
            var th = load64(ths + v * 8);
            if (th > 0) {
                if (thread_is_done(th) == 0) { running = running + 1; }
            }
            v = v + 1;
        }
        if (running > 0) {
            if (clock_now_ms() > deadline) {
                assert_eq(running, 0, what);
                assert_summary();
                sys_exit_group(1);
            }
            sleep_ms(5);
        }
    }
    var j = 0;
    while (j < n) {
        if (load64(ths + j * 8) > 0) { thread_join(load64(ths + j * 8)); }
        j = j + 1;
    }
    return 0;
}

# ================================================================
# Zetas-table init race: first callers staggered across the decode
# ================================================================
# Each trial resets the lazy init to "not built" (nothing else is running),
# parks KAT_ZR_N workers on a spin barrier, and has worker k call mldsa_ntt
# — whose first act is mldsa_ntt_init — k × step after the release. The
# step sweeps 30%..120% of a measured decode, so the second arrival lands
# inside the first caller's decode. That is what exposes an unguarded
# check-then-set init: a late first caller re-points `_mldsa_zetas` at a
# fresh table and has filled only its start when the earlier caller finishes
# and runs its NTT on it. Released all at once, the callers re-point
# together and every decode then fills the final table, so the unguarded
# init passed that version of this check 10 times out of 10.

var KAT_ZR_N = 2;
var KAT_ZR_TRIALS = 40;
var _zr_ready = 0;
var _zr_go = 0;
var _zr_t0 = 0;
var _zr_step = 0;
var _zr_out = 0;    # KAT_ZR_N × 2048 result polys

fn kat_ntt_input(p) {
    var i = 0;
    while (i < 256) {
        store64(p + i * 8, (i * 7919 + 13) % MLDSA_Q);
        i = i + 1;
    }
    return 0;
}

# Barrier arrival; the last to arrive stamps the release time.
fn kat_zr_arrive() {
    if (atomic_fetch_add(&_zr_ready, 1) == KAT_ZR_N - 1) {
        _zr_t0 = clock_now_ns();
        atomic_fence();
        atomic_store(&_zr_go, 1);
    }
    return 0;
}

fn _kat_zeta_worker(arg): i64 {
    var id = load64(arg);
    var p = _zr_out + id * 2048;
    kat_ntt_input(p);
    kat_zr_arrive();
    while (atomic_load(&_zr_go) == 0) { }
    atomic_fence();
    var at = _zr_t0 + id * _zr_step;
    while (clock_now_ns() < at) { }
    mldsa_ntt(p);
    return 0;
}

# Calibration: one thread-context reset-and-rebuild, timed (a decode inside a
# fresh thread runs 2-3x slower than the same decode on the warm main thread).
var _zr_cal = 0;

fn _kat_zeta_cal(arg): i64 {
    kat_zr_reset();
    var t0 = clock_now_ns();
    mldsa_ntt_init();
    _zr_cal = clock_now_ns() - t0;
    return 0;
}

# Put the lazy zetas init back to "not built" (test-only; no caller running).
fn kat_zr_reset() {
    atomic_store(&_mldsa_ntt_inited, 0);
    atomic_fence();
    return 0;
}

# ================================================================
# Concurrency worker: keygen, sign, verify, reject — twice
# ================================================================

fn _kat_worker(arg): i64 {
    var v = load64(arg);
    var ks = load64(_kv_key + v * 8);
    var len = load64(_kv_len + v * 8);
    var seed = _kv_seed + ks * 32;
    var epk = _kv_pk + ks * MLDSA65_PK_BYTES;
    var esk = _kv_sk + ks * MLDSA65_SK_BYTES;
    var esig = _kv_sig + v * MLDSA65_SIG_BYTES;
    var msg = _kv_msg + v * KAT_MSGCAP;
    var tmsg = _kv_tmsg + v * KAT_MSGCAP;
    var pk = _cw_pk + v * MLDSA65_PK_BYTES;
    var sk = _cw_sk + v * MLDSA65_SK_BYTES;
    var sig = _cw_sig + v * MLDSA65_SIG_BYTES;
    var bad = _cw_bad + v * 32;
    var rep = 0;
    while (rep < 2) {
        mldsa65_keypair_from_seed(seed, pk, sk);
        if (kat_diff(pk, epk, MLDSA65_PK_BYTES) + kat_diff(sk, esk, MLDSA65_SK_BYTES) != 0) {
            store64(bad, load64(bad) + 1);
        }
        mldsa65_sign(sig, msg, len, sk);
        if (kat_diff(sig, esig, MLDSA65_SIG_BYTES) != 0) {
            store64(bad + 8, load64(bad + 8) + 1);
        }
        if (mldsa65_verify(sig, msg, len, epk) != 0) {
            store64(bad + 16, load64(bad + 16) + 1);
        }
        if (mldsa65_verify(sig, tmsg, len, epk) != 1) {
            store64(bad + 24, load64(bad + 24) + 1);
        }
        rep = rep + 1;
    }
    return 0;
}

# ================================================================
# Workspace-pool and zeroization helpers
# ================================================================
# The pool (src/mldsa.cyr) hands a serial caller the lowest non-empty slot
# and takes it back into the lowest empty one, so after any serial call
# slot 0 holds exactly the workspace that call used. That lets the test
# look at the bytes the call left behind.

# Number of idle workspaces in the pool.
fn kat_pool_count() {
    var c = 0;
    var i = 0;
    while (i < _MLDSA_WS_POOL_SLOTS) {
        if (load64(&_mldsa_ws_pool + i * 8) != 0) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Sum of the idle workspaces' addresses (identity check for reuse).
fn kat_pool_sum() {
    var s = 0;
    var i = 0;
    while (i < _MLDSA_WS_POOL_SLOTS) {
        s = s + load64(&_mldsa_ws_pool + i * 8);
        i = i + 1;
    }
    return s;
}

# Number of bytes in p[n] that differ from `val`.
fn kat_count_ne(p, n, val) {
    var c = 0;
    var i = 0;
    while (i < n) {
        if ((load8(p + i) & 0xFF) != val) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Occurrences of needle[nlen] anywhere in hay[haylen].
fn kat_count_needle(hay, haylen, needle, nlen) {
    var hits = 0;
    var i = 0;
    while (i + nlen <= haylen) {
        var j = 0;
        var ok = 1;
        while (j < nlen) {
            if ((load8(hay + i + j) & 0xFF) != (load8(needle + j) & 0xFF)) {
                ok = 0;
                j = nlen;
            }
            j = j + 1;
        }
        if (ok == 1) { hits = hits + 1; }
        i = i + 1;
    }
    return hits;
}

# ---- dead-stack residue probe for the ExpandS / ExpandMask drivers ----
# A driver's st / ab / buf are arrays in its own frame. Calling it and then,
# from the SAME caller, a function with a large uninitialised array puts that
# array over the driver's dead frame, so its bytes are whatever the driver
# left. Needles: the first 16 B of the secret seed (ab holds seed ‖ nonce)
# and the first 16 B of each of the first 10 SHAKE-256(seed ‖ nonce) blocks
# (buf holds the squeezed blocks; st, after the eager final permute, holds
# the next one). The plant control below proves the probe really sees the
# dead frame. The probe depends on stack layout, so it can miss residue on
# a layout it does not cover, but it cannot report residue that is not there.

var KAT_SNAP = 4096;

fn kat_snapshot(dst) {
    var scan[4096];
    memcpy(dst, &scan, KAT_SNAP);
    return 0;
}

fn kat_residue_hits(snap, seed, nonce) {
    var inb = alloc(MLDSA_CRHBYTES + 2);
    memcpy(inb, seed, MLDSA_CRHBYTES);
    store8(inb + MLDSA_CRHBYTES, nonce & 0xFF);
    store8(inb + MLDSA_CRHBYTES + 1, (nonce >> 8) & 0xFF);
    var out = alloc(10 * 136);
    shake256(inb, MLDSA_CRHBYTES + 2, out, 10 * 136);
    var hits = kat_count_needle(snap, KAT_SNAP, seed, 16);
    var b = 0;
    while (b < 10) {
        hits = hits + kat_count_needle(snap, KAT_SNAP, out + b * 136, 16);
        b = b + 1;
    }
    return hits;
}

# Control: leave the seed in a dead stack array, unwiped, like a driver would.
fn _kat_plant(seed) {
    var tmp[80];
    memcpy(&tmp, seed, MLDSA_CRHBYTES);
    return load8(&tmp) & 0xFF;
}

fn kat_run_plant(snap, seed) {
    _kat_plant(seed);
    kat_snapshot(snap);
    return 0;
}

fn kat_run_gamma1(snap, y, seed, nonce) {
    mldsa_poly_uniform_gamma1(y, seed, nonce);
    kat_snapshot(snap);
    return 0;
}

fn kat_run_eta(snap, y, seed, nonce) {
    mldsa_poly_uniform_eta(y, seed, nonce);
    kat_snapshot(snap);
    return 0;
}

# The lengths the _mldsa_wipe unit check covers: empty, sub-word, word,
# word + tail, and the 200-byte Keccak state with and without a tail.
fn kat_wipe_len(i) {
    if (i == 0) { return 0; }
    if (i == 1) { return 1; }
    if (i == 2) { return 7; }
    if (i == 3) { return 8; }
    if (i == 4) { return 9; }
    if (i == 5) { return 13; }
    if (i == 6) { return 16; }
    if (i == 7) { return 200; }
    return 203;
}

fn main() {
    alloc_init();
    kat_setup();

    # ============================================================
    # 0. Zetas-table init race, from a cold start (no NTT has run yet).
    # ============================================================
    test_group("mldsa zetas lazy init raced by staggered first callers");
    _zr_out = alloc(KAT_ZR_N * 2048);
    var zexp = alloc(2048);
    var zargs = alloc(KAT_ZR_N * 8);
    var zths = alloc(KAT_ZR_N * 8);
    # The first init of the process is cold and serial. The stagger is scaled
    # to a decode timed inside a fresh thread (the best of three).
    kat_ntt_input(zexp);
    mldsa_ntt(zexp);
    var zcal = 0;
    var zm = 0;
    while (zm < 3) {
        var ct = thread_create(&_kat_zeta_cal, 0);
        if (ct > 0) {
            thread_join(ct);
            if (zcal == 0 || _zr_cal < zcal) { zcal = _zr_cal; }
        }
        zm = zm + 1;
    }
    var zspawn_bad = 0;
    var zbad = 0;
    var trial = 0;
    while (trial < KAT_ZR_TRIALS) {
        # The second caller arrives 30%, 40%, ... 120% of one decode after the
        # first (10 offsets, 4 rounds). The unguarded init fails when it lands
        # in the back half of the first caller's decode.
        _zr_step = zcal * (30 + 10 * (trial % 10)) / 100;
        _zr_ready = 0;
        _zr_go = 0;
        kat_zr_reset();
        var z = 0;
        while (z < KAT_ZR_N) {
            store64(zargs + z * 8, z);
            var zt = thread_create(&_kat_zeta_worker, zargs + z * 8);
            if (zt <= 0) {
                zspawn_bad = zspawn_bad + 1;
                kat_zr_arrive();   # stand in for the missing worker
            }
            store64(zths + z * 8, zt);
            z = z + 1;
        }
        kat_reap(zths, KAT_ZR_N, "all staggered NTT threads finished within the deadline");
        z = 0;
        while (z < KAT_ZR_N) {
            if (load64(zths + z * 8) > 0) {
                if (kat_diff(_zr_out + z * 2048, zexp, 2048) != 0) { zbad = zbad + 1; }
            }
            z = z + 1;
        }
        trial = trial + 1;
    }
    assert_eq(zspawn_bad, 0, "80 staggered NTT threads spawned (40 trials x 2)");
    assert_eq(zbad, 0, "80 racing first NTTs all equal the serial NTT");

    # ============================================================
    # 1. Concurrent keygen/sign/verify, from an empty workspace pool.
    # ============================================================
    test_group("mldsa65 concurrent keygen/sign/verify (empty pool) == OpenSSL");
    assert_eq(kat_pool_count(), 0, "workspace pool is empty before any ML-DSA call");
    var args = alloc(KAT_NV * 8);
    var ths = alloc(KAT_NV * 8);
    var spawn_bad = 0;
    var v = 0;
    while (v < KAT_NV) {
        store64(args + v * 8, v);
        var t = thread_create(&_kat_worker, args + v * 8);
        if (t <= 0) { spawn_bad = spawn_bad + 1; }
        store64(ths + v * 8, t);
        v = v + 1;
    }
    assert_eq(spawn_bad, 0, "6 worker threads spawned");
    kat_reap(ths, KAT_NV, "all workers finished within the deadline");
    var kg_bad = 0;
    var sg_bad = 0;
    var va_bad = 0;
    var vr_bad = 0;
    v = 0;
    while (v < KAT_NV) {
        kg_bad = kg_bad + load64(_cw_bad + v * 32);
        sg_bad = sg_bad + load64(_cw_bad + v * 32 + 8);
        va_bad = va_bad + load64(_cw_bad + v * 32 + 16);
        vr_bad = vr_bad + load64(_cw_bad + v * 32 + 24);
        v = v + 1;
    }
    assert_eq(kg_bad, 0, "12 concurrent keygens all equal OpenSSL pk/sk");
    assert_eq(sg_bad, 0, "12 concurrent deterministic signs all equal OpenSSL");
    assert_eq(va_bad, 0, "12 concurrent verifies all accept");
    assert_eq(vr_bad, 0, "12 concurrent verifies of a tampered message all reject");
    # A fresh workspace is taken only when every pooled one is in use, so the
    # pool can never hold more than the 6 calls that were ever in flight.
    var pc = kat_pool_count();
    var pc_ok = 0;
    if (pc >= 1) { if (pc <= KAT_NV) { pc_ok = 1; } }
    assert_eq(pc_ok, 1, "pool keeps 1..6 idle workspaces after 6 concurrent workers");

    # ============================================================
    # 2. Keygen KAT (serial) + keygen leaves no secret in its workspace.
    # ============================================================
    test_group("mldsa65 keygen KAT vs OpenSSL; workspace wiped");
    var pk = alloc(MLDSA65_PK_BYTES);
    var sk = alloc(MLDSA65_SK_BYTES);
    # Poison the workspace keygen is about to get (slot 0) so the checks
    # below see exactly what keygen wrote and wiped.
    var kws = load64(&_mldsa_ws_pool);
    assert(kws != 0, "pool slot 0 holds an idle workspace");
    if (kws != 0) { memset(kws, 0xA5, _MLDSA_WS_BYTES); }
    mldsa65_keypair_from_seed(_kv_seed, pk, sk);
    if (kws != 0) {
        assert_eq(load64(&_mldsa_ws_pool), kws, "keygen returned the same workspace to slot 0");
        assert_eq(kat_count_ne(kws, _MLDSA_WS_Z, 0), 0,
          "keygen leaves [0, 61440) of its workspace zero (s1, s2, t0, K, rho', SHAKE state)");
        assert(kat_count_ne(kws + _MLDSA_WS_MAT, _MLDSA_WS_BYTES - _MLDSA_WS_MAT, 0xA5) > 0,
          "keygen really used that workspace (A-hat written)");
    }
    assert_eq(kat_diff(pk, _kv_pk, MLDSA65_PK_BYTES), 0, "key0 pk == OpenSSL (bytes differing)");
    assert_eq(kat_diff(sk, _kv_sk, MLDSA65_SK_BYTES), 0, "key0 sk == OpenSSL (bytes differing)");
    mldsa65_keypair_from_seed(_kv_seed + 32, pk, sk);
    assert_eq(kat_diff(pk, _kv_pk + MLDSA65_PK_BYTES, MLDSA65_PK_BYTES), 0,
      "key2 pk == OpenSSL (bytes differing)");
    assert_eq(kat_diff(sk, _kv_sk + MLDSA65_SK_BYTES, MLDSA65_SK_BYTES), 0,
      "key2 sk == OpenSSL (bytes differing)");

    # ============================================================
    # 3. Deterministic sign KAT (serial) — the H4 regression.
    # ============================================================
    test_group("mldsa65 deterministic sign KAT vs OpenSSL; workspace wiped");
    var sig = alloc(MLDSA65_SIG_BYTES);
    v = 0;
    while (v < KAT_NV) {
        var ks = load64(_kv_key + v * 8);
        var sws = load64(&_mldsa_ws_pool);
        if (sws != 0) { memset(sws, 0xA5, _MLDSA_WS_BYTES); }
        mldsa65_sign(sig, _kv_msg + v * KAT_MSGCAP, load64(_kv_len + v * 8),
          _kv_sk + ks * MLDSA65_SK_BYTES);
        assert_eq(kat_diff(sig, _kv_sig + v * MLDSA65_SIG_BYTES, MLDSA65_SIG_BYTES), 0,
          kat_sig_name(v));
        if (v == 1 && sws != 0) {
            # v1 needs 5 rejection-loop attempts, so every region was reused.
            assert_eq(load64(&_mldsa_ws_pool), sws, "sign returned the same workspace to slot 0");
            assert_eq(kat_count_ne(sws, _MLDSA_WS_MAT, 0), 0,
              "sign leaves [0, 96256) of its workspace zero (s1, s2, t0, K, rho'', y, z, w0, h)");
            assert(kat_count_ne(sws + _MLDSA_WS_MAT, _MLDSA_WS_BYTES - _MLDSA_WS_MAT, 0xA5) > 0,
              "sign really used that workspace (A-hat written)");
        }
        v = v + 1;
    }

    # ============================================================
    # 4. Verify interop: sigil accepts OpenSSL's signatures.
    # ============================================================
    test_group("mldsa65 verify accepts OpenSSL signatures, rejects tampering");
    var acc_bad = 0;
    var rej_bad = 0;
    v = 0;
    while (v < KAT_NV) {
        var kv = load64(_kv_key + v * 8);
        var vpk = _kv_pk + kv * MLDSA65_PK_BYTES;
        var vsig = _kv_sig + v * MLDSA65_SIG_BYTES;
        var vlen = load64(_kv_len + v * 8);
        if (mldsa65_verify(vsig, _kv_msg + v * KAT_MSGCAP, vlen, vpk) != 0) {
            acc_bad = acc_bad + 1;
        }
        if (mldsa65_verify(vsig, _kv_tmsg + v * KAT_MSGCAP, vlen, vpk) != 1) {
            rej_bad = rej_bad + 1;
        }
        v = v + 1;
    }
    assert_eq(acc_bad, 0, "all 6 OpenSSL signatures verify under sigil");
    assert_eq(rej_bad, 0, "all 6 OpenSSL signatures reject a one-bit message change");

    # ============================================================
    # 5. Zeroization primitives.
    # ============================================================
    test_group("mldsa zeroization: _mldsa_wipe tails, sampler dead-stack residue");
    # _mldsa_wipe: exact length, any tail, no overrun into a 16-byte guard.
    var wbuf = alloc(256);
    var wbad = 0;
    var wi = 0;
    while (wi < 9) {
        var wl = kat_wipe_len(wi);
        memset(wbuf, 0xA5, 256);
        _mldsa_wipe(wbuf, wl);
        wbad = wbad + kat_count_ne(wbuf, wl, 0) + kat_count_ne(wbuf + wl, 16, 0xA5);
        wi = wi + 1;
    }
    assert_eq(wbad, 0, "_mldsa_wipe zeroes exactly n bytes for n in {0,1,7,8,9,13,16,200,203}");
    var pseed = alloc(MLDSA_CRHBYTES);
    var pi = 0;
    while (pi < MLDSA_CRHBYTES) {
        store8(pseed + pi, (pi * 73 + 41) & 0xFF);
        pi = pi + 1;
    }
    var snap = alloc(KAT_SNAP);
    var ypoly = alloc(2048);
    kat_run_plant(snap, pseed);
    assert(kat_count_needle(snap, KAT_SNAP, pseed, 16) > 0,
      "control: the probe finds a seed left in a dead stack frame");
    kat_run_gamma1(snap, ypoly, pseed, 7);
    assert_eq(kat_residue_hits(snap, pseed, 7), 0,
      "ExpandMask driver leaves no seed / SHAKE bytes in its dead frame");
    kat_run_eta(snap, ypoly, pseed, 3);
    assert_eq(kat_residue_hits(snap, pseed, 3), 0,
      "ExpandS driver leaves no seed / SHAKE bytes in its dead frame");

    # ============================================================
    # 6. Workspace pool: serial reuse, overflow.
    # ============================================================
    test_group("mldsa workspace pool: reuse, bounded, overflow frees");
    # Serial calls reuse pooled workspaces and never take a fresh one. This
    # is what keeps Windows flat: there `fl_free`'s munmap of a large block
    # fails (cyrius routes no PE syscall 11 to VirtualFree), so a design
    # that allocated and freed a workspace per call grew ~154 KB per call.
    var c0 = kat_pool_count();
    var s0 = kat_pool_sum();
    assert(c0 >= 1, "pool holds idle workspaces before the serial loop");
    var r = 0;
    var loop_bad = 0;
    while (r < 20) {
        mldsa65_keypair_from_seed(_kv_seed, pk, sk);
        mldsa65_sign(sig, _kv_msg + KAT_MSGCAP, load64(_kv_len + 8), sk);
        loop_bad = loop_bad + mldsa65_verify(sig, _kv_msg + KAT_MSGCAP, load64(_kv_len + 8), pk);
        r = r + 1;
    }
    assert_eq(loop_bad, 0, "20 serial keygen/sign/verify rounds all verify");
    assert_eq(kat_pool_count(), c0, "pool count unchanged after 60 serial calls");
    assert_eq(kat_pool_sum(), s0, "pool holds the same workspaces after 60 serial calls");
    # Overflow and empty-pool paths, on a pool whose real contents are set aside.
    var saved = alloc(_MLDSA_WS_POOL_SLOTS * 8);
    memcpy(saved, &_mldsa_ws_pool, _MLDSA_WS_POOL_SLOTS * 8);
    memset(&_mldsa_ws_pool, 0, _MLDSA_WS_POOL_SLOTS * 8);
    var fresh = _mldsa_ws_acquire();
    assert(fresh != 0, "empty pool: acquire falls back to a fresh workspace");
    _mldsa_ws_release(fresh);
    assert_eq(load64(&_mldsa_ws_pool), fresh, "release parks it in slot 0");
    assert_eq(_mldsa_ws_acquire(), fresh, "the next acquire reuses it");
    assert_eq(kat_pool_count(), 0, "and empties the slot");
    # Fill every slot with a dummy token (never dereferenced), release one
    # more: it must be freed, not parked, and no token may be disturbed.
    var fi = 0;
    while (fi < _MLDSA_WS_POOL_SLOTS) {
        store64(&_mldsa_ws_pool + fi * 8, 4096 + fi * 16);
        fi = fi + 1;
    }
    var ftok = 0;
    fi = 0;
    while (fi < _MLDSA_WS_POOL_SLOTS) {
        ftok = ftok + 4096 + fi * 16;
        fi = fi + 1;
    }
    _mldsa_ws_release(fresh);
    assert_eq(kat_pool_sum(), ftok, "full pool: a surplus workspace is freed, not parked");
    memcpy(&_mldsa_ws_pool, saved, _MLDSA_WS_POOL_SLOTS * 8);
    assert_eq(kat_pool_sum(), s0, "pool restored");

    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
