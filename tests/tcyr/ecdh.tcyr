# ---------------- zeroisation ----------------
# Counts the 8-byte words in the n bytes of dead stack below this function's frame that
# equal v. Called right after an API call returns, that region holds the frames the call
# used; a secret limb found there is a secret left behind.
fn _dead_stack_count(v, n): i64 {
    var mark[8];
    var base = &mark - n;
    var c = 0;
    var i = 0;
    while (i < n) {
        if (load64(base + i) == v) { c = c + 1; }
        i = i + 8;
    }
    return c;
}

# Bytes of dead stack the zeroisation group scans: eight times the 8 KB the ECDH entry points
# burn, so a call tree that outgrows the burn is caught rather than scanned exactly as far as
# the burn reaches (a check sized by the thing it checks cannot see past it).
var DZ_SCAN = 65536;

# Fills lv x 16 KB of stack below the caller with 0x5a (non-tail recursion), so the scanned
# region is mapped and holds nothing from earlier calls. Returns 0.
fn _dz_wipe(lv): i64 {
    var pad[16384];
    memset(&pad, 0x5a, 16384);
    if (lv > 1) { _dz_wipe(lv - 1); }
    return 0;
}

# Marks the 8-byte words of the DZ_SCAN bytes below the address ref (a local of the caller's
# frame) that already hold something other than the 0x5a fill or zero (_dz_wipe's own frame
# slots), so _dz_dirty with the same ref, after the API call, counts only what the call wrote.
# Returns 0.
var _dz_map = 0;
fn _dz_base(ref): i64 {
    if (_dz_map == 0) { _dz_map = alloc(DZ_SCAN / 8); }
    var i = 8;
    while (i <= DZ_SCAN) {
        var v = load64(ref - i);
        var b = 0;
        if (v != 0x5a5a5a5a5a5a5a5a) { if (v != 0) { b = 1; } }
        store8(_dz_map + i / 8 - 1, b);
        i = i + 8;
    }
    return 0;
}

# Counts the 8-byte words in [ref - hi, ref - lo) that are neither the 0x5a fill nor zero and
# were not marked by _dz_base: something the call wrote and the burn did not overwrite.
fn _dz_dirty(ref, lo, hi): i64 {
    var c = 0;
    var i = lo + 8;
    while (i <= hi) {
        var v = load64(ref - i);
        if (v != 0x5a5a5a5a5a5a5a5a) { if (v != 0) { if (load8(_dz_map + i / 8 - 1) == 0) { c = c + 1; } } }
        i = i + 8;
    }
    return c;
}

# What the last _residue_after_* call left between the burn and DZ_SCAN, skipping the burn's
# own frame (its 16 KB pad, whose low end it does not wipe, and its slots just below that).
# Both are given the address of one local of the helper's frame, so they agree on every offset.
var _dz_last_dirty = 0;

# A function holding a `secret var`: its compiled epilogue saves rax, rdx, r8, xmm0 and xmm1
# below its frame (cyrius EDEFER_SAVE), so calling it right after an ECDH call writes whatever
# those registers still hold into the scanned region. Returns 0.
fn _dz_spill(): i64 {
    secret var x[16];
    store64(&x, 1);
    return 0;
}

# Derives with the private key d_be on curve c, then counts how many of d's limbs survive in
# the DZ_SCAN bytes of dead stack below the caller, or in a register a later spill writes there.
fn _residue_after_shared(c, d_be, peer): i64 {
    var w = _w(c);
    var z = alloc(w);
    var ref[8];
    _dz_base(&ref);
    _shared(c, d_be, peer, 1 + 2 * w, z);
    _dz_spill();
    var found = 0;
    var i = 0;
    while (i < w / 8) {
        var limb = 0;
        var j = 0;
        while (j < 8) {
            limb = (limb << 8) | (load8(d_be + w - 8 - i * 8 + j) & 0xFF);
            j = j + 1;
        }
        found = found + _dead_stack_count(limb, DZ_SCAN);
        i = i + 1;
    }
    _dz_last_dirty = _dz_dirty(&ref, _ECDH_BURN + 512, 16384) + _dz_dirty(&ref, 16384 + 1024, DZ_SCAN);
    return found;
}

# Same after a keygen whose input reduces to the private key of the given big-endian bytes.
fn _residue_after_keygen(c, rnd): i64 {
    var w = _w(c);
    var priv = alloc(w);
    var pk = alloc(1 + 2 * w);
    var ref[8];
    _dz_base(&ref);
    _keygen(c, rnd, w + 8, priv, pk);
    _dz_spill();
    var found = 0;
    var i = 0;
    while (i < w / 8) {
        var limb = 0;
        var j = 0;
        while (j < 8) {
            limb = (limb << 8) | (load8(priv + w - 8 - i * 8 + j) & 0xFF);
            j = j + 1;
        }
        found = found + _dead_stack_count(limb, DZ_SCAN);
        i = i + 1;
    }
    _dz_last_dirty = _dz_dirty(&ref, _ECDH_BURN + 512, 16384) + _dz_dirty(&ref, 16384 + 1024, DZ_SCAN);
    return found;
}

# ---------------- concurrent callers ----------------
var _cc_rnd  = 0;   # NA x 64 random inputs
var _cc_res  = 0;   # NA x 8 per-worker mismatch counts
var _cc_ref  = 0;   # NA x (48 + 97 + 48) serial reference: priv || pub || Z
var _cc_done = 0;   # NA x 8 rounds each worker completed

# Worker: keygen + shared(own priv, G) on both curves, 3 rounds, compared with the serial
# reference computed on the main thread.
fn _cc_worker(arg): i64 {
    var idx = load64(arg);
    var bad = 0;
    var priv[48];
    var pk[97];
    var z[48];
    var r = 0;
    while (r < 3) {
        var ref = _cc_ref + idx * 2 * 193;
        ecdh_p256_keygen(_cc_rnd + idx * 64, 40, &priv, &pk);
        if (memeq(&priv, ref, 32) == 0) { bad = bad + 1; }
        if (memeq(&pk, ref + 48, 65) == 0) { bad = bad + 1; }
        ecdh_p256_shared(&priv, &pk, 65, &z);
        if (memeq(&z, ref + 145, 32) == 0) { bad = bad + 1; }
        ref = ref + 193;
        ecdh_p384_keygen(_cc_rnd + idx * 64, 56, &priv, &pk);
        if (memeq(&priv, ref, 48) == 0) { bad = bad + 1; }
        if (memeq(&pk, ref + 48, 97) == 0) { bad = bad + 1; }
        ecdh_p384_shared(&priv, &pk, 97, &z);
        if (memeq(&z, ref + 145, 48) == 0) { bad = bad + 1; }
        r = r + 1;
    }
    store64(_cc_res + idx * 8, bad);
    store64(_cc_done + idx * 8, r);   # rounds completed: a worker that never ran leaves 0
    return 0;
}

# ---------------- timing smoke ----------------
# In-place insertion sort of n i64 values; returns the median.
fn _median(arr, n): i64 {
    var i = 1;
    while (i < n) {
        var v = load64(arr + i * 8);
        var j = i - 1;
        var moving = 1;
        while (moving == 1) {
            if (j < 0) { moving = 0; }
            else {
                if (load64(arr + j * 8) > v) {
                    store64(arr + (j + 1) * 8, load64(arr + j * 8));
                    j = j - 1;
                } else { moving = 0; }
            }
        }
        store64(arr + (j + 1) * 8, v);
        i = i + 1;
    }
    return load64(arr + (n / 2) * 8);
}

var _time_fail = 0;   # timed derives that did not return 0

# Nanoseconds for one shared-secret derivation on curve c; a derive that fails is counted in
# _time_fail, so the timing group cannot pass on the time of a refusal. (Under the 6.6.9
# pin on Intel macOS, clock_now_ns writes through a stale rdx — cyrius CVE-51, fixed in
# 6.6.10 — and rdx holds `peer` here: the clock read corrupted the key, every timed derive
# failed in ~15 us, and the medians compared four refusals.)
fn _time_shared(c, priv, peer, out): i64 {
    var w = _w(c);
    var t0 = clock_now_ns();
    var rc = _shared(c, priv, peer, 1 + 2 * w, out);
    var dt = clock_now_ns() - t0;
    if (rc != 0) { _time_fail = _time_fail + 1; }
    return dt;
}

# Medians over interleaved rounds for four private scalars of very different Hamming
# weight and bit length: 1, 2^k (a single high bit), 0x55..55 (half weight), n - 1.
# Asserts every median lies within [0.75, 1.33] of the n - 1 median (wide on purpose: CI
# runners are noisy, and a leak of the kind this guards against is a factor, not percent). A ladder or window
# that skipped work on zero bits, or arithmetic that branched on operand values, shows up
# here as a gap of several times that (the 3.13.0 ladder ran k = 1 in < 1% of k = n - 1).
fn _timing(c, d1, dhi, dhalf, dmax, peer, label): i64 {
    var w = _w(c);
    var z = alloc(w);
    var t = alloc(4 * 8 * 16);
    _time_fail = 0;
    _time_shared(c, dmax, peer, z);
    var R = 9;
    var r = 0;
    while (r < R) {
        var o = 0;
        while (o < 4) {
            var which = (r + o) % 4;
            if (which == 0) { store64(t + (0 * 16 + r) * 8, _time_shared(c, d1, peer, z)); }
            if (which == 1) { store64(t + (1 * 16 + r) * 8, _time_shared(c, dhi, peer, z)); }
            if (which == 2) { store64(t + (2 * 16 + r) * 8, _time_shared(c, dhalf, peer, z)); }
            if (which == 3) { store64(t + (3 * 16 + r) * 8, _time_shared(c, dmax, peer, z)); }
            o = o + 1;
        }
        r = r + 1;
    }
    var m1 = _median(t + 0 * 128, R);
    var mh = _median(t + 1 * 128, R);
    var m5 = _median(t + 2 * 128, R);
    var mx = _median(t + 3 * 128, R);
    sys_write(1, "    ", 4);
    sys_write(1, label, strlen(label));
    sys_write(1, " medians ns: d=1 ", 17);
    fmt_int(m1);
    sys_write(1, "  d=2^k ", 8);
    fmt_int(mh);
    sys_write(1, "  d=0x55.. ", 11);
    fmt_int(m5);
    sys_write(1, "  d=n-1 ", 8);
    fmt_int(mx);
    sys_write(1, "\n", 1);
    assert_eq(_time_fail, 0, "every timed derive succeeded");
    assert_gte(m1 * 4, mx * 3, "d=1 median >= 0.75x d=n-1");
    assert_lte(m1 * 3, mx * 4, "d=1 median <= 1.33x d=n-1");
    assert_gte(mh * 4, mx * 3, "d=2^k median >= 0.75x d=n-1");
    assert_lte(mh * 3, mx * 4, "d=2^k median <= 1.33x d=n-1");
    assert_gte(m5 * 4, mx * 3, "d=0x55.. median >= 0.75x d=n-1");
    assert_lte(m5 * 3, mx * 4, "d=0x55.. median <= 1.33x d=n-1");
    return 0;
}

fn main() {
    alloc_init();
    crypto_tls_main_init();

    # ============================================================
    test_group("RFC 5903 §8.1 — P-256 ECDH");
    _kat(256, "c88f01f510d9ac3f70a292daa2316de544e9aab8afe84049c62a9c57862d1433",
      "d12dfb5289c8d4f81208b70270398c342296970a0bccb74c736fc7554494bf63",
      "56fbf3ca366cc23e8157854c13c58d6aac23f046ada30f8353e74f33039872ab",
      "d6840f6b42f6edafd13116e0e12565202fef8e9ece7dce03812464d04b9442de",
      "dad0b65394221cf9b051e1feca5787d098dfe637fc90b9ef945d0c3772581180",
      "5271a0461cdb8252d61f1c456fa3e59ab1f45b33accf5f58389e0577b8990bb3", "rfc5903 P-256: i with g^r, and g^i");
    _kat(256, "c6ef9c5d78ae012a011164acb397ce2088685d8f06bf9be0b283ab46476bee53",
      "dad0b65394221cf9b051e1feca5787d098dfe637fc90b9ef945d0c3772581180",
      "5271a0461cdb8252d61f1c456fa3e59ab1f45b33accf5f58389e0577b8990bb3",
      "d6840f6b42f6edafd13116e0e12565202fef8e9ece7dce03812464d04b9442de",
      "d12dfb5289c8d4f81208b70270398c342296970a0bccb74c736fc7554494bf63",
      "56fbf3ca366cc23e8157854c13c58d6aac23f046ada30f8353e74f33039872ab", "rfc5903 P-256: r with g^i, and g^r");

    # ============================================================
    test_group("RFC 5903 §8.2 — P-384 ECDH");
    _kat(384, "099f3c7034d4a2c699884d73a375a67f7624ef7c6b3c0f160647b67414dce655e35b538041e649ee3faef896783ab194",
      "e558dbef53eecde3d3fccfc1aea08a89a987475d12fd950d83cfa41732bc509d0d1ac43a0336def96fda41d0774a3571",
      "dcfbec7aacf3196472169e838430367f66eebe3c6e70c416dd5f0c68759dd1fff83fa40142209dff5eaad96db9e6386c",
      "11187331c279962d93d604243fd592cb9d0a926f422e47187521287e7156c5c4d603135569b9e9d09cf5d4a270f59746",
      "667842d7d180ac2cde6f74f37551f55755c7645c20ef73e31634fe72b4c55ee6de3ac808acb4bdb4c88732aee95f41aa",
      "9482ed1fc0eeb9cafc4984625ccfc23f65032149e0e144ada024181535a0f38eeb9fcff3c2c947dae69b4c634573a81c", "rfc5903 P-384: i with g^r, and g^i");
    _kat(384, "41cb0779b4bdb85d47846725fbec3c9430fab46cc8dc5060855cc9bda0aa2942e0308312916b8ed2960e4bd55a7448fc",
      "667842d7d180ac2cde6f74f37551f55755c7645c20ef73e31634fe72b4c55ee6de3ac808acb4bdb4c88732aee95f41aa",
      "9482ed1fc0eeb9cafc4984625ccfc23f65032149e0e144ada024181535a0f38eeb9fcff3c2c947dae69b4c634573a81c",
      "11187331c279962d93d604243fd592cb9d0a926f422e47187521287e7156c5c4d603135569b9e9d09cf5d4a270f59746",
      "e558dbef53eecde3d3fccfc1aea08a89a987475d12fd950d83cfa41732bc509d0d1ac43a0336def96fda41d0774a3571",
      "dcfbec7aacf3196472169e838430367f66eebe3c6e70c416dd5f0c68759dd1fff83fa40142209dff5eaad96db9e6386c", "rfc5903 P-384: r with g^i, and g^r");

    # ============================================================
    test_group("NIST CAVP KAS ECC CDH primitive — P-256 (25 vectors)");
    _cavp256();
    test_group("NIST CAVP KAS ECC CDH primitive — P-384 (25 vectors)");
    _cavp384();

    # ============================================================
    test_group("OpenSSL 3.6.5 cross-check — keygen and derive agree with pkeyutl -derive");
    _kg(256, "c09b227a7ad2263557944cf9729c29a4ca63a1ec3e7225ee382d0f13ae0beb907a8e326b3eca6635",
      "d266732d372ee0f5fcdf0f19d94a2b0b41a288f8e4fe1513524de2e481756486",
      "04f3c03293f2aba4f998aac985974faedb88e7578fb7fc2288044897227a6b11f3269eb440b35472984192b292675024024f93ae9a268cac43e3f5e297886fb558", "openssl P-256 #0 keygen");
    _kat(256, "d266732d372ee0f5fcdf0f19d94a2b0b41a288f8e4fe1513524de2e481756486",
      "baa2d8eee97581e05b962cca66c0f20eda4468811954908eb370ed8fa165dc7e",
