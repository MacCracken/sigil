# ecdh.tcyr — ECDH on P-256 / P-384 (src/ecdh.cyr, 3.13.8).
#
# Known answers come from three independent sources, none of them sigil:
#   - RFC 5903 §8.1 / §8.2 (the IKE ECP groups 19 and 20 vectors);
#   - NIST CAVP "KAS ECC CDH primitive" — KAS_ECC_CDH_PrimitiveTest.txt,
#     all 25 vectors for each of P-256 and P-384 (dIUT, QIUT = dIUT·G, and
#     Z = x(dIUT·QCAVS));
#   - OpenSSL 3.6.5: the key pairs keygen derives from fixed random input,
#     loaded into OpenSSL as SEC 1 private keys (OpenSSL recomputed the same
#     public keys) and `openssl pkeyutl -derive` against OpenSSL-generated
#     peers, in both directions.
# Keygen edge expectations (all-zero / all-one input, the n - 2 / n - 1
# boundaries of the reduction) were computed with an independent Python
# big-integer model of FIPS 186-5 A.2.1.
#
# Groups: known answers, keygen, peer-key validation (every rejection
# zeroes the output), private-scalar range, valid edge points, concurrent
# callers, and a timing smoke check (the structural constant-time review is
# docs/audit/2026-10-02-3.13.8-ct-ecdh-ecdsa-sign-audit.md).

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/str.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fmt.cyr"
include "lib/bayan.cyr"
include "lib/sakshi.cyr"
include "lib/chrono.cyr"
include "lib/ct.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"
include "src/crypto_scratch.cyr"
include "src/mul64.cyr"
include "src/types.cyr"
include "src/error.cyr"
include "lib/random.cyr"
include "src/random.cyr"
include "src/sha256.cyr"
include "src/hex.cyr"
include "src/sha512.cyr"
include "src/sha384.cyr"
include "src/hmac.cyr"
include "src/hmac_sha384.cyr"
include "src/bigint_ext.cyr"
include "src/ecdsa_p256.cyr"
include "src/ecdsa_p384.cyr"
include "src/ec_ct.cyr"
include "src/ecdh.cyr"

# Decodes a hex C-string into a fresh buffer.
fn _h(s): i64 { return hex_decode(s, strlen(s)); }

# Field width in bytes for curve selector c (256 or 384).
fn _w(c): i64 {
    if (c == 256) { return 32; }
    return 48;
}

# ECDH shared secret through the public API for curve c.
fn _shared(c, priv, peer, peer_len, out): i64 {
    if (c == 256) { return ecdh_p256_shared(priv, peer, peer_len, out); }
    return ecdh_p384_shared(priv, peer, peer_len, out);
}

# Keygen through the public API for curve c.
fn _keygen(c, rnd, rnd_len, priv, pubk): i64 {
    if (c == 256) { return ecdh_p256_keygen(rnd, rnd_len, priv, pubk); }
    return ecdh_p384_keygen(rnd, rnd_len, priv, pubk);
}

# pubk (1 + 2w bytes) = 0x04 || d·G for the big-endian scalar d_be, through the engine
# directly (the API derives public keys only inside keygen). Test-side helper.
fn _pubkey(c, d_be, pubk): i64 {
    var nl = 4;
    var f = 0; var bm = 0; var G = 0;
    if (c == 256) { _ect256_init(); f = _ect_fp256; bm = _ect_b256; G = _ect_g256; }
    else { _ect384_init(); nl = 6; f = _ect_fp384; bm = _ect_b384; G = _ect_g384; }
    var d[48];
    var R[144];
    var x[48];
    var y[48];
    _ect_load_be(&d, d_be, nl);
    _ect_smul(&R, &d, G, f, bm);
    _ect_affine(&x, &y, &R, f);
    store8(pubk, 4);
    _ect_store_be(pubk + 1, &x, nl);
    _ect_store_be(pubk + 1 + nl * 8, &y, nl);
    return 0;
}

# One known-answer check: d (hex), peer point (hex x, y), expected Z (hex), and when
# qx/qy are non-empty, the expected public key d·G.
fn _kat(c, dh, px, py, zh, qx, qy, label): i64 {
    var w = _w(c);
    var peer = alloc(1 + 2 * w);
    store8(peer, 4);
    memcpy(peer + 1, _h(px), w);
    memcpy(peer + 1 + w, _h(py), w);
    var z = alloc(w);
    assert_eq(_shared(c, _h(dh), peer, 1 + 2 * w, z), 0, label);
    assert_streq(hex_encode(z, w), zh, label);
    if (strlen(qx) > 0) {
        var pk = alloc(1 + 2 * w);
        _pubkey(c, _h(dh), pk);
        assert_eq(memeq(pk + 1, _h(qx), w), 1, label);
        assert_eq(memeq(pk + 1 + w, _h(qy), w), 1, label);
    }
    return 0;
}

# Expects keygen(rnd) to give exactly priv_hex / pub_hex.
fn _kg(c, rnd_hex, priv_hex, pub_hex, label): i64 {
    var w = _w(c);
    var rnd = _h(rnd_hex);
    var priv = alloc(w);
    var pk = alloc(1 + 2 * w);
    assert_eq(_keygen(c, rnd, w + 8, priv, pk), 0, label);
    assert_streq(hex_encode(priv, w), priv_hex, label);
    assert_streq(hex_encode(pk, 1 + 2 * w), pub_hex, label);
    return 0;
}

# Expects a rejection: -1 and every byte of the (0xAA-prefilled) output zeroed.
fn _reject(c, priv, peer, peer_len, label): i64 {
    var w = _w(c);
    var z = alloc(w);
    memset(z, 0xAA, w);
    assert_eq(_shared(c, priv, peer, peer_len, z), 0 - 1, label);
    var acc = 0;
    var i = 0;
    while (i < w) { acc = acc | (load8(z + i) & 0xFF); i = i + 1; }
    assert_eq(acc, 0, label);
    return 0;
}

