# tee_verify_concurrent.tcyr — race detector for the SGX / TDX / SEV-SNP
# verify paths (audit H2).
#
# Before the fix, sgx_quote_verify_with_pck / tdx_quote_verify_with_pck
# hashed AK || qe_auth_data into a SHARED module-global buffer and then
# compared the SHARED hash against the QE report_data; snp_report_verify
# reversed the report signature into a SHARED module-global buffer
# before handing it to ecdsa_p384_verify. A concurrent verify could
# overwrite that scratch between one call's write and its use, so:
#
#   * a genuine quote could be falsely rejected, and
#   * a FORGED quote — the genuine, replayed PCK-signed QE report with an
#     attacker-chosen AK that correctly signs the quote body — could pass
#     the AK-binding check by reading the genuine call's hash (the same
#     shape as the 3.12.3 RSA shared-lane bypass).
#
# Each worker alternates verifying a genuine quote (must ALWAYS verify)
# and the forgery (must NEVER verify). Red = any genuine false-reject or
# any forged accept; green = zero of both over every iteration.
#
# Forgeries:
#   SGX / TDX: genuine header, body, QE report + PCK signature and
#     qe_auth_data; the AK is replaced by an attacker key (RFC 6979 A.2.5
#     P-256 / A.2.6 P-384 test keys) that re-signs header || body, so the
#     forgery passes steps 1 and 3 and only the AK binding (step 2)
#     rejects it.
#   SEV-SNP: genuine body with one bit of the signature's S flipped.
#
# Detection is probabilistic. On the pre-fix code the SNP group was red
# on every run at these counts; the SGX / TDX binding-race groups were
# red only intermittently (the window between finalize and the 32-byte
# compare is microseconds inside a ~45 ms verify), so a single green run
# is not proof on its own.
#
# Scope: the *_verify_full_into groups re-cover the with_pck / verify
# race end to end only. Genuine and forged inputs carry the SAME PCK /
# VCEK chain, so they do not exercise a chain-level race; the separate
# "x509 — concurrent chain-link verify" group does (3.13.1: the module-global
# `_xvl_digest` in src/x509.cyr let a TBS-mutated leaf carrying the genuine CA
# signature verify under concurrency).

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/str.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fmt.cyr"
include "lib/bayan.cyr"
include "lib/sakshi.cyr"
include "lib/chrono.cyr"
include "lib/ct.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"
include "src/crypto_scratch.cyr"
include "src/mul64.cyr"
include "src/types.cyr"
include "src/error.cyr"
include "lib/random.cyr"
include "src/random.cyr"
include "src/sha256.cyr"
include "src/hex.cyr"
include "src/sha512.cyr"
include "src/sha384.cyr"
include "src/hmac.cyr"
include "src/hmac_sha384.cyr"
include "src/bigint_ext.cyr"
include "src/bignum.cyr"
include "src/ed25519.cyr"
include "src/ecdsa_p256.cyr"
include "src/ecdsa_p384.cyr"
include "src/ecdsa_sign.cyr"
include "src/x509.cyr"
include "src/pem.cyr"
include "src/rsa.cyr"
include "src/sgx.cyr"
include "src/tdx.cyr"
include "src/sev_snp.cyr"

# ----------------------------------------------------------------
# Fixtures — copied verbatim from sgx_verify_full.tcyr,
# tdx_verify_full.tcyr and snp_verify_full.tcyr (same test PKI).
# ----------------------------------------------------------------
var ROOT_DER_LEN = 425;
var SGX_QUOTE_LEN = 2310;
var TDX_P256_QUOTE_LEN = 2510;
var TDX_P384_QUOTE_LEN = 2574;
var VCEK_CHAIN_PEM_LEN = 1299;
var SNP_REPORT_LEN = 1184;
var NOW_IN_WINDOW = 1782518400;
var ROOT_DER_HEX = "";
var SGX_QUOTE_HEX = "";
var P256_QUOTE_HEX = "";
var P384_QUOTE_HEX = "";
var VCEK_CHAIN_PEM_HEX = "";
var SNP_REPORT_HEX = "";

# Attacker AK keys (RFC 6979 A.2.5 P-256 / A.2.6 P-384 test vectors).
var ATK256_D_HEX = "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721";
var ATK256_PK_HEX = "60fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299";
var ATK384_D_HEX = "6b9d3dad2e1b8c1c05b19875b6659f4de23c3b667bf297ba9aa47740787137d896d5724e4c70a825f872c9ea60d2edf5";
var ATK384_PK_HEX = "ec3a4e415b4e19a4568618029f427fa5da9a8bc4ae92e02e06aae5286b300c64def8f0ea9055866064a254515480bc138015d9b72d7d57244ea8ef9ac0c621896708a59367f9dfb9f54ca84b3f1c9db1288b231c3ae0d4fe7344fd2533264720";

# Worker fan-out: banks 1..NA.
var TV_NA = 8;

# Per-run shared, READ-ONLY-while-running configuration.
var _tv_kind   = 0;   # 1 SGX, 2 TDX, 3 SNP (with_pck / verify); +3 = *_verify_full_into
var _tv_iters  = 0;
var _tv_good   = 0;   # parsed genuine quote / report
var _tv_forged = 0;   # parsed forgery
var _tv_pk     = 0;   # PCK / VCEK public key (with_pck kinds)
var _tv_root   = 0;   # root CA DER (full kinds)
var _tv_chain  = 0;   # SNP VCEK chain PEM (full kinds)
var _tv_arenas = 0;   # TV_NA x 8 per-worker arenas (full kinds)
var _tv_issuer = 0;   # issuer cert for the chain-link kind (7)
# Per-worker result slots (each worker writes only its own slot).
var _tv_gbad = 0;     # TV_NA x 8 genuine false-rejects
var _tv_facc = 0;     # TV_NA x 8 forged accepts

fn _tv_verify(q, idx): i64 {
    var k = _tv_kind;
    if (k == 1) { return sgx_quote_verify_with_pck(q, _tv_pk); }
    if (k == 2) { return tdx_quote_verify_with_pck(q, _tv_pk); }
    if (k == 3) { return snp_report_verify(q, _tv_pk); }
    if (k == 7) { return _x509_verify_link(q, _tv_issuer); }
    var arena = load64(_tv_arenas + idx * 8);
    arena_reset(arena);
    if (k == 4) {
        return sgx_quote_verify_full_into(q, _tv_root, ROOT_DER_LEN, NOW_IN_WINDOW, arena);
    }
    if (k == 5) {
        return tdx_quote_verify_full_into(q, _tv_root, ROOT_DER_LEN, NOW_IN_WINDOW, arena);
    }
    return snp_report_verify_full_into(q, _tv_chain, VCEK_CHAIN_PEM_LEN,
      _tv_root, ROOT_DER_LEN, NOW_IN_WINDOW, arena);
}

fn _tv_worker(arg): i64 {
    var bank = load64(arg + 0);
    var idx  = load64(arg + 8);
    crypto_bank_set(bank);
    var gbad = 0;
    var facc = 0;
    var it = 0;
    while (it < _tv_iters) {
        # Odd workers lead with the forgery so the two call shapes are
        # always interleaved across threads.
        if ((idx & 1) == 1) {
            if (_tv_verify(_tv_forged, idx) != 0) { facc = facc + 1; }
            if (_tv_verify(_tv_good, idx) != 1) { gbad = gbad + 1; }
        } else {
            if (_tv_verify(_tv_good, idx) != 1) { gbad = gbad + 1; }
            if (_tv_verify(_tv_forged, idx) != 0) { facc = facc + 1; }
        }
        it = it + 1;
    }
    store64(_tv_gbad + idx * 8, gbad);
    store64(_tv_facc + idx * 8, facc);
    return 0;
}

var _tv_tot_gbad = 0;
var _tv_tot_facc = 0;

# Run TV_NA concurrent workers for `iters` genuine+forged pairs each;
# totals land in _tv_tot_gbad / _tv_tot_facc.
fn _tv_run(kind, good, forged, iters): i64 {
    _tv_kind = kind;
    _tv_good = good;
    _tv_forged = forged;
    _tv_iters = iters;
    memset(_tv_gbad, 0, TV_NA * 8);
    memset(_tv_facc, 0, TV_NA * 8);
    var args = alloc(TV_NA * 16);
    var ths  = alloc(TV_NA * 8);
    var i = 0;
    while (i < TV_NA) {
        store64(args + i * 16 + 0, i + 1);
        store64(args + i * 16 + 8, i);
        store64(ths + i * 8, thread_create(&_tv_worker, args + i * 16));
        i = i + 1;
    }
    i = 0;
    while (i < TV_NA) { thread_join(load64(ths + i * 8)); i = i + 1; }
    _tv_tot_gbad = 0;
    _tv_tot_facc = 0;
    i = 0;
    while (i < TV_NA) {
        _tv_tot_gbad = _tv_tot_gbad + load64(_tv_gbad + i * 8);
        _tv_tot_facc = _tv_tot_facc + load64(_tv_facc + i * 8);
        i = i + 1;
    }
    return 0;
}

# Copy of a cert's DER with the last byte of its serial number flipped: the TBS
# changes, the signature does not. 0 if the TBS does not have the expected shape.
fn _tv_flip_serial(der, der_len, cert): i64 {
    var out = alloc(der_len);
    memcpy(out, der, der_len);
    var p = load64(cert + 16);                    # tbs_off
    if (load8(out + p) != 0x30) { return 0; }
    var l = load8(out + p + 1);
    p = p + 2;
    if ((l & 0x80) != 0) { p = p + (l & 0x7F); }  # long-form length octets
    if (load8(out + p) == 0xA0) { p = p + 2 + load8(out + p + 1); }   # [0] version
    if (load8(out + p) != 0x02) { return 0; }     # serialNumber INTEGER
    var sl = load8(out + p + 1);
    if ((sl & 0x80) != 0) { return 0; }
    if (sl < 2) { return 0; }
    var last = out + p + 2 + sl - 1;
    store8(last, (load8(last) & 0xFF) ^ 0x5A);
    return out;
}

# Leaf public key of a PEM chain (parsed on the main thread).
fn _tv_leaf_pk(pem, pem_len): i64 {
    var chain[64];
    memset(&chain, 0, 64);
    var n = pem_decode_certs(pem, pem_len, &chain, 4);
    if (n < 1) { return 0; }
    var c = x509_cert_alloc();
    if (x509_parse(load64(&chain + 0), load64(&chain + 8), c) != 1) { return 0; }
    return x509_cert_pubkey(c);
}

fn main() {
    alloc_init();
    crypto_tls_main_init();
    _p256_init();
    _p384_init();
    ecdsa_p256_warm();
    ecdsa_p384_warm();

    _tv_gbad = alloc(TV_NA * 8);
    _tv_facc = alloc(TV_NA * 8);
    _tv_arenas = alloc(TV_NA * 8);
    var ai = 0;
    while (ai < TV_NA) { store64(_tv_arenas + ai * 8, arena_new(32768)); ai = ai + 1; }

    _tv_root = hex_decode(ROOT_DER_HEX, 2 * ROOT_DER_LEN);
    _tv_chain = hex_decode(VCEK_CHAIN_PEM_HEX, 2 * VCEK_CHAIN_PEM_LEN);
    var atk256_d  = hex_decode(ATK256_D_HEX, 64);
    var atk256_pk = hex_decode(ATK256_PK_HEX, 128);
    var atk384_d  = hex_decode(ATK384_D_HEX, 96);
    var atk384_pk = hex_decode(ATK384_PK_HEX, 192);

    # ============================================================
    # SGX DCAP v3
    # ============================================================
    var sgx_buf = hex_decode(SGX_QUOTE_HEX, 2 * SGX_QUOTE_LEN);
    var sgx_q = sgx_quote_alloc();
    assert_eq(sgx_quote_parse(sgx_buf, SGX_QUOTE_LEN, sgx_q), 1, "SGX genuine quote parses");
    var pck_pk = _tv_leaf_pk(sgx_quote_cert_data_ptr(sgx_q), sgx_quote_cert_data_len(sgx_q));
    assert_eq(pck_pk != 0, 1, "SGX PCK leaf pubkey extracted");

    var sgx_fbuf = alloc(SGX_QUOTE_LEN);
    memcpy(sgx_fbuf, sgx_buf, SGX_QUOTE_LEN);
    var sgx_ak_off  = sgx_quote_ak_ptr(sgx_q) - sgx_buf;
    var sgx_sig_off = sgx_quote_ecdsa_sig_ptr(sgx_q) - sgx_buf;
    memcpy(sgx_fbuf + sgx_ak_off, atk256_pk, 64);
    ecdsa_p256_sign(atk256_d, sgx_fbuf, 432, sgx_fbuf + sgx_sig_off);
    var sgx_fq = sgx_quote_alloc();
    assert_eq(sgx_quote_parse(sgx_fbuf, SGX_QUOTE_LEN, sgx_fq), 1, "SGX forgery parses");

    test_group("SGX — serial baseline");
    _tv_pk = pck_pk;
    assert_eq(sgx_quote_verify_with_pck(sgx_q, pck_pk), 1, "genuine SGX quote verifies");
    assert_eq(ecdsa_p256_verify(pck_pk, sgx_quote_qe_report_ptr(sgx_fq), 384,
        sgx_quote_qe_report_sig_ptr(sgx_fq)), 1, "forgery carries the genuine PCK-signed QE report");
    assert_eq(ecdsa_p256_verify(atk256_pk, sgx_fbuf, 432, sgx_fbuf + sgx_sig_off), 1,
      "forgery's attacker AK validly signs header || body");
    assert_eq(sgx_quote_verify_with_pck(sgx_fq, pck_pk), 0, "SGX forgery rejected (AK binding)");

    test_group("SGX — concurrent sgx_quote_verify_with_pck");
    _tv_run(1, sgx_q, sgx_fq, 150);
    assert_eq(_tv_tot_gbad, 0, "8 workers x 150: zero genuine SGX false-rejects");
    assert_eq(_tv_tot_facc, 0, "8 workers x 150: zero forged SGX accepts");

    test_group("SGX — concurrent sgx_quote_verify_full_into (per-worker arena)");
    _tv_run(4, sgx_q, sgx_fq, 5);
    assert_eq(_tv_tot_gbad, 0, "8 workers x 5: zero genuine SGX verify_full false-rejects");
    assert_eq(_tv_tot_facc, 0, "8 workers x 5: zero forged SGX verify_full accepts");

    test_group("x509 — concurrent chain-link verify (_x509_verify_link)");
    var xl_chain[64];
    memset(&xl_chain, 0, 64);
    var xl_n = pem_decode_certs(sgx_quote_cert_data_ptr(sgx_q), sgx_quote_cert_data_len(sgx_q),
      &xl_chain, 4);
    assert(xl_n >= 2, "SGX PCK chain has a leaf and its issuer");
    var xl_der = load64(&xl_chain + 0);
    var xl_len = load64(&xl_chain + 8);
    var xl_leaf = x509_cert_alloc();
    var xl_iss = x509_cert_alloc();
    assert_eq(x509_parse(xl_der, xl_len, xl_leaf), 1, "PCK leaf parses");
    assert_eq(x509_parse(load64(&xl_chain + 16), load64(&xl_chain + 24), xl_iss), 1,
      "PCK issuer parses");
    var xl_fder = _tv_flip_serial(xl_der, xl_len, xl_leaf);
    assert(xl_fder != 0, "forged leaf built (serial byte flipped)");
    var xl_forged = x509_cert_alloc();
    assert_eq(x509_parse(xl_fder, xl_len, xl_forged), 1, "forged leaf parses");
    _tv_issuer = xl_iss;
    assert_eq(_x509_verify_link(xl_leaf, xl_iss), 1, "genuine leaf link verifies (serial)");
    assert_eq(_x509_verify_link(xl_forged, xl_iss), 0, "TBS-mutated leaf rejected (serial)");
    _tv_run(7, xl_leaf, xl_forged, 300);
    assert_eq(_tv_tot_gbad, 0, "8 workers x 300: zero genuine link false-rejects");
    assert_eq(_tv_tot_facc, 0, "8 workers x 300: zero forged link accepts");

    # ============================================================
    # TDX v4 — att_key_type 2 (P-256) and 3 (P-384)
    # ============================================================
    var t2_buf = hex_decode(P256_QUOTE_HEX, 2 * TDX_P256_QUOTE_LEN);
    var t2_q = tdx_quote_alloc();
    assert_eq(tdx_quote_parse(t2_buf, TDX_P256_QUOTE_LEN, t2_q), 1, "TDX P-256 quote parses");
    var t2_fbuf = alloc(TDX_P256_QUOTE_LEN);
    memcpy(t2_fbuf, t2_buf, TDX_P256_QUOTE_LEN);
    var t2_sig_off = tdx_quote_ecdsa_sig_ptr(t2_q) - t2_buf;
    memcpy(t2_fbuf + (tdx_quote_ak_ptr(t2_q) - t2_buf), atk256_pk, 64);
    ecdsa_p256_sign(atk256_d, t2_fbuf, 632, t2_fbuf + t2_sig_off);
    var t2_fq = tdx_quote_alloc();
    assert_eq(tdx_quote_parse(t2_fbuf, TDX_P256_QUOTE_LEN, t2_fq), 1, "TDX P-256 forgery parses");

    var t3_buf = hex_decode(P384_QUOTE_HEX, 2 * TDX_P384_QUOTE_LEN);
    var t3_q = tdx_quote_alloc();
    assert_eq(tdx_quote_parse(t3_buf, TDX_P384_QUOTE_LEN, t3_q), 1, "TDX P-384 quote parses");
    var t3_fbuf = alloc(TDX_P384_QUOTE_LEN);
    memcpy(t3_fbuf, t3_buf, TDX_P384_QUOTE_LEN);
    var t3_sig_off = tdx_quote_ecdsa_sig_ptr(t3_q) - t3_buf;
    memcpy(t3_fbuf + (tdx_quote_ak_ptr(t3_q) - t3_buf), atk384_pk, 96);
    ecdsa_p384_sign(atk384_d, t3_fbuf, 632, t3_fbuf + t3_sig_off);
    var t3_fq = tdx_quote_alloc();
    assert_eq(tdx_quote_parse(t3_fbuf, TDX_P384_QUOTE_LEN, t3_fq), 1, "TDX P-384 forgery parses");

    var tdx_pck = _tv_leaf_pk(tdx_quote_cert_data_ptr(t2_q), tdx_quote_cert_data_len(t2_q));
    assert_eq(tdx_pck != 0, 1, "TDX PCK leaf pubkey extracted");

    test_group("TDX — serial baseline");
    _tv_pk = tdx_pck;
    assert_eq(tdx_quote_verify_with_pck(t2_q, tdx_pck), 1, "genuine TDX P-256 quote verifies");
    assert_eq(tdx_quote_verify_with_pck(t3_q, tdx_pck), 1, "genuine TDX P-384 quote verifies");
    assert_eq(ecdsa_p256_verify(atk256_pk, t2_fbuf, 632, t2_fbuf + t2_sig_off), 1,
      "P-256 forgery's attacker AK validly signs header || TD body");
    assert_eq(ecdsa_p384_verify(atk384_pk, t3_fbuf, 632, t3_fbuf + t3_sig_off), 1,
      "P-384 forgery's attacker AK validly signs header || TD body");
    assert_eq(tdx_quote_verify_with_pck(t2_fq, tdx_pck), 0, "TDX P-256 forgery rejected");
    assert_eq(tdx_quote_verify_with_pck(t3_fq, tdx_pck), 0, "TDX P-384 forgery rejected");

    test_group("TDX — concurrent tdx_quote_verify_with_pck");
    _tv_run(2, t2_q, t2_fq, 150);
    assert_eq(_tv_tot_gbad, 0, "P-256 8 workers x 150: zero genuine false-rejects");
    assert_eq(_tv_tot_facc, 0, "P-256 8 workers x 150: zero forged accepts");
    _tv_run(2, t3_q, t3_fq, 30);
    assert_eq(_tv_tot_gbad, 0, "P-384 8 workers x 30: zero genuine false-rejects");
    assert_eq(_tv_tot_facc, 0, "P-384 8 workers x 30: zero forged accepts");

    test_group("TDX — concurrent tdx_quote_verify_full_into (per-worker arena)");
    _tv_run(5, t3_q, t3_fq, 3);
    assert_eq(_tv_tot_gbad, 0, "8 workers x 3: zero genuine TDX verify_full false-rejects");
    assert_eq(_tv_tot_facc, 0, "8 workers x 3: zero forged TDX verify_full accepts");

    # ============================================================
    # AMD SEV-SNP
    # ============================================================
    var snp_buf = hex_decode(SNP_REPORT_HEX, 2 * SNP_REPORT_LEN);
    var snp_r = snp_report_alloc();
    assert_eq(snp_report_parse(snp_buf, SNP_REPORT_LEN, snp_r), 1, "SNP report parses");
    var snp_fbuf = alloc(SNP_REPORT_LEN);
    memcpy(snp_fbuf, snp_buf, SNP_REPORT_LEN);
    # Flip bit 0 of S (little-endian, so byte 0 is the least significant).
    store8(snp_fbuf + SNP_OFF_SIG_S, (load8(snp_fbuf + SNP_OFF_SIG_S) & 0xFF) ^ 0x01);
    var snp_fr = snp_report_alloc();
    assert_eq(snp_report_parse(snp_fbuf, SNP_REPORT_LEN, snp_fr), 1, "SNP forgery parses");
    var vcek_pk = _tv_leaf_pk(_tv_chain, VCEK_CHAIN_PEM_LEN);
    assert_eq(vcek_pk != 0, 1, "VCEK leaf pubkey extracted");

    test_group("SEV-SNP — serial baseline");
    _tv_pk = vcek_pk;
    assert_eq(snp_report_verify(snp_r, vcek_pk), 1, "genuine SNP report verifies");
    assert_eq(snp_report_verify(snp_fr, vcek_pk), 0, "SNP signature forgery rejected");

    test_group("SEV-SNP — concurrent snp_report_verify");
    _tv_run(3, snp_r, snp_fr, 40);
    assert_eq(_tv_tot_gbad, 0, "8 workers x 40: zero genuine SNP false-rejects");
    assert_eq(_tv_tot_facc, 0, "8 workers x 40: zero forged SNP accepts");

    test_group("SEV-SNP — concurrent snp_report_verify_full_into (per-worker arena)");
    _tv_run(6, snp_r, snp_fr, 3);
    assert_eq(_tv_tot_gbad, 0, "8 workers x 3: zero genuine SNP verify_full false-rejects");
    assert_eq(_tv_tot_facc, 0, "8 workers x 3: zero forged SNP verify_full accepts");

    test_group("3.13.1 exact-length parse; an unparsed struct is refused");
    var sgx_tail = alloc(SGX_QUOTE_LEN + 1);
    memcpy(sgx_tail, sgx_buf, SGX_QUOTE_LEN);
    store8(sgx_tail + SGX_QUOTE_LEN, 0);
    assert_eq(sgx_quote_parse(sgx_tail, SGX_QUOTE_LEN + 1, sgx_quote_alloc()), 0,
      "SGX: a byte after the signature section is refused");
    var t2_tail = alloc(TDX_P256_QUOTE_LEN + 1);
    memcpy(t2_tail, t2_buf, TDX_P256_QUOTE_LEN);
    store8(t2_tail + TDX_P256_QUOTE_LEN, 0);
    assert_eq(tdx_quote_parse(t2_tail, TDX_P256_QUOTE_LEN + 1, tdx_quote_alloc()), 0,
      "TDX: a byte after the signature section is refused");
    assert_eq(sgx_quote_verify_with_pck(sgx_quote_alloc(), pck_pk), 0, "SGX: unparsed struct refused");
    assert_eq(tdx_quote_verify_with_pck(tdx_quote_alloc(), tdx_pck), 0, "TDX: unparsed struct refused");
    var t2_body = tdx_quote_td_body_ptr(t2_q);
    assert_eq(tdx_quote_tee_tcb_svn_ptr(t2_q) - t2_body, 0, "TEE_TCB_SVN at TD body +0");
    assert_eq(tdx_quote_seam_attributes_ptr(t2_q) - t2_body, 112, "SEAMATTRIBUTES at TD body +112");
    assert_eq(tdx_quote_mrownerconfig_ptr(t2_q) - t2_body, 280, "MROWNERCONFIG at TD body +280");

    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
