# rsa_lane_race.tcyr — 3.12.5. The RSA verify path is correct under LANE ALIASING.
#
# WHY THIS EXISTS. `cbank()` hands out 63 lanes and never releases one, so any tree
# with more than 63 lifetime crypto-touching threads has colliding pairs. The banked
# verify workspace then let a sibling corrupt this thread's operands. 3.12.2 accepted
# 888 of 400,000 FORGED signatures; 3.12.3 closed that but verified only 1 of 2,000
# VALID ones; 3.12.4 localised the Montgomery scratch and reached 712 of 2,000.
# 3.12.5 localises the last shared buffer (`bn_mod`).
#
# ⚠ DETERMINISTIC, NOT A RACE TEST. Both threads pin to lane 1 with
# `crypto_bank_set(1)`, reproducing by construction the aliasing that 100 workers over
# 63 lanes reach by wrap. Three earlier harness attempts failed precisely because they
# waited for the counter to wrap and the workers landed on lanes 0 and 1 — a test that
# cannot collide proves nothing. The gate is an invariant that must hold under EVERY
# interleaving: a valid signature ALWAYS verifies, a forged one NEVER does.
# Shape borrowed from agnosai/tests/server_auth_lane_race.tcyr.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/str.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fmt.cyr"
include "lib/bayan.cyr"
include "lib/sakshi.cyr"
include "lib/chrono.cyr"
include "lib/ct.cyr"
include "lib/thread_local.cyr"
include "src/crypto_scratch.cyr"
include "src/mul64.cyr"
include "src/types.cyr"
include "src/error.cyr"
include "lib/random.cyr"
include "src/random.cyr"
include "src/sha256.cyr"
include "src/hex.cyr"
include "src/sha512.cyr"
include "src/sha384.cyr"
include "src/bigint_ext.cyr"
include "src/ed25519.cyr"
include "src/ecdsa_p256.cyr"
include "src/x509.cyr"
include "src/bignum.cyr"
include "src/rsa.cyr"
include "lib/thread.cyr"


var _n = 0; var _e = 0; var _msg = 0; var _good = 0; var _forged = 0;
var _iters = 400;
var _okA = 0; var _badA = 0;
var _okB = 0; var _badB = 0;
# 3.12.6 — PSS verify, same invariant. Until 3.12.5 the recovered encoded
# message lived in the banked `_rsa_em`, so this pair could not have passed.
var _pssgood = 0; var _pssbad = 0;
var _pokA = 0; var _pbadA = 0;
var _pokB = 0; var _pbadB = 0;

fn _wA(arg): i64 {
    cbank();
    crypto_bank_set(1);                      # pin: same lane as _wB
    var i = 0;
    while (i < _iters) {
        if (rsa_pkcs1v15_verify_sha256(_n, 256, _e, 3, _msg, 33, _good, 256) == 1) { _okA = _okA + 1; }
        if (rsa_pkcs1v15_verify_sha256(_n, 256, _e, 3, _msg, 33, _forged, 256) == 1) { _badA = _badA + 1; }
        i = i + 1;
    }
    return 0;
}
fn _wB(arg): i64 {
    cbank();
    crypto_bank_set(1);                      # pin: same lane as _wA
    var i = 0;
    while (i < _iters) {
        if (rsa_pkcs1v15_verify_sha256(_n, 256, _e, 3, _msg, 33, _good, 256) == 1) { _okB = _okB + 1; }
        if (rsa_pkcs1v15_verify_sha256(_n, 256, _e, 3, _msg, 33, _forged, 256) == 1) { _badB = _badB + 1; }
        i = i + 1;
    }
    return 0;
}

fn _pA(arg): i64 {
    cbank();
    crypto_bank_set(1);                      # pin: same lane as _pB
    var i = 0;
    while (i < _iters) {
        if (rsa_pss_verify_sha256(_n, 256, _e, 3, _msg, 33, _pssgood, 256) == 1) { _pokA = _pokA + 1; }
        if (rsa_pss_verify_sha256(_n, 256, _e, 3, _msg, 33, _pssbad, 256) == 1) { _pbadA = _pbadA + 1; }
        i = i + 1;
    }
    return 0;
}
fn _pB(arg): i64 {
    cbank();
    crypto_bank_set(1);                      # pin: same lane as _pA
    var i = 0;
    while (i < _iters) {
        if (rsa_pss_verify_sha256(_n, 256, _e, 3, _msg, 33, _pssgood, 256) == 1) { _pokB = _pokB + 1; }
        if (rsa_pss_verify_sha256(_n, 256, _e, 3, _msg, 33, _pssbad, 256) == 1) { _pbadB = _pbadB + 1; }
        i = i + 1;
    }
    return 0;
}

fn main(): i64 {
    alloc_init();
    _n = hex_decode("", 512);
    _e = hex_decode("010001", 6);
    _msg = hex_decode("736967696c2052534120504b435323312076312e35204b4154206d657373616765", 66);
    _good = hex_decode("", 512);
    _forged = hex_decode("", 512);

    test_group("RSA verify under lane aliasing (both threads pinned to lane 1)");
    var ta = thread_create(&_wA, 0);
    var tb = thread_create(&_wB, 0);
    thread_join(ta); thread_join(tb);

    assert_eq(_badA + _badB, 0, "NO forged signature ever verified");
    assert_eq(_okA + _okB, 800, "EVERY valid signature verified (3.12.3: 1/2000, .4: 712/2000)");

    # ---- PSS, same pinned-lane construction (3.12.6) ----
    test_group("RSA-PSS verify under lane aliasing (both threads pinned to lane 1)");
    _pssgood = hex_decode("", 512);
    _pssbad  = hex_decode("", 512);
    var pa = thread_create(&_pA, 0);
    var pb = thread_create(&_pB, 0);
    thread_join(pa); thread_join(pb);

    # Mutation-proven 3.12.6: re-banking the PSS verify workspace makes the FIRST
    # of these fail (1 forged signature accepted) and the second report 791/800.
    # Sensitivity note — this pair detects a shared workspace in AGGREGATE; it is
    # NOT reliably sensitive to any ONE buffer re-banked in isolation (tried: db
    # alone, MGF1 block alone — both stayed green at 800/800). Treat it as "the
    # PSS workspace is private", not as per-buffer coverage.
    assert_eq(_pbadA + _pbadB, 0, "NO forged PSS signature ever verified");
    assert_eq(_pokA + _pokB, 800, "EVERY valid PSS signature verified (banked: 791/800)");

    var r = assert_summary();
    return r;
}
