# secret_epilogue.tcyr — a `secret var` function's epilogue leaves no copy of its return
# registers in dead stack after its wipe (3.13.11: lifts CLAUDE.md quirk #10).
#
# Quirk #10 / architecture note 005 (found 3.13.8 under cyrius 6.6.9): cyrius compiles a
# `secret var` wipe as a `defer` block, and the defer walker saves the whole return convention
# in a 64-byte area below sp — x86_64 rax, rdx, r8, the entry rsp, xmm0, xmm1; aarch64 x0-x3,
# q0, q1 — runs the blocks (the wipe among them), reloads the registers and released the area
# WITHOUT clearing it. So every `secret var` function wrote whatever those registers held into
# dead stack AFTER its own wipe; in the first 3.13.8 draft that was half of the ECDSA nonce k.
# cyrius 6.6.15 clears the area before releasing it (the secret-var epilogue spill gap). This
# test is the proof the quirk asked for before it could be lifted, under sigil's pin.
#
# How: _ep_markers puts a distinct marker in every register the walker saves and returns (its
# own epilogue touches none of them); _ep_secret calls it as its LAST statement, so nothing but
# its epilogue sees them. The caller then calls _ep_window, whose uninitialised array covers the
# released frames and the stack below them, and records which markers it finds.
# Controls keep the count honest:
#   - _ep_deep_plain leaves all eight markers in a frame at the depth the save area occupies,
#     with no `secret`: the window MUST see them, or it is not looking where the area was;
#   - _ep_plain is _ep_secret without `secret` (no walker): no marker, so the ones a broken
#     toolchain shows in the secret row came from the epilogue, not from the helper;
#   - _ep_defer holds a plain `defer` instead: the same walker and area, cleared the same.
# With the epilogue no longer spilling, the zeroisation groups spill registers on purpose
# (tests/regdump.cyr); one row here checks that dump sees the vector registers.
# Red under cyrius 6.6.14 (the secret and defer rows find the markers); green from 6.6.15.

include "lib/string.cyr"
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/syscalls.cyr"
include "tests/regdump.cyr"

# Marker k (1..8) = EP_BASE + k * 0x10000 = 0x5EC0_0000_000k_A5A5. _ep_window recognises a
# marker arithmetically and keeps no copy of one in its own frame, so it cannot count itself.
var EP_BASE = 0x5EC000000000A5A5;
fn _ep_mk(k): i64 { return EP_BASE + k * 0x10000; }

var _ep_sink = 0;
var _ep_got = 0;

# x86_64: rax=1 rdx=2 r8=3 xmm0=[4,5] xmm1=[6,7]; aarch64: x0=1 x1=2 x2=3 x3=8 q0=[4,5] q1=[6,7].
# x9 / x10 / xmm2 are scratch no epilogue saves (xmm2 is cleared again). No `return`: the
# marker left in rax / x0 is the return value, and nothing after the block may touch them.
fn _ep_markers(): i64 {
    #ifdef CYRIUS_ARCH_X86
    asm {
        0x48; 0xB8; 0xA5; 0xA5; 0x04; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs rax, M4
        0x66; 0x48; 0x0F; 0x6E; 0xC0;                                 # movq xmm0, rax
        0x48; 0xB8; 0xA5; 0xA5; 0x05; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs rax, M5
        0x66; 0x48; 0x0F; 0x6E; 0xD0;                                 # movq xmm2, rax
        0x66; 0x0F; 0x6C; 0xC2;                                       # punpcklqdq xmm0, xmm2
        0x48; 0xB8; 0xA5; 0xA5; 0x06; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs rax, M6
        0x66; 0x48; 0x0F; 0x6E; 0xC8;                                 # movq xmm1, rax
        0x48; 0xB8; 0xA5; 0xA5; 0x07; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs rax, M7
        0x66; 0x48; 0x0F; 0x6E; 0xD0;                                 # movq xmm2, rax
        0x66; 0x0F; 0x6C; 0xCA;                                       # punpcklqdq xmm1, xmm2
        0x66; 0x0F; 0xEF; 0xD2;                                       # pxor xmm2, xmm2
        0x48; 0xBA; 0xA5; 0xA5; 0x02; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs rdx, M2
        0x49; 0xB8; 0xA5; 0xA5; 0x03; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs r8, M3
        0x48; 0xB8; 0xA5; 0xA5; 0x01; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs rax, M1
    }
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    asm {
        0xA9; 0xB4; 0x94; 0xD2;   # movz x9, #0xA5A5
        0x89; 0x00; 0xA0; 0xF2;   # movk x9, #4, lsl #16
        0x09; 0xD8; 0xEB; 0xF2;   # movk x9, #0x5EC0, lsl #48
        0x20; 0x01; 0x67; 0x9E;   # fmov d0, x9
        0xAA; 0xB4; 0x94; 0xD2;   # movz x10, #0xA5A5
        0xAA; 0x00; 0xA0; 0xF2;   # movk x10, #5, lsl #16
        0x0A; 0xD8; 0xEB; 0xF2;   # movk x10, #0x5EC0, lsl #48
        0x40; 0x1D; 0x18; 0x4E;   # mov v0.d[1], x10
        0xA9; 0xB4; 0x94; 0xD2;   # movz x9, #0xA5A5
        0xC9; 0x00; 0xA0; 0xF2;   # movk x9, #6, lsl #16
        0x09; 0xD8; 0xEB; 0xF2;   # movk x9, #0x5EC0, lsl #48
        0x21; 0x01; 0x67; 0x9E;   # fmov d1, x9
        0xAA; 0xB4; 0x94; 0xD2;   # movz x10, #0xA5A5
        0xEA; 0x00; 0xA0; 0xF2;   # movk x10, #7, lsl #16
        0x0A; 0xD8; 0xEB; 0xF2;   # movk x10, #0x5EC0, lsl #48
        0x41; 0x1D; 0x18; 0x4E;   # mov v1.d[1], x10
        0xA1; 0xB4; 0x94; 0xD2;   # movz x1, #0xA5A5
        0x41; 0x00; 0xA0; 0xF2;   # movk x1, #2, lsl #16
        0x01; 0xD8; 0xEB; 0xF2;   # movk x1, #0x5EC0, lsl #48
        0xA2; 0xB4; 0x94; 0xD2;   # movz x2, #0xA5A5
        0x62; 0x00; 0xA0; 0xF2;   # movk x2, #3, lsl #16
        0x02; 0xD8; 0xEB; 0xF2;   # movk x2, #0x5EC0, lsl #48
        0xA3; 0xB4; 0x94; 0xD2;   # movz x3, #0xA5A5
        0x03; 0x01; 0xA0; 0xF2;   # movk x3, #8, lsl #16
        0x03; 0xD8; 0xEB; 0xF2;   # movk x3, #0x5EC0, lsl #48
        0xA0; 0xB4; 0x94; 0xD2;   # movz x0, #0xA5A5
        0x20; 0x00; 0xA0; 0xF2;   # movk x0, #1, lsl #16
        0x00; 0xD8; 0xEB; 0xF2;   # movk x0, #0x5EC0, lsl #48
    }
    #endif
}

# The marker helper as the LAST statement, so the epilogue is the first code to see the
# registers. The `secret var` key stands for the secret block a sigil function holds.
fn _ep_secret(): i64 {
    secret var key[32];
    store64(&key, 0x7E7E);
    _ep_markers();
}
fn _ep_plain(): i64 {
    var key[32];
    store64(&key, 0x7E7E);
    _ep_markers();
}
fn _ep_defer(): i64 {
    defer { _ep_sink = _ep_sink + 1; }
    var key[32];
    store64(&key, 0x7E7E);
    _ep_markers();
}

# All eight markers in a frame one level below a frame shaped like _ep_secret's — where its
# save area sits.
fn _ep_put(): i64 {
    var a: i64[8];
    var k = 0;
    while (k < 8) {
        store64(&a + k * 8, _ep_mk(k + 1));
        k = k + 1;
    }
    return 0;
}
fn _ep_deep_plain(): i64 {
    var key[32];
    store64(&key, 0x7E7E);
    _ep_put();
    return 0;
}

# The distinct markers in the uninitialised 4 KB below this frame's top, as a bitmask (bit k-1 =
# marker k), so a marker seen twice counts once and the anti-vacuous row can demand all eight.
fn _ep_window(): i64 {
    var w: i64[512];
    var seen = 0;
    var d = 0;
    var i = 0;
    while (i < 512) {
        d = load64(&w + i * 8) - EP_BASE;
        if ((d & 0xFFFF) == 0) {
            if (d >= 0x10000) {
                if (d <= 0x80000) { seen = seen | (1 << ((d >> 16) - 1)); }
            }
        }
        i = i + 1;
    }
    return seen;
}
fn _ep_popcount(x): i64 {
    var n = 0;
    while (x != 0) {
        n = n + (x & 1);
        x = x >> 1;
    }
    return n;
}

# Each row starts from zeroed dead stack: without it a row would count what the PREVIOUS row's
# epilogue left behind.
fn _ep_scrub(): i64 {
    var pad: i64[1024];
    memset(&pad, 0, 8192);
    return 0;
}

fn _ep_row_deep_plain(): i64 {
    _ep_deep_plain();
    return _ep_window();
}
fn _ep_row_secret(): i64 {
    _ep_got = _ep_secret();
    return _ep_window();
}
fn _ep_row_plain(): i64 {
    _ep_got = _ep_plain();
    return _ep_window();
}
fn _ep_row_defer(): i64 {
    _ep_got = _ep_defer();
    return _ep_window();
}

# The registers tests/regdump.cyr writes, as a marker bitmask: _ep_markers loads them and
# regdump_into stores them straight away. With the epilogue clearing its area, that dump is
# what the zeroisation groups (ecdsa_sign.tcyr, ecdh.tcyr) rely on to see a register.
fn _ep_row_dump(): i64 {
    var buf: i64[64];
    memset(&buf, 0, 512);
    _ep_markers();
    regdump_into(&buf);
    var seen = 0;
    var d = 0;
    var i = 0;
    while (i < 64) {
        d = load64(&buf + i * 8) - EP_BASE;
        if ((d & 0xFFFF) == 0) {
            if (d >= 0x10000) {
                if (d <= 0x80000) { seen = seen | (1 << ((d >> 16) - 1)); }
            }
        }
        i = i + 1;
    }
    return seen;
}

# The walker hands back every return register intact after the clear.
fn _ep_pair(a, b): i64 {
    secret var key[16];
    store64(&key, a);
    return (a, b);
}

fn main(): i64 {
    alloc_init();

    test_group("the window sees the depth the save area occupies (anti-vacuous)");
    _ep_scrub();
    assert_eq(_ep_row_deep_plain(), 255, "all eight markers left one frame down are visible");

    test_group("a secret var function's epilogue leaves no return register in dead stack");
    _ep_scrub();
    var s = _ep_row_secret();
    assert_eq(_ep_popcount(s), 0, "secret var: no marker survives the epilogue");
    assert_eq(s, 0, "secret var: marker bitmask (bit k-1 = marker k)");
    assert_eq(_ep_got, _ep_mk(1), "secret var: the return value survives the clear");

    test_group("controls");
    _ep_sink = 0;
    _ep_scrub();
    assert_eq(_ep_row_defer(), 0, "plain defer: the same walker, the same clear");
    assert_eq(_ep_sink, 1, "plain defer: the block ran");
    assert_eq(_ep_got, _ep_mk(1), "plain defer: the return value survives the clear");
    _ep_scrub();
    assert_eq(_ep_row_plain(), 0, "no defer, no walker: no marker (the helper spills none)");
    assert_eq(_ep_got, _ep_mk(1), "no defer: the helper's return value");

    test_group("tests/regdump.cyr writes the vector registers (the zeroisation groups' spill)");
    var dm = _ep_row_dump();
    assert_eq(dm & 120, 120, "the dump holds xmm0 / xmm1 (aarch64 q0 / q1): markers 4-7");

    test_group("values the walker restores after the clear");
    var pa, pb = _ep_pair(7, 99);
    assert_eq(pa * 1000 + pb, 7099, "secret var: (a, b) return");

    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
