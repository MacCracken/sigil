# x509_rsa.tcyr -- X.509 chain-link verification with an RSA issuer
# (sigil 3.6.5). Exercises the RSA SPKI parse + rsa-with-SHA256/384
# signature-algorithm dispatch added to src/x509.cyr, feeding the
# issuer's parsed (n, e) to rsa_pkcs1v15_verify_*.
#
# Test chain (generated 2026-06-04 with OpenSSL 3.6.2):
#   openssl genrsa -out ca.key 2048
#   openssl req -new -x509 -key ca.key -sha256 -days 3650
#     -subj "/CN=Sigil RSA Test Root CA"
#     -addext basicConstraints=critical,CA:TRUE,pathlen:1
#     -addext keyUsage=critical,keyCertSign,cRLSign           (ca.crt)
#   openssl genrsa -out leaf.key 2048
#   openssl req -new -key leaf.key -subj "/CN=Sigil RSA Test Leaf"
#   openssl x509 -req -CA ca.crt -CAkey ca.key -sha256 ...     (leaf256.crt)
#   openssl x509 -req -CA ca.crt -CAkey ca.key -sha384 ...     (leaf384.crt)
# `openssl verify -CAfile ca.crt leaf256.crt` -> OK (both).
# DER via `openssl x509 -outform DER | xxd -p -c100000`.
#
# CA / leaf validity: 2026-06-04 18:15:15 UTC .. (CA 2036 / leaf 2027).

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/str.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fmt.cyr"
include "lib/bayan.cyr"
include "lib/sakshi.cyr"
include "lib/chrono.cyr"
include "lib/ct.cyr"

include "lib/thread_local.cyr"
include "src/crypto_scratch.cyr"
include "src/mul64.cyr"
include "src/types.cyr"
include "src/error.cyr"
include "lib/random.cyr"
include "src/random.cyr"
include "src/sha256.cyr"
include "src/hex.cyr"
include "src/sha512.cyr"
include "src/sha384.cyr"
include "src/bigint_ext.cyr"
include "src/ed25519.cyr"
include "src/ecdsa_p256.cyr"
include "src/ecdsa_p384.cyr"
include "src/x509.cyr"
include "src/bignum.cyr"
include "src/rsa.cyr"

var CA_HEX = "";

var LEAF256_HEX = "";

var LEAF384_HEX = "";

# Tampered SHA-256 leaf: final signature octet 0x01 -> 0x02. Parses
# fine (signature bytes aren't validated at parse), verify must fail.
var LEAF256_BAD_HEX = "";

# 2026-07-01 00:00:00 UTC (inside both validity windows).
var NOW = 1782864000;

# ---- 3.13.6: SHA-512 and SHA-1 RSA signatures --------------------------------
# x509_parse refused any certificate whose OWN signature algorithm was not one it
# could verify, so 8 of the 121 roots in a stock trust store (Arch's
# /etc/ssl/cert.pem) never installed: 4 self-signed with sha512WithRSAEncryption
# (among them the current D-TRUST BR / EV Root CA 2 2023) and 3 with
# sha1WithRSAEncryption, plus one ECDSA P-521 root. A trust anchor's own
# signature is never verified (RFC 5280 §6.1), so the RSA roots were refused for
# nothing — and a chain whose links are signed with SHA-512 could not verify at
# all. cyrius issue 2026-09-30-tls-client-memory-and-alert-gaps (e).
#
# Test chains (generated 2026-10-01 with OpenSSL 3.6.5; the keys are not kept):
#   openssl genrsa -out ca512.key 2048
#   openssl req -new -x509 -key ca512.key -sha512 -days 36500
#     -subj "/CN=Sigil RSA SHA-512 Test Root CA"
#     -addext basicConstraints=critical,CA:TRUE,pathlen:1
#     -addext keyUsage=critical,keyCertSign,cRLSign                   (ca512.crt)
#   openssl genrsa -out leaf.key 2048
#   openssl req -new -key leaf.key -subj "/CN=Sigil RSA Test Leaf"   (leaf.csr)
#   openssl x509 -req -CA ca512.crt -CAkey ca512.key -set_serial 0x5151 -sha512 ...  (leaf512.crt)
#   openssl x509 -req -CA ca512.crt -CAkey ca512.key -set_serial 0x5152 -sha1 ...    (leaf1.crt)
#   ca1.crt: as ca512.crt with -sha1 and -subj "/CN=Sigil RSA SHA-1 Test Root CA"
#   openssl x509 -req -CA ca1.crt -CAkey ca1.key -set_serial 0x5153 -sha256 ...      (leaf_under_ca1.crt)
# `openssl verify` -> OK for all three leaves (`-auth_level 0` for the SHA-1 ones).
# All valid 2026-10-01 .. 2126; the chain checks below pass now_unix = 0.
# The three real roots are public trust anchors, copied from /etc/ssl/cert.pem.

var CA512_HEX = "";

var LEAF512_HEX = "";

# LEAF512 with the final signature octet's low bit flipped: parses, must not verify.
var LEAF512_BAD_HEX = "";

var LEAF1_HEX = "";

var CA1_HEX = "";

var LEAF_UNDER_CA1_HEX = "";

# D-TRUST BR Root CA 2 2023 (D-Trust GmbH) — RSA-4096, self-signed sha512WithRSAEncryption.
var DTRUST_BR_2023_HEX = "";

# TWCA Root Certification Authority (TAIWAN-CA) — RSA-2048, self-signed sha1WithRSAEncryption.
var TWCA_ROOT_HEX = "";

# e-Szigno TLS Root CA 2023 (Microsec) — ECDSA P-521, ecdsa-with-SHA512. sigil has no P-521.
var MICROSEC_P521_HEX = "";

fn main() {
    alloc_init();
    _p256_init();

    var ca = hex_decode(CA_HEX, 1652);            # 826 bytes
    var leaf256 = hex_decode(LEAF256_HEX, 1574);  # 787 bytes
    var leaf384 = hex_decode(LEAF384_HEX, 1574);
    var leafbad = hex_decode(LEAF256_BAD_HEX, 1574);

    var cacert = x509_cert_alloc();
    var l256 = x509_cert_alloc();
    var l384 = x509_cert_alloc();
    var lbad = x509_cert_alloc();

    # ============================================================
    test_group("x509_parse — RSA CA + leaves");

    assert_eq(x509_parse(ca, 826, cacert), 1, "RSA CA parses");
    assert_eq(x509_cert_curve(cacert), X509_CURVE_RSA, "CA key type = RSA");
    var rblk = x509_cert_rsa_pubkey(cacert);
    assert_eq(load64(rblk + 528), 256, "CA modulus length = 256 (RSA-2048)");
    assert_eq(load64(rblk + 536), 3, "CA exponent length = 3");
    assert_eq(x509_cert_is_ca(cacert), 1, "CA basicConstraints CA:TRUE");

    assert_eq(x509_parse(leaf256, 787, l256), 1, "SHA-256 leaf parses");
    assert_eq(x509_cert_sig_algo(l256), X509_SIG_RSA_SHA256, "leaf256 sig algo = RSA-SHA256");
    assert_eq(x509_cert_curve(l256), X509_CURVE_RSA, "leaf256 key type = RSA");

    assert_eq(x509_parse(leaf384, 787, l384), 1, "SHA-384 leaf parses");
    assert_eq(x509_cert_sig_algo(l384), X509_SIG_RSA_SHA384, "leaf384 sig algo = RSA-SHA384");

    # ============================================================
    test_group("x509_verify_chain — RSA issuer (green path)");

    var inters = alloc(8);   # zero intermediates
    assert_eq(x509_verify_chain(l256, inters, 0, cacert, NOW), 1,
        "RSA CA signs SHA-256 leaf (in window)");
    assert_eq(x509_verify_chain(l384, inters, 0, cacert, NOW), 1,
        "RSA CA signs SHA-384 leaf (in window)");
    assert_eq(x509_verify_chain(l256, inters, 0, cacert, 0), 1,
        "verify with time check disabled (now_unix = 0)");

    # Direct link verify (bypasses DN/window checks).
    assert_eq(_x509_verify_link(l256, cacert), 1, "direct link verify (RSA-SHA256)");
    assert_eq(_x509_verify_link(l384, cacert), 1, "direct link verify (RSA-SHA384)");

    # ============================================================
    test_group("x509_verify_chain — RSA rejects");

    assert_eq(x509_parse(leafbad, 787, lbad), 1, "tampered leaf still parses");
    assert_eq(x509_verify_chain(lbad, inters, 0, cacert, NOW), 0,
        "tampered RSA signature rejected");
    assert_eq(_x509_verify_link(lbad, cacert), 0,
        "tampered RSA signature rejected (direct link)");

    # Wrong issuer key: verify the leaf's link against the LEAF as issuer.
    # The signature was made by the CA key, not the leaf key -> reject.
    assert_eq(_x509_verify_link(l256, l256), 0,
        "leaf signature does not verify under the leaf's own key");

    # DN mismatch: leaf.issuer ("Root CA") != leaf.subject ("Leaf"), so a
    # self-issued chain is rejected before the signature is even checked.
    assert_eq(x509_verify_chain(l256, inters, 0, l256, NOW), 0,
        "issuer DN mismatch rejected (leaf as its own root)");

    # ============================================================
    test_group("x509_parse_into — RSA cert arena no-drift (3.7.3)");
    # Parsing an RSA cert allocates the 544-byte RSA SPKI side block;
    # via _into it must come from the arena, leaving the GLOBAL heap
    # unchanged across a reset+parse loop. Warm-up parse first so the
    # init-once OID/mdays tables are already allocated before g0.
    var arena = arena_new(8192);
    var wc = x509_cert_alloc_into(arena);
    assert_eq(x509_parse_into(leaf256, 787, wc, arena), 1, "RSA leaf parses via _into");
    assert_eq(x509_cert_curve(wc), X509_CURVE_RSA, "_into RSA leaf key type = RSA");
    var g0 = alloc_used();
    var li = 0;
    var bad = 0;
    while (li < 50) {
        arena_reset(arena);
        var c2 = x509_cert_alloc_into(arena);
        if (c2 == 0) { bad = bad + 1; }
        if (x509_parse_into(leaf256, 787, c2, arena) != 1) { bad = bad + 1; }
        li = li + 1;
    }
    assert_eq(bad, 0, "50 RSA x509_parse_into iterations all succeed");
    assert_eq(alloc_used() - g0, 0, "no GLOBAL-heap drift: RSA 544-byte block is arena-routed");

    # ============================================================
    test_group("x509 — RSA SHA-512 signatures (3.13.6)");
    var ca512 = hex_decode(CA512_HEX, 1688);           # 844 bytes
    var leaf512 = hex_decode(LEAF512_HEX, 1558);       # 779 bytes
    var leaf512bad = hex_decode(LEAF512_BAD_HEX, 1558);
    var c512 = x509_cert_alloc();
    var l512 = x509_cert_alloc();
    var l512bad = x509_cert_alloc();
    assert_eq(x509_parse(ca512, 844, c512), 1, "SHA-512-self-signed RSA root parses");
    assert_eq(x509_cert_sig_algo(c512), X509_SIG_RSA_SHA512, "root sig algo = RSA-SHA512");
    assert_eq(x509_cert_is_ca(c512), 1, "root basicConstraints CA:TRUE");
    assert_eq(x509_parse(leaf512, 779, l512), 1, "SHA-512 leaf parses");
    assert_eq(x509_cert_sig_algo(l512), X509_SIG_RSA_SHA512, "leaf sig algo = RSA-SHA512");
    assert_eq(x509_verify_chain(l512, inters, 0, c512, 0), 1,
        "an RSA root verifies a SHA-512 link");
    assert_eq(_x509_verify_link(l512, c512), 1, "direct link verify (RSA-SHA512)");
    assert_eq(x509_parse(leaf512bad, 779, l512bad), 1, "tampered SHA-512 leaf still parses");
    assert_eq(x509_verify_chain(l512bad, inters, 0, c512, 0), 0,
        "tampered SHA-512 signature rejected");
    assert_eq(_x509_verify_link(l512bad, c512), 0,
        "tampered SHA-512 signature rejected (direct link)");
    assert_eq(_x509_verify_link(l512, cacert), 0,
        "a SHA-512 signature does not verify under another RSA key");

    # ============================================================
    test_group("x509 — RSA SHA-1 signatures: parsed, never verified (3.13.6)");
    var leaf1 = hex_decode(LEAF1_HEX, 1558);           # 779 bytes
    var ca1 = hex_decode(CA1_HEX, 1680);               # 840 bytes
    var lca1 = hex_decode(LEAF_UNDER_CA1_HEX, 1554);   # 777 bytes
    var l1 = x509_cert_alloc();
    var c1 = x509_cert_alloc();
    var lu1 = x509_cert_alloc();
    assert_eq(x509_parse(leaf1, 779, l1), 1, "SHA-1 leaf parses");
    assert_eq(x509_cert_sig_algo(l1), X509_SIG_RSA_SHA1, "leaf sig algo = RSA-SHA1");
    # The signature is genuine (openssl verifies it); sigil still refuses it.
    assert_eq(_x509_verify_link(l1, c512), 0, "a SHA-1 link is never verified");
    assert_eq(x509_verify_chain(l1, inters, 0, c512, 0), 0,
        "a chain with a SHA-1 link is refused");
    assert_eq(x509_parse(ca1, 840, c1), 1, "SHA-1-self-signed RSA root parses");
    assert_eq(x509_cert_sig_algo(c1), X509_SIG_RSA_SHA1, "root sig algo = RSA-SHA1");
    assert_eq(x509_parse(lca1, 777, lu1), 1, "SHA-256 leaf under the SHA-1 root parses");
    assert_eq(x509_verify_chain(lu1, inters, 0, c1, 0), 1,
        "a SHA-256 link verifies under a SHA-1-self-signed anchor (its own signature is never checked)");

    # ============================================================
    test_group("x509 — trust-store roots a stock bundle carries (3.13.6)");
    var dtr = hex_decode(DTRUST_BR_2023_HEX, 2906);    # 1453 bytes
    var twca = hex_decode(TWCA_ROOT_HEX, 1790);        # 895 bytes
    var msz = hex_decode(MICROSEC_P521_HEX, 1446);     # 723 bytes
    var cdtr = x509_cert_alloc();
    var ctw = x509_cert_alloc();
    var cmsz = x509_cert_alloc();
    assert_eq(x509_parse(dtr, 1453, cdtr), 1, "D-TRUST BR Root CA 2 2023 (sha512WithRSA) parses");
    assert_eq(x509_cert_curve(cdtr), X509_CURVE_RSA, "D-TRUST key type = RSA");
    assert_eq(x509_cert_is_ca(cdtr), 1, "D-TRUST is a CA");
    assert_eq(x509_parse(twca, 895, ctw), 1, "TWCA Root Certification Authority (sha1WithRSA) parses");
    assert_eq(x509_cert_is_ca(ctw), 1, "TWCA is a CA");
    assert_eq(x509_parse(msz, 723, cmsz), 0,
        "e-Szigno TLS Root CA 2023 (ECDSA P-521) is still refused: sigil has no P-521");

    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
