# authenticode.tcyr -- native UEFI Authenticode PE signing (sigil 3.10).
#
# The end-to-end sign path (authenticode_pe_sign over a real gnoboot
# BOOTX64.EFI) is validated against openssl in the release harness:
#   openssl pkcs7 -print_certs   -> embedded db cert
#   openssl asn1parse            -> SignedData / SpcIndirectData structure
#   openssl dgst -sha256 -verify -> "Verified OK"
# This tcyr locks the two hand-rolled, regression-fragile DER layers
# (the bottom-up TLV encoder + the SpcIndirectData wrapper) and the
# Authenticode PE-hash skip-region arithmetic against known-answer
# vectors, so a future refactor can't silently corrupt them.

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/str.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fmt.cyr"
include "lib/bayan.cyr"
include "lib/sakshi.cyr"
include "lib/chrono.cyr"
include "lib/ct.cyr"
include "lib/thread_local.cyr"
include "src/crypto_scratch.cyr"
include "src/mul64.cyr"
include "src/types.cyr"
include "src/error.cyr"
include "lib/random.cyr"
include "src/random.cyr"
include "src/sha256.cyr"
include "src/hex.cyr"
include "src/sha512.cyr"
include "src/sha384.cyr"
include "src/bigint_ext.cyr"
include "src/ed25519.cyr"
include "src/ecdsa_p256.cyr"
include "src/hmac.cyr"
include "src/hmac_sha384.cyr"
include "src/ecdsa_p384.cyr"
include "src/ecdsa_sign.cyr"
include "src/x509.cyr"
include "src/bignum.cyr"
include "src/rsa.cyr"
include "src/authenticode.cyr"

fn main() {
    alloc_init();
    _ac_oids_init();

    # ============================================================
    # DER encoder KAT -- SEQUENCE { INTEGER 1, AlgorithmIdentifier(sha256) }
    # (the DigestInfo shape the messageDigest field is built from).
    # openssl asn1parse over the same bytes at generation time:
    #   SEQUENCE { INTEGER :01, SEQUENCE { OID sha256, NULL } }
    # ============================================================
    test_group("DER encoder");

    var oid[9];
    store8(&oid + 0, 0x60); store8(&oid + 1, 0x86); store8(&oid + 2, 0x48);
    store8(&oid + 3, 0x01); store8(&oid + 4, 0x65); store8(&oid + 5, 0x03);
    store8(&oid + 6, 0x04); store8(&oid + 7, 0x02); store8(&oid + 8, 0x01);
    var v = vec_new();
    vec_push(v, der_int_small(1));
    vec_push(v, der_algid_null(&oid, 9));
    var d = der_seq(v);
    var d_exp = hex_decode("3012020101300d06096086480165030402010500", 40);
    assert_eq(dv_len(d), 20, "der_seq DigestInfo is 20 bytes");
    assert_eq(ct_eq_bytes(dv_ptr(d), d_exp, 20), 1, "der_seq DigestInfo matches KAT");

    # ============================================================
    # SpcIndirectDataContent KAT -- the Authenticode content structure
    # wrapping a fixed PE hash (00 01 02 .. 1f). Locks the obsolete
    # "<<<Obsolete>>>" moniker (UCS-2BE) + SpcPeImageData + DigestInfo.
    # ============================================================
    test_group("SpcIndirectData");

    var hash[32];
    var i = 0;
    while (i < 32) { store8(&hash + i, i); i = i + 1; }
    var spc = _spc_indirect_data(&hash);
    var spc_exp = hex_decode("3063302e060a2b06010401823702010f3020a21e801c003c003c003c004f00620073006f006c006500740065003e003e003e3031300d060960864801650304020105000420000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", 202);
    assert_eq(dv_len(spc), 101, "SpcIndirectData is 101 bytes");
    assert_eq(ct_eq_bytes(dv_ptr(spc), spc_exp, 101), 1, "SpcIndirectData matches KAT");

    # ============================================================
    # Authenticode PE-hash KAT -- a synthetic PE32+ (e_lfanew=0x40,
    # magic 0x20b) with a byte-pattern body. The hash must SKIP the
    # 4-byte CheckSum (opt+64 = 0x98) and the 8-byte security data-dir
    # entry (opt+144 = 0xE8), then hash to EOF. Expected computed by an
    # independent python SHA-256 over [0,0x98)+[0x9c,0xE8)+[0xF0,256).
    # ============================================================
    test_group("Authenticode PE hash");

    var pe[256];
    var j = 0;
    while (j < 256) { store8(&pe + j, j); j = j + 1; }
    # e_lfanew (LE u32) = 0x40
    store8(&pe + 0x3c, 0x40); store8(&pe + 0x3d, 0);
    store8(&pe + 0x3e, 0);    store8(&pe + 0x3f, 0);
    # "PE\0\0"
    store8(&pe + 0x40, 0x50); store8(&pe + 0x41, 0x45);
    store8(&pe + 0x42, 0);    store8(&pe + 0x43, 0);
    # optional-header magic (LE u16) = 0x20b (PE32+)
    store8(&pe + 0x58, 0x0b); store8(&pe + 0x59, 0x02);
    # security data-dir entry (RVA + Size) = 0 (unsigned)
    var k = 0;
    while (k < 8) { store8(&pe + 0xE8 + k, 0); k = k + 1; }

    var out[32];
    authenticode_pe_hash(&pe, 256, &out);
    var pe_exp = hex_decode("86516a30e1c04065c5420af4f825390d23f6554dc0aa06871dc9ec58950a073e", 64);
    assert_eq(ct_eq_bytes(&out, pe_exp, 32), 1, "Authenticode PE hash matches KAT");


    # ============================================================
    # Authenticode VERIFY (3.12.2) — P4.
    # ============================================================
    # Every case below signs a synthetic PE with a throwaway key and then
    # judges the result. The signed blob is the ONLY input to the verifier,
    # so each negative case is a one-byte (or one-field) mutation of a blob
    # that verifies — which is what makes the assertions meaningful: they
    # isolate exactly one check each.
    test_group("Authenticode verify");

    var AC_KEY_HEX = "";
    var AC_KEY_HEX_N = 2434;
    var AC_CERT_HEX = "";
    var AC_CERT_HEX_N = 1656;
    var AC_EC_SCALAR_HEX = "8d41b0af1b1c286e252c5bdcc5106623f81302edf3662383a25939b2534a61a8";
    var AC_EC_SCALAR_HEX_N = 64;
    var AC_EC_CERT_HEX = "";
    var AC_EC_CERT_HEX_N = 888;
    var AC_LEAF_KEY_HEX = "";
    var AC_LEAF_KEY_HEX_N = 2432;
    var AC_LEAF_CERT_HEX = "";
    var AC_LEAF_CERT_HEX_N = 1664;
    var AC_CA_CERT_HEX = "";
    var AC_CA_CERT_HEX_N = 1668;

    var ac_key_der  = hex_decode(AC_KEY_HEX, AC_KEY_HEX_N);
    var ac_cert     = hex_decode(AC_CERT_HEX, AC_CERT_HEX_N);
    var ac_cert_len = AC_CERT_HEX_N / 2;
    var ac_key = alloc(2384);
    assert_eq(rsa_privkey_from_der(ac_key_der, AC_KEY_HEX_N / 2, ac_key) >= 0, 1,
        "verify fixture: RSA private key parses");

    # Sign the same synthetic 256-byte PE the hash KAT above uses.
    var sgn = alloc(8192);
    var sgn_len = 0;
    assert_eq(authenticode_pe_sign(&pe, 256, ac_key, ac_cert, ac_cert_len,
                                   sgn, &sgn_len), 0, "sign the synthetic PE");

    # ---- positive ------------------------------------------------
    var rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(sgn, sgn_len, ac_cert, ac_cert_len, 0, &rsn), 1,
        "signed PE verifies against its own db cert");
    assert_eq(rsn, AC_VOK, "reason is AC_VOK");

    # `authenticode_pe_hash_signed` over the SIGNED image must reproduce the
    # digest `authenticode_pe_hash` took of the UNSIGNED image — that identity
    # is the whole basis of the scheme.
    var h_uns[32]; var h_sgn[32];
    authenticode_pe_hash(&pe, 256, &h_uns);
    assert_eq(authenticode_pe_hash_signed(sgn, sgn_len, &h_sgn), 0, "hash_signed parses");
    assert_eq(ct_eq_bytes(&h_uns, &h_sgn, 32), 1,
        "hash_signed(signed) == hash(unsigned)");

    # A CheckSum edit is inside a SKIP region, so it must NOT break the
    # signature — this proves the skip arithmetic is actually applied on the
    # verify side and not merely on the sign side.
    var cks_save = load8(sgn + 0x98);
    store8(sgn + 0x98, cks_save ^ 0xFF);
    assert_eq(authenticode_pe_verify(sgn, sgn_len, ac_cert, ac_cert_len, 0), 1,
        "CheckSum byte is skipped — still verifies");
    store8(sgn + 0x98, cks_save);

    # ---- the 3.12.2 pad-in-hash fix ------------------------------
    # A PE whose length is NOT a multiple of 8 gets zero-padded up to the
    # 8-byte-aligned cert-table start. The Authenticode spec hashes that pad;
    # through 3.12.1 the signer did not, so the signature covered a different
    # span than any spec verifier recomputes. This case is the regression
    # lock: it fails on a signer that excludes the pad.
    var pe253[253];
    var q = 0;
    while (q < 253) { store8(&pe253 + q, q); q = q + 1; }
    store8(&pe253 + 0x3c, 0x40); store8(&pe253 + 0x3d, 0);
    store8(&pe253 + 0x3e, 0);    store8(&pe253 + 0x3f, 0);
    store8(&pe253 + 0x40, 0x50); store8(&pe253 + 0x41, 0x45);
    store8(&pe253 + 0x42, 0);    store8(&pe253 + 0x43, 0);
    store8(&pe253 + 0x58, 0x0b); store8(&pe253 + 0x59, 0x02);
    var q2 = 0;
    while (q2 < 8) { store8(&pe253 + 0xE8 + q2, 0); q2 = q2 + 1; }

    var sgn253 = alloc(8192);
    var sgn253_len = 0;
    assert_eq(authenticode_pe_sign(&pe253, 253, ac_key, ac_cert, ac_cert_len,
                                   sgn253, &sgn253_len), 0, "sign an unaligned (253-byte) PE");
    assert_eq(authenticode_pe_verify(sgn253, sgn253_len, ac_cert, ac_cert_len, 0), 1,
        "unaligned PE round-trips (pad IS inside the hash — 3.12.2 fix)");

    # ---- negative: image / digest binding ------------------------
    var b_save = load8(sgn + 0x50);
    store8(sgn + 0x50, b_save ^ 0x01);
    rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(sgn, sgn_len, ac_cert, ac_cert_len, 0, &rsn), 0,
        "tampered image body rejected");
    assert_eq(rsn, AC_VERR_IMAGE_HASH, "  reason AC_VERR_IMAGE_HASH");
    store8(sgn + 0x50, b_save);

    # ---- negative: certificate-table framing ---------------------
    var secdir = 0xE8;
    var tab_off = _pe_rd32(sgn, secdir);
    var tab_size = _pe_rd32(sgn, secdir + 4);

    _wr32(sgn, secdir, tab_off + 1);                 # unaligned table offset
    rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(sgn, sgn_len, ac_cert, ac_cert_len, 0, &rsn), 0,
        "unaligned cert-table offset rejected");
    assert_eq(rsn, AC_VERR_CERTTAB, "  reason AC_VERR_CERTTAB");

    _wr32(sgn, secdir, sgn_len + 4096);              # table past EOF
    assert_eq(authenticode_pe_verify(sgn, sgn_len, ac_cert, ac_cert_len, 0), 0,
        "cert table past EOF rejected");

    _wr32(sgn, secdir, 0xFFFFFFF0);                  # near-2^32 offset
    assert_eq(authenticode_pe_verify(sgn, sgn_len, ac_cert, ac_cert_len, 0), 0,
        "near-2^32 cert-table offset rejected (no wrap)");
    _wr32(sgn, secdir, tab_off);

    _wr32(sgn, secdir + 4, 8);                       # size below dwLength
    assert_eq(authenticode_pe_verify(sgn, sgn_len, ac_cert, ac_cert_len, 0), 0,
        "cert-table size below dwLength rejected");
    _wr32(sgn, secdir + 4, tab_size);

    # ---- negative: WIN_CERTIFICATE header ------------------------
    var dwlen_save = _pe_rd32(sgn, tab_off);
    _wr16(sgn, tab_off + 6, 0x0001);                 # WIN_CERT_TYPE_X509
    rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(sgn, sgn_len, ac_cert, ac_cert_len, 0, &rsn), 0,
        "wrong wCertificateType rejected");
    assert_eq(rsn, AC_VERR_WINCERT, "  reason AC_VERR_WINCERT");
    _wr16(sgn, tab_off + 6, 0x0002);

    _wr16(sgn, tab_off + 4, 0x0100);                 # wrong revision
    assert_eq(authenticode_pe_verify(sgn, sgn_len, ac_cert, ac_cert_len, 0), 0,
        "wrong wRevision rejected");
    _wr16(sgn, tab_off + 4, 0x0200);

    _wr32(sgn, tab_off, 4);                          # dwLength below the header
    assert_eq(authenticode_pe_verify(sgn, sgn_len, ac_cert, ac_cert_len, 0), 0,
        "dwLength < 9 rejected");
    _wr32(sgn, tab_off, dwlen_save);

    # ---- negative: unsigned / truncated / malformed PE -----------
    rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(&pe, 256, ac_cert, ac_cert_len, 0, &rsn), 0,
        "unsigned image rejected");
    assert_eq(rsn, AC_VERR_NO_SIG, "  reason AC_VERR_NO_SIG");

    rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(sgn, 0x20, ac_cert, ac_cert_len, 0, &rsn), 0,
        "pe_len below the DOS header rejected (no OOB read)");
    assert_eq(rsn, AC_VERR_PE, "  reason AC_VERR_PE");

    assert_eq(authenticode_pe_verify(sgn, tab_off + 4, ac_cert, ac_cert_len, 0), 0,
        "truncated inside the cert table rejected");

    var lf_save = _pe_rd32(sgn, 0x3C);
    _wr32(sgn, 0x3C, sgn_len);                       # e_lfanew past EOF
    assert_eq(authenticode_pe_verify(sgn, sgn_len, ac_cert, ac_cert_len, 0), 0,
        "e_lfanew past EOF rejected");
    _wr32(sgn, 0x3C, 0x10);                          # e_lfanew inside the DOS stub
    assert_eq(authenticode_pe_verify(sgn, sgn_len, ac_cert, ac_cert_len, 0), 0,
        "e_lfanew inside the DOS header rejected");
    _wr32(sgn, 0x3C, lf_save);

    var mg_save = _pe_rd16(sgn, 0x58);
    _wr16(sgn, 0x58, 0x0107);                        # unknown optional-header magic
    assert_eq(authenticode_pe_verify(sgn, sgn_len, ac_cert, ac_cert_len, 0), 0,
        "unknown optional-header magic rejected (3.12.2 allow-list)");
    _wr16(sgn, 0x58, mg_save);

    var nrva_save = _pe_rd32(sgn, 0x58 + 108);
    _wr32(sgn, 0x58 + 108, 3);                       # NumberOfRvaAndSizes < 5
    assert_eq(authenticode_pe_verify(sgn, sgn_len, ac_cert, ac_cert_len, 0), 0,
        "NumberOfRvaAndSizes < 5 rejected (3.12.2)");
    _wr32(sgn, 0x58 + 108, nrva_save);

    # ---- negative: PKCS#7 / signature ----------------------------
    var p7_off = tab_off + 8;
    var ci_save = load8(sgn + p7_off);
    store8(sgn + p7_off, 0x31);                      # ContentInfo not a SEQUENCE
    rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(sgn, sgn_len, ac_cert, ac_cert_len, 0, &rsn), 0,
        "malformed ContentInfo rejected");
    assert_eq(rsn, AC_VERR_PKCS7, "  reason AC_VERR_PKCS7");
    store8(sgn + p7_off, ci_save);

    # Flip the last byte of the blob — inside the RSA signature, which the
    # sign path places last in the SignerInfo.
    var last = tab_off + dwlen_save - 1;
    var l_save = load8(sgn + last);
    store8(sgn + last, l_save ^ 0x01);
    rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(sgn, sgn_len, ac_cert, ac_cert_len, 0, &rsn), 0,
        "tampered signature rejected");
    assert_eq(rsn, AC_VERR_SIGNATURE, "  reason AC_VERR_SIGNATURE");
    store8(sgn + last, l_save);

    # ---- negative: trust ----------------------------------------
    var other_cert = hex_decode(AC_CA_CERT_HEX, AC_CA_CERT_HEX_N);
    rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(sgn, sgn_len, other_cert,
                                        AC_CA_CERT_HEX_N / 2, 0, &rsn), 0,
        "valid image, WRONG trust anchor rejected");
    assert_eq(rsn, AC_VERR_TRUST, "  reason AC_VERR_TRUST");

    # Still verifies against the right anchor after all that mutation —
    # proves every restore above was complete.
    assert_eq(authenticode_pe_verify(sgn, sgn_len, ac_cert, ac_cert_len, 0), 1,
        "blob restored intact after the negative sweep");

    # ============================================================
    # Chain-mode verify: db holds a CA, signer is a leaf under it.
    # ============================================================
    test_group("Authenticode verify — chain mode");

    var lf_key_der = hex_decode(AC_LEAF_KEY_HEX, AC_LEAF_KEY_HEX_N);
    var lf_cert    = hex_decode(AC_LEAF_CERT_HEX, AC_LEAF_CERT_HEX_N);
    var lf_cert_len = AC_LEAF_CERT_HEX_N / 2;
    var ca_cert    = hex_decode(AC_CA_CERT_HEX, AC_CA_CERT_HEX_N);
    var ca_cert_len = AC_CA_CERT_HEX_N / 2;
    var lf_key = alloc(2384);
    assert_eq(rsa_privkey_from_der(lf_key_der, AC_LEAF_KEY_HEX_N / 2, lf_key) >= 0, 1,
        "chain fixture: leaf private key parses");

    var csgn = alloc(8192);
    var csgn_len = 0;
    assert_eq(authenticode_pe_sign(&pe, 256, lf_key, lf_cert, lf_cert_len,
                                   csgn, &csgn_len), 0, "sign with the leaf key");
    assert_eq(authenticode_pe_verify_chain(csgn, csgn_len, ca_cert, ca_cert_len, 0), 1,
        "leaf-signed PE verifies to the CA anchor");
    # Anchor-equality must REJECT it — the signer is the leaf, not the CA.
    assert_eq(authenticode_pe_verify(csgn, csgn_len, ca_cert, ca_cert_len, 0), 0,
        "anchor-equality rejects a leaf signed under the CA");
    # And the CA must not vouch for the unrelated self-signed db cert.
    assert_eq(authenticode_pe_verify_chain(sgn, sgn_len, ca_cert, ca_cert_len, 0), 0,
        "chain mode rejects a signer outside the CA");

    # ============================================================
    # ECDSA P-256 signer variant (3.12.2) — the other half of P4.
    # ============================================================
    test_group("Authenticode P-256 signer");

    var ec_scalar = hex_decode(AC_EC_SCALAR_HEX, AC_EC_SCALAR_HEX_N);
    var ec_cert   = hex_decode(AC_EC_CERT_HEX, AC_EC_CERT_HEX_N);
    var ec_cert_len = AC_EC_CERT_HEX_N / 2;

    var esgn = alloc(8192);
    var esgn_len = 0;
    assert_eq(authenticode_pe_sign_p256(&pe, 256, ec_scalar, ec_cert, ec_cert_len,
                                        esgn, &esgn_len), 0, "P-256 sign the synthetic PE");
    rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(esgn, esgn_len, ec_cert, ec_cert_len, 0, &rsn), 1,
        "P-256 signed PE verifies");
    assert_eq(rsn, AC_VOK, "  reason AC_VOK");

    var eb_save = load8(esgn + 0x50);
    store8(esgn + 0x50, eb_save ^ 0x01);
    assert_eq(authenticode_pe_verify(esgn, esgn_len, ec_cert, ec_cert_len, 0), 0,
        "P-256: tampered image body rejected");
    store8(esgn + 0x50, eb_save);

    var etab = _pe_rd32(esgn, secdir);
    var edw = _pe_rd32(esgn, etab);
    var elast = etab + edw - 1;
    var el_save = load8(esgn + elast);
    store8(esgn + elast, el_save ^ 0x01);
    assert_eq(authenticode_pe_verify(esgn, esgn_len, ec_cert, ec_cert_len, 0), 0,
        "P-256: tampered signature rejected");
    store8(esgn + elast, el_save);

    # Cross-algorithm: the RSA anchor must not validate the P-256 image.
    assert_eq(authenticode_pe_verify(esgn, esgn_len, ac_cert, ac_cert_len, 0), 0,
        "P-256 image rejected under the RSA anchor");
    assert_eq(authenticode_pe_verify(esgn, esgn_len, ec_cert, ec_cert_len, 0), 1,
        "P-256 blob restored intact");


    # ============================================================
    # Third-party shape: CMS signedAttrs + sha256WithRSAEncryption
    # ============================================================
    # sigil's own signer emits NO signedAttrs and a bare `rsaEncryption`
    # AlgId. Microsoft's and osslsigncode's do the opposite, and that is
    # the shape the verifier must also accept. This blob is built by an
    # INDEPENDENT implementation over the same synthetic PE — a Python DER
    # writer + `cryptography` RSA sign, committed as
    # tests/data/authenticode/gen_signedattrs_fixture.py so this blob is
    # reproducible rather than opaque —
    # so it tests the parser against something sigil did not produce:
    #   * signedAttrs present, so the signature covers DER(SET OF
    #     Attribute) — the [0] IMPLICIT span with tag 0xA0 re-encoded as
    #     0x31, length bytes untouched (RFC 5652 §5.4);
    #   * contentType + messageDigest attributes present and bound;
    #   * digestEncryptionAlgorithm is sha256WithRSAEncryption, not the
    #     bare rsaEncryption sigil emits.
    # Without the re-tag handled exactly right this fails to verify; with
    # it handled loosely, N-2/N-3 below would still pass, which is why
    # both a positive and two targeted negatives are here.
    test_group("Authenticode verify — third-party signedAttrs shape");

    var ATTRS_HEX = "";
    var at_pe = hex_decode(ATTRS_HEX, 3408);
    var at_len = 3408 / 2;

    rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(at_pe, at_len, ac_cert, ac_cert_len, 0, &rsn), 1,
        "signedAttrs + sha256WithRSAEncryption binary verifies");
    assert_eq(rsn, AC_VOK, "  reason AC_VOK");

    # Tamper the image body: the signedAttrs messageDigest binds the
    # SpcIndirectData, which binds the image hash — so this must fail at
    # the image-hash step, not later.
    var at_b = load8(at_pe + 0x50);
    store8(at_pe + 0x50, at_b ^ 0x01);
    rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(at_pe, at_len, ac_cert, ac_cert_len, 0, &rsn), 0,
        "signedAttrs: tampered image body rejected");
    assert_eq(rsn, AC_VERR_IMAGE_HASH, "  reason AC_VERR_IMAGE_HASH");
    store8(at_pe + 0x50, at_b);

    # Tamper the LAST byte (inside the RSA signature over the attrs).
    var at_tab = _pe_rd32(at_pe, secdir);
    var at_dw = _pe_rd32(at_pe, at_tab);
    var at_last = at_tab + at_dw - 1;
    var at_l = load8(at_pe + at_last);
    store8(at_pe + at_last, at_l ^ 0x01);
    rsn = 0 - 1;
    assert_eq(authenticode_pe_verify_ex(at_pe, at_len, ac_cert, ac_cert_len, 0, &rsn), 0,
        "signedAttrs: tampered signature rejected");
    assert_eq(rsn, AC_VERR_SIGNATURE, "  reason AC_VERR_SIGNATURE");
    store8(at_pe + at_last, at_l);

    assert_eq(authenticode_pe_verify(at_pe, at_len, ac_cert, ac_cert_len, 0), 1,
        "signedAttrs blob restored intact");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
